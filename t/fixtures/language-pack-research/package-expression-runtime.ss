#!/usr/bin/env gxi
;;; -*- Gerbil -*-
;;; Whole expression-vocabulary package control, through its checked public entry.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!)
        "package-expression-parser"
        (only-in "list-language" list-control-parser)
        (only-in :clan/poo/object .ref)
        (only-in "../../../src/runtime/parser" parse-source)
        (only-in "../../../src/runtime/artifact"
                 parse-artifact-success? parse-artifact-valid?
                 parse-artifact-events parse-artifact-roundtrip))
(export main)
(def (main)

     (def checked 0)
     (def (probe label actual expected)
          (unless (equal? actual expected)
            (error "expression package mismatch" label actual expected))
          (set! checked (+ checked 1))
          (display "PACKAGE-EXPRESSION-CASE-OK: ") (display label)
          (newline) (force-output))
     (probe 'loader-schema (.ref list-study-language 'schema) "gerbil-parser.language-entry.v2")
     (probe 'loader-language (.ref list-study-language 'language) "list-study")
     (probe 'loader-version (.ref list-study-language 'version) "v1")
     (probe 'loader-contract (.ref list-study-language 'contract) "list-study.local.v1")
     (probe 'bound-parse-method (eq? parse-list-study (.ref list-study-language '.parse)) #t)
     (for-each
      (lambda (case)
        (let* ((source (car case)) (field-name (cadr case)) (count (caddr case))
               (candidate (parse-list-study source))
               (control (parse-source list-control-parser source)))
          (probe (list 'accepted source) (parse-artifact-success? candidate) #t)
          (probe (list 'control-accepted source) (parse-artifact-success? control) #t)
          (probe (list 'valid-artifact source) (parse-artifact-valid? candidate) #t)
          (probe (list 'roundtrip source) (parse-artifact-roundtrip candidate) source)
          (probe (list 'complete-event-parity source)
                 (parse-artifact-events candidate) (parse-artifact-events control))
          (probe (list 'per-item-fields source)
                 (length (filter (lambda (event)
                                   (and (eq? (vector-ref event 0) 'start-field)
                                        (eq? (vector-ref event 1) field-name)))
                                 (parse-artifact-events candidate))) count)))
      '(("f()" argument 0) ("f(a)" argument 1) ("f(a,b,c)" argument 3)
        ("f( a , b )" argument 2) ("[]" element 0) ("[a]" element 1)
        ("[a,b,c]" element 3) ("[ a ,\n b ]" element 2)))
     (for-each
      (lambda (source)
        (let ((candidate (parse-list-study source))
              (control (parse-source list-control-parser source)))
          (probe (list 'rejected source) (parse-artifact-success? candidate) #f)
          (probe (list 'control-rejected source) (parse-artifact-success? control) #f)
          (probe (list 'rejected-artifact-valid source) (parse-artifact-valid? candidate) #t)
          (probe (list 'rejected-roundtrip source) (parse-artifact-roundtrip candidate) source)))
      '("f(,)" "f(a,)" "f(a b)" "f(a" "[,]" "[a,]" "[a b]" "[a"))
     (display "PACKAGE-EXPRESSION-OK: ") (display checked)
     (display " checks passed") (newline) (force-output)
     (test-child-process-exit! 0)
     )
