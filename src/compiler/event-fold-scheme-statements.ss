;;; -*- Gerbil -*-
;;; Direct transitions over request-local slots and a reversed event chain.
(import (only-in ./event-fold-scheme-context
                 current-fold-scheme-counter fold-scheme-fresh-name fold-scheme-share-statements
                 fold-scheme-event current-fold-scheme-tape-kinds current-fold-scheme-idle-plan
                 current-fold-scheme-effect-only)
        (only-in ./event-fold-zero-state fold-zero-state-plan fold-ordinary-state-plan)
        (only-in ./event-fold-ordinary-run fold-ordinary-run-plan)
        (only-in ./event-fold-scheme-runs fold-scheme-run-loop)
        (only-in ./event-fold-scheme-expressions
                 fold-scheme-offset fold-scheme-uint fold-scheme-predicate)
        (only-in ./event-fold-byte-dispatch fold-byte-dispatch fold-byte-prefilter)
        (only-in ./event-fold-shared-probes fold-fuse-byte-probes)
        (only-in ./event-fold-analysis fold-eliminate-inert-branches))
(export fold-scheme-statements fold-scheme-bindings fold-scheme-initial
        current-fold-scheme-counter fold-scheme-fresh-name)

(def (fold-scheme-bindings initial)
  (let loop ((rest initial) (ordinal 0) (bindings '()))
    (if (null? rest) (reverse bindings)
      (loop (cdr rest) (+ ordinal 1)
            (cons (cons (caar rest) `(vector-ref slots ,ordinal)) bindings)))))

(def (fold-scheme-initial initial)
  `(vector ,@(map (lambda (entry)
                    (if (equal? (cadr entry) '(uint-stack)) ''() (cadr entry)))
                  initial)))

(def (lvalue bindings name)
  (let (entry (assq name bindings))
    (unless entry (error "unbound native fold transition slot" name))
    (cdr entry)))

(def (assign target value)
  (if (symbol? target) `(set! ,target ,value)
    `(vector-set! slots ,(caddr target) ,value)))

(def (fold-scheme-statements forms bindings indices helpers)
  (def (offset value) (fold-scheme-offset value bindings indices))
  (def (uint value) (fold-scheme-uint value bindings indices))
  (def (predicate value) (fold-scheme-predicate value bindings indices))
  (def (body statements (locals bindings) (cursors indices))
    (if (null? statements) '((void))
      (fold-scheme-statements statements locals cursors helpers)))
  (def (finishes count)
    (map (lambda (_) (fold-scheme-event 'finish)) (iota count)))
  (fold-scheme-share-statements
   (map
   (lambda (form)
     (case (car form)
       ((%shared-byte-probes)
        (let* ((first (cadr form)) (second (caddr form)) (probe (cadr first))
               (mask (fold-scheme-fresh-name 'probe-mask))
               (cursor (fold-scheme-fresh-name 'probe-cursor))
               (limit (fold-scheme-fresh-name 'probe-limit))
               (facts (if (equal? (caddr probe) '(line-content-end))
                        (cons (cons '%shared-content-end limit) indices) indices)))
          `(let ((from ,(offset (cadr probe))) (,limit ,(offset (caddr probe))))
             (unless (<= start from ,limit end)
               (error "native fold range outside source line"))
             (let (,mask
                     (let scan ((,cursor from) (found 0))
                       (if (or (fx= ,cursor ,limit) (fx= found ,(list-ref form 4))) found
                         (scan (fx+ ,cursor 1)
                               (fxior found (u8vector-ref ',(list-ref form 3)
                                              (u8vector-ref source-bytes ,cursor)))))))
               (if (fx= 0 (fxand ,mask 1)) (begin ,@(body (cadddr first) bindings facts))
                   (begin ,@(body (caddr first) bindings facts)))
               (if (fx= 0 (fxand ,mask 2)) (begin ,@(body (cadddr second) bindings facts))
                   (begin ,@(body (caddr second) bindings facts)))))))
       ((set-bool set-uint)
        (assign (lvalue bindings (cadr form))
                (if (eq? (car form) 'set-bool)
                  (predicate (caddr form)) (uint (caddr form)))))
       ((start-node) (fold-scheme-event 'start (cadr form)))
       ((finish-node) (fold-scheme-event 'finish))
       ((token)
        `(let ((from ,(offset (caddr form))) (until ,(offset (cadddr form))))
           (unless (= from until)
             ,(fold-scheme-event 'token (cadr form) 'from 'until))))
       ((if)
        (let* ((proof (assq '%validated-loop-byte indices))
               (plan (and proof (fold-byte-dispatch form (cadr proof)))))
          (if plan
            `(case ,(cddr proof)
               ,@(map (lambda (entry) `((,(car entry)) ,@(body (cdr entry))))
                      (vector-ref plan 0))
               (else ,@(body (vector-ref plan 1))))
            `(if ,(predicate (or (and proof (fold-byte-prefilter (cadr form) (cadr proof)))
                                (cadr form)))
                 (begin ,@(body (caddr form))) (begin ,@(body (cadddr form)))))))
       ((join-once)
        (let* ((handled (fold-scheme-fresh-name 'handled))
               (locals (cons (cons (cadr form) handled) bindings)))
          `(let (,handled #f)
             ,@(body (caddr form) locals)
             (unless ,handled ,@(body (cadddr form) locals)))))
       ((for-line-bytes)
        (let* ((cursor (fold-scheme-fresh-name 'cursor)) (limit (fold-scheme-fresh-name 'limit))
               (byte (fold-scheme-fresh-name 'byte))
               (run (and (current-fold-scheme-tape-kinds)
                         (eq? (current-fold-scheme-idle-plan) 'ordinary-run)
                         (fold-ordinary-run-plan (list-ref form 4) (cadr form)))))
          (if run
            (parameterize ((current-fold-scheme-idle-plan #f))
              (fold-scheme-run-loop form run (offset (caddr form)) (offset (cadddr form))
                                    cursor limit byte bindings indices body))
          `(let ((from ,(offset (caddr form))) (,limit ,(offset (cadddr form))))
             (unless (<= start from ,limit end)
               (error "native fold iteration outside source line"))
             (let iterate ((,cursor from))
               (unless (= ,cursor ,limit)
                 ,@(if (current-fold-scheme-tape-kinds)
                    `((let (,byte (u8vector-ref source-bytes ,cursor))
                        ,@(let* ((ordinary? (memq (current-fold-scheme-idle-plan) '(ordinary ordinary-run)))
                                 (plan (and (current-fold-scheme-idle-plan)
                                            (if ordinary?
                                              (fold-ordinary-state-plan (list-ref form 4) (cadr form))
                                              (fold-zero-state-plan (list-ref form 4)))))
                                 (prepared (if plan
                                             (list (list 'if (cons 'and
                                                       (append (if ordinary?
                                                                 (list `(not (line-bytes-any-in? (line-index ,(cadr form))
                                                                               (line-step (line-index ,(cadr form))) ,(vector-ref plan 1)))) '())
                                                               (map (lambda (name) `(uint-equal? (state ,name) (uint 0))) (vector-ref plan 0))))
                                                         (vector-ref plan (if ordinary? 2 1)) (list-ref form 4)))
                                             (list-ref form 4))))
                           (parameterize ((current-fold-scheme-idle-plan #f))
                            (body prepared bindings
                           (cons (cons '%validated-loop-byte (cons (cadr form) byte))
                             (cons (cons '%loop-byte-value byte)
                               (cons (cons (cadr form) cursor)
                                 (if (equal? (cadddr form) '(line-content-end))
                                   (cons (cons '%shared-content-end limit) indices)
                                   indices)))))))))
                    (body (list-ref form 4) bindings (cons (cons (cadr form) cursor) indices)))
                 (iterate (+ ,cursor 1))))))))
       ((with-source-bounds)
        `(let ((from ,(offset (cadr form))) (until ,(offset (caddr form))))
           (fold-source-frame-boundaries! source-bytes from until)
           (let ((start from) (end until))
             ,@(body (cadddr form) bindings
                     (filter (lambda (entry)
                               (not (memq (car entry) '(%validated-loop-byte %loop-byte-value %shared-content-end)))) indices)))))
       ((call-source-helper)
        (let (helper (assq (cadr form) helpers))
          (unless helper (error "unknown native fold helper" form))
          `(set! events
              (,(cdr helper) source-bytes ,(offset (caddr form)) ,(offset (cadddr form))
                            events ,@(map uint (if (= (length form) 5)
                                               (list-ref form 4) '()))))))
       ((scan-list-marker)
        `(let (marker (scan-event-list-marker-bytes source-bytes start end
                          ',(string->utf8 (cadr form)) ,(caddr form) ,(cadddr form)))
           ,(assign (lvalue bindings (list-ref form 4)) '(if marker #t #f))
           (when marker
             ,@(map (lambda (name ordinal)
                      (assign (lvalue bindings name) `(vector-ref marker ,ordinal)))
                    (list-tail form 5) '(0 1 2 3 4)))))
       ((push-frame open-level)
        (let (target (lvalue bindings (cadr form)))
          `(begin
             ,(assign target `(cons ,(uint (caddr form)) ,target))
             ,@(if (eq? (car form) 'open-level)
                 (list (fold-scheme-event 'start (cadddr form))) '()))))
       ((pop-frame close-frame)
        (let (target (lvalue bindings (cadr form)))
          `(when (pair? ,target)
             ,(assign target `(cdr ,target))
             ,@(if (eq? (car form) 'close-frame) (finishes (caddr form)) '()))))
       ((close-through)
        (let (target (lvalue bindings (cadr form)))
          `(let (level ,(uint (caddr form)))
             (let close ()
               (when (and (pair? ,target) (>= (car ,target) level))
                 ,(assign target `(cdr ,target))
                 ,(fold-scheme-event 'finish)
                 (close))))))
       ((close-frames-while)
        (let (target (lvalue bindings (cadr form)))
          `(let close ()
             (when (and (pair? ,target) ,(predicate (caddr form)))
               ,(assign target `(cdr ,target))
               ,@(finishes (list-ref form 3))
               (close)))))
       ((close-all close-all-frames)
        (let ((target (lvalue bindings (cadr form)))
              (count (if (eq? (car form) 'close-all) 1 (caddr form))))
          `(begin
             (let close ()
               (when (pair? ,target)
                 ,(assign target `(cdr ,target))
                 ,@(finishes count)
                 (close)))
             ,(assign target ''()))))
       (else (error "unadmitted native fold transition" form))))
   (if (current-fold-scheme-tape-kinds)
     (fold-fuse-byte-probes
      (if (eq? (current-fold-scheme-effect-only) 'pruned)
        (let (proof (assq '%validated-loop-byte indices))
          (fold-eliminate-inert-branches forms (and proof (cadr proof))))
        forms)) forms)) bindings indices))
