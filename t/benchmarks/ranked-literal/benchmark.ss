;;; Shared lexer publication: prefix chains, filtered modes and scalar controls.
(import (only-in :gerbil-parser/src/runtime/scan make-ranked-literal-scanner make-literal-trie
                 make-bounded-literal-end-scanner)
        (only-in :gerbil-parser/src/runtime/parse-cost admit-parser-allocation)
        (only-in :gerbil-parser/t/benchmarks/parser-stage-cost/benchmark measure-parser-component measure-parser-batch sample-at-percentile measure-parser-cpu-pairs))
(export benchmark-ranked-literal benchmark-ranked-literal-requests benchmark-literal-edge-cpu qualify-literal-edge-cpu
        benchmark-ranked-edge-cpu qualify-ranked-edge-cpu)
(def (benchmark-ranked-literal (samples 11) (iterations 1000))
  (unless (and (exact-integer? samples) (positive? samples)
               (exact-integer? iterations) (positive? iterations))
    (error "ranked literal benchmark requires positive exact counts"))
  (let* ((entries (map (lambda (n) (list (make-string (+ n 1) #\a) n n n)) (iota 32)))
         (scan (make-ranked-literal-scanner entries)) (text (make-string 32 #\a))
         (single (make-ranked-literal-scanner '(("a" single 0 0))))
         (short (make-vector 32 #f)) (none (make-vector 32 #f)))
    (vector-set! short 0 #t)
    (for-each (lambda (row)
      (let ((scanner (car row)) (source (cadr row)) (admitted (caddr row))
            (width (cadddr row)) (name (car (cddddr row))))
        (let sample ((index 0))
          (when (< index samples)
            (let* ((before (##process-statistics))
                   (sum (let repeat ((count 0) (total 0))
                          (if (= count iterations) total
                            (let (found (scanner source 0 admitted))
                              (repeat (+ count 1) (+ total (if found (cadr found) 0)))))))
                   (after (##process-statistics))
                   (delta (lambda (slot) (- (f64vector-ref after slot) (f64vector-ref before slot)))))
              (unless (= sum (* iterations width)) (error "ranked literal endpoint changed" name))
              (write (list 'ranked-literal name index 'iterations iterations
                           'cpu-ms-per-call (/ (* 1000 (+ (delta 0) (delta 1))) iterations)
                           'allocated-bytes-per-call
                           (let (bytes (admit-parser-allocation (delta 7) (delta 6)))
                             (and bytes (/ bytes iterations)))))
              (newline) (force-output))
            (sample (+ index 1))))))
      (list (list scan text #f 32 'prefix-chain) (list scan text short 1 'short-admitted)
            (list single "a" #f 1 'single-terminal) (list scan text none 0 'all-filtered))))
  (displayln "RANKED-LITERAL-OK") (force-output))

;;; Compiled complete-result controls across accepting-prefix depths.
(def (benchmark-ranked-literal-requests)
  (for-each
   (lambda (width)
     (let* ((entries (map (lambda (index)
                           (list (make-string (+ index 1) #\a) 'literal index index))
                         (iota width)))
            (scan (make-ranked-literal-scanner entries))
            (source (string-append (make-string width #\a) "!"))
            (mask (make-vector width #f)))
       (vector-set! mask 0 #t)
       (measure-parser-component (list 'accepting-prefixes width) 20 5000
         (lambda () (scan source 0)) (list 'literal width (- width 1) (- width 1)))
       (measure-parser-component (list 'filtered-prefixes width) 20 5000
         (lambda () (scan source 0 mask)) '(literal 1 0 0))
       (measure-parser-component (list 'missing-prefix width) 20 5000
         (lambda () (scan "!" 0)) #f)))
   '(1 4 16 64))
  (displayln "RANKED-LITERAL-REQUESTS-OK") (force-output))

;;; The reference changes edge storage only, retaining the complete bounded
;;; scanner protocol. It is a primitive comparator, not a second parser engine.
(def (table-edge-copy node)
  (let ((edges (vector-ref node 1)) (children (make-table test: eqv?)))
    (for-each (lambda (edge)
                (table-set! children (car edge) (table-edge-copy (cdr edge))))
              (cond ((pair? edges) (list edges))
                    ((not edges) '())
                    (else (table->list edges))))
    (vector (vector-ref node 0) children)))
(def (table-edge-scanner literals)
  (let (root (table-edge-copy (make-literal-trie (map (lambda (text) (cons text #t)) literals))))
    (lambda (source start limit)
      (and (exact-integer? start) (exact-integer? limit)
           (<= 0 start limit (string-length source))
        (let loop ((node root) (offset start) (selected #f))
          (if (= offset limit) selected
            (let (child (table-ref (vector-ref node 1) (string-ref source offset) #f))
              (if child
                (let (next (+ offset 1))
                  (loop child next (if (vector-ref child 0) next selected)))
                selected))))))))
(def (edge-field row key) (cdr (assq key row)))
(def (benchmark-literal-edge-cpu (groups 20) (characters-per-batch 1000000) (widths '(1 8 32 128)))
  (unless (and (exact-integer? groups) (>= groups 20)
               (exact-integer? characters-per-batch) (>= characters-per-batch 128)
               (list? widths) (pair? widths)
               (andmap (lambda (width) (memv width '(1 8 32 128))) widths))
    (error "edge CPU benchmark requires twenty groups and positive resolved batches"))
  (let (summaries '())
  (for-each
   (lambda (width)
     (let* ((literals (list (make-string width #\a) (string-append "β" (make-string width #\a))))
            (source (string-append (car literals) "!"))
            (limit (string-length source))
            (calls (quotient characters-per-batch width))
            (reference-scan (table-edge-scanner literals))
            (candidate-scan (make-bounded-literal-end-scanner literals))
            (reference (lambda () (reference-scan source 0 limit)))
            (candidate (lambda () (candidate-scan source 0 limit))))
       ;; Validate the production primitive against direct string matching at
       ;; all boundaries, including Unicode and failure, outside timed batches.
       (for-each (lambda (text)
         (let positions ((start 0))
           (when (<= start (string-length text))
             (let limits ((end start))
               (when (<= end (string-length text))
                 (let (expected
                       (let linear ((rest literals) (best #f))
                         (if (null? rest) best
                           (let (next (+ start (string-length (car rest))))
                             (linear (cdr rest)
                               (if (and (<= next end)
                                        (string=? (car rest) (substring text start next)))
                                 (if best (max best next) next) best))))))
                   (unless (and (equal? (reference-scan text start end) expected)
                                (equal? (candidate-scan text start end) expected))
                     (error "bounded edge result differs from linear oracle" width start end)))
                 (limits (+ end 1))))
             (positions (+ start 1)))))
         (list source "!" (cadr literals) "β!"))
       (let* ((before (measure-parser-cpu-pairs width 'control-before groups calls width reference reference))
              (result (measure-parser-cpu-pairs width 'production groups calls width reference candidate))
              (after (measure-parser-cpu-pairs width 'control-after groups calls width reference reference))
              (stable? (lambda (ratios) (and (>= (car ratios) 0.9) (<= (caddr ratios) 1.1))))
              (admitted? (and (stable? before) (stable? after) (< (caddr result) 0.95))))
         (write (list 'LITERAL-EDGE-CPU-SUMMARY width 'groups groups 'calls-per-batch calls
                      'before before 'production result 'after after 'cpu-benefit admitted?))
         (set! summaries
           (cons (cons width (list (cons 'before before) (cons 'production result)
                                  (cons 'after after) (cons 'cpu-benefit admitted?))) summaries))
         (newline) (force-output)))) widths)
  (displayln "LITERAL-EDGE-CPU-OK") (force-output)
  (reverse summaries)))

;;; Explicit performance test: correctness/completion alone cannot pass it.
(def (qualify-literal-edge-cpu (groups 20) (characters-per-batch 2000000))
  (let (summaries (benchmark-literal-edge-cpu groups characters-per-batch '(128)))
    (unless (andmap (lambda (entry) (edge-field (cdr entry) 'cpu-benefit)) summaries)
      (error "literal edge CPU qualification failed its unchanged controls and benefit gate" summaries))
    (displayln "LITERAL-EDGE-CPU-PROOF-OK") (force-output)
    summaries))

;;; Preserve the old ranked traversal and terminal publication exactly; change
;;; only prepared edge storage to tables for the matched CPU reference.
(def (table-ranked-scanner entries)
  (def (best-admitted candidates admitted)
    (let loop ((remaining candidates) (best #f))
      (if (null? remaining) best
        (let (candidate (car remaining))
          (loop (cdr remaining)
            (if (and (or (not admitted) (vector-ref admitted (caddr candidate)))
                     (or (not best) (> (cadr candidate) (cadr best))
                         (and (= (cadr candidate) (cadr best))
                              (< (caddr candidate) (caddr best)))))
              candidate best))))))
  (let (root (table-edge-copy
              (make-literal-trie
                (map (lambda (entry) (cons (car entry) (cdr entry))) entries)
                '() (lambda (previous payload) (cons payload previous)))))
    (lambda (source start (admitted #f))
      (let (limit (string-length source))
        (let scan ((node root) (offset start) (selected #f))
          (if (= offset limit) selected
            (let (child (table-ref (vector-ref node 1) (string-ref source offset) #f))
              (if child
                (let* ((next (+ offset 1)) (terminal (best-admitted (vector-ref child 0) admitted)))
                  (scan child next
                    (if terminal (list (car terminal) next (cadr terminal) (caddr terminal)) selected)))
                selected))))))))

;;; Independent catalog oracle, including all four public result fields.
(def (ranked-edge-oracle entries source start admitted)
  (let loop ((rest entries) (best #f))
    (if (null? rest)
      (and best (list (cadr best) (+ start (string-length (car best))) (caddr best) (cadddr best)))
      (let* ((entry (car rest)) (width (string-length (car entry))))
        (loop (cdr rest)
          (if (and (or (not admitted) (vector-ref admitted (cadddr entry)))
                   (<= (+ start width) (string-length source))
                   (string=? (car entry) (substring source start (+ start width)))
                   (or (not best) (> width (string-length (car best)))
                       (and (= width (string-length (car best)))
                            (or (> (caddr entry) (caddr best))
                                (and (= (caddr entry) (caddr best))
                                     (< (cadddr entry) (cadddr best))))))) entry best))))))

(def (benchmark-ranked-edge-cpu (groups 20) (characters-per-batch 2000000)
                                (names '(ranked-hit ranked-filtered ranked-rejected branch-hit)))
  (unless (and (exact-integer? groups) (>= groups 20)
               (exact-integer? characters-per-batch) (>= characters-per-batch 128)
               (list? names) (pair? names)
               (andmap (lambda (name) (memq name '(ranked-hit ranked-filtered ranked-rejected branch-hit))) names))
    (error "ranked CPU benchmark requires declared workloads and resolved batches"))
  (map (lambda (name)
    (let* ((literal (make-string 128 #\a))
           (entries (if (eq? name 'branch-hit)
                      (map (lambda (code) (list (string (integer->char code)) 'branch 0 (- code 32))) (iota 96 32))
                      (list (list literal 'first 2 0) (list literal 'later 2 1)
                            (list literal 'higher 3 2) '("a" short 9 3) '("β😀" unicode 1 4))))
           (source (if (eq? name 'branch-hit) "x!" (string-append literal "!")))
           (mask (case name
                   ((ranked-filtered) '#(#t #f #f #t #t))
                   ((ranked-rejected) '#(#f #f #f #f #f))
                   (else #f)))
           (calls (quotient characters-per-batch (if (eq? name 'branch-hit) 1 128)))
           (reference-scan (table-ranked-scanner entries))
           (candidate-scan (make-ranked-literal-scanner entries))
           (reference (lambda () (reference-scan source 0 mask)))
           (candidate (lambda () (candidate-scan source 0 mask)))
           (expected (ranked-edge-oracle entries source 0 mask)))
      (for-each (lambda (text)
        (let offsets ((start 0))
          (when (<= start (string-length text))
            (for-each (lambda (admitted)
              (let (oracle (ranked-edge-oracle entries text start admitted))
                (unless (and (equal? (reference-scan text start admitted) oracle)
                             (equal? (candidate-scan text start admitted) oracle))
                  (error "ranked edge complete result differs from catalog" name start))))
              (list #f mask))
            (offsets (+ start 1))))) (list source "!β😀!" "a!" ""))
      (let* ((before (measure-parser-cpu-pairs name 'control-before groups calls expected reference reference))
             (result (measure-parser-cpu-pairs name 'production groups calls expected reference candidate))
             (after (measure-parser-cpu-pairs name 'control-after groups calls expected reference reference))
             (stable? (lambda (ratios) (and (>= (car ratios) 0.90) (<= (caddr ratios) 1.10))))
             (admitted? (and (stable? before) (stable? after) (< (caddr result) 0.95)))
             (summary (list (cons 'before before) (cons 'production result)
                            (cons 'after after) (cons 'cpu-benefit admitted?))))
        (write (list 'RANKED-EDGE-CPU-SUMMARY name 'groups groups 'calls-per-batch calls summary))
        (newline) (force-output)
        (cons name summary)))) names))

(def (qualify-ranked-edge-cpu (groups 20) (characters-per-batch 2000000))
  (let (summaries (benchmark-ranked-edge-cpu groups characters-per-batch '(ranked-hit)))
    (unless (andmap (lambda (entry) (edge-field (cdr entry) 'cpu-benefit)) summaries)
      (error "ranked edge CPU controls or benefit gate failed" summaries))
    (displayln "RANKED-EDGE-CPU-PROOF-OK") (force-output)
    summaries))
