;;; Consumer-local selector facts follow control flow and declared support.
;;; No runtime cache or all-machine admission guard is generated.
(import (only-in ./event-fold-analysis fold-expression-analysis fold-statement-analysis))
(export fold-consumer-selector-body)

(def (fold-consumer-selector-body forms)
  (def (pure? predicate)
    (null? (vector-ref (fold-expression-analysis predicate) 2)))
  (def (known predicate facts)
    (let (entry (assoc predicate facts)) (and entry (list 'bool (cdr entry)))))
  (def (select predicate truth facts)
    (let (facts (cons (cons predicate truth) facts))
      (case (car predicate)
        ((not) (select (cadr predicate) (not truth) facts))
        ((and or)
         (if (eq? truth (eq? (car predicate) 'and))
           (foldl (lambda (part selected) (select part truth selected)) facts (cdr predicate)) facts))
        (else facts))))
  (def (invalidate forms facts)
    (let (effect (fold-statement-analysis forms))
      (if (any (cut memq <> '(opaque helper bounds)) (vector-ref effect 2)) '()
        (filter (lambda (fact)
                  (not (any (cut memq <> (vector-ref effect 1))
                            (vector-ref (fold-expression-analysis (car fact)) 0)))) facts))))
  (def (common left right) (filter (cut member <> right) left))
  (def (walk forms facts)
    (let loop ((rest forms) (facts facts) (out '()))
      (if (null? rest) (vector (reverse out) facts)
        (let (form (car rest))
          (if (eq? (car form) 'if)
            (let* ((predicate (cadr form)) (pure (pure? predicate))
                   (value (and pure (known predicate facts))))
              (if value
                (let (chosen (walk (if (cadr value) (caddr form) (cadddr form)) facts))
                  (loop (cdr rest) (vector-ref chosen 1)
                        (append (reverse (vector-ref chosen 0)) out)))
                (let* ((basis (if pure facts '()))
                       (yes (walk (caddr form) (if pure (select predicate #t basis) basis)))
                       (no (walk (cadddr form) (if pure (select predicate #f basis) basis))))
                  (loop (cdr rest) (common (vector-ref yes 1) (vector-ref no 1))
                    (cons (list 'if predicate (vector-ref yes 0) (vector-ref no 0)) out)))))
            ;; Loops, lexical joins and helper/frame handoffs remain opaque
            ;; here. No selector truth is carried into another iteration.
            (loop (cdr rest) (invalidate (list form) facts) (cons form out)))))))
  (vector-ref (walk forms '()) 0))
