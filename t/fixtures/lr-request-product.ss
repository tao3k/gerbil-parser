;;; Typed extraction and independent request/AST/publication interpretation.
(import :gerbil-parser/src/runtime/recognition
        (only-in :gerbil-parser/src/runtime/token token? token-kind token-lexeme token-start token-end)
        (only-in :gerbil-parser/src/runtime/funcs recognition-sequence->list)
        (only-in :gerbil-parser/src/compiler/lr production-id production-rhs operand-actions production-action)
        (only-in :gerbil-parser/src/runtime/lr-parser lr-recognition-fragment?
                 lr-recognition-fragment-production-id lr-recognition-fragment-children lr-recognition-fragment-offset)
        (only-in :std/list/list-builder with-list-builder))
(export extract-value extract-token extract-event replay-request reference-events)
(def (name-text name)
  (cond ((symbol? name) (symbol->string name)) ((string? name) name)
        (else (error "unadmitted model name" name))))
(def (natural value)
  (unless (and (integer? value) (exact? value) (>= value 0)) (error "unadmitted model natural" value)) value)
(def (extract-token token)
  (unless (token? token) (error "model extraction requires token" token))
  (unless (string? (token-lexeme token)) (error "unadmitted token lexeme" token))
  (list 'token (name-text (token-kind token)) (natural (token-start token))
        (natural (token-end token)) (token-lexeme token)))
(def (extract-children children)
  (map (lambda (child)
         (list (and (recognition-child-field child) (name-text (recognition-child-field child)))
               (extract-value (recognition-child-value child))))
       (recognition-sequence->list children)))
(def (extract-value value)
  (cond
   ((token? value) (extract-token value))
   ((recognition-node? value)
    (list 'node (name-text (recognition-node-kind value))
          (natural (recognition-node-start value)) (natural (recognition-node-end value))
          (extract-children (recognition-node-children value))))
   ((recognition-fragment? value)
    (list 'fragment #f (natural (recognition-fragment-start value)) (natural (recognition-fragment-end value))
          (extract-children (recognition-fragment-children value))))
   (else (error "unadmitted model value" value))))
(def (extract-event event)
  (unless (and (vector? event) (> (vector-length event) 0)) (error "invalid model event" event))
  (case (vector-ref event 0)
    ((token)
     (unless (= (vector-length event) 6) (error "invalid token event width" event))
     (unless (string? (vector-ref event 3)) (error "invalid token event lexeme" event))
     (list 'token (natural (vector-ref event 1)) (name-text (vector-ref event 2))
           (vector-ref event 3) (natural (vector-ref event 4)) (natural (vector-ref event 5))))
    ((start-node finish-node)
     (unless (= (vector-length event) 4) (error "invalid node event width" event))
     (list (vector-ref event 0) (natural (vector-ref event 1)) (name-text (vector-ref event 2))
           (natural (vector-ref event 3))))
    ((start-field finish-field)
     (unless (= (vector-length event) 3) (error "invalid field event width" event))
     (list (vector-ref event 0) (name-text (vector-ref event 1)) (natural (vector-ref event 2))))
    (else (error "unknown model event tag" event))))
(def (bounds children offset)
  (if (null? children) (list offset offset)
    (list (caddr (cadar children))
          (let last ((rest children))
            (if (null? (cdr rest)) (cadddr (cadar rest)) (last (cdr rest)))))))
(def (interpret-actions actions children offset)
  (if (null? actions) children
    (let* ((action (car actions)) (name (name-text (cadr action))) (span (bounds children offset))
           (value
            (case (car action)
              ((field)
               (cond ((null? children) '())
                     ((and (null? (cdr children)) (not (caar children))) (list (list name (cadar children))))
                     (else (list (list name (list 'fragment #f (car span) (cadr span) children))))))
              ((alias) (list (list #f (list 'node name (car span) (cadr span) children))))
              (else (error "unadmitted semantic action" action)))))
      (interpret-actions (cdr actions) value offset))))
;;; Return the complete source-order instruction list and semantic value.
;;; No cached fragment value or native reducer participates in this evaluator.
(def (replay-request table root tokens)
  (let ((instructions '()) (pending tokens)
        (input-end (foldl (lambda (token current) (max current (token-end token))) 0 tokens)))
    (def (visit piece)
      (cond
       ((token? piece)
        (unless (and (pair? pending) (eq? piece (car pending)))
          (error "request extraction lost source-token identity/order" piece))
        (set! pending (cdr pending))
        (set! instructions (cons (list 'shift (extract-token piece)) instructions))
        (list (list #f (extract-token piece))))
       ((lr-recognition-fragment? piece)
        (let* ((id (lr-recognition-fragment-production-id piece)) (production (vector-ref table id))
               (children (map visit (lr-recognition-fragment-children piece)))
               (rhs (production-rhs production)) (offset (lr-recognition-fragment-offset piece)))
          (unless (and (= (production-id production) id) (= (length rhs) (length children))
                       (memq (production-action production) '(pass concat)))
            (error "request extraction lost production identity/width" id))
          (unless (= offset (if (pair? pending) (token-start (car pending)) input-end))
            (error "request extraction lost pending/EOF boundary" id offset))
          (set! instructions (cons (list 'reduce id (natural offset)) instructions))
          (let reduce ((operands rhs) (remaining children) (result '()))
            (if (null? operands) result
              (let (anchor (if (pair? (car remaining)) offset
                              (let next ((values (cdr remaining)))
                                (cond ((null? values) offset)
                                      ((null? (car values)) (next (cdr values)))
                                      (else (car (bounds (car values) offset)))))))
                (reduce (cdr operands) (cdr remaining)
                        (append result (interpret-actions (operand-actions (car operands)) (car remaining) anchor))))))))
       (else (error "unadmitted request derivation" piece))))
    (let (result (visit root))
      (unless (null? pending) (error "request extraction left significant tokens" pending))
      (values (reverse instructions) result))))

;;; Interpret the extracted closed AST; consume the actual source queue.
(def (reference-events root tokens trivia? source-end)
  (unless (eq? (car root) 'node) (error "model root must be node" root))
  (with-list-builder (emit!)
    (let ((remaining tokens) (next-node 0) (next-token 0))
      (def (emit-token!)
        (let (token (extract-token (car remaining)))
          (emit! (list 'token next-token (cadr token) (car (cddddr token)) (caddr token) (cadddr token)))
          (set! next-token (+ next-token 1)) (set! remaining (cdr remaining))))
      (def (flush boundary)
        (when (and (pair? remaining) (<= (token-end (car remaining)) boundary))
          (unless (trivia? (car remaining)) (error "model unclaimed significant token" (car remaining)))
          (emit-token!) (flush boundary)))
      (def (visit value field root?)
        (let* ((kind (car value)) (name (cadr value))
               (start (if root? 0 (caddr value))) (end (if root? source-end (cadddr value))))
          (flush start)
          (when field (emit! (list 'start-field field start)))
          (case kind
            ((token)
             (unless (and (pair? remaining) (equal? value (extract-token (car remaining))))
               (error "model token does not bind current source" value))
             (emit-token!))
            ((node fragment)
             (let (id next-node)
               (when (eq? kind 'node)
                 (set! next-node (+ next-node 1)) (emit! (list 'start-node id name start)))
               (for-each (lambda (child) (visit (cadr child) (car child) #f)) (car (cddddr value)))
               (flush end)
               (when (eq? kind 'node) (emit! (list 'finish-node id name end)))))
            (else (error "unknown extracted AST tag" kind)))
          (when field (emit! (list 'finish-field field end)))))
      (visit root #f #t)
      (unless (null? remaining) (error "model source tokens remain" remaining)))))
