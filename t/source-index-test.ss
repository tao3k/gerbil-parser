#!/usr/bin/env gxi
(import :gerbil-parser/language-test-support)
(import :std/test :std/iter
        (only-in :gerbil-parser/src/runtime/token make-token token-kind token-lexeme token-start token-end)
        (only-in :gerbil-parser/src/runtime/source-index
                 source-index-count source-index-height source-index-start source-index-end
                 source-index-shift source-index-concat source-index-slice source-index->lists
                 source-index-audit source-index-storage make-source-index-builder
                 source-index-builder-token! source-index-builder-shared! source-index-builder-finish
                 source-index-builder-fresh source-index-builder-shared source-index-builder-chunks source-index-builder-mode-chunks
                 make-source-index-cursor source-index-cursor-copy source-index-cursor-token
                 source-index-cursor-mode source-index-cursor-rank source-index-cursor-next! source-index-cursor-seek!))
(def (build tokens modes)
  (let (builder (make-source-index-builder))
    (for-each (lambda (token mode) (source-index-builder-token! builder token mode)) tokens modes)
    (source-index-builder-finish builder)))
(def (tokens n)
  (let loop ((at 0) (found '()))
    (if (= at n) (reverse found)
      (loop (+ at 1) (cons (make-token 'identifier "x" at (+ at 1)) found)))))
(def (materialize tree)
  (call-with-values (lambda () (source-index->lists tree)) list))
(def (relocate token delta)
  (make-token (token-kind token) (token-lexeme token) (+ delta (token-start token)) (+ delta (token-end token))))
(deflanguage-parser-tests source-index-test "persistent measured source index"
  (engine)
    (scenario "empty streams and token/mode ownership"
      (sequential ((source (tokens 130)) (modes (map (lambda (at) (modulo at 7)) (iota 130)))
             (tree (build source modes)))
        (equal (source-index-count #f)  0)
        (equal (materialize #f)  '(() ()))
        (equal (source-index-audit tree)  #t)
        (equal (materialize tree)  (list source modes))
        (equal (<= (source-index-height tree) 4)  #t)
        (scope ((cursor (make-source-index-cursor tree 63)))
          (equal (eq? (source-index-cursor-token cursor) (list-ref source 63))  #t)
          (equal (source-index-cursor-mode cursor)  0)
          (act (source-index-cursor-next! cursor))
          (equal (source-index-cursor-token cursor)  (list-ref source 64))
          (equal (source-index-cursor-mode cursor)  1))))
    (scenario "UTF8 byte positions remain independent of character measures"
      (sequential ((source (list (make-token 'identifier "λ中😀" 0 9) (make-token 'trivia " " 9 10)
                           (make-token 'identifier "é" 10 12))) (modes '(2 2 4))
             (tree (build source modes)) (shifted (source-index-shift tree 5)))
        (equal (source-index-audit shifted)  #t)
        (equal (materialize shifted)  (list (map (cut relocate <> 5) source) modes))
        (equal (eq? (source-index-shift shifted -5) tree)  #t)
        (scope ((cursor (make-source-index-cursor shifted)))
          (act (source-index-cursor-seek! cursor 6))
          (equal (source-index-cursor-rank cursor)  1)
          (equal (token-start (source-index-cursor-token cursor))  14)
          (act (source-index-cursor-seek! cursor 15))
          (equal (source-index-cursor-mode cursor)  4)
          (act (source-index-cursor-seek! cursor 17))
          (equal (source-index-cursor-token cursor)  #f))))
    (scenario "slice/concat retain backing chunks and rejected trials do not consume"
      (sequential ((source (tokens 1024)) (modes (make-list 1024 3)) (tree (build source modes))
             (middle (source-index-slice tree 71 831)))
        (equal (source-index-audit middle)  #t)
        (equal (materialize middle)  (list (take (drop source 71) 831) (make-list 831 3)))
        (equal (every (lambda (storage) (and (memq storage (source-index-storage tree)) #t))
                      (source-index-storage middle))  #t)
        (sequential ((cursor (make-source-index-cursor middle 63)) (trial (source-index-cursor-copy cursor)))
          (act (source-index-cursor-seek! trial 800))
          (equal (source-index-cursor-rank trial)  729)
          (equal (source-index-cursor-rank cursor)  63)
          (equal (token-start (source-index-cursor-token cursor))  134))
        (equal (materialize (source-index-concat (source-index-slice tree 0 512)
                                                (source-index-slice tree 512 512)))
                (list source modes))))
    (scenario "origins coalesce and fresh allocations are confined to changed chunks"
      (sequential ((tree (build (tokens 1024) (make-list 1024 1)))
             (builder (make-source-index-builder (source-index-slice tree 0 100))))
        (act (source-index-builder-token! builder (make-token 'identifier "zz" 100 102) 6))
        (act (source-index-builder-shared! builder tree 100 400 2))
        (act (source-index-builder-shared! builder tree 500 524 2))
        (scope ((next (source-index-builder-finish builder)))
          (equal (source-index-count next)  1025)
          (equal (source-index-end next)  1026)
          (equal (source-index-builder-fresh builder)  1)
          (equal (source-index-builder-shared builder)  1024)
          (equal (source-index-builder-chunks builder)  1)
          (equal (source-index-audit next)  #t)
          (equal (> (length (filter (lambda (storage) (memq storage (source-index-storage tree)))
                                  (source-index-storage next))) 10)  #t))))
    (scenario "sparse mode changes retain token chunks and old mode versions"
      (sequential ((original (tokens 130)) (old-modes (make-list 130 1)) (tree (build original old-modes))
             (builder (make-source-index-builder)))
        (act (source-index-builder-shared! builder tree 0 63 0))
        (act (source-index-builder-shared! builder tree 63 1 0 0))
        (act (source-index-builder-shared! builder tree 64 1 0 9))
        (act (source-index-builder-shared! builder tree 65 65 0))
        (scope ((next (source-index-builder-finish builder)))
          (equal (source-index-audit next)  #t)
          (equal (materialize tree)  (list original old-modes))
          (equal (materialize next)  (list original (append (make-list 63 1) '(0 9) (make-list 65 1))))
          (equal (every eq? (source-index-storage next) (source-index-storage tree))  #t)
          (equal (source-index-builder-chunks builder)  0)
          (equal (source-index-builder-mode-chunks builder)  2))))
    (scenario "deterministic sequential splices preserve old versions and AVL measures"
      (sequential ((original (tokens 1024)) (modes (make-list 1024 2)) (initial (build original modes)))
        (iterate loop ((step 0) (tree initial) (expected original) (expected-modes modes))
          (equal (source-index-audit tree)  #t)
          (equal (materialize tree)  (list expected expected-modes))
          (equal (materialize initial)  (list original modes))
          (equal (<= (source-index-height tree) 16)  #t)
          (when (< step 180)
            (sequential ((size (length expected)) (at (modulo (+ (* step 37) 5) size))
                   (deleted (min (modulo step 5) (- size at))) (added (modulo (+ step 2) 7))
                   (delta (- added deleted))
                   (middle (map (lambda (n) (make-token 'identifier "y" (+ at n) (+ at n 1))) (iota added)))
                   (middle-modes (make-list added (modulo step 9)))
                   (builder (make-source-index-builder (source-index-slice tree 0 at))))
              (each (token mode) (middle middle-modes) (act (source-index-builder-token! builder token mode)))
              (act (source-index-builder-shared! builder tree (+ at deleted) (- size at deleted) delta))
              (continue loop (+ step 1) (source-index-builder-finish builder) (append (take expected at) middle (map (cut relocate <> delta) (drop expected (+ at deleted)))) (append (take expected-modes at) middle-modes (drop expected-modes (+ at deleted)))))))))
    (scenario "invalid gaps and out-of-range slices fail before sharing"
      (scope ((tree (build (tokens 10) (make-list 10 0))))
        (raises (source-index-slice tree 9 2) true)
        (raises (source-index-slice tree -1 1) true)
        (raises (source-index-concat tree (source-index-shift tree 11)) true)
        (raises (build (list (make-token 'trivia "" 0 0)) '(0)) true))))
