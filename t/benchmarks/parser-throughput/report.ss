;;; Native receipt admission; no external statistics or JSON translation.
(export main)

(def (field row key)
  (let (entry (assq key row))
    (unless entry (error "missing benchmark field" key))
    (cdr entry)))

(def (median values)
  (let* ((ordered (list-sort < values)) (count (length ordered))
         (middle (quotient count 2)))
    (if (odd? count) (list-ref ordered middle)
      (/ (+ (list-ref ordered (- middle 1)) (list-ref ordered middle)) 2))))

(def (main path)
  (let ((rows '()) (finished #f))
    (call-with-input-file path
      (lambda (port)
        (let loop ()
          (let (line (read-line port))
            (unless (eof-object? line)
              (let (value (call-with-input-string line read))
                (cond
                 ((and (pair? value) (assq 'schema value))
                  (when (eq? (field value 'phase) 'acceptance)
                    (set! rows (cons value rows))))
                 ((eq? value 'PARSER-THROUGHPUT-FULL-OK) (set! finished #t))
                 (else (error "unexpected or failed benchmark output" line))))
              (loop))))))
    (unless (and finished (= (length rows) 60))
      (error "complete sixty-batch receipt required"))
    (for-each
     (lambda (count)
       (let (group (filter (lambda (row) (= (field row 'requests) count)) rows))
         (unless (and (= (length group) 20)
                      (equal? (list-sort < (map (cut field <> 'batch) group)) (iota 20 1))
                      (every (lambda (row)
                               (and (= (field row 'input-index-base)
                                       (* count (field row 'batch)))
                                    (equal? (field row 'source-identity)
                                            (field (car rows) 'source-identity))
                                    (field (field row 'samples) 'throughput-wall-gate)
                                    (= (field (field row 'samples) 'completed) count))) group))
           (error "missing, mismatched or failed acceptance batch" count))
         (let (metrics (map (cut field <> 'samples) group))
           (write `((requests . ,count) (batches . 20)
                    (boundary . ,(field (car group) 'label))
                    (aggregation . medians-of-per-batch-request-percentiles-not-pooled)
                    ,@(map (lambda (key)
                             (cons key (median (map (cut field <> key) metrics))))
                           '(batch-wall-s throughput-requests/s request-p95-us request-p99-us
                             gc-count allocation-counter-delta))
                    (sub-resolution-request-samples .
                      ,(foldl + 0 (map (cut field <> 'sub-resolution-request-samples) metrics)))))
           (newline))))
     '(1000 10000 100000))
    (displayln "PARSER-THROUGHPUT-REPORT-OK") (force-output)))
