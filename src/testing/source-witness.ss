;;; Typed source-data declarations. Proofs belong to Lean, not Scheme strings.
(import (only-in :std/misc/ports read-all-as-string))
(export parser-source-data write-parser-source-data source-data-current?)
(defstruct source-binding (namespace name value) final: #t)
(defrules parser-source-data ()
  ((_ (namespace name value) ...)
   (list (make-source-binding 'namespace 'name value) ...)))

(def (identifier-text name)
  (unless (and (symbol? name)
               (every (lambda (ch) (or (char-alphabetic? ch) (char-numeric? ch)
                                      (memv ch '(#\. #\_))))
                      (string->list (symbol->string name))))
    (error "invalid source-data identifier" name))
  (symbol->string name))
(def (quoted-text value)
  (call-with-output-string (lambda (port) (write value port))))
(def (datum-tokens value)
  (cond ((symbol? value) (list "(s " (quoted-text (symbol->string value)) ")"))
        ((string? value) (list "(.text " (quoted-text value) ")"))
        ((boolean? value) (list (if value "(b true)" "(b false)")))
        ((and (integer? value) (exact? value) (>= value 0))
         (list "(n " (number->string value) ")"))
        ((list? value)
         (cons "(l ["
           (let loop ((rest value))
             (if (null? rest) '("])")
               (append (datum-tokens (car rest))
                       (if (null? (cdr rest)) '("])")
                         (cons ", " (loop (cdr rest)))))))))
        (else (error "unsupported source datum" value))))
(def (binding-tokens binding)
  (unless (source-binding? binding) (error "expected typed source-data binding" binding))
  (let ((namespace (identifier-text (source-binding-namespace binding)))
        (name (identifier-text (source-binding-name binding))))
    (append (list "namespace " namespace "\nopen WalkSource\ndef " name " : Datum :=\n")
            (datum-tokens (source-binding-value binding))
            (list "\nend " namespace "\n"))))
(def (write-parser-source-data bindings port)
  (unless (and (list? bindings) (pair? bindings)) (error "source data must be nonempty"))
  (let loop ((rest bindings) (seen '()))
    (unless (null? rest)
      (let* ((binding (car rest))
             (key (and (source-binding? binding)
                       (cons (source-binding-namespace binding) (source-binding-name binding)))))
        (unless (and key (not (member key seen))) (error "invalid or duplicate source-data binding" key))
        (loop (cdr rest) (cons key seen)))))
  ;; The sole rendering boundary emits data constructors and declarations only.
  (for-each (lambda (token) (write-string token port))
            (append '("-- Generated reader data; proofs are maintained in WalkWitness.lean.\nimport ParserEngine.WalkSource\n")
                    (apply append (map binding-tokens bindings)))))
(def (source-data-current? bindings path)
  (equal? (call-with-output-string (lambda (port) (write-parser-source-data bindings port)))
          (call-with-input-file path read-all-as-string)))
