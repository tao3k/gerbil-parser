((benchmarkKind . scenario-e2e)
 (max_total . 250ms)
 (target_total . 100ms)
 (regression_budget . 150ms)
 (expected_over_input_budget . 100ms)
 (targetRationale . "one hundred full CREATE clauses must retain typed semantics while long LR rows use indexed rather than linear lookup")
 (sampleCount . 40)
 (rule . GERBIL-PARSER-OPENCYPHER-LARGE-QUERY)
 (feature . opencypher-large-query)
 (optimizationFocus . "adaptive standard hash indexes for long LR action/goto rows plus immutable rope concatenation")
 (inputShape . "one openCypher query containing exactly one hundred CREATE clauses with labels, properties, and NULL literals")
 (expectedOutcome . "the complete query is accepted, validates, and roundtrips without duplicate completion expansion")
 (measurementPhases collect-before collect-after policy-before policy-after
                    assert-time-gate observe-runtime-memory)
 (tags performance integration parser opencypher repetition))
