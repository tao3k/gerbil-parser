;;; Admit matching data/boundaries before reporting backend-specific medians.
(import :std/misc/ports (only-in :std/string/misc string-trim))
(export main)
(def (field row key)
  (let (entry (assq key row))
    (unless entry (error "missing baseline field" key))
    (cdr entry)))
(def (median values)
  (let* ((ordered (list-sort < values)) (half (quotient (length ordered) 2)))
    (/ (+ (list-ref ordered (- half 1)) (list-ref ordered half)) 2)))
(def (read-batches path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((rows '()))
        (let (row (read port))
          (cond
           ((eof-object? row) (error "baseline completion marker missing" path))
           ((eq? row 'BACKEND-BASELINE-COMPLETE)
            (unless (and (= (length rows) 20)
                         (equal? (list-sort < (map (cut field <> 'batch) rows)) (iota 20 1))
                         (eof-object? (read port)))
              (error "baseline requires exactly twenty batches" path))
            (reverse rows))
           ((and (pair? row) (eq? (car row) 'backend-baseline.v1))
            (loop (cons (cdr row) rows)))
           (else (error "invalid baseline data" path row))))))))
(def (rss-bytes path)
  (let* ((text (call-with-input-file path read-all-as-string))
         (lines (string-split text #\newline))
         (darwin (find (lambda (line) (string-contains line "maximum resident set size")) lines))
         (linux (find (lambda (line) (string-contains line "Maximum resident set size (kbytes):")) lines)))
    (cond
     (darwin (string->number (car (filter (lambda (part) (not (equal? part "")))
                                    (string-split (string-trim darwin) #\space)))))
     (linux (* 1024 (string->number (string-trim (last (string-split linux #\:))))))
     (else (error "process RSS receipt missing" path)))))
(def (main directory)
  (displayln "backend requests batches median-wall-ms median-p95-us median-p99-us median-requests/s process-peak-rss-bytes")
  (for-each
    (lambda (count)
      (let* ((name (number->string count))
             (rust-path (path-expand (string-append "rust-aot-" name ".ss") directory))
             (scheme-path (path-expand (string-append "scheme-vm-" name ".ss") directory))
             (rust (read-batches rust-path)) (scheme (read-batches scheme-path)))
        (for-each
          (lambda (left right)
            (unless (and (eq? (field left 'backend) 'rust-aot)
                         (eq? (field right 'backend) 'scheme-vm)
                         (= (field left 'requests) count) (= (field right 'requests) count)
                         (= (field left 'concurrency) 1) (= (field right 'concurrency) 1)
                         (every (lambda (key) (equal? (field left key) (field right key)))
                           '(batch grammar corpus-sha256 input-bytes boundary)))
              (error "backend corpus or execution boundaries differ" count)))
          rust scheme)
        (for-each
          (lambda (rows path)
            (let (rss (rss-bytes (string-append path ".resources")))
              (unless (and (number? rss) (> rss 0)) (error "invalid RSS" path))
              (displayln (field (car rows) 'backend) " " count " 20 "
                (* 1000 (median (map (cut field <> 'wall-s) rows))) " "
                (median (map (cut field <> 'p95-us) rows)) " "
                (median (map (cut field <> 'p99-us) rows)) " "
                (median (map (cut field <> 'throughput-requests/s) rows)) " " rss)))
          (list rust scheme) (list rust-path scheme-path))))
    '(1000 10000 100000))
  (displayln "MATCHED-BASELINE-REPORT-OK; serial arithmetic only, not Org/FFI/Tokio/SMP acceptance"))
