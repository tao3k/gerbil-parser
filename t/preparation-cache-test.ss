(import :gerbil-parser/language-test-support
        (only-in :std/io/tempfile make-temporary-file-name)
        (only-in :std/misc/ports read-all-as-string)
        (only-in :gerbil-parser/src/build-support/preparation-cache call-with-preparation-cache preparation-store-file conformance-source-only? conformance-module-product-matcher conformance-module-product? conformance-generated-cache?)
        (only-in :gerbil-parser/src/build-support/preparation-snapshot preparation-files preparation-native-object?))
;; Assert production cache values through the common test macro owner.

(defstruct cache-case (root count))
(def (cache-path cache name) (path-expand name (cache-case-root cache)))
(def (put-cache-file path text)
  (create-directory* (path-directory path))
  (when (file-exists? path) (delete-file path))
  (call-with-output-file path (lambda (port) (display text port))))
(def (with-cache-case procedure)
  (let (root (make-temporary-file-name "parser-cache-controls-"))
    (create-directory* root)
    (let (cache (make-cache-case root 0))
      (try
        (put-cache-file (cache-path cache "input.ss") "original")
        (put-cache-file (cache-path cache "lib/dependency.ssi") "immutable-interface")
        (procedure cache)
        (finally (delete-file-or-directory root #t))))))
(def (prepare-cache-output cache)
  (cache-case-count-set! cache (+ 1 (cache-case-count cache)))
  (put-cache-file (cache-path cache "output.o") (number->string (cache-case-count cache))))
(def (run-cache-case cache (stored? #f) (prepare #f))
  (call-with-preparation-cache (cache-path cache "receipt.sexp")
    (lambda () (list (cache-path cache "input.ss")))
    (lambda () (let (output (cache-path cache "output.o"))
                 (if (file-exists? output) (list output) '())))
    (or prepare (lambda () (prepare-cache-output cache)))
    (and stored? (cache-path cache "store"))
    (lambda (path) (equal? path (cache-path cache "output.o")))))
(def (drop-cache-products cache)
  (delete-file (cache-path cache "receipt.sexp"))
  (delete-file (cache-path cache "output.o")))
(def (read-cache-output cache)
  (call-with-input-file (cache-path cache "output.o") read-all-as-string))
(def (cache-memo-paths cache)
  (cons (cache-path cache "lib/static/foreign-module.o.options.sexp")
    (map (lambda (name)
           (cache-path cache (string-append "lib/gerbil-parser/" name "/digest.scm")))
         '("compiled-language-artifacts" "compiled-language-parser-cache"
           "compiled-language-declaration-cache" "compiled-language-program-cache"))))
(def (cache-memo-inputs cache)
  (let (library (cache-path cache "lib"))
    (filter (lambda (path)
              (not (or (conformance-generated-cache? path library)
                       (preparation-native-object? path library))))
            (preparation-files library))))
(def (run-cache-memo cache)
  (call-with-preparation-cache (cache-path cache "receipt.sexp")
    (lambda () (cache-memo-inputs cache))
    (lambda () (list (cache-path cache "output.o")))
    (lambda ()
      (prepare-cache-output cache)
      (for-each (lambda (path) (put-cache-file path "derived")) (cache-memo-paths cache)))))
(def (prepare-cache-discovery cache)
  (create-directory* (cache-path cache "discovery/b"))
  (create-directory* (cache-path cache "discovery/.hidden-directory"))
  (for-each (lambda (name) (put-cache-file (cache-path cache name) name))
            '("discovery/z.ss" "discovery/a.ss" "discovery/b/c.ss"
              "discovery/.hidden.ss" "discovery/.hidden-directory/x.ss")))

(deflanguage-parser-tests preparation-cache-test "source-bound preparation cache"
  (engine)
  (scenario "development catalogs retain their source-only language test closure"
    (each (owner) ('("t/fixtures/language-entries"
                     "languages/arithmetic/parser-test"
                     "t/generate-language-abi-alignment"
                     "t/benchmarks/versioned-languages/all-languages"))
      (equal (and (conformance-source-only? owner) #t) #t))
    (each (owner) ('("t/fixtures/bash-products" "languages/arithmetic/parser"))
      (equal (conformance-source-only? owner) #f)))
  (scenario "static phase products belong to their precise module"
    (using (with-cache-case) (cache)
      (scope ((library (cache-path cache "lib")))
        (each (suffix) ('(".scm" "~0.scm" "~1.scm" "~0.c"))
          (equal (conformance-module-product?
                   (path-expand (string-append "static/gerbil-parser__t__fixture" suffix) library)
                   library '("t/fixture")) #t))
        (equal (conformance-module-product?
                 (path-expand "static/gerbil-parser__t__fixture-other~0.scm" library)
                 library '("t/fixture")) #f))))
  (scenario "discovery retains sorted identity and excludes hidden entries"
    (using (with-cache-case) (cache)
      (act (prepare-cache-discovery cache))
      (equal (preparation-files (cache-path cache "discovery"))
             (map (lambda (name) (cache-path cache name))
                  '("discovery/a.ss" "discovery/b/c.ss" "discovery/z.ss")))
      (equal (preparation-files (cache-path cache "discovery/missing")) '())
      (equal (preparation-files (cache-path cache "discovery/a.ss"))
             (list (cache-path cache "discovery/a.ss")))))
  (scenario "unchanged input and output reuse preparation"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache))
      (act (run-cache-case cache))
      (equal (cache-case-count cache) 1)))
  (scenario "input content invalidates preparation"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache))
      (act (put-cache-file (cache-path cache "input.ss") "changed"))
      (act (run-cache-case cache))
      (equal (cache-case-count cache) 2)))
  (scenario "corrupt output invalidates preparation"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache))
      (act (put-cache-file (cache-path cache "output.o") "corrupt"))
      (act (run-cache-case cache))
      (equal (cache-case-count cache) 2)))
  (scenario "missing output invalidates preparation"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache))
      (act (delete-file (cache-path cache "output.o")))
      (act (run-cache-case cache))
      (equal (cache-case-count cache) 2)))
  (scenario "corrupt receipt invalidates preparation"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache))
      (act (put-cache-file (cache-path cache "receipt.sexp") "broken ("))
      (act (run-cache-case cache))
      (equal (cache-case-count cache) 2)))
  (scenario "failed preparation withdraws admission and retries"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache))
      (act (put-cache-file (cache-path cache "input.ss") "changed"))
      (raises (run-cache-case cache #f (lambda () (error "expected preparation failure")))
              (lambda (exception) (equal? (error-message exception) "expected preparation failure")))
      (equal (file-exists? (cache-path cache "receipt.sexp")) #f)
      (act (run-cache-case cache))
      (equal (cache-case-count cache) 2)))
  (scenario "a valid store restores products without preparing again"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache #t))
      (act (drop-cache-products cache))
      (act (run-cache-case cache #t))
      (equal (cache-case-count cache) 1)
      (equal (read-cache-output cache) "1")))
  (scenario "a corrupt store rebuilds its products"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache #t))
      (act (drop-cache-products cache))
      (act (put-cache-file (preparation-store-file (cache-path cache "store") 0) "corrupt"))
      (act (run-cache-case cache #t))
      (equal (cache-case-count cache) 2)))
  (scenario "changed input cannot reuse a stored generation"
    (using (with-cache-case) (cache)
      (act (run-cache-case cache #t))
      (act (drop-cache-products cache))
      (act (put-cache-file (cache-path cache "input.ss") "changed-after-store"))
      (act (run-cache-case cache #t))
      (equal (cache-case-count cache) 2)))
  (scenario "input mutation during preparation cannot publish a receipt"
    (using (with-cache-case) (cache)
      (raises (run-cache-case cache #f
                (lambda () (put-cache-file (cache-path cache "input.ss") "mutation")))
              (lambda (exception)
                (equal? (error-message exception) "conformance preparation inputs changed during build")))
      (equal (file-exists? (cache-path cache "receipt.sexp")) #f)))
  (scenario "generated memo products do not change the admitted source closure"
    (using (with-cache-case) (cache)
      (act (run-cache-memo cache))
      (equal (cache-memo-inputs cache) (list (cache-path cache "lib/dependency.ssi")))
      (act (run-cache-memo cache))
      (act (put-cache-file (car (cache-memo-paths cache)) "new-derived-content"))
      (act (run-cache-memo cache))
      (equal (cache-case-count cache) 1)))
  (scenario "changed dependency interfaces invalidate memo reuse"
    (using (with-cache-case) (cache)
      (act (run-cache-memo cache))
      (act (put-cache-file (cache-path cache "lib/dependency.ssi") "changed-interface"))
      (act (run-cache-memo cache))
      (equal (cache-case-count cache) 2)))
  (scenario "generated cache exclusions retain sibling paths as inputs"
    (using (with-cache-case) (cache)
      (each (name) ('("dependency.ssi"
                     "gerbil-parser/compiled-language-artifacts-extra/digest.scm"
                     "other/compiled-language-artifacts/digest.scm"
                     "gerbil-parser/compiled-language-artifacts"))
        (equal (conformance-generated-cache? (path-expand name (cache-path cache "lib"))
                                             (cache-path cache "lib")) #f))))
  (scenario "generated object exclusions retain source and sibling inputs"
    (using (with-cache-case) (cache)
      (each (name) ('("dependency.ssi" "dependency.o.options.sexp"
                     "static/dependency.scm" "static/dependency.ssi"
                     "static-extra/foreign-module.o.options.sexp"))
        (equal (preparation-native-object? (path-expand name (cache-path cache "lib"))
                                              (cache-path cache "lib")) #f)))))
