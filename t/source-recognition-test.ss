(import :gerbil-parser/language-test-support)
;;; Source-backed recognition spans are independent of language semantics.
(import :std/test
        :gerbil-parser/src/runtime/recognition
        (only-in :gerbil-parser/src/runtime/token make-token token? token-kind token-lexeme token-start token-end))

(def (rejects? thunk)
  (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(deflanguage-parser-tests source-recognition-test "source-backed recognition spans"
  (engine)
    (scenario "token inline calls retain first-class procedures and live checked vector reads"
      (sequential ((token (make-token 'word "x" 4 5))
             (readers (list token-kind token-lexeme token-start token-end)))
        (equal (every procedure? readers)  #t)
        (equal (map (lambda (read) (read token)) readers)  '(word "x" 4 5))
        (act (vector-set! token 0 'changed))
        (act (vector-set! token 1 "y"))
        (equal (list (token-kind token) (token-lexeme token)
                     (token-start token) (token-end token))  '(changed "y" 4 5))
        (equal (map (lambda (read) (read token)) readers)  '(changed "y" 4 5))
        (equal (token? token)  #t)
        (each (read) (readers) (raises (read '#()) true))
        (raises (token-kind '#()) true)
        (raises (token-lexeme #f) true))
      (each (value) ((list #f 0 '#() '#(word "x" -1 2) '#(word "x" 3 2))) (equal (token? value)  #f))
      (equal (token? (make-token 0 "x" 0 1))  #f))
    (scenario "private recognition variants reject extension and wrong-kind access"
      (sequential ((token (make-token 'value "x" 4 5))
             (child (make-recognition-child #f token))
             (node (make-recognition-node 'Expression 4 5 (list child)))
             (fragment (make-recognition-fragment 4 5 (list child)))
             (view (relocate-recognition-value node 3)))
        (each (value) ((list node fragment child view))
           (equal (rejects?
                   (lambda ()
                     (make-class-type 'recognition-extension 'recognition-extension
                                      (list (class-of value)) '() '() #f)))  #t))
        (equal (rejects? (lambda () (recognition-node-start fragment)))  #t)
        (equal (rejects? (lambda () (recognition-child-value node)))  #t)
        (act (recognition-child-field-set! child 'value))
        (equal (recognition-child-field child)  'value)
        (equal (recognition-child-value child)  token)
        (scope-values (((start end) (recognition-value-bounds view)))
          (equal (list start end)  '(7 8)))))
    (scenario "all Unicode widths and nonmonotonic endpoints agree with UTF-8"
      (sequential ((text "aα中😀\n")
             (source (prepare-recognition-source (make-token 'source text 13 24))))
        (each (at) ('(5 0 4 1 3 2))
                    (equal (recognition-source-offset source at)
                            (+ 13 (u8vector-length (string->utf8 (substring text 0 at))))))
        (sequential ((token (recognition-source-token source 'value 1 4))
               (node (recognition-source-node source 'Expression 1 4
                                             (list (make-recognition-child 'value token)))))
          (equal (token-lexeme token)  "α中😀")
          (equal (token-start token)  14)
          (equal (token-end token)  23)
          (equal (recognition-value-start node)  14)
          (equal (recognition-value-end node)  23))))
    (scenario "ASCII and a late multibyte scalar admit exact boundaries"
      (each (text) ('("" "abc" "abcα" "abcα中😀"))
         (scope ((source (prepare-recognition-source
                       (make-token 'source text 7 (+ 7 (u8vector-length (string->utf8 text)))))))
           (iterate loop ((at 0))
             (when (<= at (string-length text))
               (equal (recognition-source-offset source at)
                       (+ 7 (u8vector-length (string->utf8 (substring text 0 at)))))
               (continue loop (+ at 1)))))))
    (scenario "original text and returned views cannot invalidate admitted offsets"
      (sequential ((text (string-copy "αx"))
             (source (prepare-recognition-source (make-token 'source text 2 5)))
             (view (recognition-source-text source)))
        (act (string-set! text 0 #\a))
        (act (string-set! view 0 #\b))
        (equal (recognition-source-text source)  "αx")
        (equal (token-lexeme (recognition-source-token source 'value 0 1))  "α")
        (equal (recognition-source-offset source 1)  4)))
    (scenario "malformed byte spans and out-of-source boundaries reject"
      (each (token) ((list #f (make-token 'source "α" 0 1) (make-token 'source "" 3 4)))
                  (equal (rejects? (lambda () (prepare-recognition-source token)))  #t))
      (scope ((source (prepare-recognition-source (make-token 'source "α" 0 2))))
        (each (at) ('(-1 2 0.5))
                    (equal (rejects? (lambda () (recognition-source-offset source at)))  #t))
        (equal (rejects? (lambda () (recognition-source-token source 'value 1 0)))  #t)
        (equal (rejects? (lambda () (recognition-source-node source 'Value 0 2 '())))  #t))))
