((benchmarkKind . scenario-e2e)
 (max_total . 1000ms)
 (target_total . 100ms)
 (regression_budget . 900ms)
 (expected_over_input_budget . 5ms)
 (targetRationale . "one warm native C parse at a declared source scale, including UTF-8 admission, lossless publication and owned payload replacement")
 (sampleCount . 10)
 (rule . GERBIL-PARSER-NATIVE-LANGUAGE-SCALE)
 (feature . shared-scanner-native-language)
 (optimizationFocus . "source admission and event materialization allocation growth across complete native calls")
 (inputShape . "256 or 4096 record assignments; ASCII LF and Unicode CRLF; rows and byte length accompany every sample")
 (expectedOutcome . "scaled complete calls retain accepted lossless payloads with recorded CPU, GC and allocated bytes")
 (measurementPhases collect-before collect-after policy-before policy-after assert-time-gate observe-runtime-memory)
 (tags performance native ffi scanner scale))
