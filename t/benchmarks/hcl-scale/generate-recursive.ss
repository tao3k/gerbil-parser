;;; Generate a recursive-descent semantic parser from the HCL Grammar IR.
(import (only-in :std/misc/ports read-all-as-string)
        (only-in :gerbil-parser/languages/hcl/v2-24/grammar
                 hcl-v2-24-parser-ir hcl-v2-24-parser)
        (only-in :gerbil-parser/src/compiler/machine
                 parser-machine-grammar-digest))
(def rules (cdr (assq 'rules hcl-v2-24-parser-ir)))
(def counter 0)
(def (fresh prefix)
  (let (name (string->symbol
              (string-append prefix (number->string counter))))
    (set! counter (fx+ counter 1))
    name))
(def (rule-procedure name)
  (string->symbol (string-append "direct-" (symbol->string name))))
(def (compile-sequence children pos)
  (if (null? children)
    `(values ,pos '() #t)
    (let ((next (fresh "next")) (value (fresh "value"))
          (ok? (fresh "ok")) (after (fresh "after"))
          (more (fresh "more")) (rest-ok? (fresh "rest-ok")))
      `(let-values (((,next ,value ,ok?)
                     ,(compile-expression (car children) pos)))
         (if ,ok?
           (let-values (((,after ,more ,rest-ok?)
                         ,(compile-sequence (cdr children) next)))
             (if ,rest-ok?
               (values ,after
                       (recognition-sequence-append ,value ,more) #t)
               (values ,pos '() #f)))
           (values ,pos '() #f))))))
(def (compile-choice choices pos)
  (if (null? choices)
    `(values ,pos '() #f)
    (let ((next (fresh "next")) (value (fresh "value"))
          (ok? (fresh "ok")))
      `(let-values (((,next ,value ,ok?)
                     ,(compile-expression (car choices) pos)))
         (if ,ok? (values ,next ,value #t)
           ,(compile-choice (cdr choices) pos))))))
(def (compile-expression expr pos)
  (case (car expr)
    ((empty) `(values ,pos '() #t))
    ((literal token)
     (let* ((literal? (eq? (car expr) 'literal))
            (expected (cadr expr))
            (test (if literal?
                    `(equal? (token-lexeme input) ,expected)
                    `(eq? (token-kind input) ',expected))))
       `(if (< ,pos limit)
          (let (input (vector-ref significant ,pos))
            (if ,test
              (values (fx+ ,pos 1)
                      (list (make-recognition-child #f input)) #t)
              (values ,pos '() #f)))
          (values ,pos '() #f))))
    ((reference) `(,(rule-procedure (cadr expr)) ,pos))
    ((sequence) (compile-sequence (cdr expr) pos))
    ((choice) (compile-choice (cdr expr) pos))
    ((optional)
     (let ((next (fresh "next")) (value (fresh "value"))
           (ok? (fresh "ok")))
       `(let-values (((,next ,value ,ok?)
                      ,(compile-expression (cadr expr) pos)))
          (if ,ok? (values ,next ,value #t)
            (values ,pos '() #t)))))
    ((repeat repeat1)
     (let ((loop-name (fresh "repeat-loop"))
           (next (fresh "next")) (combined (fresh "combined"))
           (count (fresh "count")) (after (fresh "after"))
           (value (fresh "value")) (ok? (fresh "ok"))
           (required? (eq? (car expr) 'repeat1)))
       `(let ,loop-name ((,next ,pos) (,combined '()) (,count 0))
          (let-values (((,after ,value ,ok?)
                        ,(compile-expression (cadr expr) next)))
            (if ,ok?
              (begin
                (when (= ,after ,next)
                  (error "zero-width repeated grammar expression"))
                (,loop-name ,after
                 (recognition-sequence-append ,combined ,value)
                 (fx+ ,count 1)))
              (if ,(if required? `(> ,count 0) #t)
                (values ,next ,combined #t)
                (values ,pos '() #f)))))))
    ((field alias)
     (let ((next (fresh "next")) (value (fresh "value"))
           (ok? (fresh "ok"))
           (constructor
            (if (eq? (car expr) 'field)
              'recognition-children-field
              'recognition-children-alias)))
       `(let-values (((,next ,value ,ok?)
                      ,(compile-expression (caddr expr) pos)))
          (if ,ok?
            (values ,next
                    (,constructor ',(cadr expr)
                     (recognition-sequence->list ,value)
                     (offset ,pos)) #t)
            (values ,pos '() #f)))))
    ((precedence) (compile-expression (cadddr expr) pos))
    (else (error "unsupported grammar expression" expr))))
(def (module-expression)
  `(begin
     (import (only-in :gerbil-parser/src/compiler/machine
                      parser-machine-grammar-digest parser-machine-trivia)
             (only-in :gerbil-parser/src/runtime/lexer lex-source)
             (only-in :gerbil-parser/src/runtime/significant
                      parser-significant-tokens)
             (only-in :gerbil-parser/src/runtime/token
                      token-kind token-lexeme token-start)
             (only-in :gerbil-parser/src/runtime/recognition
                      make-recognition-child recognition-child-field
                      recognition-child-value)
             (only-in :gerbil-parser/src/runtime/reduce
                      recognition-children-field recognition-children-alias)
             (only-in :gerbil-parser/src/runtime/funcs
                      recognition-sequence-append recognition-sequence->list)
             (only-in :gerbil-parser/src/runtime/artifact
                      make-success-parse-artifact))
     (export direct-parse-hcl direct-hcl-grammar-digest)
     (def direct-hcl-grammar-digest
       ,(parser-machine-grammar-digest hcl-v2-24-parser))
     (def (direct-parse-hcl machine source)
       (let* ((tokens (lex-source machine source))
              (significant
               (list->vector (parser-significant-tokens machine tokens)))
              (limit (vector-length significant))
              (byte-length (u8vector-length (string->utf8 source))))
         (def (offset pos)
           (if (< pos limit)
             (token-start (vector-ref significant pos))
             byte-length))
         (letrec
             ,(map (lambda (row)
                     `(,(rule-procedure (car row))
                       (lambda (pos)
                         ,(compile-expression (cadr row) 'pos))))
                   rules)
           (let-values (((end value ok?) (direct-config-file 0)))
             (if (and ok? (= end limit))
               (let (children (recognition-sequence->list value))
                 (if (and (pair? children) (null? (cdr children))
                          (not (recognition-child-field (car children))))
                   (make-success-parse-artifact
                    direct-hcl-grammar-digest source tokens
                    (recognition-child-value (car children))
                    (parser-machine-trivia machine))
                   #f))
               #f)))))))
(def (emit-module port)
  (display ";;; Generated HCL recursive parser from Grammar IR.\n" port)
  (write (module-expression) port)
  (newline port))
(def (main . args)
  (cond
   ((and (= (length args) 2) (equal? (car args) "module"))
    (call-with-output-file (cadr args) emit-module))
   ((and (= (length args) 2) (equal? (car args) "check"))
    (let ((expected (call-with-output-string emit-module))
          (actual (call-with-input-file (cadr args) read-all-as-string)))
      (unless (string=? expected actual)
        (error "generated HCL recursive parser is stale" (cadr args)))
      (displayln "GENERATED-HCL-RECURSIVE-OK")))
   (else (error "expected module|check source path" args))))
(export main)
