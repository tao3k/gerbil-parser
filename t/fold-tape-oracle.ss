;;; Independent canonical-list wire oracle; never a production consumer.
(import (only-in :std/vector/u8vector little u8vector-uint-set!)
        (only-in ../src/language/descriptor language-grammar-ir language-grammar-machine)
        (only-in ../src/runtime/machine parser-machine-grammar-digest))
(export canonical-fold-tape make-legacy-fold-tape-consumer)

;; Match the existing Org two-pass consumer, including admission, with its
;; grammar/header/catalog prepared before request timing. The independent
;; reference encoder below remains separate from both production writers.
(def (make-legacy-fold-tape-consumer grammar)
  (let ((header (string->utf8 (string-append "OEV1"
                  (parser-machine-grammar-digest (language-grammar-machine grammar)))))
        (indices (make-hash-table-eq)))
    (let loop ((rest (cdr (assq 'syntax-kinds (language-grammar-ir grammar)))) (index 0))
      (unless (null? rest)
        (hash-put! indices (caar rest) (cons index (cadar rest)))
        (loop (cdr rest) (+ index 1))))
    (def (put! bytes offset width value)
      (unless (and (exact-integer? value) (<= 0 value) (< value (expt 256 width)))
        (error "legacy Fold tape integer out of range" value))
      (u8vector-uint-set! bytes offset value little width))
    (lambda (events)
      (let* ((header-size (u8vector-length header))
             (size (foldl (lambda (event total)
                            (+ total (case (car event)
                                       ((start) 3) ((token) 19) ((finish) 1)
                                       (else (error "invalid legacy Fold event" event)))))
                          header-size events))
             (bytes (make-u8vector size 0)))
        (u8vector-copy! bytes 0 header)
        (let loop ((rest events) (offset header-size))
          (unless (null? rest)
            (let* ((event (car rest)) (tag (car event))
                   (width (case tag ((start) 3) ((token) 19) (else 1))))
              (unless (eq? tag 'finish)
                (let ((kind (hash-get indices (cadr event))))
                  (unless (and kind (eq? (cdr kind) (if (eq? tag 'start) 'node 'token)))
                    (error "invalid legacy Fold kind" event))
                  (u8vector-set! bytes offset (if (eq? tag 'start) 1 2))
                  (put! bytes (+ offset 1) 2 (car kind))))
              (when (eq? tag 'token)
                (put! bytes (+ offset 3) 8 (caddr event))
                (put! bytes (+ offset 11) 8 (cadddr event)))
              (loop (cdr rest) (+ offset width)))))
        bytes))))
(def (canonical-fold-tape grammar events)
  (let ((kinds (map car (cdr (assq 'syntax-kinds (language-grammar-ir grammar)))))
        (header (string->utf8 (string-append "OEV1"
                   (parser-machine-grammar-digest (language-grammar-machine grammar))))))
    (def (unsigned value width)
      (if (= width 0) '()
        (cons (modulo value 256) (unsigned (quotient value 256) (- width 1)))))
    (def (index kind)
      (let loop ((rest kinds) (ordinal 0))
        (cond ((null? rest) (error "missing oracle tape kind" kind))
              ((eq? (car rest) kind) ordinal)
              (else (loop (cdr rest) (+ ordinal 1))))))
    (list->u8vector
     (append (u8vector->list header)
       (foldr append '()
         (map (lambda (event)
                (case (car event)
                  ((finish) '(0))
                  ((start) (cons 1 (unsigned (index (cadr event)) 2)))
                  ((token) (append (cons 2 (unsigned (index (cadr event)) 2))
                                   (unsigned (caddr event) 8) (unsigned (cadddr event) 8)))
                  (else (error "invalid oracle tape event" event)))) events))))))
