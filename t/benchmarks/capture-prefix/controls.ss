;;; Direct kernel parity plus nullable, Unicode, relocation and exact tail checks.
(import (only-in :gerbil-parser/src/runtime/lr-parser/state
                 make-lr-capture-plan lr-recognition-view? lr-recognition-view-base lr-recognition-fragment-lookahead lr-runtime-reduction-widths lr-recognition-fragment? lr-recognition-fragment-children make-lr-recognition-view)
        (only-in :gerbil-parser/src/runtime/lr-parser/recognition capture-reduction prepare-capture-plans lr-recognition-relocate lr-recognition-fragment-terminal-yield)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-runtime)
        (only-in :gerbil-parser/src/runtime/token make-token)
        (only-in :gerbil-parser/t/fixtures/runtime-record-assignments/languages/records/grammar records-parser)
        (only-in :gerbil-parser/t/benchmarks/lr-request-stack/capture-reference reference-capture-reduction))
(def (require! value message) (unless value (error message)))
(export verify-capture-prefix!)
(def (verify-capture-prefix!)
  (let* ((runtime (parser-machine-runtime records-parser))
         (widths (lr-runtime-reduction-widths runtime))
         (plans (prepare-capture-plans runtime))
         (ids (iota (vector-length widths)))
         (unary (find (lambda (id) (= (vector-ref widths id) 1)) ids))
         (nullable (find (lambda (id) (= (vector-ref widths id) 0)) ids))
         (combinations 0)
         (executor (lambda _ #f)))
    (def (observe-children! piece)
      (cond ((lr-recognition-view? piece) (observe-children! (lr-recognition-view-base piece)))
            ((lr-recognition-fragment? piece)
             (lr-recognition-fragment-lookahead piece)
             (for-each observe-children! (lr-recognition-fragment-children piece)))))
    (def (make-piece kind i)
      (let* ((token (make-token 'identifier "α" (* i 2) (+ 2 (* i 2))))
             (empty? (memq kind '(empty-fragment moved-empty nested-empty)))
             (fragment? (or empty? (memq kind '(fragment moved-fragment nested-fragment))))
             (piece (if fragment?
                      (car (reference-capture-reduction runtime executor (if empty? nullable unary)
                             (if empty? '(0) '(0 0)) (if empty? '() (list token))
                             '() (* i 2) '(value) 1)) token)))
        (cond ((memq kind '(moved-token moved-fragment moved-empty))
               (lr-recognition-relocate piece 3))
              ((memq kind '(nested-token nested-fragment nested-empty))
               (make-lr-recognition-view (make-lr-recognition-view piece 3) -1))
              (else piece))))
    (for-each
     (lambda (production)
       (let (width (vector-ref widths production))
         (for-each
          (lambda (kind)
            (for-each
             (lambda (rest)
               (set! combinations (+ combinations 1))
               (let* ((prefix (map (lambda (i) (make-piece kind i)) (iota width)))
                      (suffix (list (make-token 'identifier "tail" 100 104)))
                      (stack (append (reverse prefix) suffix))
                      (states (iota (+ width 1)))
                      (args (list runtime executor production states stack rest 7 '(value) 1))
                      (reference (apply reference-capture-reduction args))
                      (candidate (capture-reduction (vector-ref plans production) executor (list-ref states width) stack
                                   (and (pair? rest) (car rest)) 7 '(value) 1)))
                 (let* ((uncached (make-lr-capture-plan runtime production width #f))
                        (fast (capture-reduction uncached executor (list-ref states width) stack
                                (and (pair? rest) (car rest)) 7 '(value) 1)))
                   (lr-recognition-fragment-terminal-yield (car fast))
                   (observe-children! (car reference)) (observe-children! (car fast))
                   (require! (equal? reference fast) "uncached plan changed capture fields")
                   (require! (eq? (cdr fast) suffix) "uncached plan copied remaining stack"))
                 (lr-recognition-fragment-terminal-yield (car candidate))
                 (observe-children! (car reference)) (observe-children! (car candidate))
                 (require! (equal? reference candidate) "capture fields or yield association changed")
                 (require! (eq? (cdr candidate) suffix) "capture copied or changed the remaining stack")
                 (require! (equal? (lr-recognition-fragment-children (car candidate)) prefix)
                           "source order changed")))
             (list '() (list (make-token 'identifier "β" 120 122)))))
          '(token moved-token nested-token fragment moved-fragment nested-fragment
            empty-fragment moved-empty nested-empty))))
     ids)
    (require! (and unary nullable) "nullable and unary productions not exercised")
    (require! (= combinations 198) "capture representation inventory incomplete")
    (displayln "CAPTURE-METADATA-VARIANTS-OK combinations=" combinations) (force-output)
    (displayln "CAPTURE-PREFIX-CONTROLS-OK productions=" (vector-length widths)) (force-output)))

(def (main . _) (verify-capture-prefix!))
