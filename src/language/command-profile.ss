;;; Closed command token roles and node projections prepare once per source engine.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in ../grammar/lexical-algebra text-profile-data)
        (only-in ../runtime/scan make-text-profile-scanner)
        (only-in ../runtime/token token-kind token-lexeme)
        (only-in ./result-profile result-plan-catalog))
(export CommandProfile. defcommand-profile compile-command-profile admit-command-plan
        command-plan-recipe command-plan-role-matcher command-plan-token? command-plan-text? command-plan-kind)
(def +command-shapes+ '(
  (Redirection descriptor operator target)
  (ArrayAssignment assignment open close separator element)
  (SimpleCommand assignment name argument redirect)
  (CommandList command separator here-document)
  (IfCommand keyword condition body else-body)
  (WhileCommand keyword condition body)
  (UntilCommand keyword condition body)
  (ForCommand keyword header variable item separator body)
  (SelectCommand keyword header variable item separator body)
  (ArithmeticForCommand keyword header variable item separator body)
  (CaseCommand keyword subject separator clause)
  (CaseClause open pattern alternate close body terminator)
  (FunctionDefinition keyword name open close body)
  (ConditionalCommand open close operator operand)
  (ArithmeticCommand open close expression operator)
  (RedirectedCommand command redirect)
  (BraceGroup open body close)
  (Subshell open body close)
  (Pipeline keyword option negate command operator)
  (AndOrList command operator)
  (HereDocument delimiter content)
  (BashFile command separator here-document)
))
(def CommandProfile. (.o roles: '() texts: '()
                        projections: (map (lambda (shape) (list (car shape) (car shape))) +command-shapes+)))
(def +command-roles+ '(trivia separator redirect here-redirect strip-redirect reserved conditional-operator pipeline and-or case-end))
(defstruct command-plan (recipe-field roles texts projections))
(def (copy-data value)
  (cond ((pair? value) (cons (copy-data (car value)) (copy-data (cdr value))))
        ((string? value) (string-copy value)) (else value)))
(def (unique? values)
  (let loop ((remaining values) (seen '()))
    (or (null? remaining)
        (and (not (member (car remaining) seen)) (loop (cdr remaining) (cons (car remaining) seen))))))
(def (same-keys? rows keys)
  (and (list? rows) (andmap (lambda (row) (and (list? row) (pair? row) (symbol? (car row)))) rows)
       (unique? (map car rows)) (= (length rows) (length keys))
       (andmap (lambda (key) (assq key rows)) keys)))
(def (compile-command-profile profile)
  (unless (object? profile) (error "command profile requires a POO value"))
  (let* ((roles (copy-data (.ref profile 'roles))) (texts (copy-data (.ref profile 'texts)))
         (projections (copy-data (.ref profile 'projections)))
         (role-index (make-hash-table-eq)) (text-index (make-hash-table-eq)) (projection-index (make-hash-table-eq)))
    (unless (and (same-keys? roles +command-roles+) (same-keys? texts '(descriptor))
                 (same-keys? projections (map car +command-shapes+)))
      (error "command profile requires every closed role and projection exactly once"))
    (for-each (lambda (row)
      (let (kinds (make-hash-table-eq))
        (unless (and (pair? (cdr row)) (andmap (lambda (clause)
          (and (list? clause) (pair? clause) (symbol? (car clause))
               (andmap (lambda (literal) (and (string? literal) (> (string-length literal) 0))) (cdr clause))
               (unique? (cdr clause)))) (cdr row)) (unique? (map car (cdr row))))
          (error "invalid command token role" (car row)))
        (for-each (lambda (clause)
          (let (index (make-table test: equal?))
            (for-each (lambda (literal) (hash-put! index literal #t)) (cdr clause))
            (hash-put! kinds (car clause) (if (null? (cdr clause)) #t index)))) (cdr row))
        (hash-put! role-index (car row) kinds))) roles)
    (for-each (lambda (row)
      (unless (= (length row) 2) (error "invalid command text profile" row))
      (hash-put! text-index (car row) (make-text-profile-scanner (cadr row)))) texts)
    (for-each (lambda (row)
      (unless (and (= (length row) 2) (symbol? (cadr row))) (error "invalid command projection" row))
      (hash-put! projection-index (car row) (cadr row))) projections)
    (make-command-plan (list roles texts projections) role-index text-index projection-index)))
(def (command-plan-recipe plan) (copy-data (command-plan-recipe-field plan)))
(def (command-plan-kind plan role)
  (or (hash-get (command-plan-projections plan) role) (error "undeclared command projection" role)))
(def (command-plan-role-matcher plan role)
  (let (kinds (or (hash-get (command-plan-roles plan) role) (error "undeclared command role" role)))
    (lambda (token)
      (and token (let (accepted (hash-get kinds (token-kind token)))
                   (and accepted (or (eq? accepted #t) (hash-get accepted (token-lexeme token)))))))))
(def (command-plan-token? plan role token) ((command-plan-role-matcher plan role) token))
(def (command-plan-text? plan role text)
  (let* ((scanner (or (hash-get (command-plan-texts plan) role) (error "undeclared command text role" role)))
         (end (scanner text 0)))
    (and end (= end (string-length text)))))
(def (admit-command-plan plan results scanner)
  (let* ((catalog (result-plan-catalog results)) (nodes (cdr (assq 'syntax-kinds catalog)))
         (tokens (map car (cdr (assq 'terminals catalog)))) (scanner-tokens (.ref scanner 'tokens)))
    (for-each (lambda (shape)
      (let* ((kind (command-plan-kind plan (car shape))) (entry (assq kind nodes)))
        (unless (and entry (andmap (lambda (field) (memq field (caddr entry))) (cdr shape)))
          (error "command projection disagrees with result fields" (car shape) kind)))) +command-shapes+)
    (for-each (lambda (row)
      (for-each (lambda (clause)
        (unless (and (memq (car clause) tokens) (memq (car clause) scanner-tokens))
          (error "command role uses an undeclared scanner terminal" (car row) (car clause)))) (cdr row)))
      (car (command-plan-recipe-field plan)))
    plan))
(defsyntax (defcommand-profile stx)
  (syntax-case stx (roles texts projections)
    ((_ (name marker self base) (roles role ...) (texts (key expression) ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) roles: '(role ...)
                     texts: (list (list 'key (text-profile-data expression)) ...))))
    ((_ (name marker self base) (roles role ...) (texts (key expression) ...) (projections projection ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) roles: '(role ...)
                     texts: (list (list 'key (text-profile-data expression)) ...)
                     projections: '(projection ...))))))
