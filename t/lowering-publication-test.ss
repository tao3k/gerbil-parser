(import :gerbil-parser/language-test-support
        (only-in :gerbil-parser/t/fixtures/event-walk-source read-source-definition read-source-subdefinition)
        (only-in :gerbil-parser/t/fixtures/lr1-construction native-fact-rules)
        (only-in :gerbil-parser/src/compiler/lr lower-rules production-id production-rhs))

;;; Execute the complete source emitter in its real lexical counter/list scope.
;;; Only callbacks and inspection are supplied; no emitter instructions are copied.
(def (make-source-emitter origin proof)
  ((eval
     (list 'lambda '(observe-origin observe-proof)
       (list 'let '((next-id 1) (productions '()))
         (read-source-definition "src/compiler/lr.ss" 'make-production)
         (read-source-subdefinition "src/compiler/lr.ss" 'lower-rules 'emit-production)
         '(values emit-production (lambda () (list next-id (reverse productions)))))))
   origin proof))

(defparser-check (publication-observer-case origin? proof?)
  (scope ((inspect #f) (observed '()))
    (scope-values (((emit snapshot)
      (make-source-emitter
        (and origin? (parser-check-procedure (parser-check (production owner path expression)
          (equal (production-id production) (car (inspect)))
          (equal (length (cadr (inspect))) (- (car (inspect)) 1))
          (equal owner 'start) (equal path '(0)) (equal expression '(empty))
          (act (set! observed (cons (cons 'origin production) observed))))))
        (and proof? (parser-check-procedure (parser-check (kind production recipe)
          (equal kind 'production) (equal recipe '(identity ()))
          (equal (production-id production) (car (inspect)))
          (equal (length (cadr (inspect))) (- (car (inspect)) 1))
          (act (set! observed (cons (cons 'proof production) observed)))))))))
      (act (set! inspect snapshot))
      (each (index) ((iota 8))
        (act (emit 'start '() 'concat #f 'start '(0) '(empty) '(identity ()))))
      (equal (car (inspect)) 9)
      (equal (map production-id (cadr (inspect))) '(1 2 3 4 5 6 7 8))
      (each (entry) ((reverse observed))
        (equal (eq? (cdr entry) (list-ref (cadr (inspect)) (- (production-id (cdr entry)) 1))) #t))
      (equal (map car (reverse observed))
        (apply append (map (lambda (_) (append (if origin? '(origin) '()) (if proof? '(proof) '()))) (iota 8)))))))

(defparser-check (publication-failure-case stage fail-at)
  (scope ((failure (list 'publication-failure)) (events '()))
    (scope-values (((emit inspect)
      (make-source-emitter
        (lambda (production _owner _path _expression)
          (set! events (cons (cons 'origin (production-id production)) events))
          (when (and (eq? stage 'origin) (= (production-id production) fail-at)) (raise failure)))
        (lambda (_kind production _recipe)
          (set! events (cons (cons 'proof (production-id production)) events))
          (when (and (eq? stage 'proof) (= (production-id production) fail-at)) (raise failure))))))
      (equal (with-catch (lambda (condition) (eq? condition failure))
               (lambda ()
                 (for-each (lambda (_) (emit 'start '() 'concat #f 'start '() '(empty) '(identity ()))) (iota 8))
                 #f)) #t)
      (equal (car (inspect)) fail-at)
      (equal (map production-id (cadr (inspect))) (cdr (iota fail-at)))
      (equal (car events) (cons stage fail-at))
      (equal (length events) (+ (* 2 (- fail-at 1)) (if (eq? stage 'origin) 1 2))))))

(defparser-check (branch-publication-case rules origin? proof?)
  (scope ((origins '()) (proofs '()))
    (scope ((rows (lower-rules rules 'start #t
      (and origin? (lambda (production _owner _path _expression) (set! origins (cons production origins))))
      (and proof? (lambda (kind production _recipe)
        (when (eq? kind 'production) (set! proofs (cons production proofs))))))))
      (equal rows (lower-rules rules 'start #t))
      (equal (map production-id rows) (iota (length rows)))
      (equal (map production-id (reverse origins)) (if origin? (cdr (iota (length rows))) '()))
      (equal (map production-id (reverse proofs)) (if proof? (cdr (iota (length rows))) '()))
      (each (production) ((append origins proofs))
        (equal (eq? production (list-ref rows (production-id production))) #t)))))

(deflanguage-parser-tests lowering-publication-test "source lowering publication protocol"
  (engine)
  (matrix "callbacks observe the pre-commit counter and the same native objects"
    (setup) ((origin? '(#f #t)) (proof? '(#f #t))) (bindings)
    (equal (parser-check-result publication-observer-case origin? proof?) (void)))
  (matrix "callback failures preserve the committed prefix and stop subsequent effects"
    (setup) ((stage '(origin proof)) (fail-at '(1 3 8))) (bindings)
    (equal (parser-check-result publication-failure-case stage fail-at) (void)))
  (matrix "native recursive lowering branches share one ordered publication protocol"
    (setup)
    ((origin? '(#f #t)) (proof? '(#f #t))
     (rules (append native-fact-rules
       '(((start (choice (empty) (layout-end indent)
                     (sequence (token word) (literal "x") (reference next)
                       (field item (optional (alias Item (literal "a")))))
                     (repeat (literal "b")) (repeat1 (token word))
                     (precedence dynamic 1 (literal "c"))))
          (next (literal "n")))
         ((start (repeat (literal "a"))) (start (optional (literal "b")))
          ($start.0 (empty)) ($accept (literal "reserved")))))))
    (bindings)
    (equal (parser-check-result branch-publication-case rules origin? proof?) (void)))
  (scenario "nested lowering keeps a separate counter and publication owner"
    (scope ((nested '()))
      (scope-values (((emit inspect)
        (make-source-emitter
          (lambda (_production _owner _path _expression)
            (set! nested (cons (lower-rules '((inner (empty))) 'inner) nested))) #f)))
        (act (emit 'start '() 'concat #f 'start '() '(empty) '(identity ())))
        (act (emit 'start '() 'concat #f 'start '() '(empty) '(identity ())))
        (equal (car (inspect)) 3)
        (equal (map production-id (cadr (inspect))) '(1 2))
        (equal (map (lambda (rows) (map production-id rows)) nested) '((0 1) (0 1)))))))
