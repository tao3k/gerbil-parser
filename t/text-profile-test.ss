(import :gerbil-parser/language-test-support)
;;; Closed profile execution consumes the real FHIRPath declaration data.
(import (only-in "text-profile-cases.ss" fhirpath-profile-cases)
        :std/test
        (only-in :gerbil-parser/src/grammar/lexical-algebra text-profile? lexical-expression?)
        (only-in :gerbil-parser/src/runtime/scan make-text-profile-scanner)
        (only-in :gerbil-parser/languages/fhirpath/grammar fhirpath-parser-ir)
        (only-in :gerbil-parser/languages/hl7/grammar hl7-parser-ir))


;;; Independent declaration interpreter, never prepared engine predicates.
(def (class-oracle expression character)
  (case (car expression)
    ((numeric) (char-numeric? character))
    ((alphabetic) (char-alphabetic? character))
    ((ascii-letter)
     (or (and (char>=? character #\A) (char<=? character #\Z))
         (and (char>=? character #\a) (char<=? character #\z))))
    ((characters) (and (memv character (string->list (cadr expression))) #t))
    ((union) (ormap (lambda (part) (class-oracle part character)) (cdr expression)))))

(deflanguage-parser-tests text-profile-test "closed text profile IR"
  (engine)
    (scenario "real language profiles preserve rollback, commitment and Unicode endpoints"
      (scope ((rules (cdr (assq 'lexical-rules fhirpath-parser-ir))))
        (each (group) (fhirpath-profile-cases)
           (sequential ((expression (cadr (assq (car group) rules)))
                  (scan (make-text-profile-scanner (cadr expression))))
             (equal (car expression)  'text-profile)
             (each (row) ((cdr group))
                         (equal (scan (car row) 0)  (cadr row))
                         (equal (scan (string-append "α" (car row)) 1)
                                 (and (cadr row) (+ 1 (cadr row)))))))))
    (scenario "HL7 segment ids keep maximal-run rejection and CRLF stays one terminator"
      (scope ((rules (cdr (assq 'lexical-rules hl7-parser-ir))))
        (each (group) ('((segment-id ("MSH|" 3) ("AB٣|" 3) ("AB４|" 3) ("MSHA|" #f)
                       ("MSH3|" #f) ("MS|" #f) ("msH|" #f) ("MSH²" 3))
           (segment-terminator ("\r\nx" 2) ("\rx" 1) ("\nx" 1) ("x" #f) ("" #f))))
           (sequential ((expression (cadr (assq (car group) rules)))
                  (scan (make-text-profile-scanner (cadr expression))))
             (each (row) ((cdr group)) (equal (scan (car row) 0)  (cadr row)))))))
    (scenario "invalid, callback and nullable roots reject before scanner construction"
      (each (profile) ('(() callback (seq) (literal "") (run (numeric) -1 #f)
         (run (numeric) 2 1) (run (numeric) 4294967296 #f)
         (run (numeric) 1 4294967296)
         (seq (run (numeric) 4294967295 #f) (literal "x")) (run (unknown) 1 #f) (run (characters "") 1 #f)
         (optional (literal "x")) (not-next (numeric))
         (if-next (numeric) (literal "x"))
         (seq (literal "x") (if-next (numeric) invalid))))
         (equal (text-profile? profile)  #f)
         (equal (lexical-expression? (list 'text-profile profile))  #f)
         (equal (with-catch (lambda (_) #t)
                  (lambda () (make-text-profile-scanner profile) #f))  #t)))
    (scenario "closed union classes agree over ASCII and Unicode boundaries"
      (scope ((observations 0)
            (characters (append (map integer->char (iota 256))
                                (string->list "α中😀٣４²é𝟡"))))
        (each (class) ('((union (ascii-letter) (characters "_") (numeric))
           (union (characters "ABCDEFGHIJKLMNOPQRSTUVWXYZ") (numeric))
           (union (alphabetic) (numeric) (characters "_"))
           (union (characters "éα😀_") (numeric))
           (union (union (characters "_") (numeric)) (ascii-letter))
           (union (characters "aaé") (characters "é_"))))
           (scope ((scan (make-text-profile-scanner (list 'run class 1 #f))))
             (each (character) (characters)
                (sequential ((source (string character))
                       (expected (and (class-oracle class character) 1)))
                  (unless (equal? (scan source 0) expected)
                    (act (error "text class declaration changed" class character expected)))
                  (act (set! observations (+ observations 1)))))))
        (equal observations  1584)))
    (scenario "prepared character unions isolate declaration string mutation"
      (sequential ((characters (string-copy "_α"))
             (scan (make-text-profile-scanner
                    (list 'run (list 'union (list 'characters characters) '(numeric)) 1 #f))))
        (act (string-set! characters 0 #\x))
        (act (string-set! characters 1 #\β))
        (equal (scan "_α٣" 0)  3)
        (equal (scan "x" 0)  #f)
        (equal (scan "β" 0)  #f)))
    (property "prepared profiles retain source and offset bounds"
      (bindings (scan (make-text-profile-scanner '(run (numeric) 1 #f))))
      (equal (scan "1" -1)  #f)
      (equal (scan "1" 2)  #f)
      (equal (scan "1" 1)  #f)
      (equal (scan "1" 0.5)  #f)
      (equal (scan "١２x" 0)  2)))
