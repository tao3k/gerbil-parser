(import :gerbil-parser/language-test-support)
;;; Closed declared regions: shared matching, source isolation and admission.
(import :std/test
        (only-in :gerbil-parser/src/runtime/region-scanner
                 prepare-region-plan valid-region-specification? region-plan-end
                 region-plan-specification region-plan-pair-end region-plan-quote-end
                 region-plan-operator prepare-region-source prepare-scoped-region-source region-source-pair-end region-source-quote-end)
        (only-in :gerbil-parser/t/fixtures/bash-products bash-word-regions))

(def (rejects? thunk)
  (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (collision-rows root count)
  (let loop ((n 0) (rows '()))
    (if (= n count) rows
      (loop (+ n 1) (cons (list (string-append root (number->string n) "{") #\{ #\} 1) rows)))))
(deflanguage-parser-tests region-scanner-test "closed region plans"
  (engine)
    (scenario "longest openers and initial depth retain word boundaries"
      (each (word) ('("α$((1+(2*3)))" "<(printf 'α')" ">(cat)" "${x:-$(printf '}')}"))
         (equal (region-plan-end bash-word-regions (string-append word " ;tail") 0)
                 (string-length word)))
      (equal (region-plan-operator bash-word-regions "x;;&y" 1)  ";;&"))
    (scenario "quote scopes admit declared nesting and shield literal openers"
      (scope ((source "\"${x:-$(printf '%s' '}')}\" tail"))
        (equal (region-plan-quote-end bash-word-regions source 0 #\")
                (region-plan-end bash-word-regions source 0)))
      (equal (region-plan-end bash-word-regions "'${opaque' rest" 0)  10)
      (equal (region-plan-end bash-word-regions "`$(opaque` rest" 0)  10)
      (equal (region-plan-end bash-word-regions "a\\ b rest" 0)  4))
    (property "deep nesting uses explicit frames with exact endpoints"
      (bindings (depth 5000) (word (string-append
                    (apply string-append (make-list depth "$(")) "α"
                    (make-string depth #\)))) (source (string-append "xx" word " rest")))
      (equal (region-plan-end bash-word-regions source 2)  (+ 2 (string-length word)))
      (equal (region-plan-pair-end bash-word-regions source 2)  (+ 2 (string-length word))))
    (scenario "counter frames retain endpoints across reuse and independent scans"
      (sequential ((plan (prepare-region-plan '((";") ((#\" #t ())) (("@{" #\{ #\} 1) ("%(" #\( #\) 1)) #f)))
             (text (string-append "@{" (make-string 2048 #\{) "%(a(b)c)\"}\""
                                  (make-string 2048 #\}) "}"))
             (end (string-length text)))
        (each (_) ((iota 3)) (equal (region-plan-pair-end plan text 0)  end))
        (scope ((first (prepare-region-source plan text))
              (second (prepare-region-source plan text)))
          (equal (region-source-pair-end first 0)  end)
          (equal (region-source-pair-end second 0)  end)
          (equal (region-source-pair-end first 0)  end))
        (scope ((workers (map (lambda (_) (spawn (lambda () (region-plan-pair-end plan text 0)))) (iota 4))))
          (each (worker) (workers) (equal (thread-join! worker)  end)))
        (equal (rejects? (lambda () (region-plan-pair-end plan (substring text 0 (- end 1)) 0)))  #t)
        (equal (region-plan-pair-end plan text 0)  end)))
    (property "source-local boundaries retain all nested frame endpoints"
      (bindings (depth 5000) (text (string-append (apply string-append (make-list depth "${"))
                                  "α" (make-string depth #\}))) (source (prepare-region-source bash-word-regions text)))
      (equal (region-source-pair-end source 0)  (string-length text))
      (equal (let loop ((at 0))
                 (or (= at depth)
                     (and (= (region-source-pair-end source (* 2 at))
                             (- (string-length text) at))
                          (loop (+ at 1)))))  #t))
    (scenario "independent declared regions own text and preserve quote boundaries"
      (sequential ((plan (prepare-region-plan '((";") ((#\" #t ("@{"))) (("@{" #\{ #\} 1)) #f)))
             (text (string-copy "@{\"@{α}\"}"))
             (source (prepare-region-source plan text)))
        (act (string-set! text 0 #\x))
        (equal (region-source-pair-end source 0)  9)
        (equal (region-source-quote-end source 2 #\")  8)
        (equal (region-source-pair-end source 3)  7)
        (equal (rejects? (lambda () (region-source-quote-end source 2 #\')))  #t))
      (scope ((source (prepare-region-source bash-word-regions "'literal ${x}")))
        ;; Here-document literals do not require matching the leading quote.
        (equal (region-source-pair-end source 9)  13)
        (equal (rejects? (lambda () (region-source-quote-end source 0 #\')))  #t)))
    (scenario "overlapping quote and pair entries keep separate match identities"
      (sequential ((plan (prepare-region-plan '((";") ((#\" #t ())) (("\"(" #\( #\) 1)) #f)))
             (first (prepare-region-source plan "\"(α)\""))
             (second (prepare-region-source plan "\"(α)\"")))
        (equal (region-source-quote-end first 0 #\")  5)
        (equal (region-source-pair-end first 0)  4)
        (equal (region-source-pair-end second 0)  4)
        (equal (region-source-quote-end second 0 #\")  5)))
    (scenario "unterminated scopes fail rather than publish a partial word"
      (each (source) ('("${x" "$((1)" "<(cat" "\"${x}" "`x"))
         (equal (rejects? (lambda () (region-plan-end bash-word-regions source 0)))  #t)))
    (scenario "prepared plans own their declaration data across sources"
      (sequential ((spec (region-plan-specification bash-word-regions))
             (plan (prepare-region-plan spec))
             (view (region-plan-specification plan)))
        (act (string-set! (caar spec) 0 #\x))
        (act (string-set! (caar view) 0 #\y))
        (equal (region-plan-operator plan ";;&" 0)  ";;&")
        (equal (region-plan-end plan "${a} " 0)  4)
        (equal (region-plan-end plan "β " 0)  1)))
    (scenario "scoped overlapping pair openers retain independent cached endpoints"
      (scope ((plan (prepare-region-plan '((";") () (("#{" #\{ #\} 1) ("@" #\@ #\! 1) ("@(" #\( #\) 1)) #f))))
        (each (first) ('(0 2))
                    (scope ((source (prepare-scoped-region-source plan "#{@(x)!}" '(("#{" "@")))))
                      (equal (region-source-pair-end source first)  (if (= first 0) 8 6))
                      (equal (region-source-pair-end source 0)  8)
                      (equal (region-source-pair-end source 2)  6)))
        (equal (rejects? (lambda () (prepare-scoped-region-source plan "x" '(("unknown" "@")))))  #t)))
    (scenario "candidate indexes retain Unicode and declaration ownership"
      (sequential ((spec (list '(";") '()
                         (list (list (string-copy "α{") #\{ #\} 1)
                               (list (string-copy "😀[") #\[ #\] 1)) #f))
             (plan (prepare-region-plan spec))
             (view (region-plan-specification plan))
             (source (prepare-region-source plan "α{😀[x]}")))
        (act (string-set! (car (car (caddr spec))) 0 #\x))
        (act (string-set! (car (car (caddr view))) 0 #\y))
        (equal (region-source-pair-end source 0)  7)
        (equal (region-source-pair-end source 2)  6)
        (equal (region-plan-end plan "βx rest" 0)  2)
        (each (at) ('(-1 1 7 8 0.5)) (equal (rejects? (lambda () (region-source-pair-end source at)))  #t))))
    (scenario "overlapping buckets preserve longest admitted opener in either order"
      (each (pairs) ('((("#{" #\{ #\} 1) ("@" #\@ #\! 1) ("@(" #\( #\) 1))
         (("@(" #\( #\) 1) ("@" #\@ #\! 1) ("#{" #\{ #\} 1))))
         (sequential ((plan (prepare-region-plan (list '(";") '() pairs #f)))
                (outer (prepare-scoped-region-source plan "#{@(x)!}" '(("#{" "@"))))
                (unrestricted (prepare-region-source plan "@(x)!")))
           (equal (region-source-pair-end unrestricted 0)  4)
           (equal (region-source-pair-end outer 0)  8)
           (equal (region-source-pair-end outer 2)  6)
           (scope ((opaque (prepare-scoped-region-source plan "#{@(x}" '(("#{")))))
             (equal (region-source-pair-end opaque 0)  6)))))
    (scenario "shared prefix paths retain shorter admitted terminals in sparse and dense catalogs"
      (each (extra) ((list '() (collision-rows "@" 16)))
         (sequential ((plan (prepare-region-plan
                        (list '(";") '()
                          (append '(("#{" #\{ #\} 1) ("@" #\@ #\! 1)
                                    ("@a" #\a #\! 1) ("@ab{" #\{ #\} 1)) extra) #f)))
                (text "#{@ab{x!}")
                (source (prepare-scoped-region-source plan text '(("#{" "@a")))))
           (equal (region-source-pair-end source 0)  (string-length text))
           ;; A direct query is unrestricted and cannot reuse the shorter scoped row.
           (equal (region-source-pair-end source 2)  9)
           (each (text) ('("@" "@a" "@ab{")) (equal (rejects? (lambda () (region-plan-pair-end plan text 0)))  #t)))))
    (scenario "Unicode continuation edges discriminate dense ASCII and Unicode roots"
      (each (root) ('("@" "α"))
         (sequential ((texts (map (lambda (tail) (string-append root tail)) '("α{x}" "中{x}" "😀{x}")))
                (pairs (map (lambda (text) (list (substring text 0 3) #\{ #\} 1)) texts))
                (plan (prepare-region-plan (list '(";") '() (append pairs (collision-rows root 16)) #f))))
           (each (text) (texts) (equal (region-plan-pair-end plan text 0)  (string-length text)))
           (equal (rejects? (lambda () (region-plan-pair-end plan (string-append root "β{x}") 0)))  #t))))
    (scenario "malformed rows and foreign quote prefixes reject at admission"
      (each (spec) ('(((";") (bad-row) () #f)
         ((";") () (bad-row) #f)
         ((";" ";") () () #f)
         ((";") ((#\" #t ("missing"))) () #f)
         ((";") () (("$(" #\( #\) 0)) #f)
         ((";") () (("$(" #\( #\) 3)) #f)
         ((";") () (("α(" #\( #\) 3)) #f)))
         (equal (valid-region-specification? spec)  #f)
         (equal (rejects? (lambda () (prepare-region-plan spec)))  #t))))
