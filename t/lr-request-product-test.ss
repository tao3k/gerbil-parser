(import :gerbil-parser/language-test-support)
;;; Complete request extraction, AST replay and canonical event products.
(import :std/test
        (only-in :gerbil-parser/t/fixtures/event-iterator-extraction event-graph-certificate check-event-certificate generate-event-witness witness-callbacks extract-event-graph replay-event-graph packet-event-callbacks hybrid-event-callbacks hybrid-event-run event-program-callbacks)
        (only-in :std/string/utf8 string-utf8-length)
        (only-in :gerbil-parser/t/fixtures/lr-request-product extract-value extract-token extract-event replay-request reference-events)
        (only-in :gerbil-parser/t/fixtures/runtime-record-assignments/languages/records/grammar records-parser)
        (only-in :gerbil-parser/languages/arithmetic/grammar arithmetic-parser)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-runtime parser-machine-ir
                 parser-machine-trivia parser-machine-grammar-digest)
        (only-in :gerbil-parser/src/compiler/lr lr-spec-ref production-table)
        (only-in :gerbil-parser/src/runtime/token make-token token-kind token-lexeme token-start token-end)
        (only-in :gerbil-parser/src/runtime/lexer lex-source)
        (only-in :gerbil-parser/src/runtime/significant parser-significant-tokens)
        (only-in :gerbil-parser/src/runtime/recognition make-recognition-node make-recognition-child recognition-child-value relocate-recognition-value)
        (only-in :gerbil-parser/src/runtime/funcs recognition-sequence-root-child)
        (only-in :gerbil-parser/src/runtime/lr-parser lr-parse/prepared lr-recognition-project
                 current-lr-recognition-observer current-lr-event-program-enabled?)
        (only-in :gerbil-parser/src/runtime/artifact make-success-parse-artifact parse-artifact-events
                 parse-artifact-valid? parse-artifact-roundtrip)
        (only-in :gerbil-parser/src/runtime/event-program event-program-value?)
        (only-in :gerbil-parser/src/runtime/parser parse-source))

(defparser-check (check-shifted-product machine source root)
  (sequential ((shifted-source (string-append " " source))
         (tokens (lex-source machine shifted-source))
         (trivia? (parser-machine-trivia machine))
         (digest (parser-machine-grammar-digest machine))
         (product (make-success-parse-artifact digest shifted-source tokens
                    (relocate-recognition-value root 1) trivia?)))
    (parameters ((current-lr-event-program-enabled? #f) (current-lr-recognition-observer #f))
      (scope-values (((fresh-root rest) (lr-parse/prepared (parser-machine-runtime machine)
                                      (parser-significant-tokens machine tokens))))
        (equal rest  '())
        (equal (map extract-event (parse-artifact-events product))
                (reference-events (extract-value fresh-root) tokens trivia? (string-utf8-length shifted-source)))))
    (equal (parse-artifact-valid? product)  #t)
    (equal (parse-artifact-roundtrip product)  shifted-source)))
(defparser-check (check-request-product machine source)
  (sequential ((tokens (lex-source machine source)) (significant (parser-significant-tokens machine tokens))
         (runtime (parser-machine-runtime machine)) (trivia? (parser-machine-trivia machine))
         (digest (parser-machine-grammar-digest machine)) (captured #f))
    (parameters ((current-lr-event-program-enabled? #f)
                   (current-lr-recognition-observer (lambda (value) (set! captured value))))
      (scope-values (((root rest) (lr-parse/prepared runtime significant)))
        (equal rest  '())
        (sequential ((extracted (extract-value root))
               (projected (recognition-child-value (recognition-sequence-root-child (lr-recognition-project captured tokens))))
               (expected (reference-events extracted tokens trivia? (string-utf8-length source)))
               (artifact (make-success-parse-artifact digest source tokens root trivia?))
               (events (parse-artifact-events artifact)))
          (equal (extract-value projected)  extracted)
          (verify check-shifted-product machine source root)
          (sequential ((spec (cdr (assq 'lr-spec (parser-machine-ir machine)))) (table (production-table (lr-spec-ref spec 'productions))))
            (scope-values (((instructions values) (replay-request table captured significant)))
              (equal (list values)  (list (list (list #f extracted))))
              (equal (length (filter (lambda (instruction) (eq? (car instruction) 'shift)) instructions))  (length significant))
              (equal (> (length instructions) (length significant))  #t)))
          (equal (map extract-event events)  expected)
          (equal (parse-artifact-valid? artifact)  #t)
          (equal (parse-artifact-roundtrip artifact)  source)
          ;; A cancelled view must still accept freshly allocated source tokens;
          ;; the untranslated path must reject them by object identity.
          (sequential ((fresh (map (lambda (token) (make-token (token-kind token) (token-lexeme token)
                                                       (token-start token) (token-end token))) tokens))
                 (view (relocate-recognition-value (relocate-recognition-value root 11) -11))
                 (product (make-success-parse-artifact digest source fresh view trivia?)))
            (equal (map extract-event (parse-artifact-events product))  expected)
            (equal (parse-artifact-valid? product)  #t)
            (equal (parse-artifact-roundtrip product)  source)
            (when (pair? significant)
              (raises (make-success-parse-artifact digest source fresh root trivia?) true)))
          (equal (map extract-event (parse-artifact-events (parse-source machine source)))  expected)
          (parameters ((current-lr-event-program-enabled? #t) (current-lr-recognition-observer #f))
            (scope-values (((program rest) (lr-parse/prepared runtime significant)))
              (equal (event-program-value? program)  #t)
              (sequential ((graph (extract-event-graph program)) (ranks (event-graph-certificate graph))
                     (witness (generate-event-witness graph ranks (+ 1 (vector-ref ranks (car graph))))))
                (equal (check-event-certificate graph ranks)  #t)
                (equal (witness-callbacks witness)  (event-program-callbacks program))
                (equal (witness-callbacks witness 1)  (event-program-callbacks program 1))
                (each (cutoff) ('(0 64))
                            (equal (hybrid-event-callbacks graph cutoff 1)  (event-program-callbacks program 1))
                            (equal (hybrid-event-callbacks graph cutoff)  (event-program-callbacks program)))
                (equal (packet-event-callbacks graph 1)  (event-program-callbacks program 1))
                (equal (packet-event-callbacks graph)  (event-program-callbacks program))
                (equal (replay-event-graph graph 1)  (event-program-callbacks program 1))
                (equal (replay-event-graph graph)  (event-program-callbacks program)))
              (verify check-shifted-product machine source program)
              (equal rest  '())
              (scope ((product (make-success-parse-artifact digest source tokens program trivia?)))
                (equal (map extract-event (parse-artifact-events product))  expected)
                (equal (parse-artifact-valid? product)  #t)
                (equal (parse-artifact-roundtrip product)  source)
                (sequential ((fresh (map (lambda (token) (make-token (token-kind token) (token-lexeme token)
                                                             (token-start token) (token-end token))) tokens))
                       (view (relocate-recognition-value (relocate-recognition-value program 11) -11))
                       (moved-product (make-success-parse-artifact digest source fresh view trivia?)))
                  (equal (map extract-event (parse-artifact-events moved-product))  expected)
                  (equal (parse-artifact-valid? moved-product)  #t)
                  (equal (parse-artifact-roundtrip moved-product)  source)
                  (when (pair? significant)
                    (raises (make-success-parse-artifact digest source fresh program trivia?) true)))))))))))
(deflanguage-parser-tests lr-request-product-test "complete LR request AST and event correspondence"
  (engine)
    (scenario "empty, trivia, Unicode and 64-record requests share AST and event meaning"
      (each (source) ((list "" " \t " "  alpha = \"λ\"\n beta=22 \n " (apply string-append (make-list 64 "alpha=1\n")))) (verify check-request-product records-parser source)))
    (scenario "arithmetic precedence and fields use the same complete-request adapter"
      (each (source) ('("1" " 1 + 2 * name " "(1 + 2) * 3")) (verify check-request-product arithmetic-parser source)))
    (scenario "malformed native event extraction rejects widths, tags and payload types"
      (each (event) ((list #f '#() '#(token 0 word "x" 0) '#(token -1 word "x" 0 1)
                      '#(token 0 word #f 0 1) '#(token 1.0 word "x" 0 1) '#(start-node 0 Root) '#(start-field name -1)
                      '#(unknown 0 Root 0))) (raises (extract-event event) true)))
    (scenario "source binding and root admission fail closed before publication"
      (sequential ((token (make-token 'word "x" 0 1)) (other (make-token 'word "y" 0 1))
             (root (make-recognition-node 'Root 0 1 (list (make-recognition-child #f token))))
             (tree (extract-value root)))
        (raises (reference-events tree (list other) (lambda (_) #f) 1) true)
        (raises (make-success-parse-artifact "test" "y" (list other) root (lambda (_) #f)) true)
        (scope ((missing (make-recognition-node 'Root 0 1 '())))
          (raises (reference-events (extract-value missing) (list token) (lambda (_) #f) 1) true)
          (raises (make-success-parse-artifact "test" "x" (list token) missing (lambda (_) #f)) true))
        (raises (reference-events (extract-token token) (list token) (lambda (_) #f) 1) true)
        (raises (make-success-parse-artifact "test" "x" (list token) token (lambda (_) #f)) true))))
