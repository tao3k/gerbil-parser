((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 20ms)
 (regression_budget . 80ms)
 (expected_over_input_budget . 5ms)
 (targetRationale . "one hundred warm length-bearing native C parses, including callback, UTF-8 admission, lossless publication and owned payload replacement")
 (sampleCount . 40)
 (rule . GERBIL-PARSER-NATIVE-LANGUAGE)
 (feature . shared-scanner-language-abi-context)
 (optimizationFocus . "prepared language/scanner admission outside repeated calls; no per-call runtime, grammar or process isolation")
 (inputShape . "one hundred UTF-8 record assignments per sample")
 (expectedOutcome . "a 100-call warm batch stays below 100ms; startup and language registration are separately reported")
 (measurementPhases collect-before collect-after policy-before policy-after assert-time-gate observe-runtime-memory)
 (tags performance native ffi scanner))
