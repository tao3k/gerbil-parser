;;; Shared lexer publication: prefix chains, filtered modes and scalar controls.
(import (only-in :gerbil-parser/src/runtime/scan make-ranked-literal-scanner)
        (only-in :gerbil-parser/src/runtime/parse-cost admit-parser-allocation))
(export benchmark-ranked-literal)
(def (benchmark-ranked-literal (samples 11) (iterations 1000))
  (unless (and (exact-integer? samples) (positive? samples)
               (exact-integer? iterations) (positive? iterations))
    (error "ranked literal benchmark requires positive exact counts"))
  (let* ((entries (map (lambda (n) (list (make-string (+ n 1) #\a) n n n)) (iota 32)))
         (scan (make-ranked-literal-scanner entries)) (text (make-string 32 #\a))
         (single (make-ranked-literal-scanner '(("a" single 0 0))))
         (short (make-vector 32 #f)) (none (make-vector 32 #f)))
    (vector-set! short 0 #t)
    (for-each (lambda (row)
      (let ((scanner (car row)) (source (cadr row)) (admitted (caddr row))
            (width (cadddr row)) (name (car (cddddr row))))
        (let sample ((index 0))
          (when (< index samples)
            (let* ((before (##process-statistics))
                   (sum (let repeat ((count 0) (total 0))
                          (if (= count iterations) total
                            (let (found (scanner source 0 admitted))
                              (repeat (+ count 1) (+ total (if found (cadr found) 0)))))))
                   (after (##process-statistics))
                   (delta (lambda (slot) (- (f64vector-ref after slot) (f64vector-ref before slot)))))
              (unless (= sum (* iterations width)) (error "ranked literal endpoint changed" name))
              (write (list 'ranked-literal name index 'iterations iterations
                           'cpu-ms-per-call (/ (* 1000 (+ (delta 0) (delta 1))) iterations)
                           'allocated-bytes-per-call
                           (let (bytes (admit-parser-allocation (delta 7) (delta 6)))
                             (and bytes (/ bytes iterations)))))
              (newline) (force-output))
            (sample (+ index 1))))))
      (list (list scan text #f 32 'prefix-chain) (list scan text short 1 'short-admitted)
            (list single "a" #f 1 'single-terminal) (list scan text none 0 'all-filtered))))
  (displayln "RANKED-LITERAL-OK") (force-output))
