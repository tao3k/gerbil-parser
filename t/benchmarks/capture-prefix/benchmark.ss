;;; Two persistent SDK processes admit two real native images; request CPU is
;;; measured inside each worker, excluding startup and protocol exchange.
(displayln "CAPTURE-CPU-START") (force-output)
(def (worker image scope)
  (open-process (list path: "gxi" arguments: (list "t/benchmarks/capture-prefix/worker.ss" image scope)
                      stdin-redirection: #t stdout-redirection: #t stderr-redirection: #f)))
(def (batch process calls)
  (write calls process) (newline process) (force-output process)
  (let (row (read process))
    (unless (and (list? row) (= (length row) 3) (eq? (car row) 'CAPTURE-BATCH)
                 (= (cadr row) calls) (> (caddr row) .001))
      (error "invalid or unresolved complete-request CPU batch" row))
    (write row) (newline) (force-output)
    (caddr row)))
(def (percentile values rank)
  (list-ref (list-sort < values) (- (ceiling (/ (* rank (length values)) 100)) 1)))
(def (phase name reference candidate calls)
  (let loop ((group 0) (ratios '()))
    (if (= group 5)
      (let (summary (map (lambda (rank) (percentile ratios rank)) '(10 50 90)))
        (write (list 'CAPTURE-CPU-SUMMARY name summary)) (newline) (force-output) summary)
      (let* ((order (apply append (make-list 4 (if (even? group) '(a b b a b a a b) '(b a a b a b b a)))))
             (rows (map (lambda (side)
                          (cons side (batch (if (eq? side 'a) reference candidate) calls))) order))
             (total (lambda (side) (foldl (lambda (row sum) (if (eq? (car row) side) (+ sum (cdr row)) sum)) 0 rows)))
             (ratio (/ (total 'b) (total 'a))))
        (write (list 'CAPTURE-CPU-GROUP name group ratio)) (newline) (force-output)
        (loop (+ group 1) (cons ratio ratios))))))
(def (main reference-image (scope "selector-input"))
 (let ((reference (worker reference-image scope)) (candidate (worker "candidate" scope)))
  (try
   (let ((left (read reference)) (right (read candidate)))
    (unless (and (list? left) (list? right) (= (length left) 5) (= (length right) 5)
                 (eq? (car left) 'CAPTURE-READY) (eq? (car right) 'CAPTURE-READY)
                 (equal? (cadr left) (cadr right)) (equal? (caddr left) (caddr right))
                 (not (equal? (cadddr left) (cadddr right)))
                 (equal? (car (cddddr left)) (car (cddddr right))))
      (error "native images changed complete artifact" left right))
    (write left) (newline)
    (write right) (newline) (force-output))
   (batch reference 256) (batch candidate 256)
   (let* ((before (phase 'before reference reference 256))
          (production (phase 'production reference candidate 256))
          (after (phase 'after reference reference 256)))
    (unless (and (>= (car before) .90) (<= (caddr before) 1.10)
                 (>= (car after) .90) (<= (caddr after) 1.10) (< (caddr production) .95))
      (error "complete capture CPU admission failed" before production after))
    (displayln "CAPTURE-COMPLETE-CPU-PROOF-OK") (force-output))
   (finally
     (for-each (lambda (process)
                 (with-catch (lambda (_) (void))
                   (lambda () (write 'stop process) (newline process) (force-output process)))
                 (close-port process)) (list reference candidate))))))
