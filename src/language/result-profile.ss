;;; Declarative result construction is the authority for publication and catalogs.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in :clan/poo/mop define-type validate)
        (only-in :core/types PooFlowContract. poo-flow-classification-evidence)
        (only-in ./scanner-profile compile-scanner-profile)
        (only-in ../runtime/token token? token-kind token-start token-end)
        (only-in ../runtime/recognition
                 make-recognition-node recognition-node? recognition-node-kind recognition-node-start recognition-node-end
                 recognition-child? recognition-child-field recognition-child-value
                 make-recognition-child recognition-source-offset recognition-source-token)
        (only-in ../runtime/funcs recognition-sequence-append))
(export ResultProfile. ResultProfileContract defresult-profile compile-result-profile
        result-plan? result-plan-recipe result-plan-catalog result-plan-node result-plan-token
        result-plan-projection result-projection-build)
(def ResultProfile. (.o nodes: '() tokens: '() scanner: #f projections: '()))
(defstruct result-plan (owned-recipe node-index token-index projection-index))
(defstruct result-projection (owner kind captures operations arity executor))
(def (copy-datum value)
  (cond ((pair? value) (cons (copy-datum (car value)) (copy-datum (cdr value))))
        ((string? value) (string-copy value)) (else value)))
(def (unique-symbols? values)
  (and (list? values) (andmap symbol? values)
       (let (seen (make-hash-table-eq))
         (andmap (lambda (value)
                   (and (not (hash-get seen value))
                        (begin (hash-put! seen value #t) #t))) values))))
(def (projection-catalog nodes tokens projections)
  (unless (and (list? projections)
               (andmap (lambda (row) (and (list? row) (>= (length row) 3)
                                           (symbol? (car row)) (symbol? (cadr row)))) projections)
               (unique-symbols? (map car projections)))
    (error "invalid result projection declarations"))
  (let ((derived (make-hash-table-eq)) (order '()) (terminals tokens))
    (for-each (lambda (row)
      (let ((kind (cadr row)) (fields '()))
        (for-each (lambda (operation)
          (unless (and (list? operation) (>= (length operation) 2) (symbol? (cadr operation))
                       (case (car operation)
                         ((token) (and (= (length operation) 5) (symbol? (caddr operation))))
                         ((one) (= (length operation) 4))
                         ((many) (= (length operation) 3)) (else #f)))
            (error "invalid result projection operation" (car row) operation))
          (unless (memq (cadr operation) fields) (set! fields (cons (cadr operation) fields)))
          (when (and (eq? (car operation) 'token) (not (memq (caddr operation) terminals)))
            (set! terminals (append terminals (list (caddr operation)))))) (cdddr row))
        ;; Explicit node declarations constrain fields; otherwise derive them.
        ;; Several projection programs may construct the same derived node.
        (unless (assq kind nodes)
          (unless (hash-key? derived kind) (set! order (cons kind order)))
          (let (prior (or (hash-get derived kind) '()))
            (hash-put! derived kind (append prior (filter (lambda (field) (not (memq field prior))) (reverse fields)))))))) projections)
    (values (append nodes (map (lambda (kind) (list kind (hash-get derived kind))) (reverse order))) terminals)))
(def (profile-plan profile)
  (unless (object? profile) (error "result profile requires a POO object"))
  (let ((nodes (.ref profile 'nodes)) (tokens (.ref profile 'tokens))
        (scanner (.ref profile 'scanner)) (projections (copy-datum (.ref profile 'projections))))
    (unless (and (list? nodes)
                 (andmap (lambda (row)
                           (and (list? row) (= (length row) 2) (symbol? (car row))
                                (unique-symbols? (cadr row)))) nodes)
                 (unique-symbols? (map car nodes)) (unique-symbols? tokens))
      (error "invalid result construction declaration"))
    (when scanner (compile-scanner-profile scanner))
    (let-values (((all-nodes derived-tokens) (projection-catalog nodes tokens projections)))
      (unless (pair? all-nodes) (error "result profile requires a node construction"))
      (let* ((published-tokens
              (if scanner
                (append derived-tokens (filter (lambda (kind) (not (memq kind derived-tokens))) (.ref scanner 'tokens)))
                derived-tokens))
             (node-index (make-hash-table-eq)) (token-index (make-hash-table-eq))
             (owned (map (lambda (row) (list (car row) (map values (cadr row)))) all-nodes)))
        (for-each (lambda (row)
                    (let (fields (make-hash-table-eq))
                      (for-each (lambda (field) (hash-put! fields field #t)) (cadr row))
                      (hash-put! node-index (car row) fields))) owned)
        (for-each (lambda (kind) (hash-put! token-index kind #t)) published-tokens)
        (let (plan (make-result-plan (list owned (map values published-tokens) projections)
                                      node-index token-index (make-hash-table-eq)))
          (for-each (lambda (row) (compile-projection! plan row)) projections)
          plan)))))

;;; Each capture is consumed once, in declaration order. Compilation resolves
;;; field and terminal membership and assigns fixed vector indexes; execution
;;; never searches an association list or flattens nested token sequences.
(def (compile-projection! plan row)
  (let* ((id (car row)) (kind (cadr row)) (captures (caddr row)) (operations (cdddr row))
         (fields (hash-get (result-plan-node-index plan) kind)))
    (unless (and fields (list? captures)
                 (andmap (lambda (capture) (and (list? capture) (= (length capture) 2)
                    (symbol? (car capture)) (memq (cadr capture) '(span node parts)))) captures)
                 (unique-symbols? (map car captures)) (= (length captures) (length operations)))
      (error "invalid result projection captures" id))
    (let* ((index -1)
           (compiled
          (map (lambda (operation capture)
                 (set! index (+ index 1))
                 (unless (and (list? operation) (>= (length operation) 2)
                              (symbol? (cadr operation)) (hash-get fields (cadr operation))
                              (case (car operation)
                                ((token) (and (= (length operation) 5) (eq? (cadr capture) 'span)
                                  (hash-get (result-plan-token-index plan) (caddr operation))
                                  (eq? (list-ref operation 3) (car capture))
                                  (memq (list-ref operation 4) '(required optional))))
                                ((one) (and (= (length operation) 4) (eq? (cadr capture) 'node)
                                  (eq? (caddr operation) (car capture))
                                  (memq (list-ref operation 3) '(required optional))))
                                ((many) (and (= (length operation) 3) (eq? (cadr capture) 'parts)
                                  (eq? (caddr operation) (car capture))))
                                (else #f)))
                   (error "invalid result projection operation" id operation))
                 (list->vector (cons index operation)))
               operations captures)))
      (hash-put! (result-plan-projection-index plan) id
                 (make-result-projection plan kind
                   (map (lambda (capture operation)
                          (if (eq? (cadr capture) 'parts) capture
                            (append capture (list (list-ref operation (- (length operation) 1)))))) captures operations)
                   compiled (length captures)
                   (compile-projection-executor plan kind compiled))))))
(def (result-plan-projection plan id expected-captures)
  (let (projection (hash-get (result-plan-projection-index plan) id))
    (unless (and projection (equal? expected-captures (result-projection-captures projection)))
      (error "missing or incompatible result projection" id expected-captures))
    projection))
(def (compile-projection-executor plan kind operations)
  ;; Static one-operation programs avoid VM dispatch and redundant catalog
  ;; checks. Capture bounds and source offsets are still checked on every call.
  (let (operation (and (pair? operations) (null? (cdr operations)) (car operations)))
    (cond
      ((and operation (eq? (vector-ref operation 1) 'token) (eq? (vector-ref operation 5) 'required))
       (let ((field (vector-ref operation 2)) (terminal (vector-ref operation 3)))
         (lambda (source start end captures)
           (let (span (vector-ref captures 0))
             (unless (and (pair? span) (exact-integer? (car span)) (exact-integer? (cdr span))
                          (<= start (car span) (cdr span) end))
               (error "invalid required projection span" field span))
             (let (token (recognition-source-token source terminal (car span) (cdr span)))
               (values (make-recognition-node kind
                         (recognition-source-offset source start) (recognition-source-offset source end)
                         (list (make-recognition-child field token))) (list token)))))))
      ((and operation (eq? (vector-ref operation 1) 'many))
       (let (field (vector-ref operation 2))
         (lambda (source start end captures)
           (let (parts (vector-ref captures 0))
             (unless (and (pair? parts) (list? (car parts)) (andmap recognition-node? (car parts)))
               (error "invalid projection parts capture" field))
             (values (result-plan-node plan kind
                         (recognition-source-offset source start) (recognition-source-offset source end)
                         (map (lambda (value) (make-recognition-child field value)) (car parts))) (cdr parts))))))
      (else #f))))
(def (result-projection-build projection source start end captures)
  (unless (and (result-projection? projection) (vector? captures)
               (= (vector-length captures) (result-projection-arity projection))
               (exact-integer? start) (exact-integer? end) (<= 0 start end))
    (error "invalid result projection frame"))
  (let (executor (result-projection-executor projection))
    (if executor (executor source start end captures)
      (interpret-result-projection projection source start end captures))))
(def (interpret-result-projection projection source start end captures)
  (let ((plan (result-projection-owner projection)) (children '()) (tokens '()))
    (def (emit! field value) (set! children (cons (make-recognition-child field value) children)))
    (for-each
     (lambda (operation)
       (let* ((value (vector-ref captures (vector-ref operation 0)))
              (opcode (vector-ref operation 1)) (field (vector-ref operation 2)))
         (case opcode
           ((token)
            (when (and (not value) (eq? (vector-ref operation 5) 'required))
              (error "missing required projection span" field))
            (when value
              (unless (and (pair? value) (exact-integer? (car value)) (exact-integer? (cdr value))
                           (<= start (car value) (cdr value) end))
                (error "invalid projection span" field value))
              (let (token (recognition-source-token source (vector-ref operation 3) (car value) (cdr value)))
                (emit! field token)
                (set! tokens (recognition-sequence-append tokens (list token))))))
           ((one)
            (when (and (not value) (eq? (vector-ref operation 4) 'required))
              (error "missing required projection node" field))
            (when value
              (unless (and (pair? value) (recognition-node? (car value)))
                (error "invalid projection node capture" field))
              (emit! field (car value))
              (set! tokens (recognition-sequence-append tokens (cdr value)))))
           ((many)
            (unless (and (pair? value) (list? (car value)) (andmap recognition-node? (car value)))
              (error "invalid projection parts capture" field))
            (for-each (lambda (part) (emit! field part)) (car value))
            (set! tokens (recognition-sequence-append tokens (cdr value)))))))
     (result-projection-operations projection))
    (values (result-plan-node plan (result-projection-kind projection)
                              (recognition-source-offset source start) (recognition-source-offset source end)
                              (reverse children)) tokens)))
(def (profile-valid? profile)
  (with-catch (lambda (_) #f) (lambda () (profile-plan profile) #t)))
(define-type (ResultProfileContract @ PooFlowContract.)
  identity: 'gerbil-parser/result-profile
  .classify: (lambda (candidate context)
    (let (accepted? (profile-valid? candidate))
      (poo-flow-classification-evidence 'gerbil-parser/result-profile candidate accepted?
       (if accepted? '() '((expected gerbil-parser/result-profile))) context))))
(def (compile-result-profile profile)
  (validate ResultProfileContract profile)
  (profile-plan profile))
(def (result-plan-recipe plan)
  (let (recipe (result-plan-owned-recipe plan))
    (list (map (lambda (row) (list (car row) (map values (cadr row)))) (car recipe))
          (map values (cadr recipe)) (copy-datum (caddr recipe)))))
(def (result-plan-catalog plan)
  ;; Catalog publication copies only the catalog, never the projection program.
  (let (recipe (result-plan-owned-recipe plan))
    (list (cons 'syntax-kinds
                (map (lambda (row) (list (car row) 'result (map values (cadr row)))) (car recipe)))
          (cons 'terminals (map (lambda (kind) (list kind 'token)) (cadr recipe))))))
(def (result-plan-token plan token)
  (unless (and (token? token) (exact-integer? (token-start token))
               (exact-integer? (token-end token)) (<= 0 (token-start token) (token-end token))
               (hash-get (result-plan-token-index plan) (token-kind token)))
    (error "undeclared result terminal" token))
  token)
(def (result-plan-node plan kind start end children)
  (let (fields (hash-get (result-plan-node-index plan) kind))
    (unless (and fields (exact-integer? start) (exact-integer? end) (<= 0 start end)
                 (list? children))
      (error "invalid or undeclared result node" kind start end))
    (for-each
     (lambda (child)
       (unless (and (recognition-child? child)
                    (hash-get fields (recognition-child-field child)))
         (error "undeclared result field" kind child))
       (let (value (recognition-child-value child))
         ;; Dispatch once, retain both bounds, then validate the local operation.
         ;; Do not call the generic span dispatcher repeatedly for each child.
         (let-values (((child-start child-end)
                       (cond
                        ((token? value)
                         (unless (hash-get (result-plan-token-index plan) (token-kind value))
                           (error "undeclared child result terminal" kind))
                         (values (token-start value) (token-end value)))
                        ((recognition-node? value)
                         (unless (hash-get (result-plan-node-index plan) (recognition-node-kind value))
                           (error "undeclared child result node" kind))
                         (values (recognition-node-start value) (recognition-node-end value)))
                        (else (error "invalid result child value" kind)))))
           (unless (and (exact-integer? child-start) (exact-integer? child-end)
                        (<= start child-start child-end end))
             (error "result child outside parent span" kind))))) children)
    (make-recognition-node kind start end children)))
(defsyntax (defresult-profile stx)
  (syntax-case stx (nodes tokens scanner projections)
    ((_ (name marker self base) (scanner source-scanner)
        (nodes (kind field ...) ...) (tokens token ...) (projections projection ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) scanner: source-scanner
                    nodes: '((kind (field ...)) ...) tokens: '(token ...) projections: '(projection ...))))
    ((_ (name marker self base) (nodes (kind field ...) ...) (tokens token ...) (projections projection ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) nodes: '((kind (field ...)) ...)
                    tokens: '(token ...) projections: '(projection ...))))
    ((_ (name marker self base) (projections projection ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) projections: '(projection ...))))
    ((_ (name marker self base) (scanner source-scanner)
        (nodes (kind field ...) ...) (tokens token ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) scanner: source-scanner
                    nodes: '((kind (field ...)) ...) tokens: '(token ...))))
    ((_ (name marker self base) (nodes (kind field ...) ...) (tokens token ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) nodes: '((kind (field ...)) ...) tokens: '(token ...))))
    ((_ (name marker self base) (nodes (kind field ...) ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) nodes: '((kind (field ...)) ...))))
    ((_ (name marker self base) (tokens token ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) tokens: '(token ...))))
    ((_ (name marker self base) (scanner source-scanner))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) scanner: source-scanner)))))
