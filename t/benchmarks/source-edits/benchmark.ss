#!/usr/bin/env gxi
;;; Matched edit calls over the actual C ABI; independent fresh payload control.
(import (only-in :gerbil-parser/languages/bash/parser bash-source-language)
        (only-in :gerbil-parser/src/ffi/language-artifact-codec bind-language-abi abi-parse-binary-payload)
        (only-in :gerbil-parser/src/ffi/language-handles register-language! release-language!
                 language-handle-count language-handle-scan-counts)
        (only-in :gerbil-parser/src/runtime/parse-cost current-parser-cost-observer with-parser-cost-stage admit-parser-allocation)
        (only-in :std/vector/u8vector little u8vector-u32-ref)
        (only-in :asp-gerbil-scheme/src/benchmark/statistics benchmark-percentile-index)
        (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!)
        ./abi-call)
(export main verify-callback-gc)
(def (fixtures lines)
  (let (tail (string-join (make-list lines "echo tail\n") ""))
    (list
      (list 'utf8-prefix (string-append "cat <<A\nα\nA\n" tail)
                        (string-append "echo猫 <<A\nα\nA\n" tail) 0)
      (list 'quoted-marker (string-append "cat <<A\nα\nA\n" tail)
                          (string-append "cat <<'A'\nα\nA\n" tail) 0)
      (list 'marker-fifo (string-append "cat <<A <<B\nx\nA\ny\nB\n" tail)
                        (string-append "cat <<'A' <<B\nx\nA\ny\nB\n" tail) 0)
      (list 'grammar-rejection (string-append "echo old\n" tail)
                               (string-append "| echo bad\n" tail) 1)
      (list 'lexical-rejection (string-append "cat <<A\nx\nA\n" tail)
                               "cat <<MISSING\nunfinished\n" 1))))
(def (quantile rows key rank)
  (let (ordered (list-sort < (filter number? (map (lambda (row) (cdr (assq key row))) rows))))
    (and (pair? ordered) (list-ref ordered (benchmark-percentile-index (length ordered) rank)))))
(def (call! handle bytes output)
  (unless (zero? (parse-source/abi! handle bytes output))
    (error "native Source edit transport failed")))
(def (measure-call handle bytes output)
  (let* ((before (##process-statistics))
         (started (##current-time-point))
         (_ (call! handle bytes output))
         (wall (* 1000 (- (##current-time-point) started)))
         (after (##process-statistics))
         (delta (lambda (index) (- (f64vector-ref after index) (f64vector-ref before index)))))
    (list (cons 'wall-ms wall) (cons 'cpu-ms (* 1000 (+ (delta 0) (delta 1))))
          (cons 'allocated-bytes (admit-parser-allocation (delta 7) (delta 6)))
          (cons 'allocation-counter-delta (delta 7)) (cons 'gc-count (delta 6))
          (cons 'gc-wall-ms (* 1000 (delta 5))))))
(def (summary rows)
  (list (cons 'wall-p50-ms (quantile rows 'wall-ms 50))
        (cons 'wall-p95-ms (quantile rows 'wall-ms 95))
        (cons 'cpu-p50-ms (quantile rows 'cpu-ms 50))
        (cons 'allocated-p50-bytes (quantile rows 'allocated-bytes 50))
        (cons 'allocation-observation-count
          (length (filter (lambda (row) (number? (cdr (assq 'allocated-bytes row)))) rows)))
        ;; Preserve counters from the wall-ranked observation.
        (cons 'wall-p95-sample
          (list-ref (list-sort (lambda (a b) (< (cdr (assq 'wall-ms a)) (cdr (assq 'wall-ms b)))) rows)
                    (benchmark-percentile-index (length rows) 95)))))
(def (run-case row samples fresh session language)
  (let* ((name (car row)) (base (cadr row)) (edited (caddr row))
         (bytes (string->utf8 edited)) (base-bytes (string->utf8 base))
         (expected (abi-parse-binary-payload language edited))
         (base-result (abi-parse-binary-payload language base))
         (prime-output (make-u8vector (u8vector-length base-result)))
         (empty-output (make-u8vector (u8vector-length (abi-parse-binary-payload language ""))))
         (fresh-output (make-u8vector (u8vector-length expected)))
         (session-output (make-u8vector (u8vector-length expected))))
    (unless (= (u8vector-u32-ref expected 8 little) (cadddr row))
      (error "benchmark fixture acceptance changed" name))
    (let loop ((sample -2) (fresh-rows '()) (session-rows '()))
      (if (= sample samples)
        (begin
          (write (list 'SOURCE-EDIT-SUMMARY name 'fresh (summary (reverse fresh-rows)))) (newline)
          (write (list 'SOURCE-EDIT-SUMMARY name 'session (summary (reverse session-rows)))) (newline))
        (begin
          ;; Preparation is excluded equally: fresh has no prior tokens, session has base.
          (call! fresh #u8() empty-output)
          (call! session base-bytes prime-output)
          (let-values (((fresh-row session-row)
                        (if (even? sample)
                          (values (measure-call fresh bytes fresh-output)
                                  (measure-call session bytes session-output))
                          (let (s (measure-call session bytes session-output))
                            (values (measure-call fresh bytes fresh-output) s)))))
            ;; Compare every byte after the complete uninstrumented call.
            (unless (and (equal? fresh-output expected) (equal? session-output expected))
              (error "fresh/session GPA1 mismatch" name sample))
            (when (>= sample 0)
              (write (list 'SOURCE-EDIT-SAMPLE name sample 'fresh fresh-row 'session session-row))
              (newline) (force-output))
            (loop (+ sample 1)
                  (if (negative? sample) fresh-rows (cons fresh-row fresh-rows))
                  (if (negative? sample) session-rows (cons session-row session-rows)))))))
    ;; A separate instrumented call explains boundaries, never the A/B latency.
    (for-each
      (lambda (lane)
        (let ((handle (if (eq? lane 'fresh) fresh session)) (stages '()))
          (if (eq? lane 'fresh) (call! handle #u8() empty-output)
            (call! handle base-bytes prime-output))
          (parameterize ((current-parser-cost-observer
                          (lambda (stage receipt) (set! stages (cons (cons stage receipt) stages)))))
            (with-parser-cost-stage 'full-call (call! handle bytes session-output)))
          (unless (equal? session-output expected) (error "observed call GPA1 mismatch" name lane))
          (for-each (lambda (stage)
                      (unless (assq stage stages) (error "missing native cost stage" name lane stage)))
                    '(full-call ffi-input-copy utf8-decode source-copy source-prepare source-scan
                      artifact-publication artifact-validation payload-encoding ffi-result-copy))
          (when (and (not (eq? name 'lexical-rejection)) (not (assq 'command-recognition stages)))
            (error "missing command recognition stage" name lane))
          (when (and (eq? name 'lexical-rejection)
                     (cdr (assq 'completed (cdr (assq 'source-scan stages)))))
            (error "lexical failure reported a completed scan" lane))
          (let-values (((scanned reused) (language-handle-scan-counts handle)))
            (when (and (eq? lane 'fresh) (positive? reused)) (error "fresh lane reused history" name))
            (write (list 'SOURCE-EDIT-STAGES name lane
                         (cons 'inclusive #t) (cons 'stages (reverse stages))
                         (cons 'scanned scanned) (cons 'reused reused)
                         (cons 'history-token-records (if scanned (+ scanned reused) 0))
                         (cons 'history-source-bytes (if scanned (u8vector-length bytes) 0))
                         (cons 'payload-bytes (u8vector-length expected))))
            (newline) (force-output)))) '(fresh session))))
;;; Separate semantic stress child; all collections arise from real parses.
;;; This control never changes GC policy or the timed benchmark samples.
(def (verify-callback-gc)
  (let* ((baseline (language-handle-count))
         (handle (register-language! bash-source-language))
         (language (bind-language-abi bash-source-language))
         (collections 0))
    (dynamic-wind void
      (lambda ()
        (for-each
         (lambda (row)
           (let* ((source (caddr row)) (bytes (string->utf8 source))
                  (expected (abi-parse-binary-payload language source))
                  (output (make-u8vector (u8vector-length expected))))
             (for-each
              (lambda (_sample)
                (let (before (f64vector-ref (##process-statistics) 6))
                  (call! handle bytes output)
                  (set! collections (+ collections
                    (- (f64vector-ref (##process-statistics) 6) before))))
                (unless (equal? output expected)
                  (error "C callback collection changed GPA1 bytes" (car row))))
              (iota 16))
             (displayln "SOURCE-CALLBACK-GC-CASE-OK " (car row)) (force-output)))
         (fixtures 1024)))
      (lambda () (release-language! handle)))
    (unless (and (positive? collections) (= baseline (language-handle-count)))
      (error "callback collection control lacks a GC receipt" collections))
    (displayln "SOURCE-CALLBACK-GC-OK collections=" collections) (force-output))
  (test-child-process-exit! 0))
(def (main . args)
  (let ((samples (if (pair? args) (string->number (car args)) 20))
        (lines (if (> (length args) 1) (string->number (cadr args)) 128)))
    (unless (and (integer? samples) (<= 2 samples 200)
                 (integer? lines) (<= 1 lines 1024))
      (error "expected samples in 2..200 and tail lines in 1..1024"))
    (let* ((baseline (language-handle-count))
           (fresh (register-language! bash-source-language))
           (session (register-language! bash-source-language))
           (language (bind-language-abi bash-source-language)))
      (dynamic-wind void
        (lambda ()
          (for-each (lambda (row) (run-case row samples fresh session language)) (fixtures lines)))
        (lambda () (release-language! fresh) (release-language! session)))
      (unless (= baseline (language-handle-count)) (error "benchmark leaked handles")))
    (displayln "SOURCE-EDIT-BENCHMARK-OK") (force-output)
    (test-child-process-exit! 0)))
