import ParserEngine.Names
import Init.Data.List.Perm

/-! The source fresh loop, including collisions and its mutable counter. The
finite search bound is proved from occupancy; it is not a runtime fuel setting.
Candidate formatting/interning has an explicit injectivity contract. -/
namespace ParserEngine.LoweringNames
open Lowering

def search [DecidableEq Name] (candidate : Nat → Name) (used : List Name) : Nat → Nat → Option Nat
  | _, 0 => none
  | counter, fuel + 1 =>
      if candidate counter ∈ used then search candidate used (counter + 1) fuel else some counter

theorem exhausted [DecidableEq Name] {candidate : Nat → Name} {used : List Name} {counter fuel}
    (empty : search candidate used counter fuel = none) :
    ∀ index ∈ List.range' counter fuel, candidate index ∈ used := by
  induction fuel generalizing counter with
  | zero => simp
  | succ fuel ih =>
      simp only [search] at empty
      split at empty
      next collision =>
        intro index member
        rw [List.range'_succ] at member
        rcases List.mem_cons.mp member with rfl | later
        · exact collision
        · exact ih empty index later
      next fresh => cases empty

theorem mapped_nodup {candidate : Nat → Name}
    (injective : ∀ a b, candidate a = candidate b → a = b) {indices : List Nat}
    (unique : indices.Nodup) : (indices.map candidate).Nodup := by
  induction indices with
  | nil => simp
  | cons head tail ih =>
      have parts := List.nodup_cons.mp unique
      apply List.nodup_cons.mpr
      constructor
      · intro member
        obtain ⟨other, present, equal⟩ := List.mem_map.mp member
        exact parts.1 (injective other head equal ▸ present)
      · exact ih parts.2

theorem search_total [DecidableEq Name] (candidate : Nat → Name)
    (injective : ∀ a b, candidate a = candidate b → a = b) (used : List Name) (counter : Nat) :
    ∃ index, search candidate used counter (used.length + 1) = some index := by
  cases result : search candidate used counter (used.length + 1) with
  | some index => exact ⟨index, rfl⟩
  | none =>
      have covered := exhausted result
      have subset : (List.range' counter (used.length + 1)).map candidate ⊆ used := by
        intro name member
        obtain ⟨index, present, rfl⟩ := List.mem_map.mp member
        exact covered index present
      have bounded := (mapped_nodup injective (List.nodup_range' (s := counter)
        (n := used.length + 1))).length_le_of_subset subset
      simp only [List.length_map, List.length_range'] at bounded
      omega

def claimed (before : Names.State Name) (candidate : Nat → Name) (owner : Owner) (index : Nat) :
    Names.State Name :=
  ⟨candidate index :: before.used, (candidate index, owner) :: before.bindings, index + 1⟩

theorem search_trace [DecidableEq Name] {candidate : Nat → Name} {before : Names.State Name}
    {fuel index} (owner : Owner) (found : search candidate before.used before.attempt fuel = some index) :
    candidate index ∉ before.used ∧ before.attempt ≤ index ∧
    Names.Trace before (claimed before candidate owner index) := by
  generalize counterEq : before.attempt = counter at found
  induction fuel generalizing before counter with
  | zero => simp [search] at found
  | succ fuel ih =>
      simp only [search] at found
      split at found
      next collision =>
        let next : Names.State Name := { before with attempt := counter + 1 }
        have nextFound : search candidate next.used next.attempt fuel = some index := found
        obtain ⟨fresh, increasing, history⟩ := ih (before := next) (counter + 1) rfl nextFound
        refine ⟨fresh, ?_, ?_⟩
        · omega
        · have retry : Names.Trace before next := by
            simpa [next, counterEq] using Names.Trace.retry (Names.Trace.refl before) collision
          have trans : ∀ {a b c : Names.State Name}, Names.Trace a b → Names.Trace b c → Names.Trace a c := by
            intro a b c first second
            induction second with
            | refl => exact first
            | retry _ occupied ih => exact .retry ih occupied
            | claim _ free ih => exact .claim ih free
          exact trans retry history
      next fresh =>
        have same : counter = index := Option.some.inj found
        subst index
        refine ⟨fresh, by omega, ?_⟩
        simpa [claimed, counterEq] using Names.Trace.claim (owner := owner) (Names.Trace.refl before) fresh

/-- Every returned allocation has a source retry/claim derivation. In contrast
to Names.Trace alone, freshness and termination are generated by the search. -/
def allocate [DecidableEq Name] (candidate : Nat → Name)
    (injective : ∀ a b, candidate a = candidate b → a = b)
    (before : Names.State Name) (owner : Owner) :
    { pair : Nat × Names.State Name //
      candidate pair.1 ∉ before.used ∧ before.attempt ≤ pair.1 ∧
      pair.2 = claimed before candidate owner pair.1 ∧ Names.Trace before pair.2 } :=
  match found : search candidate before.used before.attempt (before.used.length + 1) with
  | some index =>
      let proof := search_trace owner found
      ⟨(index, claimed before candidate owner index), proof.1, proof.2.1, rfl, proof.2.2⟩
  | none => by
      have impossible : False := by
        obtain ⟨index, success⟩ := search_total candidate injective before.used before.attempt
        rw [found] at success
        cases success
      exact False.elim impossible

end ParserEngine.LoweringNames
