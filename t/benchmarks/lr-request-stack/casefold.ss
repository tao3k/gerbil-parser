;;; Paired lookup component; this is not complete-parser CPU admission.
(import (only-in :gerbil-parser/languages/gql/parser gql-parser)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-ir)
        (only-in :gerbil-parser/src/runtime/lr-action-index
                 index-action-rows lookup-literal-action-entry lookup-casefolded-literal-action-entry)
        (only-in :gerbil-parser/t/benchmarks/parser-stage-cost/benchmark
                 measure-parser-batch sample-at-percentile))
(export benchmark-lr-casefold)
(def (field row key) (cdr (assq key row)))
(def (benchmark-lr-casefold (groups 20) (iterations 20))
  (unless (and (exact-integer? groups) (positive? groups)
               (exact-integer? iterations) (positive? iterations))
    (error "casefold benchmark requires positive integral counts"))
  (let* ((spec (cdr (assq 'lr-spec (parser-machine-ir gql-parser))))
         (actions (cdr (assq 'actions spec)))
         (rows (index-action-rows actions #t)))
    (for-each
     (lambda (width)
       (let* ((source (string-append "identifier_" (make-string width #\x)))
              (reference (lambda ()
                           (let loop ((state 0) (count 0))
                             (if (= state (vector-length rows)) count
                               (loop (+ state 1)
                                (+ count (if (lookup-literal-action-entry (vector-ref rows state) (string-upcase source)) 1 0)))))))
              (candidate (lambda ()
                           (let loop ((state 0) (count 0))
                             (if (= state (vector-length rows)) count
                               (loop (+ state 1)
                                (+ count (if (lookup-casefolded-literal-action-entry (vector-ref rows state) source) 1 0)))))))
              (expected (reference)) (observations '()))
         (unless (= expected (candidate)) (error "casefold product mismatch" width))
         ;; Establish entry identity independently, not just the result count.
         (let loop ((state 0))
           (when (< state (vector-length rows))
             (unless (eq? (lookup-literal-action-entry (vector-ref rows state) (string-upcase source))
                          (lookup-casefolded-literal-action-entry (vector-ref rows state) source))
               (error "casefold entry mismatch" state width))
             (loop (+ state 1))))
         (##gc)
         (let loop ((group 0))
           (when (< group groups)
             (let* ((order (if (even? group) '(reference candidate candidate reference) '(candidate reference reference candidate)))
                    (batches (map (lambda (variant)
                                    (cons variant
                                      (measure-parser-batch (list 'casefold width variant) group
                                        (* iterations (vector-length rows))
                                        (if (eq? variant 'reference) reference candidate) expected
                                        (vector-length rows)))) order))
                    (sum (lambda (variant key)
                           (apply + (map (lambda (batch) (field (cdr batch) key))
                                     (filter (lambda (batch) (eq? (car batch) variant)) batches))))))
               (let (observation (list (cons 'sample group)
                                      (cons 'cpu-ratio (/ (sum 'candidate 'cpu-ms) (sum 'reference 'cpu-ms)))
                                      (cons 'batches batches)))
                 (set! observations (cons observation observations))
                 (write (list 'LR-CASEFOLD-PAIR width observation)) (newline) (force-output)))
             (loop (+ group 1))))
         (let ((p10 (field (sample-at-percentile observations 'cpu-ratio 10) 'cpu-ratio))
               (p50 (field (sample-at-percentile observations 'cpu-ratio 50) 'cpu-ratio))
               (p90 (field (sample-at-percentile observations 'cpu-ratio 90) 'cpu-ratio)))
           (write (list 'LR-CASEFOLD-SUMMARY width 'states (vector-length rows)
                        'groups groups 'iterations iterations 'cpu-ratio-p10 p10 'cpu-ratio-p50 p50
                        'cpu-ratio-p90 p90 'lookup-benefit (< p90 0.95)))
           (newline) (force-output))))
     '(32 256)))
  (displayln "LR-CASEFOLD-OK") (force-output))
