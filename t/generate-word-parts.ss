#!/usr/bin/env gxi
;;; Independent Rust recognition controls executed by the actual Scheme Word engine.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!)
        (only-in :clan/poo/object .o .ref)
        (only-in :gerbil-parser/t/fixtures/bash-products bash-results bash-parts bash-word-regions bash-parameter-binding)
        (only-in :gerbil-parser/src/compiler/rust-scanner part-profile-rust-source)
        (only-in :gerbil-parser/src/compiler/rust-runtime result-profile-rust-source)
        (only-in :gerbil-parser/src/language/result-profile compile-result-profile result-plan-recipe)
        (only-in :gerbil-parser/src/language/part-profile compile-part-profile)
        (only-in :gerbil-parser/src/runtime/region-scanner prepare-region-plan region-plan-specification)
        (only-in :gerbil-parser/src/runtime/shell-word make-shell-word-parser)
        (only-in :gerbil-parser/src/runtime/token make-token token? token-kind token-start token-end)
        (only-in :gerbil-parser/src/runtime/recognition recognition-node-kind recognition-node-start recognition-node-end
                 recognition-node-children recognition-child-field recognition-child-value))
(def controls
 '((word "") (word "α😀") (word "'α😀'") (word "\"α${x:-中}\"") (word "$'a\\n'")
   (word "${arr[${i:-1}]:-λ}") (word "$(echo α)") (word "$((1+2))") (word "<(echo 中)")
   (word "`echo α`") (word "$x\\α") (assignment "name+=\"α${x:-中}\"") (here "α${x:-中}\\\n")
   (word "$😀") (word "$?") (word "${#}") (word "${!arr[@]}") (word "${x:-${y:-λ}}")
   (word "${x[1[2]]:=中}") (word "${x[${y:-[}]:-λ}") (word "${x//α/β}") (word "${123:-α}")
   (word "\\") (word "a\\😀b") (word "\"a\\$x\\q\"") (word "$'a\\😀b'") (word "a$(echo 中)b${x}c")
   (here "'raw\"text") (here "\\x\\α\\$x") (here "$(echo α)\n${x:-λ}") (here "\\`x\\\n")
   (assignment "α_2=😀") (assignment "name=α${x[0]:-中}") (assignment "name=")
   (assignment "name") (assignment "1name=α") (assignment "α-β=中")
   (word "'") (word "\"unterminated") (word "${") (word "$(") (word "$((1)")
   (word "${x[0}") (assignment "name='bad") (here "${x")
   (word "λ{！arr［λ{i→中}]→😀}") (word "«αλ{x→中}«") (word "※😀tail")
   (word "λ{x→λ{y→中}}") (word "λ{x［0]→中}") (word "λ{x［0}")
   (word "a$😀$x") (here "literal※😀«raw") (word "λ{！}") (word "λ{！x→α}")))
(def generic-binding (.o (:: self bash-parameter-binding) prefixes: '("！") operators: '("→") subscript: '("［" #\])))
(def generic-parts
 (.o (:: self bash-parts)
     bindings: (map (lambda (row) (if (eq? (car row) 'parameter) (cons 'parameter generic-binding) row)) (.ref bash-parts 'bindings))
     rules: (append '(((word) (prefix "$" next) (name SimpleParameter simple))
                       ((word DoubleQuoted HereDocument) (prefix "λ{" any) (parameter))
                       ((word) (prefix "«" any) (quote DoubleQuoted 1 1 #\«))
                       ((word) (prefix "※" any) (escape EscapeSequence))) (map (lambda (row) (if (string=? (cadadr row) "$")
                         (cons (remq 'word (car row)) (cdr row)) row)) (.ref bash-parts 'rules)))))
(def generic-regions
 (let (data (region-plan-specification bash-word-regions))
   (prepare-region-plan (list (car data) (append (cadr data) '((#\« #t ("λ{"))))
                             (append (caddr data) '(("λ{" #\{ #\} 1))) (cadddr data)))))
(def (index-of values predicate)
 (let loop ((values values) (at 0))
  (cond ((null? values) (error "unknown result kind")) ((predicate (car values)) at)
        (else (loop (cdr values) (+ at 1))))))
(def (main output)
 (let* ((results (compile-result-profile bash-results)) (recipe (result-plan-recipe results))
        (nodes (car recipe)) (terminals (cadr recipe)) (count 0))
  (def (node-id kind) (index-of nodes (lambda (row) (eq? (car row) kind))))
  (def (token-id kind) (+ (length nodes) (index-of terminals (lambda (value) (eq? value kind)))))
  (def (events port value)
   (if (token? value)
    (begin (display "TreeEvent::Token {kind: " port) (display (token-id (token-kind value)) port)
     (display ", start: " port) (display (token-start value) port) (display ", end: " port)
     (display (token-end value) port) (display "}," port))
    (begin (display "TreeEvent::StartNode(" port) (display (node-id (recognition-node-kind value)) port) (display ")," port)
     (for-each (lambda (child) (events port (recognition-child-value child))) (recognition-node-children value))
     (display "TreeEvent::FinishNode," port))))
  (def (fields port node)
   (for-each (lambda (child)
    (display "(" port) (write (symbol->string (recognition-node-kind node)) port) (display "," port)
    (write (symbol->string (recognition-child-field child)) port) (display ")," port)
    (unless (token? (recognition-child-value child)) (fields port (recognition-child-value child))))
    (recognition-node-children node)))
  (call-with-output-file output (lambda (port)
   (display "// @generated by Scheme Word recognition; do not edit.\n" port)
   (display "pub struct Control { pub mode: &'static str, pub source: &'static str, pub start: usize, pub end: usize, pub status: u8, pub events: &'static [gerbil_parser_runtime::TreeEvent], pub fields: &'static [(&'static str,&'static str)] }\n" port)
   (for-each (lambda (entry)
    (let* ((name (car entry)) (parts (cadr entry)) (regions (caddr entry)))
     (display "pub mod " port) (display name port) (display " {\nuse gerbil_parser_runtime::TreeEvent;\n" port)
     (display (result-profile-rust-source results) port)
     (display (part-profile-rust-source parts results regions) port)
     (display "pub static CONTROLS: &[super::Control] = &[\n" port)
     (let-values (((word assignment here) (make-shell-word-parser regions results (compile-part-profile parts))))
      (for-each (lambda (control)
       (let* ((text (cadr control)) (start (u8vector-length (string->utf8 "前:")))
              (end (+ start (u8vector-length (string->utf8 text))))
              (parser (case (car control) ((word) word) ((assignment) assignment) ((here) here)))
              (outcome (with-catch (lambda (_) 'rejected)
                        (lambda () (let-values (((node tokens) (parser (make-token 'word text start end)))) node)))))
        (display "super::Control { mode: " port) (write (symbol->string (car control)) port)
        (display ", source: " port) (write (string-append "前:" text ":尾") port)
        (display ", start: " port) (display start port) (display ", end: " port) (display end port)
        (display ", status: " port) (display (cond ((eq? outcome 'rejected) 0) (outcome 1) (else 2)) port)
        (display ", events: &[" port) (when (and outcome (not (eq? outcome 'rejected))) (events port outcome))
        (display "], fields: &[" port) (when (and outcome (not (eq? outcome 'rejected))) (fields port outcome))
        (display "] },\n" port) (set! count (+ count 1)))) controls))
     (display "];\n}\n" port)))
    (list (list "bash" bash-parts bash-word-regions) (list "generic" generic-parts generic-regions)))))
  (displayln "WORD-PARTS-RUST-GENERATED controls=" count) (force-output) (test-child-process-exit! 0)))
