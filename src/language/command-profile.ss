;;; Closed command token roles and node projections prepare once per source engine.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in ../grammar/lexical-algebra text-profile-data)
        (only-in ../runtime/scan make-text-profile-scanner)
        (only-in ../runtime/token token-kind token-lexeme token-start token-end)
        (only-in ./result-profile result-plan-catalog))
(export command-node-schemas CommandProfile. defcommand-profile compile-command-profile admit-command-plan
        command-plan-recipe command-plan-role-matcher command-plan-token? command-plan-text? command-plan-kind command-plan-forms command-plan-match-form command-plan-trigger?)
(def +command-shapes+ '(
  (Redirection descriptor operator target)
  (ArrayAssignment assignment open close separator element)
  (SimpleCommand assignment name argument redirect)
  (CommandList command separator here-document)
  (IfCommand keyword condition body else-body)
  (WhileCommand keyword condition body)
  (UntilCommand keyword condition body)
  (ForCommand keyword header variable item separator body)
  (SelectCommand keyword header variable item separator body)
  (ArithmeticForCommand keyword header variable item separator body)
  (CaseCommand keyword subject separator clause)
  (CaseClause open pattern alternate close body terminator)
  (FunctionDefinition keyword name open close body)
  (ConditionalCommand open close operator operand)
  (ArithmeticCommand open close expression operator)
  (RedirectedCommand command redirect)
  (BraceGroup open body close)
  (Subshell open body close)
  (Pipeline keyword option negate command operator)
  (AndOrList command operator)
  (HereDocument delimiter content)
  (BashFile command separator here-document)
))
(def (command-node-schemas)
  (map (lambda (row) (list (car row) (map values (cdr row)))) +command-shapes+))
(def CommandProfile. (.o roles: '() texts: '() forms: '()
                        projections: (map (lambda (shape) (list (car shape) (car shape))) +command-shapes+)))
(def +command-roles+ '(trivia separator redirect here-redirect strip-redirect reserved conditional-operator pipeline and-or case-end))
(defstruct command-plan (recipe-field roles texts projections dispatch fallback))
(def (copy-data value)
  (cond ((pair? value) (cons (copy-data (car value)) (copy-data (cdr value))))
        ((string? value) (string-copy value)) (else value)))
(def (unique? values)
  (let loop ((remaining values) (seen '()))
    (or (null? remaining)
        (and (not (member (car remaining) seen)) (loop (cdr remaining) (cons (car remaining) seen))))))
(def (same-keys? rows keys)
  (and (list? rows) (andmap (lambda (row) (and (list? row) (pair? row) (symbol? (car row)))) rows)
       (unique? (map car rows)) (= (length rows) (length keys))
       (andmap (lambda (key) (assq key rows)) keys)))
(def (compile-command-profile profile)
  (unless (object? profile) (error "command profile requires a POO value"))
  (let* ((roles (copy-data (.ref profile 'roles))) (texts (copy-data (.ref profile 'texts)))
         (projections (copy-data (.ref profile 'projections)))
         (forms (copy-data (.ref profile 'forms)))
         (role-index (make-hash-table-eq)) (text-index (make-hash-table-eq)) (projection-index (make-hash-table-eq)))
    (unless (and (same-keys? roles +command-roles+) (same-keys? texts '(descriptor))
                 (same-keys? projections (map car +command-shapes+)))
      (error "command profile requires every closed role and projection exactly once"))
    (for-each (lambda (row)
      (let (kinds (make-hash-table-eq))
        (unless (and (pair? (cdr row)) (andmap (lambda (clause)
          (and (list? clause) (pair? clause) (symbol? (car clause))
               (andmap (lambda (literal) (and (string? literal) (> (string-length literal) 0))) (cdr clause))
               (unique? (cdr clause)))) (cdr row)) (unique? (map car (cdr row))))
          (error "invalid command token role" (car row)))
        (for-each (lambda (clause)
          (let (index (make-table test: equal?))
            (for-each (lambda (literal) (hash-put! index literal #t)) (cdr clause))
            (hash-put! kinds (car clause) (if (null? (cdr clause)) #t index)))) (cdr row))
        (hash-put! role-index (car row) kinds))) roles)
    (for-each (lambda (row)
      (unless (= (length row) 2) (error "invalid command text profile" row))
      (hash-put! text-index (car row) (make-text-profile-scanner (cadr row)))) texts)
    (for-each (lambda (row)
      (unless (and (= (length row) 2) (symbol? (cadr row))) (error "invalid command projection" row))
      (hash-put! projection-index (car row) (cadr row))) projections)
    (let-values (((dispatch fallback) (prepare-command-forms forms)))
      (make-command-plan (list roles texts projections forms) role-index text-index projection-index dispatch fallback))))
(def (command-plan-recipe plan) (copy-data (command-plan-recipe-field plan)))
(def (command-plan-kind plan role)
  (or (hash-get (command-plan-projections plan) role) (error "undeclared command projection" role)))
(def (command-plan-role-matcher plan role)
  (let (kinds (or (hash-get (command-plan-roles plan) role) (error "undeclared command role" role)))
    (lambda (token)
      (and token (let (accepted (hash-get kinds (token-kind token)))
                   (and accepted (or (eq? accepted #t) (hash-get accepted (token-lexeme token)))))))))
(def (command-plan-token? plan role token) ((command-plan-role-matcher plan role) token))
(def (command-plan-text? plan role text)
  (let* ((scanner (or (hash-get (command-plan-texts plan) role) (error "undeclared command text role" role)))
         (end (scanner text 0)))
    (and end (= end (string-length text)))))
(def (admit-command-plan plan results scanner)
  (let* ((catalog (result-plan-catalog results)) (nodes (cdr (assq 'syntax-kinds catalog)))
         (tokens (map car (cdr (assq 'terminals catalog)))) (scanner-tokens (.ref scanner 'tokens)))
    (for-each (lambda (shape)
      (let* ((kind (command-plan-kind plan (car shape))) (entry (assq kind nodes)))
        (unless (and entry (andmap (lambda (field) (memq field (caddr entry))) (cdr shape)))
          (error "command projection disagrees with result fields" (car shape) kind)))) +command-shapes+)
    (for-each (lambda (row)
      (for-each (lambda (clause)
        (unless (and (memq (car clause) tokens) (memq (car clause) scanner-tokens))
          (error "command role uses an undeclared scanner terminal" (car row) (car clause)))) (cdr row)))
      (car (command-plan-recipe-field plan)))
    plan))

;;; Programs are closed data: no procedures, foreign references or nullable loops.
(def (valid-command-trigger? trigger (depth 0))
  (and (< depth 32) (list? trigger) (pair? trigger)
    (case (car trigger)
      ((none) (null? (cdr trigger)))
      ((manual) (or (null? (cdr trigger))
                    (and (= (length trigger) 2) (valid-command-trigger? (cadr trigger) (+ depth 1))
                         (memq (car (cadr trigger)) '(word operator)))))
      ((role) (and (= (length trigger) 2) (memq (cadr trigger) +command-roles+)))
      ((or lookahead adjacent)
       (and (pair? (cdr trigger))
            (andmap (lambda (item) (valid-command-trigger? item (+ depth 1))) (cdr trigger))
            (or (eq? (car trigger) 'or)
                (and (<= (length (cdr trigger)) 32)
                     (andmap (lambda (item) (memq (car item) '(word operator))) (cdr trigger))))))
      ((word operator newline)
       (andmap (lambda (literal) (and (string? literal) (> (string-length literal) 0))) (cdr trigger)))
      (else #f))))
(def (command-fields kind)
  (or (assq kind +command-shapes+) (error "unknown command node role" kind)))
(def (validate-command-program program kind forms (depth 0))
  (unless (and (< depth 128) (list? program)) (error "invalid command program depth or body" kind))
  (def (field! field)
    (unless (memq field (cdr (command-fields kind))) (error "command program uses a foreign field" kind field)))
  (def (trigger! value)
    (unless (valid-command-trigger? value) (error "invalid command trigger" value)))
  (def (body steps (owner kind)) (validate-command-program steps owner forms (+ depth 1)))
  (let loop ((remaining program) (minimum 0))
    (if (null? remaining) minimum
      (let* ((step (car remaining)) (width
       (begin
        (unless (and (list? step) (pair? step)) (error "invalid command operation" step))
        (case (car step)
          ((raw word command)
           (unless (= (length step) 2) (error "invalid command leaf operation" step)) (field! (cadr step)) 1)
          ((take)
           (unless (= (length step) 3) (error "invalid command take operation" step))
           (field! (cadr step)) (trigger! (caddr step)) 1)
          ((list)
           (unless (and (= (length step) 4) (boolean? (cadddr step))) (error "invalid command list operation" step))
           (field! (cadr step)) (trigger! (caddr step)) (if (cadddr step) 0 1))
          ((call)
           (unless (and (= (length step) 3) (symbol? (caddr step)) (assq (caddr step) forms))
             (error "undeclared command form reference" step)) (field! (cadr step)) 1)
          ((node)
           (unless (and (>= (length step) 3) (symbol? (caddr step))) (error "invalid command node operation" step))
           (field! (cadr step)) (command-fields (caddr step)) (body (cdddr step) (caddr step)))
          ((as)
           (unless (and (= (length step) 2) (symbol? (cadr step))) (error "invalid command projection branch" step))
           (unless (andmap (lambda (field) (memq field (cdr (command-fields (cadr step)))))
                          (cdr (command-fields kind))) (error "branch projection loses fields" step)) 0)
          ((optional many until)
           (unless (>= (length step) 2) (error "invalid command repetition" step))
           (trigger! (cadr step))
           (let (consumed (body (cddr step)))
             (when (and (memq (car step) '(many until)) (zero? consumed))
               (error "command repetition requires a consuming body" step))) 0)
          ((branch)
           (unless (= (length step) 4) (error "invalid command branch" step)) (trigger! (cadr step))
           (min (body (caddr step)) (body (cadddr step))))
          ((choose)
           (unless (pair? (cdr step)) (error "empty command choice" step))
           (apply min (map (lambda (row)
             (unless (and (list? row) (pair? row)) (error "invalid command choice row" row))
             (trigger! (car row)) (body (cdr row))) (cdr step))))
          ((balance)
           (unless (and (>= (length step) 6) (exact-integer? (list-ref step 3))
                        (> (list-ref step 3) 0)) (error "invalid balanced command body" step))
           (trigger! (cadr step)) (trigger! (caddr step))
           (field! (list-ref step 4)) (field! (list-ref step 5))
           (when (zero? (body (list-tail step 6))) (error "balanced body must consume input" step)) 1)
          (else (error "unregistered command operation" (car step)))))))
       (loop (cdr remaining) (+ minimum width))))))
(def (prepare-command-forms forms)
  (unless (and (list? forms) (pair? forms)
               (andmap (lambda (row) (and (list? row) (>= (length row) 4) (symbol? (car row)))) forms)
               (unique? (map car forms))) (error "invalid or duplicate command forms"))
  (let ((dispatch (make-hash-table-eq)) (fallback '()))
    (for-each (lambda (row)
      (let ((trigger (cadr row)) (priority (caddr row)) (kind (cadddr row)))
        (unless (and (valid-command-trigger? trigger) (exact-integer? priority) (<= 0 priority 1000))
          (error "invalid command form selector" (car row)))
        (command-fields kind)
        (when (and (not (eq? (car trigger) 'manual))
                   (zero? (validate-command-program (list-tail row 4) kind forms)))
          (error "command form must consume input" (car row)))
        (case (car trigger)
          ((manual) #t)
          ((word operator)
           (unless (pair? (cdr trigger)) (error "entry selectors require literal tokens" (car row)))
           (let (index (or (hash-get dispatch (car trigger))
                          (let (table (make-table test: equal?)) (hash-put! dispatch (car trigger) table) table)))
             (for-each (lambda (literal)
               (when (hash-get index literal) (error "ambiguous command form literal" literal))
               (hash-put! index literal row)) (cdr trigger))))
          ((lookahead adjacent)
           (when (ormap (lambda (candidate) (equal? (cadr candidate) trigger)) fallback)
             (error "duplicate command lookahead selector" trigger))
           (set! fallback (cons row fallback)))
          (else (error "unregistered command entry selector" trigger))))) forms)
    ;; Manual calls cannot form a cycle: they run before an input-dependent command dispatch.
    (def colors (make-hash-table-eq))
    (def (visit id)
      (case (hash-get colors id)
        ((visiting) (error "cyclic command form call" id))
        ((done) #t)
        (else
         (hash-put! colors id 'visiting)
         (let walk ((data (list-tail (assq id forms) 4)))
           (when (pair? data)
             (when (eq? (car data) 'call) (visit (caddr data)))
             (walk (car data)) (walk (cdr data))))
         (hash-put! colors id 'done))))
    (for-each (lambda (row) (visit (car row))) forms)
    (for-each (lambda (entry)
      (let (row (assq (car entry) forms))
        (unless (and row (eq? (caadr row) 'manual) (eq? (cadddr row) (cadr entry)))
          (error "missing or invalid manual command entrypoint" (car entry)))))
      '((array-tail ArrayAssignment) (pipeline-prefix Pipeline)))
    (let* ((header (assq 'pipeline-prefix forms)) (array (assq 'array-tail forms)))
      ;; A nullable header is a guarded sequence. Its FIRST set can skip the VM
      ;; for ordinary commands without changing publication or projection.
      (unless (andmap (lambda (step)
                        (and (memq (car step) '(optional many))
                             (> (validate-command-program (cddr step) 'Pipeline forms) 0)))
                      (list-tail header 4))
        (error "pipeline header requires guarded consuming operations"))
      (when (zero? (validate-command-program (list-tail array 4) 'ArrayAssignment forms))
        (error "array command body must consume input")))
    (let walk ((data forms))
      (when (pair? data)
        (when (eq? (car data) 'call)
          (let (target (assq (caddr data) forms))
            (when (zero? (validate-command-program (list-tail target 4) (cadddr target) forms))
              (error "command call requires a consuming target" (caddr data)))))
        (walk (car data)) (walk (cdr data))))
    (values dispatch fallback)))
(def (command-plan-forms plan) (copy-data (list-ref (command-plan-recipe-field plan) 3)))
(def (command-plan-trigger? plan trigger tokens)
  (let (token (and (pair? tokens) (car tokens)))
    (case (car trigger)
      ((none) #f)
      ((manual) (and (pair? (cdr trigger)) (command-plan-trigger? plan (cadr trigger) tokens)))
      ((role) (command-plan-token? plan (cadr trigger) token))
      ((or) (ormap (lambda (choice) (command-plan-trigger? plan choice tokens)) (cdr trigger)))
      ((lookahead adjacent)
       (let loop ((matchers (cdr trigger)) (remaining tokens) (previous #f))
         (if (null? matchers) #t
           (let skip ((rest remaining))
             (if (and (eq? (car trigger) 'lookahead) (pair? rest)
                      (command-plan-token? plan 'trivia (car rest))) (skip (cdr rest))
               (and (pair? rest)
                    (or (not previous) (not (eq? (car trigger) 'adjacent))
                        (= (token-end previous) (token-start (car rest))))
                    (command-plan-trigger? plan (car matchers) rest)
                    (loop (cdr matchers) (cdr rest) (car rest))))))))
      (else (and token (eq? (token-kind token) (car trigger))
                 (or (null? (cdr trigger)) (and (member (token-lexeme token) (cdr trigger)) #t)))))))
(def (command-plan-match-form plan tokens)
  (let* ((token (and (pair? tokens) (car tokens)))
         (index (and token (hash-get (command-plan-dispatch plan) (token-kind token))))
         (literal (and index (hash-get index (token-lexeme token)))))
    (let loop ((remaining (command-plan-fallback plan)) (selected literal))
      (if (null? remaining) (and selected (car selected))
        (let (candidate (car remaining))
          (loop (cdr remaining)
            (if (and (or (not selected) (> (caddr candidate) (caddr selected)))
                     (command-plan-trigger? plan (cadr candidate) tokens)) candidate selected)))))))
(defsyntax (defcommand-profile stx)
  (syntax-case stx (roles texts forms projections)
    ((_ (name marker self base) (roles role ...) (texts (key expression) ...) (forms form ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) roles: '(role ...) forms: '(form ...)
                     texts: (list (list 'key (text-profile-data expression)) ...))))
    ((_ (name marker self base) (roles role ...) (texts (key expression) ...) (forms form ...) (projections projection ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) roles: '(role ...) forms: '(form ...)
                     texts: (list (list 'key (text-profile-data expression)) ...)
                     projections: '(projection ...))))))
