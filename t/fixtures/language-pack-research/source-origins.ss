#!/usr/bin/env gxi
;;; -*- Gerbil -*-
(import "located-list-roles"
        (only-in "../../../src/compiler/normalize" compile-grammar/receipt)
        (only-in "../../../src/compiler/bound-ir" bind-grammar-ir bound-grammar-ir-binding))
(def checked 0)
(def (probe label actual expected)
  (unless (equal? actual expected) (error "source location mismatch" label actual expected))
  (set! checked (+ checked 1))
  (display "SOURCE-LOCATION-CASE-OK: ") (display label) (newline) (force-output))
(def (ref value key) (let (row (assq key value)) (and row (cdr row))))
(def (line-at path number)
  (call-with-input-file path
    (lambda (port)
      (let loop ((index 1))
        (let (line (read-line port))
          (when (eof-object? line) (error "source line absent" path number))
          (if (= index number) line (loop (+ index 1))))))))
(def (source-token origin expected)
  (let* ((start (ref origin 'start))
         (line (line-at (ref origin 'path) (ref start 'line)))
         (offset (- (ref start 'column) 1)))
    (substring line offset (+ offset (string-length expected)))))
(let-values (((grammar receipt) (compile-grammar/receipt (make-located-list-grammar))))
  (def located-study-bound-grammar-ir
    (bind-grammar-ir grammar "located-list-roles" '(deflocated-list)
      (located-list-source-map receipt)))
(for-each
 (lambda (case)
   (let* ((entry (car case)) (helper (cadr case)) (owner (caddr case))
          (binding (bound-grammar-ir-binding located-study-bound-grammar-ir 'rule helper))
          (source (ref binding 'source))
          (author (ref source 'authorOrigin)) (template (ref source 'templateOrigin)))
     (probe (list 'owner helper) (ref source 'componentOwner) owner)
     (probe (list 'generated helper) (ref source 'generated?) #t)
     (probe (list 'author-token helper) (source-token author (symbol->string owner))
       (symbol->string owner))
     (probe (list 'template-token helper) (source-token template "(defsyntax")
       "(defsyntax")
     (probe (list 'author-and-template-distinct helper)
       (equal? (ref author 'path) (ref template 'path)) #f)
     (probe (list 'entry-and-helper-share-origin entry)
       (ref (bound-grammar-ir-binding located-study-bound-grammar-ir 'rule entry) 'source) source)))
 '((arguments call-arguments/tail call-arguments)
   (elements array-elements/tail array-elements))))
(display "SOURCE-ORIGINS-OK: ") (display checked)
(display " checks passed") (newline) (force-output)
(exit 0)
