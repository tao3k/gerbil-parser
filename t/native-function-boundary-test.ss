;;; -*- Gerbil -*-
;;; Real callbacks cross native Function boundaries, including nested results.
(import :gerbil-parser/language-test-support
        (only-in :clan/poo/object .o .cc .ref .get .call)
        (only-in "../init.ss" gerbil-parser.init.exports)
        (only-in :clan/poo/mop validate TypeError? define-type Type. element?)
        (only-in :clan/poo/type Record Symbol String OrFalse)
        (only-in :gerbil-parser/graph-query-support
                 GraphQueryViewContract make-graph-query-context graph-query-map graph-query-select)
        (only-in :gerbil-parser/src/graph/graph-query-objects graph-query-context-view)
        (only-in :gerbil-parser/src/runtime/source-scanner
                 make-source-scanner source-scanner-initial-state source-scanner-step source-scan-state-with-context)
        (only-in :gerbil-parser/src/runtime/function-types ActionSelectorFactory)
        (only-in :gerbil-parser/src/runtime/token make-token token-kind))
(defstruct scanner-context (label) transparent: #t)
(define-type (ScannerContext @ Type.)
  .element?: (lambda (v) (and (scanner-context? v) (element? String (scanner-context-label v)))))
(def GraphRow (Record id: [Symbol] parent: [(OrFalse Symbol)] kind: [Symbol]))
(deflanguage-parser-tests native-function-boundary-test "native parser Function boundaries"
  (engine)
    (scenario "graph admission retains checked callbacks and never executes them"
      (sequential ((calls 0)
             (view (.o records: '()
                       id-of: (lambda (record) (set! calls (+ calls 1)) (.ref record 'id))
                       parent-of: (lambda (record) (.ref record 'parent))
                       kind-of: (lambda (record) (.ref record 'kind))))
             (checked (validate (GraphQueryViewContract GraphRow Symbol Symbol) view)))
        (equal calls 0)
        (raises ((.ref checked 'id-of) 42) TypeError?)
        (equal calls 0)
        (equal ((.ref checked 'id-of) (.o id: 'a parent: #f kind: 'node)) 'a)
        (equal calls 1)
        (raises (validate (GraphQueryViewContract GraphRow Symbol Symbol) (.cc view 'id-of 42)) TypeError?)))
    (scenario "context owns its admitted view and Scheme truth-value predicates"
      (sequential ((record (.o id: 'root parent: #f kind: 'node))
             (raw (.o records: (list record) id-of: (lambda (r) (.ref r 'id))
                      parent-of: (lambda (r) (.ref r 'parent))
                      kind-of: (lambda (r) (.ref r 'kind))))
             (context (make-graph-query-context GraphRow Symbol Symbol raw)))
        (raises ((.ref (graph-query-context-view context) 'kind-of) 42) TypeError?)
        (equal (graph-query-map context 'node (lambda (_) '(truthy))) (list record))
        (raises (graph-query-map context 'node 42) TypeError?)))
    (scenario "scanner checks multiple results and preserves progress invariants"
      (sequential ((worker (make-source-scanner (OrFalse Symbol) Symbol "x" 'state
                       (lambda (_source offset context _mode)
                         (values 'word (+ offset 1) context))))
             (state (source-scanner-initial-state worker)))
        (scope-values (((token next) (source-scanner-step worker state 'mode)))
          (equal (token-kind token) 'word)))
      (each (step) ((list (lambda _ (values 42 1 #f))
                         (lambda _ (values 'word -1 #f))
                         (lambda _ (values 'word 1))
                         (lambda _ (values))
                         (lambda _ (values 'word 1 #f 'extra))
                         (lambda _ (values 'word 1 42))))
        (scope ((worker (make-source-scanner (OrFalse Symbol) Symbol "x" #f step)))
          (raises (source-scanner-step worker (source-scanner-initial-state worker) 'mode)
                  TypeError?)))
      (scope ((worker (make-source-scanner (OrFalse Symbol) Symbol "x" #f (lambda _ (values 'word 0 #f)))))
        (raises (source-scanner-step worker (source-scanner-initial-state worker) 'mode)
                error?)))
    (scenario "caller struct Context and Mode Types reject mismatches without swallowing exceptions"
      (sequential ((context (make-scanner-context "source"))
          (worker (make-source-scanner ScannerContext Symbol "x" context
                    (lambda (_source offset state _mode) (values 'word (+ offset 1) state))))
          (initial (source-scanner-initial-state worker)))
        (scope-values (((token next) (source-scanner-step worker initial 'mode)))
          (equal (token-kind token) 'word))
        (raises (source-scanner-step worker initial 42) TypeError?)
        (raises (source-scan-state-with-context initial 'other) TypeError?)
        (raises (make-source-scanner ScannerContext Symbol "x" (make-scanner-context 42) (lambda _ (values))) TypeError?))
      (scope ((worker (make-source-scanner (OrFalse Symbol) Symbol "x" #f (lambda _ (raise 'scanner-original-failure)))))
        (equal (with-catch (lambda (e) (eq? e 'scanner-original-failure))
          (lambda () (source-scanner-step worker (source-scanner-initial-state worker) 'mode) #f)) #t)))
    (scenario "graph row, identity, kind and query parameters have selected Types"
      (sequential ((record (.o id: 'root parent: #f kind: 'node))
          (view (.o records: (list record) id-of: (lambda (r) (.ref r 'id))
                   parent-of: (lambda (r) (.ref r 'parent)) kind-of: (lambda (r) (.ref r 'kind))))
          (context (make-graph-query-context GraphRow Symbol Symbol view)))
        (raises (make-graph-query-context GraphRow Symbol Symbol (.cc view 'id-of (lambda (_) 42))) TypeError?)
        (raises (make-graph-query-context GraphRow Symbol Symbol (.cc view 'parent-of (lambda (_) 42))) TypeError?)
        (raises ((.ref (graph-query-context-view context) 'kind-of) (.o id: 'root parent: #f kind: 42)) TypeError?)
        (raises (graph-query-map context 42 (lambda (_) #t)) TypeError?)
        (equal (graph-query-map context 'node (lambda (_) #f)) '())
        (raises (graph-query-select context 'node 'root 'any '() 42) TypeError?)
        (equal (graph-query-select context 'node 'root 'any '() (lambda (_) '(truthy))) (list record))
        (scope ((wrong-kind (make-graph-query-context GraphRow Symbol Symbol
                      (.cc view 'kind-of (lambda (_) 42)))))
          (raises (graph-query-map wrong-kind 'node (lambda (_) #t)) TypeError?))))
    (scenario "selector result is an LR entry rather than an arbitrary Scheme value"
      (each (answer) ((list 42 '(accept) '((terminal eof) shift -1)
                           '((terminal token 42) accept) '((terminal eof) accept extra)
                           '((terminal eof) fork (shift 0) (unknown))))
        (scope ((selector ((validate ActionSelectorFactory (lambda _ (lambda _ answer))) '#() '#() #f #f)))
          (raises (selector 0 #f) TypeError?)))
      (raises ((validate ActionSelectorFactory (lambda _ (lambda _ #f))) '#(42) '#() #f #f) TypeError?)
      (raises ((validate ActionSelectorFactory (lambda _ (lambda _ #f))) '#() '#(42) #f #f) TypeError?))
    (scenario "actual shift actions retain precedence metadata"
      (each (precedence) ('(#f (none 0) (left 2) (right -1) (dynamic 3)))
        (sequential ((answer (list '(terminal token word) 'shift 1 precedence))
                (selector ((validate ActionSelectorFactory (lambda _ (lambda _ answer))) '#() '#() #f #f)))
          (equal (selector 0 #f) answer)))
      (each (answer) ('(((terminal token word) shift 1)
                        ((terminal token word) shift 1 opaque)
                        ((terminal token word) shift 1 (left "2"))))
        (scope ((selector ((validate ActionSelectorFactory (lambda _ (lambda _ answer))) '#() '#() #f #f)))
          (raises (selector 0 #f) TypeError?))))
    (scenario "cyclic action branches do not become a selector result"
      (sequential ((branch (list 'fork #f)))
        (act (set-car! (cdr branch) branch))
        (scope ((selector ((validate ActionSelectorFactory
                    (lambda _ (lambda _ (cons '(terminal eof) branch)))) '#() '#() #f #f)))
          (raises (selector 0 #f) TypeError?))))
    (scenario "selector factories validate the returned callback before retaining it"
      (sequential ((calls 0)
             (factory (validate ActionSelectorFactory
                        (lambda (_rows _index _fold? _layout?)
                          (lambda (state token) (set! calls (+ calls 1)) '((terminal eof) accept)))))
             (selector (factory '#() '#() #f #f)))
        (equal calls 0)
        (equal (selector 2 (make-token 'word "a" 0 1)) '((terminal eof) accept))
        (raises (selector -1 #f) TypeError?)
        (raises (selector 0 'not-a-token) TypeError?)
        (equal calls 1)
        (raises ((validate ActionSelectorFactory (lambda _ 42)) '#() '#() #f #f)
                TypeError?)))
    (property "native conformance selection retains the boundary Suite"
      (bindings (covered (.get (.call (.get gerbil-parser.init.exports tests) .for-directory "t") spec)))
      (equal (and (member (path-expand "t/native-function-boundary-test.ss") covered) #t) #t)))
