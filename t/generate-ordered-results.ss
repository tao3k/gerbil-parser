#!/usr/bin/env gxi
;;; Scheme-owned lexical field order for catalog constructors used by Commands.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!)
        (only-in :gerbil-parser/languages/bash/grammar bash-results)
        (only-in :gerbil-parser/src/compiler/rust-rowan result-profile-rust-source)
        (only-in :gerbil-parser/src/language/result-profile compile-result-profile result-plan-node result-plan-recipe)
        (only-in :gerbil-parser/src/runtime/recognition make-recognition-child recognition-node-kind recognition-node-start recognition-node-end recognition-node-children recognition-child-field recognition-child-value)
        (only-in :gerbil-parser/src/runtime/token make-token token? token-kind token-start token-end))
;;; Repeated fields retain lexical order, including interleaved fields.
(def controls
 '(("abc" (SimpleCommand 0 3
           (name (Word 0 1 (part (token LiteralPart 0 1))))
           (redirect (Redirection 1 2 (operator (token operator 1 2))))
           (argument (Word 2 3 (part (token LiteralPart 2 3))))))
   ("a|b" (Pipeline 0 3
           (command (SimpleCommand 0 1 (name (Word 0 1 (part (token LiteralPart 0 1))))))
           (operator (token operator 1 2))
           (command (SimpleCommand 2 3 (name (Word 2 3 (part (token LiteralPart 2 3))))))))
   ("αβ😀" (BashFile 0 8
            (command (SimpleCommand 0 8
                      (argument (Word 0 2 (part (token LiteralPart 0 2))))
                      (name (Word 2 4 (part (token LiteralPart 2 4))))
                      (argument (Word 4 8 (part (token LiteralPart 4 8))))))))
   ("" (BashFile 0 0))))
(def (main output)
 (let* ((plan (compile-result-profile bash-results)) (recipe (result-plan-recipe plan))
        (kinds (append (map car (car recipe)) (cadr recipe))))
  (def (index value (token? #f))
   (let loop ((values (if token? (cadr recipe) (map car (car recipe)))) (at (if token? (length (car recipe)) 0))) (cond ((null? values) (error "unknown result kind" value))
     ((eq? value (car values)) at) (else (loop (cdr values) (+ at 1))))))
  (def (recognize row source)
   (if (eq? (car row) 'token)
    (make-token (cadr row) "" (caddr row) (cadddr row))
    (result-plan-node plan (car row) (cadr row) (caddr row)
     (map (lambda (child) (make-recognition-child (car child) (recognize (cadr child) source))) (cdddr row)))))
  (def (emit port node)
   (display "profile.bind_node(" port) (write (symbol->string (recognition-node-kind node)) port)
   (display ")?.build(source," port) (display (recognition-node-start node) port) (display ".." port) (display (recognition-node-end node) port)
   (display ",vec![" port)
   (for-each (lambda (child)
    (let (value (recognition-child-value child))
     (display "ResultChildCapture {field:" port) (write (symbol->string (recognition-child-field child)) port)
     (display ",value:ProjectedValue::" port)
     (if (token? value)
      (begin (display "Token {kind:" port) (display (index (token-kind value) #t) port) (display ",span:" port)
       (display (token-start value) port) (display ".." port) (display (token-end value) port) (display "}" port))
      (begin (display "Node(" port) (emit port value) (display "?)" port)))
     (display "}," port))) (recognition-node-children node))
   (display "])" port))
  (def (events port value)
   (if (token? value)
    (begin (display "TreeEvent::Token {kind:" port) (display (index (token-kind value) #t) port)
     (display ",start:" port) (display (token-start value) port) (display ",end:" port) (display (token-end value) port) (display "}," port))
    (begin (display "TreeEvent::StartNode(" port) (display (index (recognition-node-kind value)) port) (display ")," port)
     (for-each (lambda (child) (events port (recognition-child-value child))) (recognition-node-children value))
     (display "TreeEvent::FinishNode," port))))
  (call-with-output-file output (lambda (port)
   (display (result-profile-rust-source plan) port)
   (display "use gerbil_parser_rowan::{PreparedResultProfile, ProjectedNode, ResultChildCapture, ProjectedValue, Diagnostic, TreeEvent};\n" port)
   (for-each (lambda (row at)
    (let (node (recognize (cadr row) (car row)))
     (display "pub fn replay_" port) (display at port)
     (display "<'s>(profile:&PreparedResultProfile,source:&'s str)->Result<ProjectedNode<'s>,Diagnostic>{" port)
     (emit port node) (display "}\n" port))) controls (iota (length controls)))
   (display "pub static SOURCES:&[&str]=&[" port) (for-each (lambda (row) (write (car row) port) (display "," port)) controls)
   (display "];\npub static EVENTS:&[&[TreeEvent]]=&[" port)
   (for-each (lambda (row) (display "&[" port) (events port (recognize (cadr row) (car row))) (display "]," port)) controls)
   (display "];\n" port)))
  (displayln "ORDERED-RESULTS-RUST-GENERATED controls=" (length controls)) (force-output) (test-child-process-exit! 0)))
