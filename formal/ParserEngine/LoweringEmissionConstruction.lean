import ParserEngine.LoweringMixedEmission

/-! Compose actual Scheme emission scheduling with the existing retained
LeanPoo construction. The source encoder owns payload representation; this
module proves dense physical IDs, not arbitrary payload/AST normalization. -/
namespace ParserEngine.LoweringEmissionConstruction
open SchemeTableEvaluation LoweringProductionEvaluation LoweringEmitterEvaluation
open LoweringEmissionCalls

/-- Native IDs are generated by source evaluation, then related to the same
published input and retained construction product. No source-emission trace or
counter-to-record agreement is supplied as an input premise. -/
theorem retained_ids (encode : LoweringPublication.Pending → Request)
    (lowering : LoweringPublication.Sources) (sources : ConstructionConsumer.Sources)
    (metadata : LoweringPublication.Metadata) (observers : LoweringPublication.Observers)
    (pending : List LoweringPublication.Pending) (traversal : CachedConstruction.Traversal)
    (output : Σ input, ConstructionGrammar.Output input traversal)
    (built : LoweringPublication.construct lowering sources metadata observers pending traversal = some output)
    (listPrimitive : env "list" = none) (consPrimitive : env "cons" = none) (plusPrimitive : env "+" = none)
    (count : before base 0 = some (.natural 1))
    (contents : before (base + 4) 0 = some (.list [])) :
    ∃ after, Calls env base before (pending.map encode) after ∧
      after base 0 = some (.natural (pending.length + 1)) ∧
      after (base + 4) 0 = some (.list (records 1 (pending.map encode)).reverse) ∧
      (records 1 (pending.map encode)).map recordId =
        output.1.records.tail.map (fun row => some row.id) := by
  obtain ⟨after, calls, count, contents, _⟩ := source_history (pending.map encode) 1
    listPrimitive consPrimitive plusPrimitive count contents
  obtain ⟨_, returned, identity, _⟩ := LoweringPublication.constructed lowering sources metadata observers pending traversal output built
  have identifiers := LoweringPublication.successful_ids metadata observers pending returned
  rw [← identity] at identifiers
  have tailIds := congrArg List.tail identifiers
  simp only [List.range_eq_range', List.range'_succ, List.tail_cons] at tailIds
  refine ⟨after, calls, ?_, ?_, ?_⟩
  · simpa [List.length_map, Nat.add_comm] using count
  · simpa using contents
  · rw [record_ids, List.length_map, ← tailIds]
    simp only [← List.map_tail, List.map_map]
    rfl

/-- The same retained product also receives the ID projection of an actual
mixed allocation/declaration/emission trace. The concrete payload encoding is
still explicit; this theorem does not replace the raw grammar normalization. -/
theorem retained_trace_ids (encode : LoweringPublication.Pending → Request)
    (lowering : LoweringPublication.Sources) (sources : ConstructionConsumer.Sources)
    (metadata : LoweringPublication.Metadata) (observers : LoweringPublication.Observers)
    (pending : List LoweringPublication.Pending) (traversal : CachedConstruction.Traversal)
    (output : Σ input, ConstructionGrammar.Output input traversal)
    (built : LoweringPublication.construct lowering sources metadata observers pending traversal = some output)
    (run : LoweringMixedEmission.Trace env base before (pending.map encode) after)
    (listPrimitive : env "list" = none) (consPrimitive : env "cons" = none) (plusPrimitive : env "+" = none)
    (count : before base 0 = some (.natural 1))
    (contents : before (base + 4) 0 = some (.list [])) :
    after base 0 = some (.natural (pending.length + 1)) ∧
      after (base + 4) 0 = some (.list (records 1 (pending.map encode)).reverse) ∧
      (records 1 (pending.map encode)).map recordId =
        output.1.records.tail.map (fun row => some row.id) := by
  obtain ⟨count, contents⟩ := LoweringMixedEmission.publication run 1
    listPrimitive consPrimitive plusPrimitive count contents
  obtain ⟨_, _, _, _, identifiers⟩ := retained_ids encode lowering sources metadata observers
    pending traversal output built listPrimitive consPrimitive plusPrimitive
    (before := before) (base := base) (by assumption) (by assumption)
  exact ⟨by simpa [List.length_map, Nat.add_comm] using count,
    by simpa using contents, identifiers⟩

end ParserEngine.LoweringEmissionConstruction
