(import :gerbil-parser/language-test-support)
;;; Position-view iterator controls against an independent recipe interpreter.
(import :std/test
        (only-in :gerbil-parser/t/fixtures/event-iterator-extraction event-graph-certificate check-event-certificate generate-event-witness witness-callbacks extract-event-graph replay-event-graph packet-event-callbacks hybrid-event-callbacks hybrid-event-run event-program-callbacks decode-event-frame)
        :gerbil-parser/src/runtime/event-program
        (only-in :gerbil-parser/src/runtime/token make-token token-start)
        (only-in :gerbil-parser/src/runtime/recognition make-recognition-child)
        (only-in :gerbil-parser/src/runtime/funcs recognition-sequence-append
                 recognition-sequence-relocate recognition-sequence-for-each))


;; Recipes describe semantic frames independently of private rope storage.
(def (compile-recipe recipe)
  (case (car recipe)
    ((token) (cadr recipe))
    ((view) (event-program-relocate (compile-recipe (caddr recipe)) (cadr recipe)))
    ((join) (event-program-append/avl (compile-recipe (cadr recipe)) (compile-recipe (caddr recipe))))
    ((sequence) (foldl (lambda (item code) (event-program-append code (compile-recipe item))) #f (cdr recipe)))
    ((node) (event-program-node-value (cadr recipe) 0 1 (compile-recipe (caddr recipe))))
    ((field) (event-program-field (cadr recipe) 0 1 (compile-recipe (caddr recipe))))
    ((fragment) (event-program-fragment-value 0 1 (compile-recipe (cadr recipe))))))
(def (recipe-events recipe delta moved?)
  (case (car recipe)
    ((token) (list (list 'token (cadr recipe) (token-start (cadr recipe)) delta moved?)))
    ((view) (recipe-events (caddr recipe) (+ delta (cadr recipe)) #t))
    ((join) (append (recipe-events (cadr recipe) delta moved?) (recipe-events (caddr recipe) delta moved?)))
    ((sequence) (apply append (map (lambda (item) (recipe-events item delta moved?)) (cdr recipe))))
    ((node field)
     (append (list (list (if (eq? (car recipe) 'node) 'open-node 'open-field) (cadr recipe) 0 delta moved?))
             (recipe-events (caddr recipe) delta moved?)
             (list (list (if (eq? (car recipe) 'node) 'close-node 'close-field) (cadr recipe) 1 delta moved?))))
    ((fragment) (append (recipe-events (cadr recipe) delta moved?) (list (list 'boundary #f 1 delta moved?))))))
(defparser-check (check-recipe recipe)
  (scope ((program (compile-recipe recipe)) (actual '()) (inlined '()) (ids '()) (next-id 0))
    (act (event-program-walk (lambda (op name offset delta moved?)
                          (set! actual (cons (list op name offset delta moved?) actual))) program))
    (equal (reverse actual)  (recipe-events recipe 0 #f))
    (sequential ((graph (extract-event-graph program)) (ranks (event-graph-certificate graph))
           (fuel (+ 1 (if (eq? (car graph) #f) 0 (vector-ref ranks (car graph)))))
           (witness (generate-event-witness graph ranks fuel)))
      (equal (check-event-certificate graph ranks)  #t)
      (equal (not (not witness))  #t)
      (equal (generate-event-witness graph ranks 0)  #f)
      (equal (witness-callbacks witness)  (event-program-callbacks program))
      (equal (witness-callbacks witness 1)  (event-program-callbacks program 1))
      (each (cutoff) ('(0 64))
                  (equal (hybrid-event-callbacks graph cutoff 1)  (event-program-callbacks program 1))
                  (equal (hybrid-event-callbacks graph cutoff)  (event-program-callbacks program)))
      (equal (packet-event-callbacks graph 1)  (event-program-callbacks program 1))
      (equal (packet-event-callbacks graph)  (event-program-callbacks program))
      (equal (replay-event-graph graph 1)  (event-program-callbacks program 1))
      (equal (replay-event-graph graph)  (event-program-callbacks program)))
    (inline-callback (event-program-walk/inline program)
      (op name offset delta moved? context)
      (act (set! inlined (cons (list op name offset delta moved?) inlined)))
      (choose op
        ((open-node)
         (scope ((id next-id))
           (act (set! next-id (+ next-id 1)))
           (act (set! ids (cons id ids)))
           (result id)))
        ((close-node)
         (equal context (car ids))
         (act (set! ids (cdr ids))))))
    (equal ids  '())
    (equal (reverse inlined)  (reverse actual))))
(deflanguage-parser-tests event-iterator-test "position views and event rope continuations"
  (engine)
    (scenario "chunk and carry boundaries retain ordered independent sibling views"
      (each (width) ('(0 1 15 16 17 31 32 33 65 129))
         (sequential ((items (let loop ((i 0) (items '()))
                         (if (= i width) (reverse items)
                           (loop (+ i 1) (cons (list 'token (make-token 'word "x" i (+ i 1))) items)))))
                (sequence (cons 'sequence items))
                (moved (list 'view -9 (list 'view 9 sequence))))
           (verify check-recipe (list 'join moved sequence))
           (verify check-recipe (list 'view 3 (list 'join moved (list 'view -2 sequence)))))))
    (scenario "hybrid cutoffs retain native callers and fallback counter provenance"
      (sequential ((leaf (list 'token (make-token 'word "x" 0 1)))
             (nested (foldl (lambda (i body)
                              (case (modulo i 4)
                                ((0) (list 'node 'Nested body))
                                ((1) (list 'field 'value body))
                                ((2) (list 'fragment body))
                                (else (list 'view (if (even? (quotient i 4)) 9 -9) body)))) leaf (iota 67)))
             (program (compile-recipe (list 'view -9 (list 'view 9
                        (list 'node 'Outer (list 'join nested (list 'node 'Tail leaf)))))))
             (graph (extract-event-graph program)))
        (each (cutoff) ('(0 1 2 63 64 65 200))
           (each (stride) ('(1 7))
              (scope ((result (hybrid-event-run graph cutoff stride)))
                (equal (car result)  (event-program-callbacks program stride))
                (when (= cutoff 2)
                  (equal (every (lambda (fallback)
                                  (and (= (cadr fallback) 0) (eq? (caddr fallback) #t)
                                       (= (list-ref fallback 3) stride))) (cdr result))  #t))
                (branch (= cutoff 200) (equal (cdr result)  '())
                    (group (equal (pair? (cdr result))  #t)
                           (equal (every (lambda (fallback) (= (car fallback) cutoff)) (cdr result))  #t))))))))
    (scenario "actual record extraction covers layouts and detaches private instruction lists"
      (sequential ((recipe (list 'node 'Root (list 'field 'value
                      (list 'view 0 (cons 'sequence
                        (map (lambda (i) (list 'token (make-token 'word "x" i (+ i 1)))) (iota 129)))))))
             (program (compile-recipe recipe))
             (graph (extract-event-graph program))
             (tags (map car (vector->list (cdr graph)))))
        (each (tag) ('(value field view append branch chunk token)) (equal (not (not (memq tag tags)))  #t))
        (equal (event-program-inspect #f)  '#(empty))
        (raises (event-program-inspect '#(unknown)) true)
        (sequential ((tokens (map (lambda (i) (make-token 'word "x" i (+ i 1))) (iota 33)))
               (chunk (event-program-append (car tokens) (cadr tokens)))
               (append-code (foldl (lambda (token code) (event-program-append code token)) #f tokens))
               (before (event-program-callbacks append-code))
               (chunk-packet (event-program-inspect chunk))
               (append-packet (event-program-inspect append-code)))
          (equal (vector-ref chunk-packet 0)  'chunk)
          (equal (vector-ref append-packet 0)  'append)
          (act (set-car! (vector-ref chunk-packet 1) #f))
          (act (set-car! (vector-ref append-packet 2) #f))
          (equal (event-program-callbacks append-code)  before)
          (equal (length (event-program-callbacks chunk))  2))))
    (scenario "generated certificate data is independently checked before witness admission"
      (sequential ((program (compile-recipe (list 'node 'Root (list 'token (make-token 'word "x" 0 1)))))
             (graph (extract-event-graph program)) (ranks (event-graph-certificate graph))
             (broken (vector-copy ranks)))
        (act (vector-set! broken (car graph) 0))
        (equal (check-event-certificate graph broken)  #f)
        (raises (generate-event-witness graph broken 100) true)
        (scope ((cycle (cons 0 (vector '(view 0 0)))))
          (equal (check-event-certificate cycle '#(1))  #f)
          (raises (event-graph-certificate cycle) true))
        (scope ((outside (cons 0 (vector '(view 7 0)))))
          (equal (check-event-certificate outside '#(1))  #f))))
    (scenario "physical frame extraction rejects widths tags and malformed cursor references"
      (each (frame) ((list #f '#() '#(0 #f 0) '#(0 #t 0 #f) '#(0 #f 0 #f 0) '#(0 #t 0 #f #t)
              '#(-1 #f 0 #f) '#(0 #f 0 0) '#(0 #f 0.5 #f))) (raises (decode-event-frame frame) true))
      (equal (decode-event-frame '#(0 #t -7 #t 0))  '(finish 0 -7 #t 0))
      (equal (decode-event-frame '#(0 16 -7 #t))  '(chunk 0 16 -7 #t))
      (raises (replay-event-graph (cons 0 (vector '(chunk (1) 0 1) '(token "word" "x" 0 1)))) true)
      (raises (replay-event-graph (cons 0 (vector '(view 0 0)))) true)
      (raises (replay-event-graph (cons 0 (vector '(view 7 0)))) true))
    (scenario "canonical child views restore deferred sibling context"
      (sequential ((left (make-recognition-child 'left (make-token 'word "a" 0 1)))
             (right (make-recognition-child 'right (make-token 'word "b" 1 2)))
             (cancelled (recognition-sequence-relocate
                         (recognition-sequence-relocate (list left) 9) -9))
             (sequence (recognition-sequence-append cancelled (list right)))
             (actual '()))
        (act (recognition-sequence-for-each
         (lambda (child delta moved?) (set! actual (cons (list child delta moved?) actual))) sequence))
        (equal (reverse actual)  (list (list left 0 #t) (list right 0 #f)))
        (equal (eq? (caar (reverse actual)) left)  #t)))
    (scenario "recursive and explicit fallback paths preserve fields fragments and closing IDs"
      (each (depth) ('(1 15 16 63 64 65 129))
         (iterate loop ((n depth) (recipe (list 'token (make-token 'word "x" 0 1))))
           (branch (zero? n) (verify check-recipe recipe)
             (continue loop (- n 1) (list 'node 'Root (list 'field 'value
                                 (list 'fragment (list 'view 1 (list 'view -1 recipe)))))))))))
