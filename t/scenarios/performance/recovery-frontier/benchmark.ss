((benchmarkKind . scenario-e2e)
 (max_total . 250ms)
 (target_total . 100ms)
 (regression_budget . 150ms)
 (expected_over_input_budget . 100ms)
 (targetRationale . "one hundred operands must recover from the terminal LR frontier without replaying the accepted prefix per candidate")
 (sampleCount . 40)
 (rule . GERBIL-PARSER-RECOVERY-FRONTIER)
 (feature . lr-failure-frontier-recovery)
 (optimizationFocus . "parser-state expected terminals plus immutable checkpoint suffix resumption")
 (inputShape . "one rejected arithmetic expression with one hundred operands and a missing closing delimiter")
 (expectedOutcome . "the one-edit candidate is derived at the exact failure state while at least 199 accepted-prefix tokens are reused")
 (measurementPhases collect-before collect-after policy-before policy-after
                    assert-time-gate observe-runtime-memory)
 (tags performance integration parser recovery checkpoint))
