;;; Static call sites, not dynamic counts, exclusive CPU or allocation proof.
(export main)

(def (main product)
  (let ((definitions (make-hash-table-eq)) (calls 0) (tail-calls 0) (owner-assignments 0))
    (for-each
     (lambda (file)
       (when (and (string-prefix? "parse-org-compiled-events" file)
                  (string-suffix? ".ss" file))
         (call-with-input-file (path-expand file product)
           (lambda (port)
             (let read-next ()
               (let (form (read port))
                 (unless (eof-object? form)
                   (when (and (pair? form) (eq? (car form) 'def) (pair? (cadr form)))
                     (hash-put! definitions (caadr form) (cddr form)))
                   (read-next))))))))
     (directory-files product))
    (def (sequence forms tail?)
      (unless (null? forms)
        (visit (car forms) (and tail? (null? (cdr forms))))
        (sequence (cdr forms) tail?)))
    (def (visit code tail?)
      (when (pair? code)
        (case (car code)
          ((quote) (void))
          ((begin) (sequence (cdr code) tail?))
          ((if) (visit (cadr code) #f) (for-each (cut visit <> tail?) (cddr code)))
          ((let let*)
           (cond
            ((symbol? (cadr code))
             (if (and (pair? (caddr code)) (pair? (caaddr code)))
               (begin
                 (for-each (lambda (binding) (for-each (cut visit <> #f) (cdr binding))) (caddr code))
                 (sequence (cdddr code) tail?))
               (begin (visit (caddr code) #f) (sequence (cdddr code) tail?))))
            ((and (pair? (cadr code)) (symbol? (caadr code)))
             (for-each (cut visit <> #f) (cdadr code)) (sequence (cddr code) tail?))
            (else
             (for-each (lambda (binding) (for-each (cut visit <> #f) (cdr binding))) (cadr code))
             (sequence (cddr code) tail?))))
          ((lambda) (sequence (cddr code) #t))
          ((set!)
           (when (eq? (cadr code) 'events) (set! owner-assignments (+ owner-assignments 1)))
           (visit (caddr code) #f))
          (else
           (when (and (symbol? (car code)) (hash-get definitions (car code)))
             (set! calls (+ calls 1))
             (when tail? (set! tail-calls (+ tail-calls 1))))
           ;; Other syntax is conservatively non-tail; do not overstate edges.
           (for-each (cut visit <> #f) code)))))
    (hash-for-each (lambda (_ body) (sequence body #t)) definitions)
    (write (list 'static-fold-call-sites
                 (cons 'definitions (hash-length definitions))
                 (cons 'private-calls calls) (cons 'syntactic-tail-calls tail-calls)
                 (cons 'events-assignments owner-assignments)))
    (newline)))
