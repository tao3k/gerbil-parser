;;; -*- Gerbil -*-
;;; Language test declarations share the admitted POO loader and invariants.
(import (for-syntax (only-in ./contracts parser-test-form-admitted?))
        (only-in :std/test check check-exception test-case test-suite)
        (only-in :clan/poo/object .ref .cc)
        (only-in :core/observability/testing-case poo-flow-test-case)
        (only-in :clan/poo/mop validate)
        (only-in ../../language-support/entry LanguageLoaderContract)
        (only-in ../../language-support/development language-parser-entry-ref run-language-test language-loader-fixtures language-loader-fixture-count
                 +language-parser-entry-schema+)
        (only-in ../runtime/artifact parse-artifact-valid? parse-artifact-success?
                 parse-artifact-ref parse-artifact-roundtrip parse-artifact-events
                 token-event? token-event-token-kind event-kind)
        (only-in ../runtime/identity sha256-text)
        (only-in ../../language-support/fixture syntax-fixture-source syntax-fixture-source-digest syntax-fixture-expected-status)
        (only-in ./parser-ast check-parser-ast check-accepted-parse)
        (only-in ./language-product language-model-test-receipt
                 check-language-abi-entry check-language-portable-rejection)
        (only-in ../compiler/normalize grammar-ir-ref)
        (only-in ./language-strategy check-language-strategies check-language-installed
                 check-language-fixture-strategies)
        (only-in ../runtime/cst parse-artifact->cst syntax-node? syntax-node-kind
                 syntax-field-name
                 syntax-node-children syntax-field? syntax-field-children)
        (only-in ../runtime/token token? token-lexeme)
        (only-in ../compiler/bound-ir bound-grammar-ir-ref bound-grammar-ir-binding)
        (only-in ../compiler/parser-ir parser-ir-ref)
        (only-in ../compiler/lr lr-spec-ref production-lhs production-rhs)
        (only-in ../compiler/machine parser-machine-ir)
        (only-in ../runtime/lexer lex-source)
        (only-in ../runtime/significant parser-significant-tokens)
        (only-in ../runtime/lr-parser lr-parse/receipt)
        (only-in ../language/descriptor language-grammar? language-grammar-machine language-grammar-grammar)
        (only-in ../runtime/incremental make-edit parse-source/incremental)
        (only-in ../runtime/recovery parse-source/recover)
        (only-in ../runtime/region-scanner source-prefix-at?)
        (only-in :std/string/utf8 string-utf8-length)
        (only-in :std/sync/barrier make-barrier barrier-post! barrier-wait!))
(export deflanguage-parser-tests defparser-check parser-check parser-check-result parser-check-procedure parser-test-datum-writer)

(def (checked-test-loader loader)
  (validate LanguageLoaderContract loader)
  loader)

(def (checked-language-source loader source accepted?)
  (unless (and (equal? (language-parser-entry-ref loader 'schema)
                      +language-parser-entry-schema+) (string? source))
    (error "language test requires an admitted loader and string source" source))
  (let (artifact ((.ref loader '.parse) source))
    (check (parse-artifact-valid? artifact) => #t)
    (check (parse-artifact-success? artifact) => accepted?)
    (check (parse-artifact-roundtrip artifact) => source)
    (check (parse-artifact-ref artifact 'sourceDigest) => (sha256-text source))
    artifact))

(def (checked-language-fixtures loader (expected-status #f))
  (let ((artifacts (run-language-test loader 'fixtures)) (fixtures (language-loader-fixtures loader)))
    (check (pair? artifacts) => #t)
    (check (length artifacts) => (length fixtures))
    (when expected-status
      (check (map syntax-fixture-expected-status fixtures)
             => (make-list (length fixtures) expected-status)))
    (for-each (lambda (artifact fixture)
                (check (parse-artifact-valid? artifact) => #t)
                (check (parse-artifact-roundtrip artifact) => (syntax-fixture-source fixture))
                (check (parse-artifact-ref artifact 'sourceDigest) => (syntax-fixture-source-digest fixture)))
              artifacts fixtures)
    artifacts))

(def (checked-fixture-group loader status)
  (let (fixtures (language-loader-fixtures loader status))
    (checked-language-fixtures (checked-test-loader (.cc loader 'fixtures fixtures)) status)))

(def (test-fixture-catalog loader key)
  (case key
    ((total) (language-loader-fixture-count loader))
    ((accepted rejected) (language-loader-fixture-count loader key))
    ((first-digest) (let (fixtures (language-loader-fixtures loader))
                      (and (pair? fixtures) (syntax-fixture-source-digest (car fixtures)))))))

(def (artifact-field-names artifact kind)
  (let loop ((pending (list (parse-artifact->cst artifact))) (names '()))
    (if (null? pending) names
      (let (value (car pending))
        (cond
         ((syntax-node? value)
          (loop (append (syntax-node-children value) (cdr pending))
                (if (eq? (syntax-node-kind value) kind)
                  (append (map syntax-field-name (filter syntax-field? (syntax-node-children value))) names) names)))
         ((syntax-field? value) (loop (append (syntax-field-children value) (cdr pending)) names))
         (else (loop (cdr pending) names)))))))

(def (nonempty-language-sources sources)
  (unless (and (list? sources) (pair? sources) (andmap string? sources))
    (error "language test source collection must be nonempty strings" sources))
  sources)

(def (artifact-node-kinds artifact)
  (map (lambda (event) (vector-ref event 2))
       (filter (lambda (event) (eq? (event-kind event) 'start-node))
               (parse-artifact-events artifact))))

(def (cst-direct-nodes value)
  (cond ((syntax-node? value) (list value))
        ((syntax-field? value) (apply append (map cst-direct-nodes (syntax-field-children value))))
        (else '())))

(def (cst-lexemes value)
  (cond ((token? value) (list (token-lexeme value)))
        ((syntax-node? value) (apply append (map cst-lexemes (syntax-node-children value))))
        ((syntax-field? value) (apply append (map cst-lexemes (syntax-field-children value))))
        (else '())))

;;; Child rows select the declared node kinds through transparent fields, then
;;; require exact count/order. Other direct node kinds are not selected.
(def (cst-node-matches? value pattern)
  (and (syntax-node? value) (eq? (syntax-node-kind value) (cadr pattern))
       (andmap
        (lambda (condition)
          (case (car condition)
            ((lexemes) (andmap (lambda (text) (member text (cst-lexemes value))) (cdr condition)))
            ((children)
             (let* ((patterns (cdr condition)) (kinds (map cadr patterns))
                    (selected (filter (lambda (child) (memq (syntax-node-kind child) kinds))
                                      (apply append (map cst-direct-nodes (syntax-node-children value))))))
               (and (= (length selected) (length patterns))
                    (andmap values (map cst-node-matches? selected patterns)))))
            (else (error "unknown CST test condition" condition))))
        (cddr pattern))))

(def (artifact-subtree-matches? artifact pattern)
  (def (visit value)
    (cond ((syntax-node? value)
           (or (cst-node-matches? value pattern) (ormap visit (syntax-node-children value))))
          ((syntax-field? value) (ormap visit (syntax-field-children value)))
          (else #f)))
  (and (visit (parse-artifact->cst artifact)) #t))

(def (artifact-field-counts artifact kind field)
  (let loop ((pending (list (parse-artifact->cst artifact))) (counts '()))
    (if (null? pending) (reverse counts)
      (let (value (car pending))
        (cond
         ((syntax-node? value)
          (loop (append (syntax-node-children value) (cdr pending))
                (if (eq? (syntax-node-kind value) kind)
                  (cons (length (filter (lambda (child)
                                         (and (syntax-field? child) (eq? (syntax-field-name child) field)))
                                       (syntax-node-children value))) counts)
                  counts)))
         ((syntax-field? value) (loop (append (syntax-field-children value) (cdr pending)) counts))
         (else (loop (cdr pending) counts)))))))

(def (test-grammar-machine loader)
  (let (descriptor (.ref loader 'descriptor))
    (unless (language-grammar? descriptor) (error "grammar test requires a Grammar IR loader"))
    (language-grammar-machine descriptor)))

(def (check-parallel-language loader workers sources)
  (let* ((inputs (nonempty-language-sources sources))
         (expected (map (lambda (source) (checked-language-source loader source #t)) inputs))
         (barrier (make-barrier workers))
         (threads (map (lambda (index)
                         (spawn (lambda ()
                                  (barrier-post! barrier) (barrier-wait! barrier)
                                  (with-catch (lambda (condition) (cons 'failed condition))
                                    (lambda () (cons 'parsed ((.ref loader '.parse)
                                                             (list-ref inputs (modulo index (length inputs))))))))))
                       (iota workers)))
         (results (map thread-join! threads)))
    ;; Join all workers before propagating a parser exception.
    (for-each (lambda (result) (when (eq? (car result) 'failed) (raise (cdr result)))) results)
    (check (map cdr results)
           => (map (lambda (index) (list-ref expected (modulo index (length inputs)))) (iota workers)))))

(def (test-incremental-receipt loader source old new)
  (let* ((offset (let find ((at 0))
                    (cond ((source-prefix-at? source at old) at)
                          ((>= at (string-length source)) (error "incremental test replacement not found" old))
                          (else (find (+ at 1))))))
         (prefix (substring source 0 offset))
         (edited (string-append prefix new (substring source (+ offset (string-length old)) (string-length source))))
         (base (checked-language-source loader source #t)))
    (let-values (((artifact receipt)
                  (parse-source/incremental (test-grammar-machine loader) source base
                                            (make-edit (string-utf8-length prefix) (string-utf8-length old) new))))
      (check artifact => (checked-language-source loader edited #t))
      receipt)))

(def (test-recovery-rejection loader source)
  (let-values (((artifact receipt) (parse-source/recover (test-grammar-machine loader) source)))
    (check (parse-artifact-success? artifact) => #f)
    (check (parse-artifact-valid? artifact) => #t)
    (check (parse-artifact-roundtrip artifact) => source)
    receipt))

(def (test-parser-ir-ref ir key)
  (case key
    ((rule-count) (length (parser-ir-ref ir 'rules)))
    (else (parser-ir-ref ir key))))

(def (test-lr-value ir key)
  (let (spec (parser-ir-ref ir 'lr-spec))
    (case key
      ((state-count) (lr-spec-ref spec 'state-count))
      ((fork-count)
       (apply + (map (lambda (row) (length (filter (lambda (entry) (eq? (cadr entry) 'fork)) row)))
                     (vector->list (lr-spec-ref spec 'actions)))))
      (else (error "unknown LR test value" key)))))

(def (nullable-prefix-productions ir prefixes)
  (filter (lambda (production)
            (and (null? (production-rhs production))
                 (ormap (lambda (prefix)
                          (string-prefix? prefix (symbol->string (production-lhs production)))) prefixes)))
          (lr-spec-ref (parser-ir-ref ir 'lr-spec) 'productions)))

(def (initial-shifts? ir literals)
  (let (actions (vector-ref (lr-spec-ref (parser-ir-ref ir 'lr-spec) 'actions) 0))
    (and (andmap (lambda (literal)
                   (let (entry (assoc (list 'terminal 'literal literal) actions))
                     (and entry (eq? (cadr entry) 'shift)))) literals) #t)))

(def (test-bound-rule ir name)
  (or (bound-grammar-ir-binding ir 'rule name) (error "missing bound test rule" name)))

(def (test-bound-source binding key)
  (bound-grammar-ir-ref (bound-grammar-ir-ref binding 'source) key))

(def (test-bound-source-prefix? binding key prefix)
  (let (value (test-bound-source binding key))
    (and (string? value) (string-prefix? prefix value))))

(def (test-lr-receipt machine source budget)
  (let ((spec (parser-ir-ref (parser-machine-ir machine) 'lr-spec))
        (tokens (parser-significant-tokens machine (lex-source machine source))))
    (let-values (((_root rest receipt) (lr-parse/receipt spec tokens budget)))
      (cons (cons 'rest rest) receipt))))

(defrules language-bound-expectation (source source-prefix references reference-names binding-id)
  ((_ binding (source key expected)) (check (test-bound-source binding 'key) => expected))
  ((_ binding (source-prefix key prefix)) (check (test-bound-source-prefix? binding 'key prefix) => #t))
  ((_ binding (references expected)) (check (bound-grammar-ir-ref binding 'references) => expected))
  ((_ binding (reference-names expected))
   (check (map (lambda (row) (bound-grammar-ir-ref row 'name))
               (bound-grammar-ir-ref binding 'references)) => expected))
  ((_ binding (binding-id expected)) (check (bound-grammar-ir-ref binding 'bindingId) => expected)))

(defrules language-bound-row ()
  ((_ ir (name expectation ...))
   (let (binding (test-bound-rule ir 'name))
     (language-bound-expectation binding expectation) ...)))

(defrules language-lr-expectation (state-count fork-count empty-nullable-prefixes initial-shifts)
  ((_ ir (state-count expected)) (check (test-lr-value ir 'state-count) => expected))
  ((_ ir (fork-count expected)) (check (test-lr-value ir 'fork-count) => expected))
  ((_ ir (empty-nullable-prefixes prefix ...))
   (check (nullable-prefix-productions ir '(prefix ...)) => '()))
  ((_ ir (initial-shifts literal ...)) (check (initial-shifts? ir '(literal ...)) => #t)))

(defrules language-artifact-expectation (nodes tokens counts without-nodes diagnostics artifact-ref projection root subtree without-subtree field-counts fields token-counts)
  ((_ artifact (nodes kind ...))
   (begin (check (and (memq 'kind (artifact-node-kinds artifact)) #t) => #t) ...))
  ((_ artifact (without-nodes kind ...))
   (begin (check (and (memq 'kind (artifact-node-kinds artifact)) #t) => #f) ...))
  ((_ artifact (counts (kind count) ...))
   (begin (check (length (filter (lambda (value) (eq? value 'kind))
                                (artifact-node-kinds artifact))) => count) ...))
  ((_ artifact (fields kind name ...))
   (let (names (artifact-field-names artifact 'kind))
     (check (and (memq 'name names) #t) => #t) ...))
  ((_ artifact (token-counts (kind count) ...))
   (let (kinds (map token-event-token-kind (filter token-event? (parse-artifact-events artifact))))
     (check (length (filter (lambda (value) (eq? value 'kind)) kinds)) => count) ...))
  ((_ artifact (tokens kind ...))
   (let (kinds (map token-event-token-kind (filter token-event? (parse-artifact-events artifact))))
     (check (and (memq 'kind kinds) #t) => #t) ...))
  ((_ artifact (root kind)) (check (car (artifact-node-kinds artifact)) => 'kind))
  ((_ artifact (field-counts kind field (count ...)))
   (check (artifact-field-counts artifact 'kind 'field) => '(count ...)))
  ((_ artifact (without-subtree pattern)) (check (artifact-subtree-matches? artifact 'pattern) => #f))
  ((_ artifact (subtree pattern)) (check (artifact-subtree-matches? artifact 'pattern) => #t))
  ((_ artifact (diagnostics count)) (check (length (parse-artifact-ref artifact 'diagnostics)) => count))
  ((_ artifact (diagnostics))
   (check (pair? (parse-artifact-ref artifact 'diagnostics)) => #t))
  ((_ artifact (artifact-ref key expected))
   (check (parse-artifact-ref artifact 'key) => expected))
  ((_ artifact (projection project (key expected) ...))
   (let (value (project artifact))
     (check (cdr (assq 'key value)) => expected) ...)))

(defrules language-model-expectation (nonzero)
  ((_ receipt (nonzero key))
   (check (let (value (bound-grammar-ir-ref receipt 'key))
            (and (number? value) (not (zero? value)))) => #t))
  ((_ receipt (key expected)) (check (bound-grammar-ir-ref receipt 'key) => expected)))

;;; Finite engine matrices use the same closed property/equality clauses as
;;; language fixtures. Empty axes are rejected rather than silently skipping.
(def (language-test-axis values)
  (unless (and (list? values) (pair? values))
    (error "parser test matrix requires nonempty list axes" values))
  values)
(defrules language-test-axes ()
  ((_ () body) body)
  ((_ ((name values) rest ...) body)
   (for-each (lambda (name) (language-test-axes (rest ...) body))
             (language-test-axis values))))

(defstruct parser-test-fixture-owner (procedure) final: #t)
(def (register-parser-test-fixture! owner label)
  (unless (parser-test-fixture-owner? owner)
    (error "expected a declared parser test fixture" label owner))
  ((parser-test-fixture-owner-procedure owner)))

(defstruct parser-check-owner (procedure) final: #t)
(def (parser-check-result owner . arguments)
  (unless (parser-check-owner? owner) (error "expected a declared parser check" owner))
  (apply (parser-check-owner-procedure owner) arguments))
(def (parser-check-procedure owner)
  (unless (parser-check-owner? owner) (error "expected a declared parser check" owner))
  (lambda arguments (apply (parser-check-owner-procedure owner) arguments)))
(def (parser-test-datum-writer produce)
  (unless (procedure? produce) (error "expected a fixture datum producer" produce))
  ;; A subject writer returns structured data; the test support owns its codec
  ;; and the caller's explicit output-port protocol. No console is selected.
  (lambda (value port) (write (produce value) port)))
(def (language-test-receipt! value)
  (write value) (newline) (force-output))

;;; Closed engine scenarios preserve lexical scope and evaluation order. Subject
;;; effects are explicit actions; assertions and control structure belong here.
(defsyntax (language-test-step stx)
  ;; Consume every DSL tag before introducing user lexical bindings. Dispatch
  ;; tags by datum so a subject named receipt/group/equal cannot capture them.
  (def (compile node)
    (case (stx-e (stx-car node))
      ((equal) (syntax-case node () ((_ actual expected) #'(check actual => expected))))
      ((matches) (syntax-case node () ((_ actual predicate) #'(check actual ? predicate))))
      ((raises) (syntax-case node () ((_ expression predicate) #'(check-exception expression predicate))))
      ((ast) (syntax-case node () ((_ artifact source pattern) #'(check-parser-ast artifact source pattern))))
      ((accepted-parse)
       (syntax-case node ()
         ((_ source candidate reference ...) #'(check-accepted-parse source candidate reference ...))))
      ((continue) (syntax-case node () ((_ name argument ...) #'(name argument ...))))
      ((verify) (syntax-case node () ((_ checker argument ...) #'(parser-check-result checker argument ...))))
      ((result) (syntax-case node () ((_ expression) #'expression)))
      ((act) (syntax-case node () ((_ expression) #'expression)))
      ((receipt) (syntax-case node () ((_ value) #'(language-test-receipt! value))))
      ((scope)
       (syntax-case node ()
         ((_ bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(let bindings expanded ...)))))
      ((sequential)
       (syntax-case node ()
         ((_ bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(let* bindings expanded ...)))))
      ((locals)
       (syntax-case node ()
         ((_ bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(letrec* bindings expanded ...)))))
      ((scope-values)
       (syntax-case node ()
         ((_ bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(let-values bindings expanded ...)))))
      ((sequential-values)
       (syntax-case node ()
         ((_ bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(let*-values bindings expanded ...)))))
      ((parameters)
       (syntax-case node ()
         ((_ bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(parameterize bindings expanded ...)))))
      ((each)
       (syntax-case node ()
         ((_ parameters (input ...) step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(for-each (lambda parameters expanded ...) input ...)))))
      ((iterate)
       (syntax-case node ()
         ((_ name bindings step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(let name bindings expanded ...)))))
      ((inline-callback)
       (syntax-case node ()
         ((_ (producer argument ...) parameters step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(producer (lambda parameters expanded ...) argument ...)))))
      ((install-check)
       (syntax-case node ()
         ((_ (producer argument ...) parameters step ...)
          #'(producer argument ...
              (parser-check-procedure (parser-check parameters step ...))))))
      ((using)
       (syntax-case node ()
         ((_ (producer argument ...) parameters step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(let (entered? #f)
                (call-with-values
                  (lambda ()
                    (producer argument ...
                      (lambda parameters (set! entered? #t) expanded ...)))
                  (lambda results
                    (unless entered? (error "parser test receiver was not invoked"))
                    (apply values results))))))))
      ((when)
       (syntax-case node ()
         ((_ condition step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(when condition expanded ...)))))
      ((unless)
       (syntax-case node ()
         ((_ condition step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(unless condition expanded ...)))))
      ((group)
       (syntax-case node ()
         ((_ step ...)
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...)))))
            #'(begin expanded ...)))))
      ((choose)
       (syntax-case node ()
         ((_ value clause ...)
          (with-syntax (((expanded ...)
                         (map (lambda (clause)
                                (syntax-case clause ()
                                  ((keys step ...)
                                   (with-syntax (((body ...) (map compile (syntax->list #'(step ...)))))
                                     #'(keys body ...)))))
                              (syntax->list #'(clause ...)))))
            #'(case value expanded ...)))))
      ((branch)
       (syntax-case node ()
         ((_ condition yes no)
          (with-syntax ((left (compile #'yes)) (right (compile #'no)))
            #'(if condition left right)))))
      ((protect)
       (syntax-case node ()
         ((_ (_ step ...) (_ final ...))
          (with-syntax (((expanded ...) (map compile (syntax->list #'(step ...))))
                        ((cleanup ...) (map compile (syntax->list #'(final ...)))))
            #'(try (begin expanded ...) (finally cleanup ...))))))
      ((wind)
       (syntax-case node ()
         ((_ (_ enter ...) (_ step ...) (_ leave ...))
          (with-syntax (((opening ...) (map compile (syntax->list #'(enter ...))))
                        ((expanded ...) (map compile (syntax->list #'(step ...))))
                        ((closing ...) (map compile (syntax->list #'(leave ...)))))
            #'(dynamic-wind (lambda () opening ...) (lambda () expanded ...)
                            (lambda () closing ...))))))
      (else (raise-syntax-error #f "unsupported parser test step" node))))
  (syntax-case stx () ((_ node) (compile #'node))))

(defrules language-loader-test-clause (accepted rejected accepted-many rejected-many identity fixtures ast property bindings equal parser-ir bound-ir bound-rules lr lr-receipt parallel incremental replace recovery-rejected status installed strategy-parity fixture-parity fixture-group accepted-fixture fixture-catalog syntax-kind distinct-contract model-receipt native-entry portable-rejected matrix scenario profiled)
  ((_ loader (accepted label source expectation ...))
   (test-case label
     (let (artifact (checked-language-source loader source #t))
       (language-artifact-expectation artifact expectation) ... (void))))
  ((_ loader (rejected label source expectation ...))
   (test-case label
     (let (artifact (checked-language-source loader source #f))
       (language-artifact-expectation artifact expectation) ... (void))))
  ((_ loader (accepted-many label sources expectation ...))
   (test-case label
     (for-each (lambda (source)
                 (let (artifact (checked-language-source loader source #t))
                   (language-artifact-expectation artifact expectation) ... (void))) (nonempty-language-sources sources))))
  ((_ loader (rejected-many label sources expectation ...))
   (test-case label
     (for-each (lambda (source)
                 (let (artifact (checked-language-source loader source #f))
                   (language-artifact-expectation artifact expectation) ... (void))) (nonempty-language-sources sources))))
  ((_ loader (identity label (key expected) ...))
   (test-case label (check (language-parser-entry-ref loader 'key) => expected) ...))
  ((_ loader (fixtures label (status expected)))
   (test-case label (checked-language-fixtures loader 'expected)))
  ((_ loader (fixtures label))
   (test-case label
     (checked-language-fixtures loader)))
  ((_ loader (ast label source pattern))
   (test-case label
     (let* ((text source) (artifact (checked-language-source loader text #t)))
       (check-parser-ast artifact text pattern))))
  ((_ loader (parallel label workers sources))
   (test-case label (check-parallel-language loader workers sources)))
  ((_ loader (incremental label source (replace old new) (key expected) ...))
   (test-case label (let (receipt (test-incremental-receipt loader source old new))
                      (check (bound-grammar-ir-ref receipt 'key) => expected) ...)))
  ((_ loader (recovery-rejected label source (key expected) ...))
   (test-case label (let (receipt (test-recovery-rejection loader source))
                      (check (bound-grammar-ir-ref receipt 'key) => expected) ...)))
  ((_ loader (parser-ir label value (key expected) ...))
   (test-case label (let (ir value) (check (test-parser-ir-ref ir 'key) => expected) ...)))
  ((_ loader (bound-ir label value (binding-count expected)))
   (test-case label (check (bound-grammar-ir-ref value 'bindingCount) => expected)))
  ((_ loader (bound-rules label value row ...))
   (test-case label (let (ir value) (language-bound-row ir row) ...)))
  ((_ loader (lr label value expectation ...))
   (test-case label (let (ir value) (language-lr-expectation ir expectation) ...)))
  ((_ loader (lr-receipt label machine source budget (key expected) ...))
   (test-case label (let (receipt (test-lr-receipt machine source budget))
                      (check (bound-grammar-ir-ref receipt 'key) => expected) ...)))
  ((_ loader (installed label route))
   (test-case label (check-language-installed loader 'route)))
  ((_ loader (strategy-parity label specification option ...))
   (test-case label (check-language-strategies loader 'specification '(option ...))))
  ((_ loader (fixture-parity label expected-status option ...))
   (test-case label
     (checked-language-fixtures loader)
     (check-language-fixture-strategies loader 'expected-status '(option ...))))
  ((_ loader (fixture-group label expected-status expectation ...))
   (test-case label
     (for-each (lambda (artifact) (language-artifact-expectation artifact expectation) ... (void))
               (checked-fixture-group loader 'expected-status))))
  ((_ loader (accepted-fixture label index expectation ...))
   (test-case label
     (let (artifact (checked-language-source loader (syntax-fixture-source (list-ref (.ref loader 'fixtures) index)) #t))
       (language-artifact-expectation artifact expectation) ... (void))))
  ((_ loader (fixture-catalog label (key expected) ...))
   (test-case label (check (test-fixture-catalog loader 'key) => expected) ...))
  ((_ loader (syntax-kind label kind category (name ...)))
   (test-case label
     (check (assq 'kind (grammar-ir-ref (language-grammar-grammar (.ref loader 'descriptor)) 'syntax-kinds))
            => '(kind category (name ...)))))
  ((_ loader (distinct-contract label other))
   (test-case label (check (equal? (.ref loader 'contract) (.ref (checked-test-loader other) 'contract)) => #f)))
  ((_ loader (model-receipt label model source config tool workers (key expected) ...))
   (test-case label
     (let (receipt (language-model-test-receipt loader model source config 'tool workers))
       (language-model-expectation receipt (key expected)) ...)))
  ((_ loader (native-entry label source accepted-status))
   (test-case label
     (let* ((text source) (accepted? (eq? 'accepted-status 'accepted))
            (artifact (checked-language-source loader text accepted?)))
       (check-language-abi-entry loader text artifact accepted?))))
  ((_ loader (portable-rejected label module-path message))
   (test-case label (check-language-portable-rejection module-path message)))
)

;;; Engine clause tags are datum keywords. Subject bindings such as `bindings`
;;; or `equal` must not alter declaration dispatch or capture emitted checks.
(defsyntax (language-test-clause stx)
  (syntax-case stx ()
    ((_ loader clause)
     (case (stx-e (stx-car #'clause))
       ((suite)
        (syntax-case #'clause ()
          ((_ label reference) #'(register-parser-test-fixture! reference label))))
       ((profiled)
        (syntax-case #'clause ()
          ((_ label step ...)
           #'(poo-flow-test-case label (language-test-step step) ...))))
       ((scenario)
        (syntax-case #'clause ()
          ((_ label step ...)
           #'(test-case label (language-test-step step) ...))))
       ((matrix)
        (syntax-case #'clause ()
          ((_ label (_ (shared initial) ...) ((axis values) ...)
              (_ (name value) ...) (_ actual expected) ...)
           #'(test-case label
               (let* ((shared initial) ...)
                 (language-test-axes ((axis values) ...)
                   (let* ((name value) ...) (check actual => expected) ...)))))))
       ((property)
        (syntax-case #'clause ()
          ((_ label (_ (name value) ...) (_ actual expected) ...)
           #'(test-case label
               (let* ((name value) ...) (check actual => expected) ...)))))
       (else #'(language-loader-test-clause loader clause))))))

;;; The loader expression is evaluated once. No free-form test-case body is
;;; accepted: each row and artifact expectation must match the closed syntax.
(begin-syntax
  (def (quiet? form)
    (parser-test-form-admitted? form
      '(display displayln write write-string write-char printf fprintf pretty-print newline force-output
        check check-exception test-suite test-case)
      '(display write write-string write-char newline force-output)))

  (def (nonempty? rows pred) (and (pair? rows) (andmap pred rows)))
  (def (symbol-row? row) (and (list? row) (= (length row) 2) (symbol? (car row))))
  (def (names? names)
    (and (list? names) (pair? names)
         (let loop ((rest names) (seen '()))
           (or (null? rest)
               (and (symbol? (car rest)) (not (memq (car rest) seen))
                    (loop (cdr rest) (cons (car rest) seen)))))))
  (def (step? row (loops '()))
    (def (nested? row) (step? row loops))
    (and (list? row) (pair? row)
         (case (car row)
           ((equal raises matches) (= (length row) 3))
           ((ast) (= (length row) 4))
           ((accepted-parse) (>= (length row) 3))
           ((receipt result) (= (length row) 2))
           ((verify) (>= (length row) 2))
           ((scope sequential locals)
            (and (>= (length row) 3) (list? (cadr row))
                 (andmap symbol-row? (cadr row)) (nonempty? (cddr row) nested?)))
           ((parameters)
            (and (>= (length row) 3) (list? (cadr row))
                 (andmap (lambda (binding) (and (list? binding) (= (length binding) 2))) (cadr row))
                 (nonempty? (cddr row) nested?)))
           ((scope-values sequential-values)
            (and (>= (length row) 3) (list? (cadr row))
                 (andmap (lambda (binding)
                           (and (list? binding) (= (length binding) 2)
                                (names? (car binding)))) (cadr row))
                 (nonempty? (cddr row) nested?)))
           ((each)
            (and (>= (length row) 4) (names? (cadr row))
                 (list? (caddr row)) (= (length (cadr row)) (length (caddr row)))
                 (nonempty? (cdddr row) nested?)))
           ((when unless) (and (>= (length row) 3) (nonempty? (cddr row) nested?)))
           ((branch) (and (= (length row) 4) (nested? (caddr row)) (nested? (cadddr row))))
           ((group) (nonempty? (cdr row) nested?))
           ((choose)
            (and (>= (length row) 3)
                 (nonempty? (cddr row)
                   (lambda (clause)
                     (and (list? clause) (pair? clause)
                          (or (eq? (car clause) 'else) (list? (car clause)))
                          (nonempty? (cdr clause) nested?))))))
           ((iterate)
            (and (>= (length row) 4) (symbol? (cadr row)) (list? (caddr row))
                 (andmap symbol-row? (caddr row))
                 (nonempty? (cdddr row)
                   (lambda (step) (step? step (cons (cons (cadr row) (length (caddr row))) loops))))))
           ((continue)
            (and (>= (length row) 2) (assq (cadr row) loops)
                 (= (length (cddr row)) (cdr (assq (cadr row) loops)))))
           ((using install-check inline-callback)
            (and (>= (length row) 4) (list? (cadr row)) (pair? (cadr row))
                 (not (memq (caadr row) '(begin lambda quote if when unless let let*)))
                 (list? (caddr row))
                 (or (null? (caddr row)) (names? (caddr row)))
                 (nonempty? (cdddr row) nested?)))
           ((protect)
            (and (= (length row) 3)
                 (list? (cadr row)) (pair? (cadr row)) (eq? (caadr row) 'body)
                 (nonempty? (cdadr row) nested?)
                 (list? (caddr row)) (pair? (caddr row)) (eq? (caaddr row) 'cleanup)
                 (nonempty? (cdaddr row) nested?)))
           ((wind)
            (and (= (length row) 4)
                 (andmap (lambda (block)
                           (and (list? block) (pair? block)
                                (nonempty? (cdr block) nested?))) (cdr row))
                 (equal? (map car (cdr row)) '(before body after))))
           ((act)
            (and (= (length row) 2) (list? (cadr row)) (pair? (cadr row))
                 (symbol? (caadr row))
                 (not (memq (caadr row)
                   '(begin let let* let-values let*-values letrec def define
                     if when unless parameterize for-each check check-exception
                     test-suite test-case)))))
           (else #f))))
  (def (asserts? step)
    (and (pair? step)
         (or (memq (car step) '(equal raises matches verify ast accepted-parse))
             (case (car step)
               ((scope sequential locals scope-values sequential-values parameters when unless)
                (ormap asserts? (cddr step)))
               ((each iterate using) (ormap asserts? (cdddr step)))
               ((choose) (ormap (lambda (clause) (ormap asserts? (cdr clause))) (cddr step)))
               ((protect wind) (ormap (lambda (block) (ormap asserts? (cdr block))) (cdr step)))
               ((branch) (or (asserts? (caddr step)) (asserts? (cadddr step))))
               ((group) (ormap asserts? (cdr step)))
               (else #f)))))


)

(defsyntax (parser-check stx)
  (syntax-case stx ()
    ((_ parameters step ...)
     (and (stx-list? #'parameters) (andmap (lambda (parameter) (or (symbol? parameter) (symbol-row? parameter))) (syntax->datum #'parameters)))
     (let (steps (syntax->datum #'(step ...)))
       (unless (and (nonempty? steps step?) (ormap asserts? steps)
                    (quiet? (cons 'lambda (cons (syntax->datum #'parameters) steps))))
         (raise-syntax-error #f "invalid parser check declaration" stx))
       #'(make-parser-check-owner (lambda parameters (language-test-step step) ...))))
    (_ (raise-syntax-error #f "parser check requires parameters and assertions" stx))))
(defrules defparser-check ()
  ((_ (name parameter ...) step ...)
   (def name (parser-check (parameter ...) step ...))))

(defsyntax (deflanguage-parser-tests stx)


  (def (node-pattern? pattern)
    (and (list? pattern) (>= (length pattern) 2) (eq? (car pattern) 'node) (symbol? (cadr pattern))
         (andmap (lambda (row)
                   (and (list? row) (pair? row)
                        (case (car row)
                          ((lexemes) (nonempty? (cdr row) string?))
                          ((children) (nonempty? (cdr row) node-pattern?))
                          (else #f)))) (cddr pattern))))
  (def (bound-expectation? row)
    (and (list? row) (pair? row)
         (case (car row)
           ((source source-prefix) (and (= (length row) 3) (symbol? (cadr row))))
           ((references reference-names binding-id) (= (length row) 2))
           (else #f))))
  (def (lr-expectation? row)
    (and (list? row) (pair? row)
         (case (car row)
           ((state-count fork-count) (= (length row) 2))
           ((empty-nullable-prefixes initial-shifts) (nonempty? (cdr row) string?))
           (else #f))))
  (def (expectation? row)
    (and (list? row) (pair? row)
      (case (car row)
        ((nodes tokens without-nodes) (nonempty? (cdr row) symbol?))
        ((counts token-counts) (nonempty? (cdr row) (lambda (item)
                    (and (symbol-row? item) (exact-integer? (cadr item)) (>= (cadr item) 0)))))
        ((diagnostics) (or (= (length row) 1)
                           (and (= (length row) 2) (exact-integer? (cadr row)) (>= (cadr row) 0))))
        ((fields) (and (>= (length row) 3) (andmap symbol? (cdr row))))
        ((root) (and (= (length row) 2) (symbol? (cadr row))))
        ((subtree without-subtree) (and (= (length row) 2) (node-pattern? (cadr row))))
        ((field-counts)
         (and (= (length row) 4) (symbol? (cadr row)) (symbol? (caddr row))
              (list? (cadddr row)) (andmap (lambda (count) (and (exact-integer? count) (>= count 0))) (cadddr row))))
        ((artifact-ref) (and (= (length row) 3) (symbol? (cadr row))))
        ((projection) (and (>= (length row) 3) (nonempty? (cddr row) symbol-row?)))
        (else #f))))
  (def (positive-integer? value) (and (exact-integer? value) (> value 0)))
  (def (nonnegative-integer? value) (and (exact-integer? value) (>= value 0)))
  (def (template? node names)
    (cond ((string? node) #t)
          ((symbol? node) (or (eq? node 'index) (memq node names)))
          ((and (list? node) (pair? node))
           (case (car node)
             ((concat) (nonempty? (cdr node) (lambda (part) (template? part names))))
             ((choice) (nonempty? (cdr node) string?))
             ((character) (and (= (length node) 2) (string? (cadr node)) (positive? (string-length (cadr node)))))
             ((integer) (and (= (length node) 3) (exact-integer? (cadr node)) (positive-integer? (caddr node))))
             ((if-even) (and (= (length node) 3) (template? (cadr node) names) (template? (caddr node) names)))
             ((repeat) (and (= (length node) 4) (nonnegative-integer? (cadr node))
                            (positive-integer? (caddr node)) (template? (cadddr node) names)))
             ((when-equal) (and (= (length node) 4) (symbol? (cadr node)) (memq (cadr node) names)
                                (string? (caddr node)) (template? (cadddr node) names)))
             ((bind)
              (and (= (length node) 3) (list? (cadr node)) (pair? (cadr node))
                   (let loop ((rows (cadr node)) (scope names) (seen '()))
                     (if (null? rows) (template? (caddr node) scope)
                       (let (row (car rows))
                         (and (symbol-row? row) (not (eq? (car row) 'index))
                              (not (memq (car row) seen)) (template? (cadr row) scope)
                              (loop (cdr rows) (cons (car row) scope) (cons (car row) seen))))))))
             (else #f)))
          (else #f)))
  (def (source-specification? spec)
    (and (list? spec) (pair? spec)
         (case (car spec)
           ((sources) (nonempty? (cdr spec) string?))
           ((indexed) (and (= (length spec) 3) (positive-integer? (cadr spec)) (template? (caddr spec) '())))
           ((seeded) (and (= (length spec) 4) (nonnegative-integer? (cadr spec)) (< (cadr spec) 2147483648)
                          (positive-integer? (caddr spec)) (template? (cadddr spec) '())))
           ((append) (nonempty? (cdr spec) source-specification?))
           (else #f))))
  (def (strategy-options? options fixture?)
    (and (pair? options)
         (let loop ((rows options) (seen '()))
           (if (null? rows)
             (and (memq 'routes seen)
                  (let (routes (cdr (assq 'routes options)))
                    (or (>= (length routes) 2) (memq 'accepted seen) (memq 'lexical seen)))
                  (or (not (memq 'coverage seen)) (memq 'lexical seen)))
             (let (row (car rows))
               (and (list? row) (pair? row) (not (memq (car row) seen))
                    (case (car row)
                      ((routes) (let route-loop ((remaining (cdr row)) (used '()))
                                  (or (null? remaining)
                                      (and (memq (car remaining) '(entry indexed source-default source-ranked source-raw source-generic))
                                           (not (memq (car remaining) used))
                                           (route-loop (cdr remaining) (cons (car remaining) used))))))
                      ((lexical) (and (= (length row) 2) (memq (cadr row) '(fast fallback optional))))
                      ((accepted) (and (= (length row) 2) (boolean? (cadr row)) (pair? (cdr (assq 'routes options)))))
                      ((coverage) (and (not fixture?) (= (length row) 3) (nonnegative-integer? (cadr row)) (nonnegative-integer? (caddr row))))
                      ((diagnostics) (and fixture? (= (length row) 2) (nonnegative-integer? (cadr row))))
                      (else #f))
                    (loop (cdr rows) (cons (car row) seen))))))))


  (def (clause? row)
    (and (list? row) (>= (length row) 2) (string? (cadr row))
         (positive? (string-length (cadr row)))
      (case (car row)
        ((suite) (and (= (length row) 3) (symbol? (caddr row))))
        ((accepted rejected accepted-many rejected-many)
         (and (>= (length row) 3) (andmap expectation? (cdddr row))))
        ((fixtures) (or (= (length row) 2)
                        (and (= (length row) 3) (list? (caddr row)) (= (length (caddr row)) 2)
                             (eq? (caaddr row) 'status) (memq (cadr (caddr row)) '(accepted rejected)))))
        ((identity) (nonempty? (cddr row) (lambda (item)
                       (and (symbol-row? item) (memq (car item) '(schema language version contract))))))
        ((ast) (= (length row) 4))
        ((parallel)
         (and (= (length row) 4) (exact-integer? (caddr row)) (positive? (caddr row))))
        ((incremental)
         (and (>= (length row) 5) (list? (cadddr row)) (= (length (cadddr row)) 3)
              (eq? (car (cadddr row)) 'replace) (string? (cadr (cadddr row)))
              (positive? (string-length (cadr (cadddr row)))) (string? (caddr (cadddr row)))
              (nonempty? (list-tail row 4) symbol-row?)))
        ((recovery-rejected) (and (>= (length row) 4) (nonempty? (cdddr row) symbol-row?)))
        ((parser-ir)
         (and (>= (length row) 4)
              (nonempty? (cdddr row) (lambda (item)
                (and (symbol-row? item)
                     (memq (car item) '(rule-count root-rule materialization conflict-policy case-insensitive?)))))))
        ((bound-ir)
         (and (= (length row) 4) (symbol-row? (cadddr row)) (eq? (car (cadddr row)) 'binding-count)))
        ((bound-rules)
         (and (>= (length row) 4) (nonempty? (cdddr row) (lambda (item)
                (and (list? item) (pair? item) (symbol? (car item))
                     (nonempty? (cdr item) bound-expectation?))))))
        ((lr) (and (>= (length row) 4) (nonempty? (cdddr row) lr-expectation?)))
        ((lr-receipt)
         (and (>= (length row) 6) (exact-integer? (list-ref row 4)) (positive? (list-ref row 4))
              (nonempty? (list-tail row 5) (lambda (item)
                (and (symbol-row? item) (memq (car item)
                  '(rest branchesExplored speculativeBranchesExplored maxSpeculativeDepth successfulCompletions)))))))
        ((fixture-group) (and (>= (length row) 3) (memq (caddr row) '(accepted rejected)) (andmap expectation? (cdddr row))))
        ((accepted-fixture) (and (>= (length row) 3) (nonnegative-integer? (caddr row)) (andmap expectation? (cdddr row))))
        ((fixture-catalog) (nonempty? (cddr row) (lambda (item) (and (symbol-row? item) (memq (car item) '(total accepted rejected first-digest))))))
        ((syntax-kind) (and (= (length row) 5) (symbol? (caddr row)) (memq (cadddr row) '(node token))
                             (list? (list-ref row 4)) (andmap symbol? (list-ref row 4))))
        ((distinct-contract) (= (length row) 3))
        ((native-entry) (and (= (length row) 4) (memq (cadddr row) '(accepted rejected))))
        ((portable-rejected) (and (= (length row) 4) (string? (caddr row)) (string? (cadddr row))))
        ((model-receipt)
         (and (>= (length row) 8) (string? (caddr row)) (positive? (string-length (caddr row)))
              (andmap (lambda (ch) (or (char-alphabetic? ch) (char-numeric? ch) (memq ch '(#\_ #\-)))) (string->list (caddr row)))
              (string? (cadddr row)) (string? (list-ref row 4))
              (let (tool (list-ref row 5))
                (and (list? tool) (pair? tool)
                     (or (equal? tool '(unresolved))
                         (and (= (length tool) 3) (eq? (car tool) 'stdout) (string? (cadr tool))
                              (nonnegative-integer? (caddr tool)) (<= (caddr tool) 255)))))
              (positive-integer? (list-ref row 6))
              (nonempty? (list-tail row 7) (lambda (item)
                (and (symbol-row? item) (or (and (eq? (car item) 'nonzero) (eq? (cadr item) 'exit-status)) (memq (car item)
                  '(schema syntax-contract model source-digest config-digest syntax-accepted roundtrip tool-path workers
                    exit-status completed tlc-version states-generated distinct-states states-left graph-depth admitted output-digest))))))))
        ((installed) (and (= (length row) 3) (memq (caddr row) '(step source))))
        ((strategy-parity) (and (>= (length row) 4) (source-specification? (caddr row))
                                (strategy-options? (cdddr row) #f)))
        ((fixture-parity) (and (>= (length row) 4) (memq (caddr row) '(accepted rejected))
                               (strategy-options? (cdddr row) #t)))
        ((scenario profiled) (and (nonempty? (cddr row) step?) (ormap asserts? (cddr row))))
        ((matrix)
         (and (>= (length row) 6)
              (list? (caddr row)) (pair? (caddr row)) (eq? (caaddr row) 'setup)
              (andmap symbol-row? (cdaddr row))
              (nonempty? (cadddr row) symbol-row?)
              (let loop ((names (map car (cadddr row))) (seen '()))
                (or (null? names) (and (not (memq (car names) seen))
                                      (loop (cdr names) (cons (car names) seen)))))
              (clause? (cons 'property (cons (cadr row) (list-tail row 4))))))
        ((property)
         (and (>= (length row) 4) (list? (caddr row)) (pair? (caddr row))
              (eq? (caaddr row) 'bindings) (andmap symbol-row? (cdaddr row))
              (nonempty? (cdddr row) (lambda (item)
                (and (list? item) (= (length item) 3) (eq? (car item) 'equal))))))
        (else #f))))
  ;; Quoted templates can execute unquote/unsyntax expressions. Inspect those
  ;; expressions at their matching depth while allowing literal negative data.


  (def (admit-rows! rows engine?)
    (let (labels '())
      (unless (and (nonempty? rows clause?) (quiet? rows)
                   (or (not engine?) (andmap (lambda (row) (memq (car row) '(property matrix scenario profiled suite))) rows)))
        (raise-syntax-error #f "invalid or output-producing parser test declaration" stx))
      (for-each (lambda (row)
                  (when (member (cadr row) labels)
                    (raise-syntax-error #f "duplicate language parser test label" stx))
                  (set! labels (cons (cadr row) labels))) rows)))
  (def (execution-declarations name options)
    (let loop ((options options) (seen '()) (declarations '()))
      (if (null? options) (reverse declarations)
        (let* ((option (car options)) (row (syntax->datum option)))
          (unless (and (list? row) (= (length row) 2)
                       (not (memq (car row) seen))
                       (case (car row)
                         ((exclusive) (boolean? (cadr row)))
                         ((affinity) (symbol? (cadr row)))
                         (else #f)))
            (raise-syntax-error #f "invalid parser test execution metadata" option))
          (with-syntax ((binding (datum->syntax name
                                  (if (eq? (car row) 'exclusive)
                                    'test-worker-exclusive? 'test-worker-affinity)))
                        (value (cadr (syntax->list option))))
            (loop (cdr options) (cons (car row) seen)
                  (cons (if (eq? (car row) 'exclusive)
                          #'(begin (def binding value) (export binding))
                          #'(begin (def binding 'value) (export binding)))
                        declarations)))))))
  (syntax-case stx (loader)
    ((_ name title (profile) clause ...)
     (and (identifier? #'name) (stx-string? #'title)
          (eq? (stx-e #'profile) 'fixture))
     (begin
       (admit-rows! (syntax->datum #'(clause ...)) #t)
       #'(def name (make-parser-test-fixture-owner
                    (lambda () (language-test-clause #f clause) ...)))))
    ((_ name title (profile option ...) clause ...)
     (and (identifier? #'name) (stx-string? #'title)
          (eq? (stx-e #'profile) 'engine))
     (begin
       (admit-rows! (syntax->datum #'(clause ...)) #t)
       (with-syntax (((declaration ...)
                      (execution-declarations #'name (syntax->list #'(option ...)))))
         #'(begin declaration ...
             (def name (test-suite title (language-test-clause #f clause) ...))
             (export name)))))
    ((_ name title (loader entry) clause ...)
     (and (identifier? #'name) (stx-string? #'title))
     (let (rows (syntax->datum #'(clause ...)))
       (admit-rows! rows #f)
       #'(begin
           (def name (let (owner (checked-test-loader entry))
                       (test-suite title (language-test-clause owner clause) ...)))
           (export name))))
    (_ (raise-syntax-error #f "parser tests require a name, title and loader or engine profile" stx))))
