;;; Native compiled Scheme baseline; its AOT compilation does not make it Rust.
(import (only-in :gerbil-parser/languages/arithmetic/parser parse-arithmetic arithmetic-parser)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-grammar-digest)
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-success? parse-artifact-roundtrip)
        (only-in :gerbil-parser/t/benchmarks/parser-throughput/protocol parser-throughput-batch)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode))
(export main)
(def (parse-and-roundtrip source)
  (let (artifact (parse-arithmetic source))
    (unless (parse-artifact-success? artifact) (error "changing source rejected"))
    (parse-artifact-roundtrip artifact)))
(def (main requests batches)
  (let ((count (string->number requests)) (samples (string->number batches)))
    (unless (and (memv count '(1000 10000 100000)) (eqv? samples 20))
      (error "expected supported request count and twenty batches"))
    (for-each
      (lambda (batch)
        (let* ((inputs (list->vector
                        (map (lambda (index)
                               (string-append "alpha + " (number->string index)
                                              " * (beta - 3)\n"))
                             (iota count (* count batch)))))
               (corpus (string-concatenate (vector->list inputs)))
               (digest (hex-encode (sha256 (string->utf8 corpus)))))
          (unless (equal? (parse-and-roundtrip (vector-ref inputs 0)) (vector-ref inputs 0))
            (error "warmup roundtrip mismatch"))
          (let (sample (parser-throughput-batch parse-and-roundtrip inputs inputs))
            (write
              `(backend-baseline.v1 (backend . scheme-vm) (requests . ,count) (batch . ,batch)
                (grammar . ,(parser-machine-grammar-digest arithmetic-parser))
                (corpus-sha256 . ,digest) (input-bytes . ,(string-length corpus))
                (input-reserved-bytes . unavailable)
                (wall-s . ,(cdr (assq 'batch-wall-s sample)))
                (throughput-requests/s . ,(cdr (assq 'throughput-requests/s sample)))
                (p95-us . ,(cdr (assq 'request-p95-us sample)))
                (p99-us . ,(cdr (assq 'request-p99-us sample)))
                (unresolved . ,(cdr (assq 'sub-resolution-request-samples sample)))
                (clock . sdk-realtime-integer-nanoseconds)
                (boundary . parse-and-lossless-roundtrip) (concurrency . 1)
                (smp . not-exercised)))
            (newline) (force-output))))
      (iota samples 1))
    (displayln "BACKEND-BASELINE-COMPLETE")))
