;;; -*- Gerbil -*-
;;; Pinned SANY proof-step lexemes retain their original source spelling.
(export scan-sany-proof-step scan-sany-identifier scan-sany-module-text scan-sany-proof-reference scan-sany-proof-start)

(def (scan-sany-proof-step source start)
  (let (size (string-length source))
    (and (< start size) (char=? (string-ref source start) #\<)
     (let* ((first (+ start 1))
            (level-end
             (and (< first size)
              (if (memv (string-ref source first) '(#\+ #\*))
                (+ first 1)
                (let loop ((at first))
                  (if (and (< at size) (char-numeric? (string-ref source at)))
                    (loop (+ at 1)) at))))))
       (and level-end (> level-end first) (< level-end size)
            (char=? (string-ref source level-end) #\>)
            (let loop ((at (+ level-end 1)))
              (if (and (< at size)
                       (or (char-alphabetic? (string-ref source at))
                           (char-numeric? (string-ref source at))
                           (char=? (string-ref source at) #\_)))
                (loop (+ at 1))
                (let* ((mark-end
                        (if (and (= at (+ level-end 1)) (< at size)
                                 (memv (string-ref source at) '(#\* #\-)))
                          (+ at 1) at)))
                  (let dots ((end mark-end))
                    (if (and (< end size) (char=? (string-ref source end) #\.))
                      (dots (+ end 1)) end))))))))))

(def (source-prefix? source start text)
  (and (<= (+ start (string-length text)) (string-length source))
       (equal? text (substring source start (+ start (string-length text))))))

(def (scan-characters source start predicate)
  (let loop ((at start))
    (if (and (< at (string-length source)) (predicate (string-ref source at)))
      (loop (+ at 1)) at)))

(def (scan-sany-identifier source start)
  (let (end (scan-characters source start
             (lambda (ch) (or (char-alphabetic? ch) (char-numeric? ch) (char=? ch #\_)))))
    (and (> end start)
         (let loop ((at start))
           (and (< at end)
                (or (not (char-numeric? (string-ref source at))) (loop (+ at 1)))))
         end)))

(def (module-header-end source at)
  (and (source-prefix? source at "----")
       (let* ((dash-end (scan-characters source at (cut char=? <> #\-)))
              (word (scan-characters source dash-end char-whitespace?)))
         (and (source-prefix? source word "MODULE")
              (let* ((name-start (scan-characters source (+ word 6) char-whitespace?))
                     (name-end (scan-sany-identifier source name-start)))
                (and name-end
                     (let (border (scan-characters source name-end char-whitespace?))
                       (and (source-prefix? source border "----")
                            (scan-characters source border (cut char=? <> #\-))))))))))

(def (skip-block source start)
  (let loop ((at (+ start 2)) (depth 1))
    (cond ((>= at (string-length source)) at)
          ((source-prefix? source at "(*") (loop (+ at 2) (+ depth 1)))
          ((source-prefix? source at "*)")
           (if (= depth 1) (+ at 2) (loop (+ at 2) (- depth 1))))
          (else (loop (+ at 1) depth)))))

(def (skip-string source start)
  (let loop ((at (+ start 1)))
    (cond ((>= at (string-length source)) at)
          ((char=? (string-ref source at) #\") (+ at 1))
          ((char=? (string-ref source at) #\\) (loop (+ at 2)))
          (else (loop (+ at 1))))))

(def (module-depth source end)
  (let loop ((at 0) (depth 0))
    (if (>= at end) depth
      (cond ((source-prefix? source at "(*") (loop (skip-block source at) depth))
            ((char=? (string-ref source at) #\") (loop (skip-string source at) depth))
            ((source-prefix? source at "\\*")
             (loop (scan-characters source at (lambda (ch) (not (char=? ch #\newline)))) depth))
            ((module-header-end source at) => (lambda (next) (loop next (+ depth 1))))
            ((source-prefix? source at "====")
             (loop (scan-characters source at (cut char=? <> #\=)) (- depth 1)))
            (else (loop (+ at 1) depth))))))

(def (scan-sany-module-text source start)
  (and (< start (string-length source))
       (or (= start 0)
           (let (prior
                 (let loop ((at (- start 1)))
                   (if (and (>= at 0) (char-whitespace? (string-ref source at)))
                     (loop (- at 1)) at)))
             (and (>= prior 3) (equal? "====" (substring source (- prior 3) (+ prior 1)))
                  (= (module-depth source start) 0))))
       (let loop ((at start))
         (cond ((>= at (string-length source)) (and (> at start) at))
               ((module-header-end source at) (and (> at start) at))
               (else (loop (+ at 1)))))))

(def (scan-sany-proof-reference source start)
  (alet (end (scan-sany-proof-step source start))
    (and (> end start)
         (let (last (string-ref source (- end 1)))
           (or (char-alphabetic? last) (char-numeric? last) (char=? last #\_)))
         end)))

(def (scan-sany-proof-start source start)
  (alet (end (scan-sany-proof-step source start))
    (and (not (scan-sany-proof-reference source start)) end)))
