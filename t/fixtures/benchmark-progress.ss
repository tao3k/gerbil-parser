(import :gerbil/expander)
(def (runtime-export? entry) (fx= (module-export-phi entry) 0))
(def (eval-export entry)
  (eval (binding-id (core-resolve-module-export entry))))
(def (export-entry context name)
  (find (lambda (entry) (and (runtime-export? entry) (eq? (module-export-name entry) name)))
        (module-context-export context)))
(def (main path . args)
  (let ((importer (current-expander-module-import))
        (evaluator (current-expander-module-eval)))
    (parameterize
        ((current-expander-module-import
          (lambda (path reload?)
            (displayln "IMPORT " path) (force-output)
            (let (result (importer path reload?))
              (displayln "IMPORT-OK " path) (force-output) result)))
         (current-expander-module-eval
          (lambda (context)
            (displayln "EVAL " (module-context-id context)) (force-output)
            (let (result (evaluator context))
              (displayln "EVAL-OK " (module-context-id context)) (force-output) result))))
      (let* ((catalog? (and (pair? args) (equal? (car args) "catalog-control")))
             (catalog (and catalog? (import-module ':cursor-catalog-reuser #f #t)))
             (context (import-module path #f #t))
             (entry (find (lambda (entry)
                            (and (runtime-export? entry) (eq? (module-export-name entry) 'main)))
                          (module-context-export context))))
        (unless entry (error "benchmark has no exported main" path))
        (when catalog?
          (let* ((owner (import-module ':gerbil-parser/src/runtime/reuse #f #t))
                 (target (core-resolve-module-export (export-entry owner 'make-fragment-reuser)))
                 (control (eval-export (export-entry catalog 'make-fragment-reuser))))
            (eval (list 'set! (binding-id target) (list 'quote control))))
          (set! args (cdr args))
          (displayln "CATALOG-CONTROL source=0032a62 native-module=cursor-catalog-reuser stats-width=10") (force-output))
        (apply (eval-export entry) args)
        (exit 0)))))
