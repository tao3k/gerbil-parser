;;; Product classification never executes inspected Scheme or touches foreign code.
(import :gerbil-parser/language-test-support
        (only-in :std/io/tempfile make-temporary-file-name)
        (only-in :gerbil-parser/src/build-support/loader-products prepare-library-loader-products!)
        (only-in ./fixtures/module-loading/runtime-files write-program write-datum))

(def (with-loader-product-root procedure)
  (let* ((root (make-temporary-file-name "parser-loader-products-"))
         (namespace (path-expand "lib/gerbil-parser" root)))
    (create-directory* namespace)
    (try (procedure root namespace)
         (finally (delete-file-or-directory root #t)))))
(def (put-loader-product namespace name value)
  (let (path (path-expand name namespace))
    (create-directory* (path-directory path))
    (write-program path write-datum value)))
(def (put-loader-wrapper namespace name form)
  (put-loader-product namespace (string-append name ".scm") form)
  (put-loader-product namespace (string-append name ".ssi") '(interface))
  (put-loader-product namespace (string-append name ".o1") 'native-wrapper))
(def (loader-product? namespace name)
  (file-exists? (path-expand name namespace)))

(deflanguage-parser-tests loader-products-test "closed loader product ownership"
  (engine)
  (scenario "closed wrappers retain interfaces, source and native implementation bytes"
    (using (with-loader-product-root) (root namespace)
      (act (put-loader-wrapper namespace "entry"
        '(begin (declare (block) (standard-bindings) (extended-bindings))
                (load-module "gerbil-parser/entry~0"))))
      (act (put-loader-product namespace "entry.o2" 'old-wrapper))
      (act (put-loader-product namespace "entry~0.o1" 'native-implementation))
      (act (put-loader-product namespace "entry.o1.lock" 'retained-lock))
      (act (prepare-library-loader-products! root))
      (equal (loader-product? namespace "entry.o1") #f)
      (equal (loader-product? namespace "entry.o2") #f)
      (equal (loader-product? namespace "entry.scm") #t)
      (equal (loader-product? namespace "entry.ssi") #t)
      (equal (loader-product? namespace "entry.o1.lock") #t)
      (equal (call-with-input-file (path-expand "entry~0.o1" namespace) read)
             'native-implementation)))
  (scenario "opaque or deferred source is never a loader product"
    (each (form) ('((quote (load-module "missing"))
                   (lambda () (load-module "missing"))
                   (begin (load-module "first") (quote unsupported))
                   (declare (not a compiler declaration))
                   (define opaque (load-module "missing"))))
      (using (with-loader-product-root) (root namespace)
        (act (put-loader-wrapper namespace "opaque" form))
        (act (prepare-library-loader-products! root))
        (equal (loader-product? namespace "opaque.o1") #t))))
  (scenario "native bootstrap entrypoints retain every object generation"
    (each (name) ('("src/modules/loader" "t/support/qualification/process-child"))
      (using (with-loader-product-root) (root namespace)
        (act (put-loader-wrapper namespace name '(begin)))
        (act (put-loader-product namespace (string-append name ".o2") 'new-bootstrap))
        (act (prepare-library-loader-products! root))
        (equal (loader-product? namespace (string-append name ".o1")) #t)
        (equal (loader-product? namespace (string-append name ".o2")) #t))))
  (scenario "unpaired executables and foreign namespace products remain untouched"
    (using (with-loader-product-root) (root namespace)
      (scope ((foreign (path-expand "lib/foreign" root)))
        (act (create-directory* foreign))
        (act (put-loader-product namespace "command.scm" '(begin)))
        (act (put-loader-product namespace "command.o1" 'native-command))
        (act (put-loader-wrapper foreign "module" '(begin)))
        (act (prepare-library-loader-products! root))
        (equal (loader-product? namespace "command.o1") #t)
        (equal (loader-product? foreign "module.o1") #t)))))
