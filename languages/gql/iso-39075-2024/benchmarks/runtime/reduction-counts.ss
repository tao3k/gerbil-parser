;;; Untimed selected-derivation diagnostics; never part of a timed batch.
(import :gerbil-parser/languages/gql/iso-39075-2024/parser
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-success? parse-artifact-valid?)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-ir)
        (only-in :gerbil-parser/src/compiler/lr lr-spec-ref production-table production-rhs production-action operand-actions)
        (only-in :gerbil-parser/src/runtime/lr-parser current-lr-recognition-observer lr-recognition-fragment? lr-recognition-fragment-production-id lr-recognition-fragment-children))
(export profile-gql-reductions)

(def (profile-gql-reductions source)
  (let* ((reference (parse-gql-iso-39075-2024 source))
         (root #f)
         (observed (parameterize ((current-lr-recognition-observer (lambda (value) (set! root value))))
                     (parse-gql-iso-39075-2024 source)))
         (spec (cdr (assq 'lr-spec (parser-machine-ir gql-iso-parser))))
         (table (production-table (lr-spec-ref spec 'productions)))
         (reductions 0) (concatenating-reductions 0) (empty-actions 0) (decorated-operands 0)
         (empty-reductions 0) (unary-reductions 0) (multi-reductions 0))
    (unless (and root (parse-artifact-success? reference)
                 (parse-artifact-valid? reference) (equal? reference observed)) (error "observer changed the public artifact"))
    (let loop ((pending (list root)))
      (when (pair? pending)
        (let* ((piece (car pending))
               (fragment? (lr-recognition-fragment? piece))
               (children (if fragment? (lr-recognition-fragment-children piece) '())))
          (when fragment?
            (let* ((production (vector-ref table (lr-recognition-fragment-production-id piece)))
                   (rhs (production-rhs production))
                   (single? (and (eq? (production-action production) 'pass)
                                 (pair? rhs) (null? (cdr rhs)))))
              (unless (memq (production-action production) '(pass concat))
                (error "unexpected GQL semantic action" production))
              (set! reductions (+ reductions 1))
              (cond ((null? rhs) (set! empty-reductions (+ empty-reductions 1)))
                    ((null? (cdr rhs)) (set! unary-reductions (+ unary-reductions 1)))
                    (else (set! multi-reductions (+ multi-reductions 1))))
              (unless single? (set! concatenating-reductions (+ concatenating-reductions 1)))
              (set! decorated-operands
                (+ decorated-operands (length (filter (lambda (operand) (pair? (operand-actions operand))) rhs))))
              (set! empty-actions
                (+ empty-actions (length (filter (lambda (operand) (null? (operand-actions operand))) rhs))))))
          (loop (append children (cdr pending))))))
    (list (cons 'scope 'selected-derivation)
          (cons 'reductions reductions)
          (cons 'concatenatingReductions concatenating-reductions)
          (cons 'emptyReductions empty-reductions)
          (cons 'unaryReductions unary-reductions)
          (cons 'multiOperandReductions multi-reductions)
          (cons 'identityOperands empty-actions)
          (cons 'decoratedOperands decorated-operands))))
