;;; Negative controls consume actual receipts, never synthetic speed claims.
(import (rename-in "./report.ss" (main report-main))
        :std/misc/ports :std/io/tempfile :std/error)
(export main)
(def (main receipts)
  (let* ((left (call-with-input-file (path-expand "rust-aot-1000.ss" receipts) read-all))
         (right (call-with-input-file (path-expand "scheme-vm-1000.ss" receipts) read-all))
         (root (make-temporary-file-name (path-expand ".data/backend-report-controls-"))))
    (create-directory root)
    (def (write-rows path rows)
      (call-with-output-file path (lambda (port)
        (for-each (lambda (row) (write row port) (newline port)) rows))))
    (def (reject name l r expected)
      (let (directory (path-expand name root))
        (create-directory directory)
        (write-rows (path-expand "rust-aot-1000.ss" directory) l)
        (write-rows (path-expand "scheme-vm-1000.ss" directory) r)
        (unless (with-catch (lambda (exception)
                             (and (Error? exception) (equal? (Error-message exception) expected)))
                           (lambda () (report-main directory) #f))
          (error "report admitted invalid evidence" name))
        (displayln "REPORT-REJECT-OK " name)))
    (reject "incomplete" (take left 19) right "baseline completion marker missing")
    (reject "duplicate-batch" (cons (cadr left) (cdr left)) right "baseline requires exactly twenty batches")
    (let (changed (map (lambda (row)
                        (if (pair? row)
                          (cons (car row) (cons '(output-sha256 . "mismatch")
                            (filter (lambda (entry) (not (eq? (car entry) 'output-sha256))) (cdr row))))
                          row)) right))
      (reject "different-output" left changed "backend corpus or execution boundaries differ"))
    (let (changed (map (lambda (row)
                        (if (pair? row)
                          (cons (car row) (cons '(mode . diagnostic)
                            (filter (lambda (entry) (not (eq? (car entry) 'mode))) (cdr row))))
                          row)) right))
      (reject "diagnostic-not-baseline" left changed "backend corpus or execution boundaries differ"))
    (displayln "BACKEND-REPORT-CONTROLS-OK")))
