(import :gerbil-parser/language-test-support
        (only-in :gerbil-parser/src/build-support/build-environment canonical-build-search-path)
        (only-in :std/io/tempfile make-temporary-file-name)
        (only-in :std/misc/ports read-all-as-string)
        (only-in :std/os/flock open-output-file/lock)
        (only-in :std/os/device device-close)
        (only-in :gerbil-parser/t/support/qualification/process run-observed-process process-result-reason)
        (only-in :gerbil-parser/src/build-support/library-publication
                 call-with-library-publication publication-build-main call-with-library-reader
                 library-publication-inputs))
 (import (only-in :gerbil-parser/src/build-support/preparation-snapshot
                  preparation-snapshot preparation-resolve))

(def (put-product root name text)
  (let (path (path-expand (string-append "lib/gerbil-parser/" name) root))
    (create-directory* (path-directory path))
    (when (file-exists? path) (delete-file path))
    (call-with-output-file path (lambda (port) (display text port)))))
(def (get-product root name)
  (call-with-input-file (path-expand (string-append "lib/gerbil-parser/" name) root) read-all-as-string))
(def (put-library-input root name text)
  (let (path (path-expand (string-append "lib/" name) root))
    (create-directory* (path-directory path))
    (call-with-output-file path (lambda (port) (display text port)))))
(def (with-publication-root procedure)
  (let* ((parent (make-temporary-file-name "parser-publication-control-"))
         (location (path-expand "current" parent))
         (_ (create-directory* location))
         (root (path-normalize location)))
    (put-product root "module.ssi" "old-interface")
    (put-product root "module~0.o1" "old-object")
    (let (dependency (path-expand "lib/foreign/keep.ssi" root))
      (create-directory* (path-directory dependency))
      (call-with-output-file dependency (lambda (port) (display "dependency" port))))
    (try (with-publication-root-setting root (lambda () (procedure root)))
         (finally (delete-file-or-directory parent #t)))))
(def (build-products stage)
  (put-product stage "module.ssi" "new-interface")
  (put-product stage "module~0.o1" "new-object"))
(def (with-publication-lock root procedure)
  (let (lock (open-output-file/lock (string-append root ".publication.lock") 0))
    (try (procedure)
         (finally (device-close lock)))))
(def (with-publication-root-setting root procedure)
  (let (before (getenv "GERBIL_PATH" #f))
    (try (setenv "GERBIL_PATH" root) (procedure)
         (finally (if before (setenv "GERBIL_PATH" before) (setenv "GERBIL_PATH"))))))

(def (with-publication-path path procedure)
  (let (before (getenv "PATH"))
    (try (setenv "PATH" path) (procedure)
         (finally (setenv "PATH" before)))))
(def (publication-path-identity _root)
  (list '("compile") (getenv "PATH")))

(def (normalized-publication-path-identity _root)
  (list '("compile") (canonical-build-search-path (getenv "PATH"))))

(def (invoke-standard-clean procedure)
  ((publication-build-main procedure #f) "clean"))
(def (with-publication-directory root procedure)
  (parameterize ((current-directory root)) (procedure)))
(def (put-source root name text)
  (let (path (path-expand name root))
    (create-directory* (path-directory path))
    (call-with-output-file path (lambda (port) (display text port)))))

;; These controls deliberately change GERBIL_PATH while executing a private
;; builder. Other owners must not observe that process-global setting.

(deflanguage-parser-tests library-publication-test "complete build publication"
  (engine (exclusive #t))
  (scenario "extension writers require the same compiler environment"
    (using (with-publication-root) (root)
      (act (call-with-library-publication root build-products publication-path-identity))
      (using (with-publication-path (string-append root "/bin:" (getenv "PATH"))) ()
        (raises (call-with-library-publication root build-products publication-path-identity #f)
                true))
      (equal (file-exists? (path-expand "library-publication.sexp" root)) #t)
      (act (call-with-library-publication root build-products publication-path-identity #f))
      (equal (get-product root "module.ssi") "new-interface")))
  (scenario "nested SDK PATH prefixes retain the same extension identity"
    (using (with-publication-root) (root)
      (scope ((prefix (string-append root "/bin:"))
              (path (string-append root "/bin:" (getenv "PATH"))))
        (using (with-publication-path path) ()
          (act (call-with-library-publication root build-products normalized-publication-path-identity)))
        (using (with-publication-path (string-append prefix path)) ()
          (act (call-with-library-publication root build-products normalized-publication-path-identity #f)))
        (equal (get-product root "module~0.o1") "new-object"))))
  (scenario "foreign static build outputs do not invalidate source inputs"
    (using (with-publication-root) (root)
      (act (put-library-input root "static/foreign__helper.scm" "dependency source"))
      (scope ((before (library-publication-inputs root)))
        (each (suffix) ('(".c" ".o" ".o.options.sexp"))
          (act (put-library-input root (string-append "static/foreign__helper" suffix)
                                  "derived output")))
        (equal (library-publication-inputs root) before)
        (act (put-library-input root "static/foreign__helper.scm" "changed dependency source"))
        (equal (equal? (library-publication-inputs root) before) #f))
      (scope ((before (library-publication-inputs root)))
        (act (put-library-input root "foreign/keep~0.o1" "loadable dependency"))
        (equal (equal? (library-publication-inputs root) before) #f))
      (scope ((before (library-publication-inputs root)))
        (act (put-library-input root "static/dependency.c/keep.ssi" "nested interface"))
        (equal (equal? (library-publication-inputs root) before) #f))))
  (scenario "clean withdraws admission and delegates to the standard build owner"
    (using (with-publication-root) (root)
      (act (call-with-library-publication root build-products (lambda (_) '(source))))
      (scope ((called #f))
        (using (with-publication-root-setting root) ()
          (act (invoke-standard-clean
                  (lambda args
                    (set! called args)
                    (when (file-exists? (path-expand "library-publication.sexp" root))
                      (error "clean observed an admitted generation"))
                    (delete-file (path-expand "lib/gerbil-parser/module.ssi" root))))))
        (equal called '("clean"))
        (equal (file-exists? (path-expand "lib/gerbil-parser/module.ssi" root)) #f)
        (equal (file-exists? (path-expand "library-publication.sexp" root)) #f))))
  (scenario "failed compiler leaves an unadmitted generation and retry cleans partial products"
    (using (with-publication-root) (root)
      (scope ((prepared? #f))
       (raises (call-with-library-publication root
                 (lambda (stage)
                   (put-product stage "module.ssi" "half-new-interface")
                   (set! prepared? #t)
                   (error "compiler failed before native object"))
                 (lambda (_) '(source))) true)
       (equal prepared? #t))
      (equal (file-exists? (path-expand "lib/gerbil-parser/module~0.o1" root)) #f)
      (equal (get-product root "module.ssi") "half-new-interface")
      (equal (file-exists? (path-expand "library-publication.sexp" root)) #f)
      (raises (call-with-library-reader root void) true)
      (act (call-with-library-publication root
             (lambda (active)
               (when (file-exists? (path-expand "lib/gerbil-parser/module.ssi" active))
                 (error "retry retained a failed product"))
               (build-products active))
             (lambda (_) '(source))))
      (equal (get-product root "module~0.o1") "new-object")))
  (scenario "successful in-place build admits both products and unchanged input reuses them"
    (using (with-publication-root) (root)
      (scope ((calls 0))
        (each (_iteration) ('(first second))
          (act (call-with-library-publication root
                  (lambda (stage)
                    (unless (equal? (path-normalize stage) (path-normalize root)) (error "build destination was redirected"))
                    (unless (file-exists? (path-expand "lib/foreign/keep.ssi" root))
                      (error "foreign dependency removed"))
                    (set! calls (+ calls 1)) (build-products stage))
                  (lambda (_) '(source)))))
        (equal calls 1)
        (equal (get-product root "module.ssi") "new-interface")
        (equal (get-product root "module~0.o1") "new-object"))))
  (scenario "an actual idle watchdog leaves partial products unadmitted"
    (using (with-publication-root) (root)
      (scope ((expired? #f))
       (raises (call-with-library-publication root
                 (lambda (stage)
                   (put-product stage "module.ssi" "half-new-interface")
                   (let (result (run-observed-process
                                  '("gxi" "-e" "(thread-sleep! 10)")
                                  (path-expand "idle.log" stage) timeout: 1 idle-timeout: 0.1))
                     (unless (eq? (process-result-reason result) 'idle-timeout)
                       (error "idle control did not exercise the watchdog"))
                     (set! expired? #t)
                     (error "compiler idle timeout")))
                 (lambda (_) '(source))) true)
       (equal expired? #t))
      (equal (get-product root "module.ssi") "half-new-interface")
      (equal (file-exists? (path-expand "library-publication.sexp" root)) #f)
      (raises (call-with-library-reader root void) true)))
  (scenario "changing source during compilation rejects publication"
    (using (with-publication-root) (root)
      (scope ((revision 'before))
        (raises (call-with-library-publication root
                   (lambda (stage) (build-products stage) (set! revision 'after))
                   (lambda (_) revision)) true)
        (equal revision 'after)
        (equal (file-exists? (path-expand "library-publication.sexp" root)) #f)
        (raises (call-with-library-reader root void) true))))
  (scenario "a product receipt resolves in the unchanged library root"
    (using (with-publication-root) (root)
      (scope ((reference #f))
        (act (call-with-library-publication root
                (lambda (stage)
                  (build-products stage)
                  (let (entries (preparation-snapshot
                                  (list (path-expand "lib/gerbil-parser/module.ssi" stage))))
                    (set! reference (caar entries))))
                (lambda (_) '(source))))
        (equal reference "gerbil-path:lib/gerbil-parser/module.ssi")
        (using (with-publication-root-setting root) ()
          (equal (preparation-resolve reference)
                 (path-expand "lib/gerbil-parser/module.ssi" root))))))
  (scenario "read admission includes newly added and removed source files"
    (using (with-publication-root) (root)
      (using (with-publication-directory root) ()
        (act (put-source root "gerbil.pkg" "(package: gerbil-parser)"))
        (act (put-source root "src/input.ss" "original"))
        (act (call-with-library-publication root build-products))
        (act (call-with-library-reader root void))
        (act (put-source root "src/added.ss" "added"))
        (raises (call-with-library-reader root void) true)
        (act (delete-file (path-expand "src/added.ss" root)))
        (act (call-with-library-reader root void))
        (act (delete-file (path-expand "src/input.ss" root)))
        (raises (call-with-library-reader root void) true))))
  (scenario "corrupt products invalidate reuse and concurrent writers are rejected"
    (using (with-publication-root) (root)
      (act (call-with-library-publication root build-products (lambda (_) '(source))))
      (act (put-product root "module~0.o1" "corrupt-object"))
      (act (call-with-library-publication root build-products (lambda (_) '(source))))
      (equal (get-product root "module~0.o1") "new-object")
      (using (with-publication-lock root) ()
        (raises (call-with-library-publication root build-products (lambda (_) '(source))) true)))))
