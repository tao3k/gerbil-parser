#!/usr/bin/env gxi
;;; Freeze the producer's Scheme alphabetic character class for Rust execution.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!))
(def (main output)
  (displayln "SCHEME-ALPHABETIC-CLASS-SCAN") (force-output)
  (let (ranges
        (let loop ((code 0) (start #f) (rows '()))
          (if (= code #x110000)
            (reverse (if start (cons (cons start (- code 1)) rows) rows))
            (let (alphabetic? (and (not (<= #xd800 code #xdfff))
                                 (char-alphabetic? (integer->char code))))
              (cond ((and alphabetic? (not start)) (loop (+ code 1) code rows))
                    ((and (not alphabetic?) start)
                     (loop (+ code 1) #f (cons (cons start (- code 1)) rows)))
                    (else (loop (+ code 1) start rows)))))))
    (call-with-output-file output
      (lambda (port)
        (display "// @generated by t/generate-scheme-alphabetic-class.ss; do not edit.\n" port)
        (display "// Source authority: pinned native Scheme char-alphabetic? class.\n" port)
        (display "const RANGES: &[(u32, u32)] = &[\n" port)
        (for-each (lambda (range)
          (display "    (0x" port) (display (number->string (car range) 16) port)
          (display ", 0x" port) (display (number->string (cdr range) 16) port)
          (display "),\n" port)) ranges)
        (display "];\n\npub(super) fn is_scheme_alphabetic(character: char) -> bool {\n" port)
        (display "    let code = character as u32;\n" port)
        (display "    let index = RANGES.partition_point(|&(start, _)| start <= code);\n" port)
        (display "    index > 0 && code <= RANGES[index - 1].1\n}\n" port)))
    (displayln "SCHEME-ALPHABETIC-CLASS-GENERATED ranges=" (length ranges))) (force-output) (test-child-process-exit! 0))
