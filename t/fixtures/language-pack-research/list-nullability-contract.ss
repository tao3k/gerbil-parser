#!/usr/bin/env gxi
;;; -*- Gerbil -*-
(import (only-in "list-roles" make-nonempty-list-role)
        (only-in "../../../src/modules/parser/objects" grammar-role-ref)
        (only-in "../../../src/compiler/lr" lower-rules compute-nullable compute-first))
(def checked 0)
(def (probe label actual expected)
  (unless (equal? actual expected) (error "list nullability contract mismatch" label actual expected))
  (set! checked (+ checked 1))
  (display "LIST-NULLABILITY-CASE-OK: ") (display label) (newline) (force-output))
(for-each
 (lambda (case)
   (let* ((label (car case)) (item (cadr case)) (extra (caddr case))
          (nullable? (list-ref case 3)) (token-first? (list-ref case 4))
          (comma-first? (list-ref case 5))
          (role (make-nonempty-list-role 'call-arguments 'arguments
                  '(reference item) '(literal ",") 'argument))
          (rules (append (grammar-role-ref role 'rules) (list (list 'item item)) extra))
          (productions (lower-rules rules 'arguments)))
     (let-values (((nullable nullable-index) (compute-nullable productions)))
       (probe (list label 'item-nullable) (table-ref nullable-index 'item #f) nullable?)
       (probe (list label 'tail-nullable) (table-ref nullable-index 'call-arguments/tail #f) #t)
       (probe (list label 'entry-nullable) (table-ref nullable-index 'arguments #f) nullable?)
       (let-values (((first first-index) (compute-first productions nullable-index)))
         (let (entry-first (table-ref first-index 'arguments '()))
           (probe (list label 'token-first)
             (and (member '(terminal token identifier) entry-first) #t) token-first?)
           (probe (list label 'comma-first)
             (and (member '(terminal literal ",") entry-first) #t) comma-first?))))))
 '((token (token identifier) () #f #t #f)
   (optional-token (optional (token identifier)) () #t #t #t)
   (empty-item (empty) () #t #f #t)
   (recursive-with-base (choice (reference item) (token identifier)) () #f #t #f)
   (indirect-nullable (reference peer) ((peer (optional (token identifier)))) #t #t #t)
   (closed-unproductive-cycle (reference item) () #f #f #f)
   (token-prefix-with-dead-tail
     (sequence (token identifier) (reference blocked))
     ((blocked (reference blocked))) #f #t #f)))
(display "LIST-NULLABILITY-CONTRACT-OK: ") (display checked)
(display " checks passed") (newline) (force-output)
(exit 0)
