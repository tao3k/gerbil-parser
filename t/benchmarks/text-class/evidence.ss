;;; Unchanged allocations and repeated complete-request CPU admission.
(import (only-in :gerbil-parser/t/benchmarks/parser-stage-cost/receipt read-parser-component-receipt))
(export compare-text-class-receipts)
(def (field row key) (cdr (assq key row)))
(def (require! condition . detail)
  (unless condition (apply error "text class evidence rejected" detail)))
(def (read-receipt path batch-count)
  (read-parser-component-receipt path "LR-TEXT-CLASS-REQUESTS-OK" 12 batch-count 20))
(def (compare-text-class-receipts reference-a candidate-a candidate-b reference-b (batch-count 100))
  (let* ((ra (read-receipt reference-a batch-count)) (ca (read-receipt candidate-a batch-count))
         (cb (read-receipt candidate-b batch-count)) (rb (read-receipt reference-b batch-count)))
    (def (cpu receipt key) (field (hash-get (car receipt) key) 'cpuP50Ms))
    (def (stable? key)
      (let* ((c [(cpu ca key) (cpu cb key)]) (r [(cpu ra key) (cpu rb key)])
             (ratio (/ (apply + c) (apply + r))))
        (and (<= 0.95 ratio 1.05)
             (<= (/ (apply min c) (apply max r)) 1 (/ (apply max c) (apply min r))))))
    (let* ((keys (hash-keys (car ra)))
           (controls (filter (lambda (key)
                              (or (eq? (caddr key) 'prepared-lr)
                                  (eq? (car key) 'arithmetic-unchanged-control)
                                  (eq? (car key) 'fhirpath-unicode-control))) keys))
           (stable-controls? (andmap stable? controls)))
      (for-each
       (lambda (key)
         (let* ((bytes (car (hash-get (cadr ra) key)))
                (benefit? (< (max (cpu ca key) (cpu cb key))
                             (* 0.95 (min (cpu ra key) (cpu rb key))))))
           (require! (andmap (lambda (receipt) (= bytes (car (hash-get (cadr receipt) key))))
                            (list ca cb rb)) key 'allocation-drift)
           (write (list 'TEXT-CLASS-EVIDENCE key 'bytes-per-request (/ bytes batch-count)
                        'cpu-ratio (/ (+ (cpu ca key) (cpu cb key)) (+ (cpu ra key) (cpu rb key)))
                        'control? (and (member key controls) #t)
                        'repeated-benefit? benefit?
                        'cpu-benefit-admitted? (and stable-controls? benefit?)))
           (newline) (force-output))) keys)
      (write (list 'TEXT-CLASS-REQUEST-ALLOCATION-OK 'admitted-intervals
                   (+ (caddr ra) (caddr ca) (caddr cb) (caddr rb))
                   'unchanged-controls-stable? stable-controls?)) (newline) (force-output))))
