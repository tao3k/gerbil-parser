#!/usr/bin/env gxi
;;; Freeze the producer's Scheme numeric character class for Rust execution.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!))
(def (main output)
  (displayln "SCHEME-NUMERIC-CLASS-SCAN") (force-output)
  (let (ranges
        (let loop ((code 0) (start #f) (rows '()))
          (if (= code #x110000)
            (reverse (if start (cons (cons start (- code 1)) rows) rows))
            (let (numeric? (and (not (<= #xd800 code #xdfff))
                                 (char-numeric? (integer->char code))))
              (cond ((and numeric? (not start)) (loop (+ code 1) code rows))
                    ((and (not numeric?) start)
                     (loop (+ code 1) #f (cons (cons start (- code 1)) rows)))
                    (else (loop (+ code 1) start rows)))))))
    (call-with-output-file output
      (lambda (port)
        (display "// @generated by t/generate-scheme-numeric-class.ss; do not edit.\n" port)
        (display "// Source authority: pinned native Scheme char-numeric? class.\n" port)
        (display "pub(super) fn is_scheme_numeric(character: char) -> bool {\n" port)
        (display "    character.is_ascii_digit() || matches!(character as u32,\n" port)
        (let loop ((rest (cdr ranges)))
          (unless (null? rest)
            (display "        0x" port) (display (number->string (caar rest) 16) port)
            (display "..=0x" port) (display (number->string (cdar rest) 16) port)
            (display (if (null? (cdr rest)) "\n" " |\n") port)
            (loop (cdr rest))))
        (display "    )\n}\n" port)))
    (displayln "SCHEME-NUMERIC-CLASS-GENERATED ranges=" (length ranges))) (force-output) (test-child-process-exit! 0))
