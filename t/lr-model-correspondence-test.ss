(import :gerbil-parser/language-test-support)
;;; Concrete controls for table decoding and nonempty semantic AST adapters.
(import :std/test
        (only-in :gerbil-parser/src/compiler/lr-compiler compile-lr-spec)
        (only-in :gerbil-parser/src/compiler/lr production-id lr-spec-ref)
        (only-in :gerbil-parser/src/runtime/lr-action-index index-action-rows)
        (only-in :gerbil-parser/src/runtime/lr-parser/prepare make-lr-action-selector lr-prepare)
        (only-in :gerbil-parser/src/runtime/lr-parser/state lr-runtime-table)
        (only-in :gerbil-parser/src/runtime/token make-token token? token-kind token-start token-end)
        :gerbil-parser/src/runtime/recognition
        (only-in :gerbil-parser/src/runtime/funcs recognition-sequence-append recognition-sequence->list current-recognition-sequence-fusion-enabled?)
        (only-in :gerbil-parser/src/runtime/lr-parser/reduction apply-operand-actions)
        (only-in :gerbil-parser/src/runtime/reduction-plan prepare-lr-reduction-plans
                 reduce-lr-stack-plan reduce-lr-vector-plan reduce-lr-source-plan))


;;; Independent data interpretation: no native reduction/index helper is used.
(def (ast-value value)
  (cond
   ((token? value) (list 'token (token-kind value) (token-start value) (token-end value)))
   ((recognition-node? value)
    (list 'node (recognition-node-kind value) (recognition-node-start value) (recognition-node-end value)
          (ast-children (recognition-node-children value))))
   ((recognition-fragment? value)
    (list 'fragment #f (recognition-fragment-start value) (recognition-fragment-end value)
          (ast-children (recognition-fragment-children value))))
   (else (error "unadmitted AST value" value))))
(def (ast-children children)
  (map (lambda (child) (list (recognition-child-field child) (ast-value (recognition-child-value child))))
       (recognition-sequence->list children)))
(def (logical-bounds children offset)
  (if (null? children) (list offset offset)
    (list (caddr (cadar children))
          (let last ((rest children))
            (if (null? (cdr rest)) (cadddr (cadar rest)) (last (cdr rest)))))))
(def (logical-action action children offset)
  (let* ((span (logical-bounds children offset))
         (start (car span)) (end (cadr span)) (name (cadr action)))
    (case (car action)
      ((field)
       (cond ((null? children) '())
             ((and (null? (cdr children)) (not (caar children))) (list (list name (cadar children))))
             (else (list (list name (list 'fragment #f start end children))))))
      ((alias) (list (list #f (list 'node name start end children))))
      (else (error "unadmitted logical action" action)))))
(def (logical-actions actions children offset)
  (if (null? actions) children
    (logical-actions (cdr actions) (logical-action (car actions) children offset) offset)))
(def (semantic-production chains)
  (list 0 'root (map (lambda (actions) (list 'marked '(terminal token word) actions)) chains) 'concat #f))
(def (logical-reduction chains values offset)
  (let loop ((chains chains) (remaining values) (result '()))
    (if (null? chains) result
      (let ((children (ast-children (car remaining)))
            (anchor (let next ((rest remaining))
                      (cond ((null? rest) offset)
                            ((null? (ast-children (car rest))) (next (cdr rest)))
                            (else (car (logical-bounds (ast-children (car rest)) offset)))))))
        (loop (cdr chains) (cdr remaining)
              (append result (logical-actions (car chains) children anchor)))))))

(deflanguage-parser-tests lr-model-correspondence-test "LR runtime to certified model correspondence"
  (engine)
    (scenario "indexed priority retains original cells and state-specific terminal keys"
      (each (width) ('(0 1 7 8 9 32))
         (sequential ((literal '((terminal literal "IF") reduce 0))
                (duplicate '((terminal literal "IF") reduce 99))
                (kind '((terminal token word) reduce 1))
                (other '((terminal token word) reduce 2))
                (zero '((terminal literal "+") shift 0))
                (eof '((terminal eof) accept))
                (padding (map (lambda (n) (cons (list 'terminal 'token (string->symbol (number->string n))) (list 'shift n))) (iota width)))
                (rows (vector (append (list zero literal duplicate kind eof) padding) (list other eof))))
           (each (fold?) ('(#f #t))
              (scope ((selector (make-lr-action-selector rows (index-action-rows rows fold?) fold? #f)))
                (equal (eq? (selector 0 (make-token 'word "+" 0 1)) zero)  #t)
                (equal (eq? (selector 0 (make-token 'word "IF" 0 2)) literal)  #t)
                (equal (eq? (selector 0 (make-token 'word "if" 0 2)) (if fold? literal kind))  #t)
                (equal (eq? (selector 1 (make-token 'word "IF" 0 2)) other)  #t)
                (equal (eq? (selector 0 #f) eof)  #t)
                (equal (selector 1 (make-token 'missing "IF" 0 2))  #f))))))
    (scenario "published reduce IDs decode to exact native production vector rows"
      (each (route) ('(canonical-lr1 follow-partition-lr1))
         (sequential ((spec (compile-lr-spec
                       '((source-file (sequence (reference prefix) (token word)))
                         (prefix (empty))) 'source-file 'reject #f route))
                (runtime (lr-prepare spec)) (table (lr-runtime-table runtime))
                (productions (lr-spec-ref spec 'productions)) (rows (lr-spec-ref spec 'actions)))
           (each (production) (productions)
                       (equal (eq? (vector-ref table (production-id production)) production)  #t))
           (each (row) ((vector->list rows))
              (each (entry) (row)
                 (choose (cadr entry) ((reduce) (scope ((id (caddr entry)))
                               (equal (< id (vector-length table))  #t)
                               (equal (production-id (vector-ref table id))  id))) ((shift) (equal (< (caddr entry) (vector-length rows))  #t)) ((accept) (equal (car entry)  '(terminal eof))) (else (act (error "unexpected non-deterministic cell" entry))))))
           (raises (vector-ref table (vector-length table)) true)
           (sequential ((row (vector-ref rows 0))
                  (invalid (cons (caar row) (list 'reduce (vector-length table))))
                  (bad-rows (list->vector (vector->list rows))))
             (act (vector-set! bad-rows 0 (cons invalid row)))
             (scope ((selector (make-lr-action-selector bad-rows (index-action-rows bad-rows #f) #f #f))
                   (bad-spec (map (lambda (entry) (if (eq? (car entry) 'actions)
                                                  (cons 'actions bad-rows) entry)) spec)))
               (equal (eq? (selector 0 (make-token 'word "x" 0 1)) invalid)  #t)
               (raises (lr-prepare bad-spec) true))))))
    (property "equal grammar bodies retain distinct production IDs and semantic plans"
      (bindings (left '(0 root ((marked (terminal token word) ((alias Left)))) pass #f)) (right '(1 root ((marked (terminal token word) ((alias Right)))) pass #f)) (table (vector left right)) (plans (prepare-lr-reduction-plans 'recognition table)) (children (list (make-recognition-child #f (make-token 'word "x" 2 3)))))
      (equal (eq? (vector-ref table (production-id left)) left)  #t)
      (equal (eq? (vector-ref table (production-id right)) right)  #t)
      (equal (ast-children (reduce-lr-stack-plan (vector-ref plans (production-id left)) (list children) 91))
                '((#f (node Left 2 3 ((#f (token word 2 3)))))))
      (equal (ast-children (reduce-lr-stack-plan (vector-ref plans (production-id right)) (list children) 91))
                '((#f (node Right 2 3 ((#f (token word 2 3))))))))
    (scenario "nonempty labelled and nested values retain action order and AST structure"
      (sequential ((leaf (make-recognition-child #f (make-token 'word "one" 2 5)))
             (labelled (make-recognition-child 'prior (make-token 'word "two" 8 11)))
             (nested (make-recognition-child #f (make-recognition-node 'Existing 8 11 (list labelled))))
             (inputs (list '() (list leaf) (list labelled) (list nested)
                           (recognition-sequence-append (list leaf) (list labelled))
                           (recognition-sequence-append (list leaf labelled) (list nested)))))
        (each (actions) ('(() ((field outer)) ((alias Item)) ((field outer) (alias Item))
           ((alias Item) (field outer)) ((field outer) (field again) (alias Wrapped))))
           (sequential ((production (semantic-production (list actions)))
                  (plan (vector-ref (prepare-lr-reduction-plans 'recognition (vector production)) 0)))
             (each (children) (inputs)
                (each (fused?) ('(#f #t))
                   (parameters ((current-recognition-sequence-fusion-enabled? fused?))
                     (sequential ((before (ast-children children)) (expected (logical-actions actions before 91)))
                       (equal (ast-children (apply-operand-actions children actions 91 make-recognition-fragment))  expected)
                       (equal (ast-children (reduce-lr-stack-plan plan (list children) 91))  expected)
                       (equal (ast-children children)  before)))))))))
    (scenario "source list, reverse stack and vector reductions decode to one ordered AST"
      (each (width) ('(0 1 2 8 16))
         (sequential ((values (map (lambda (n)
                               (if (zero? (modulo n 3)) '()
                                 (list (make-recognition-child (and (odd? n) 'prior)
                                         (make-token 'word "x" (* n 3) (+ (* n 3) 1)))))) (iota width)))
                (chains (map (lambda (n) (if (even? n) '((alias EmptyOrItem) (field slot)) '((field item)))) (iota width)))
                (plan (vector-ref (prepare-lr-reduction-plans 'recognition (vector (semantic-production chains))) 0))
                (storage (make-vector (+ width 2) 'unowned))
                (before (map ast-children values)) (expected (logical-reduction chains values 91)))
           (each (n value) ((iota width) values) (act (vector-set! storage (+ n 2) value)))
           (equal (ast-children (reduce-lr-source-plan plan values 91 make-recognition-fragment))  expected)
           (equal (ast-children (reduce-lr-stack-plan plan (reverse values) 91))  expected)
           (equal (ast-children (reduce-lr-vector-plan plan storage (+ width 2) 91))  expected)
           (equal (vector-ref storage 0)  'unowned)
           (equal (vector-ref storage 1)  'unowned)
           (equal (map ast-children values)  before)))))
