(import :gerbil-parser/language-test-support)
;;; Recognition rules are executable POO values, including independent dialects.
(import :std/test
        (only-in :clan/poo/object .o .ref)
        :gerbil-parser/src/language/part-profile
        (only-in :gerbil-parser/src/language/result-profile compile-result-profile ResultProfile. defresult-profile result-plan-recipe)
        (only-in :gerbil-parser/src/runtime/shell-word make-shell-word-parser)
        (only-in :gerbil-parser/src/runtime/scan make-bounded-text-profile-scanner make-bounded-literal-end-scanner)
        (only-in :gerbil-parser/src/runtime/recognition recognition-node-kind recognition-node-children recognition-child-field)
        (only-in :gerbil-parser/src/runtime/token make-token token-kind token-lexeme token-start token-end)
        (only-in :gerbil-parser/src/language/source declare-source-language source-language-digest)
        (only-in :gerbil-parser/src/runtime/source-engines ShellSourceStrategy.)
        (only-in :gerbil-parser/t/fixtures/bash-products bash-commands bash-parts bash-simple-binding bash-parameter-binding bash-assignment-binding bash-results bash-word-regions bash-command-scanner bash-source-language))

(def (rejects? thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(defpart-profile (template-parts :: self PartProfile.)
 (contexts word HereDocument)
 (bindings (template (.o (:: self BindingProfile.))))
 (rules ((word HereDocument) (prefix "@" next) (name SimpleParameter template)))
 (literal LiteralPart))
(defpart-profile (literal-parts :: self template-parts) (rules))
(defresult-profile (template-results :: self ResultProfile.)
 (projections
  (Word TemplateWord ((parts parts)) (many fragment parts))
  (HereDocumentLine TemplateBody ((parts parts)) (many fragment parts))
  (LiteralPart TemplateLiteral ((text span)) (token content text text required))
  (SimpleParameter TemplateName ((text span)) (token identifier name text required))))
(def (components profile text)
  (let-values (((word assignment here)
                (make-shell-word-parser bash-word-regions (compile-result-profile bash-results)
                 (admit-part-plan (compile-part-profile profile) (compile-result-profile bash-results) bash-word-regions))))
    (word (make-token 'word text 0 (u8vector-length (string->utf8 text))))))
(def (assignment-components profile text)
  (let-values (((word assignment here)
                (make-shell-word-parser bash-word-regions (compile-result-profile bash-results)
                 (admit-part-plan (compile-part-profile profile) (compile-result-profile bash-results) bash-word-regions))))
    (assignment (make-token 'word text 0 (u8vector-length (string->utf8 text))))))
(deflanguage-parser-tests part-profile-test "closed part recognition plans"
  (engine)
  (scenario "independent template projection replaces every public word field and terminal through POO"
   (sequential ((results (compile-result-profile template-results))
          (parts (admit-part-plan (compile-part-profile template-parts) results bash-word-regions)))
     (scope-values (((word assignment here) (make-shell-word-parser bash-word-regions results parts)))
       (scope-values (((node tokens) (word (make-token 'raw "α@name😀" 7 18))))
         (equal (recognition-node-kind node)  'TemplateWord)
         (equal (map recognition-child-field (recognition-node-children node))  '(fragment fragment fragment))
         (equal (map token-kind tokens)  '(text name text))
         (equal (map token-start tokens)  '(7 9 14))
         (equal (map token-end tokens)  '(9 14 18)))
       (scope-values (((node tokens) (here (make-token 'raw "中@name" 0 8))))
         (equal (recognition-node-kind node)  'TemplateBody)
         (equal (map token-kind tokens)  '(text name))))))
  (scenario "missing word projection rejects and projection-only change alters Source identity"
   (sequential ((projection-declarations (caddr (result-plan-recipe (compile-result-profile bash-results))))
          (replacement (map (lambda (row) (if (eq? (car row) 'Word)
                                         (cons 'Word (cons 'HereDocumentLine (cddr row))) row)) projection-declarations))
          (result-override (.o (:: self bash-results) projections: replacement)))
     (equal (rejects? (lambda () (admit-part-plan (compile-part-profile bash-parts)
                      (compile-result-profile (.o (:: self bash-results) projections: '())) bash-word-regions)))  #t)
     (scope ((changed (declare-source-language "bash" "5.3" "bash-5.3-structured-source.v1"
                     (.o (:: self ShellSourceStrategy.) regions: bash-word-regions scanner: bash-command-scanner
                          results: result-override parts: bash-parts commands: bash-commands))))
       (equal (equal? (source-language-digest changed) (source-language-digest bash-source-language))  #f))))
  (scenario "independent template uses the same execution operations and exact UTF-8 spans"
   (scope-values (((node tokens) (components template-parts "α@name😀")))
     (equal (recognition-node-kind node)  'Word)
     (equal (map token-kind tokens)  '(LiteralPart SimpleParameter LiteralPart))
     (equal (map token-lexeme tokens)  '("α" "@name" "😀"))
     (equal (map token-start tokens)  '(0 2 7))
     (equal (map token-end tokens)  '(2 7 11)))
   (scope-values (((node tokens) (components literal-parts "α@name😀")))
     (equal (map token-kind tokens)  '(LiteralPart))
     (equal (map token-lexeme tokens)  '("α@name😀"))))
  (scenario "non-ASCII prefixes use the same ordered recognition and byte projection"
   (scope-values (((node tokens)
                 (components (.o (:: self template-parts)
                                 rules: '(((word HereDocument) (prefix "λ" next) (name SimpleParameter template))))
                             "中λname😀")))
     (equal (map token-lexeme tokens)  '("中" "λname" "😀"))
     (equal (map token-start tokens)  '(0 3 9))
     (equal (map token-end tokens)  '(3 9 13))))
  (property "one matcher controls literal boundary and recognition precedence"
      (bindings (plan (compile-part-profile bash-parts)))
      (equal (part-step-kind (part-plan-match plan "$((1))" 0 6 'word))  'ArithmeticExpansion)
      (equal (part-step-kind (part-plan-match plan "$(x)" 0 4 'word))  'CommandSubstitution)
      (equal (part-plan-match plan "$x" 0 2 'SingleQuoted)  #f)
      (equal (part-plan-literal-end plan "a$x" 0 3 'word)  1)
      (equal (part-plan-literal-end plan "a$x" 0 3 'SingleQuoted)  3)
      (equal (part-plan-match plan "\\q" 0 2 'HereDocument)  #f)
      (equal (part-step-operation (part-plan-match plan "\\$" 0 2 'HereDocument))  'escape)
      (equal (rejects? (lambda () (part-plan-match plan "x" 0 1 'undeclared)))  #t))
  (scenario "literal runs agree with complete matching at every candidate boundary"
   (scope ((plan (compile-part-profile bash-parts)))
     (each (context) ('(word HereDocument SingleQuoted))
       (each (text) ((list "plain" "中λ😀" "a$" "a$%b$x" "a\\qb\\$c" "a$(x)b" "a$((1))b" "a'α'b"))
         (scope ((end (string-length text)))
           (iterate starts ((start 0))
             (when (< start end)
               (equal (part-plan-literal-end plan text start end context)
                       (let reference ((offset (+ start 1)))
                           (if (or (= offset end) (part-plan-match plan text offset end context))
                             offset (reference (+ offset 1)))))
               (continue starts (+ start 1))))))))
   (sequential ((profile (.o (:: self template-parts)
                       rules: '(((word HereDocument) (prefix "λ" next) (name SimpleParameter template)))))
          (plan (compile-part-profile profile)))
     (equal (part-plan-literal-end plan "中λ" 0 2 'word)  2)
     (equal (part-plan-literal-end plan "中λx" 0 3 'word)  1)))
  (scenario "literal scanning terminates on empty ranges and rejects invalid bounds"
   (scope ((plan (compile-part-profile bash-parts)))
     (equal (part-plan-literal-end plan "" 0 0 'word)  0)
     (equal (part-plan-literal-end plan "αx" 1 1 'word)  1)
     (each (range) ('((-1 2) (2 1) (0 3) (0 1/2) (1/2 2)))
       (equal (rejects? (lambda () (part-plan-literal-end plan "αx" (car range) (cadr range) 'word)))  #t))))
  (scenario "unknown dollars preserve token grouping instead of dropping boundaries"
   (scope-values (((node tokens) (components bash-parts "a$%b$x")))
     (equal (map token-kind tokens)  '(LiteralPart LiteralPart SimpleParameter))
     (equal (map token-lexeme tokens)  '("a" "$%b" "$x"))))
  (scenario "owned declarations and returned recipes cannot mutate executable dispatch"
   (sequential ((declarations (list (list '(word HereDocument) (list 'prefix (string-copy "@") 'next) '(name SimpleParameter template))))
          (profile (.o (:: self template-parts) rules: declarations))
          (plan (compile-part-profile profile)) (recipe (part-plan-recipe plan)))
     (act (string-set! (cadadr (car declarations)) 0 #\!))
     (act (string-set! (cadadr (caadr recipe)) 0 #\!))
     (equal (part-step-kind (part-plan-match plan "@x" 0 2 'word))  'SimpleParameter)
     (equal (part-plan-match plan "!x" 0 2 'word)  #f)))
  (scenario "malformed contexts, matchers, operations and ambiguous duplicates reject"
   (each (profile) ((list (.o (:: self template-parts) contexts: '(word word))
          (.o (:: self template-parts) rules: '(((other) (prefix "@" next) (name SimpleParameter template))))
          (.o (:: self template-parts) rules: '(((word) (prefix "" any) (escape EscapeSequence))))
          (.o (:: self template-parts) rules: '(((word) (prefix "@" any) (callback arbitrary))))
          (.o (:: self template-parts) rules: '(((word) (prefix "@" any) (pair CommandSubstitution 2 1))))
          (.o (:: self template-parts) rules: (append (.ref template-parts 'rules) (.ref template-parts 'rules))))) (equal (rejects? (lambda () (compile-part-profile profile)))  #t)))
  (scenario "loader admission rejects result and region disagreement before source execution"
   (each (profile) ((list (.o (:: self template-parts) literal: 'Undeclared)
          (.o (:: self template-parts) rules: '(((word) (prefix "@" next) (name Undeclared template))))
          (.o (:: self template-parts) rules: '(((word) (prefix "@(" any) (pair CommandSubstitution 2 1))))
          (.o (:: self bash-parts) rules: '(((word) (prefix "$((" any) (pair ArithmeticExpansion 3 1))))))
               (equal (rejects? (lambda () (admit-part-plan (compile-part-profile profile)
                                             (compile-result-profile bash-results) bash-word-regions)))  #t)))
  (scenario "bounded lexical profiles and tries cannot see outside the current body"
   (scope ((name (make-bounded-text-profile-scanner '(run (alphabetic) 1 #f)))
         (operator (make-bounded-literal-end-scanner '(":" ":-"))))
     (equal (name "αβgamma" 0 2)  2)
     (equal (name "αβgamma" 2 2)  #f)
     (equal (operator ":-x" 0 1)  1)
     (equal (operator ":-x" 0 2)  2)
     (equal (operator ":-x" 0 0)  #f)
     (equal (name "x" 0 2)  #f)))
  (property "parameter, simple and assignment names execute the shared text algebra"
      (bindings (plan (compile-part-profile bash-parts)) (parameter (part-plan-binding plan 'parameter)) (simple (part-plan-binding plan 'simple)) (assignment (part-plan-binding plan 'assignment)))
      (equal (binding-plan-name-end parameter "123x" 0 4)  3)
      (equal (binding-plan-name-end simple "123x" 0 4)  1)
      (equal (binding-plan-name-end parameter "α_1:-x" 0 6)  3)
      (equal (binding-plan-name-end assignment "1x=" 0 3)  0)
      (equal (binding-plan-prefix-end parameter "#" 0 1)  #f)
      (equal (binding-plan-prefix-end parameter "#α" 0 2)  1)
      (equal (binding-plan-operator-end parameter "##rest" 0 6)  2))
  (scenario "independent assignment syntax inherits the same projection without callbacks"
   (sequential ((binding (.o (:: self BindingProfile.) operators: '("=" ":=")))
          (profile (.o (:: self template-parts) bindings: (list (cons 'template (.o (:: name BindingProfile.)))
                                                            (cons 'assignment binding)))))
     (scope-values (((node tokens) (assignment-components profile "α:=中@name")))
       (equal (recognition-node-kind node)  'Assignment)
       (equal (map token-lexeme tokens)  '("α" ":=" "中" "@name"))
       (equal (map token-start tokens)  '(0 2 4 7)))
     (scope-values (((node tokens) (assignment-components profile "1α:=中"))) (equal node  #f))))
  (scenario "binding recipes own value overrides and reject nullable names or missing references"
   (sequential ((operator-declarations (list (string-copy ":=")))
          (binding (.o (:: self BindingProfile.) operators: operator-declarations))
          (profile (.o (:: self template-parts) bindings: (list (cons 'template binding))))
          (plan (compile-part-profile profile)) (recipe (part-plan-recipe plan)))
     (act (string-set! (car operator-declarations) 0 #\!))
     (act (string-set! (car (caddr (cadar (list-ref recipe 3)))) 0 #\!))
     (equal (binding-plan-operator-end (part-plan-binding plan 'template) ":=x" 0 3)  2))
   (each (profile) ((list (.o (:: self template-parts) bindings: '())
          (.o (:: self template-parts) bindings: (list (cons 'template (.o (:: binding BindingProfile.)
                                                                     name: '(run (alphabetic) 0 #f)))))
          (.o (:: self template-parts) bindings: (list (cons 'template (.o (:: binding BindingProfile.) operators: '("=" "="))))))) (equal (rejects? (lambda () (compile-part-profile profile)))  #t)))
  (property "recognition values participate in source identity without changing source schema"
      (bindings (changed (declare-source-language "bash" "5.3" "bash-5.3-structured-source.v1"
                  (.o (:: self ShellSourceStrategy.) regions: bash-word-regions scanner: bash-command-scanner
                      results: bash-results parts: literal-parts commands: bash-commands))))
      (equal (equal? (source-language-digest changed) (source-language-digest bash-source-language))  #f)))
