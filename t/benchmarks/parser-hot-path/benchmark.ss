((benchmarkKind . scenario-e2e)
 (max_total . 900ms)
 (target_total . 600ms)
 (regression_budget . 300ms)
 (expected_over_input_budget . 15ms)
 (targetRationale . "one thousand generated parser invocations target a 600ms p95 envelope with a 900ms admission ceiling")
 (sampleCount . 20)
 (rule . GERBIL-PARSER-HOT-PATH)
 (feature . generic-generated-parser)
 (optimizationFocus . "hygienic GrammarExpr expansion without runtime grammar interpretation")
 (inputShape . "one thousand 25-byte arithmetic expressions per sample")
 (expectedOutcome . "lossless ParseArtifact publication remains below the 900ms admission ceiling")
 (measurementPhases collect-before collect-after policy-before policy-after
                    assert-time-gate observe-runtime-memory)
 (tags performance hot-path generated-parser))
