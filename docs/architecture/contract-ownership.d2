direction: right
fields: "POO Record\nfield inventory + normalization"
admit: "Core Contract\nancestry + evidence + returned candidate"
domain: "Parser\ngrammar composition obligations"
fields -> admit
admit -> domain
lists: "Utilities\nordered merge + explicit presence\nshared append-unique"
leaves: "LR leaf vocabulary\nterminal + precedence"
producer: "Compiler\nbounded indexes + flat forks\nnonempty terminals"
selector: "Runtime selector\nprojected layout + recursive actions"
leaves -> producer
leaves -> selector
schema: "src/schema.ss\nexisting format identity"
schema -> producer
schema -> selector
controls: "Regression controls\nnormalization / mutation / false row\nphase boundaries / order / exception identity"
admit -> controls
lists -> controls
producer -> controls
selector -> controls
