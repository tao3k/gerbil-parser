;;; Native caller qualification for regular DFA start-state specialization.
(import (only-in :gerbil-parser/src/runtime/scan make-ranked-regular-scanner)
        (only-in :gerbil-parser/src/runtime/parse-cost admit-parser-allocation)
        (only-in :gerbil-parser/languages/hcl/parser hcl-parser)
        (only-in :gerbil-parser/src/runtime/lexer lex-source)
        (only-in :gerbil-parser/src/compiler/hcl-source direct-lex-hcl))
(export benchmark-regular-mode)
(def (measure-regular-mode name run valid? samples iterations)
  (let sample ((index 0))
    (when (< index samples)
      (let* ((before (##process-statistics))
             (last (let repeat ((count 0) (last #f))
                     (if (= count iterations) last (repeat (+ count 1) (run)))))
             (after (##process-statistics))
             (delta (lambda (slot) (- (f64vector-ref after slot) (f64vector-ref before slot)))))
        (unless (valid? last) (error "regular mode product mismatch" name))
        (write (list 'regular-mode name index 'iterations iterations
                     'cpu-ms-per-call (/ (* 1000 (+ (delta 0) (delta 1))) iterations)
                     'allocated-bytes-per-call
                     (let (bytes (admit-parser-allocation (delta 7) (delta 6)))
                       (and bytes (/ bytes iterations)))))
        (newline) (force-output))
      (sample (+ index 1)))))
(def (benchmark-regular-mode (samples 11) (iterations 100))
  (unless (and (exact-integer? samples) (positive? samples)
               (exact-integer? iterations) (positive? iterations))
    (error "regular mode benchmark requires positive exact counts"))
  (let* ((scan (make-ranked-regular-scanner
               '((whitespace+ white 0 0) (horizontal-whitespace+ horizontal 3 1)
                 (newline+ newline 2 2) (decimal-digit+ digits 1 3)
                 (identifier name 0 4) (number number 0 5))))
         (ascii (make-string 4096 #\a)) (wide (make-string 4096 #\α))
         (space (make-string 4096 #\space)) (digits (make-string 4096 #\1)))
    (for-each (lambda (row)
      (let ((text (car row)) (expected (cadr row)) (name (caddr row)))
        (measure-regular-mode name (lambda () (scan text 0))
          (lambda (found) (equal? found expected)) samples iterations)))
      (list (list ascii '(name 4096 0 4) 'ascii-identifier)
            (list wide '(name 4096 0 4) 'unicode-identifier)
            (list space '(horizontal 4096 3 1) 'whitespace)
            (list digits '(digits 4096 1 3) 'numeric)
            (list "a" '(name 1 0 4) 'singleton)
            (list "?" #f 'unmatched))))
  (let* ((source (call-with-output-string (lambda (port)
                   (for-each (lambda (n) (display "key" port) (display n port)
                               (display " = " port) (display n port) (newline port)) (iota 64)))))
         (expected (direct-lex-hcl source)))
    (unless (equal? (lex-source hcl-parser source) expected)
      (error "independent HCL lexer reference mismatch"))
    (measure-regular-mode 'complete-hcl-lexer (lambda () (lex-source hcl-parser source))
      (lambda (found) (equal? found expected)) samples 20))
  (displayln "REGULAR-MODE-OK") (force-output))
