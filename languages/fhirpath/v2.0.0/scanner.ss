(export scan-fhirpath-identifier
        scan-fhirpath-delimited-identifier
        scan-fhirpath-string
        scan-fhirpath-number
        scan-fhirpath-date
        scan-fhirpath-datetime
        scan-fhirpath-time)

(def (scan-while source start predicate)
  (let (length (string-length source))
    (let loop ((offset start))
      (if (and (< offset length) (predicate (string-ref source offset)))
        (loop (+ offset 1))
        offset))))

(def (ascii-letter? character)
  (or (and (char>=? character #\A) (char<=? character #\Z))
      (and (char>=? character #\a) (char<=? character #\z))))

(def (identifier-start? character)
  (or (ascii-letter? character) (char=? character #\_)))

(def (identifier-continue? character)
  (or (identifier-start? character) (char-numeric? character)))

(def (scan-fhirpath-identifier source start)
  (and (< start (string-length source))
       (identifier-start? (string-ref source start))
       (scan-while source (+ start 1) identifier-continue?)))

(def (hex-character? character)
  (or (char-numeric? character)
      (and (char>=? character #\a) (char<=? character #\f))
      (and (char>=? character #\A) (char<=? character #\F))))

(def (escaped-end source slash-offset)
  (let* ((length (string-length source))
         (escape-offset (+ slash-offset 1)))
    (and (< escape-offset length)
         (let (escape (string-ref source escape-offset))
           (cond
            ((memv escape '(#\` #\' #\\ #\/ #\f #\n #\r #\t))
             (+ escape-offset 1))
            ((and (char=? escape #\u)
                  (<= (+ escape-offset 5) length)
                  (let loop ((offset (+ escape-offset 1)))
                    (or (= offset (+ escape-offset 5))
                        (and (hex-character? (string-ref source offset))
                             (loop (+ offset 1))))))
             (+ escape-offset 5))
            (else #f))))))

(def (scan-quoted source start quote)
  (let (length (string-length source))
    (and (< start length)
         (char=? (string-ref source start) quote)
         (let loop ((offset (+ start 1)))
           (and (< offset length)
                (let (character (string-ref source offset))
                  (cond
                   ((char=? character quote) (+ offset 1))
                   ((char=? character #\\)
                    (alet (end (escaped-end source offset))
                      (loop end)))
                   (else (loop (+ offset 1))))))))))

(def (scan-fhirpath-delimited-identifier source start)
  (scan-quoted source start #\`))

(def (scan-fhirpath-string source start)
  (scan-quoted source start #\'))

(def (scan-digits source start count)
  (let (end (+ start count))
    (and (<= end (string-length source))
         (let loop ((offset start))
           (or (= offset end)
               (and (char-numeric? (string-ref source offset))
                    (loop (+ offset 1)))))
         end)))

(def (scan-fhirpath-number source start)
  (and (< start (string-length source))
       (char-numeric? (string-ref source start))
       (let* ((integer-end (scan-while source start char-numeric?))
              (length (string-length source)))
         (if (and (< integer-end length)
                  (char=? (string-ref source integer-end) #\.)
                  (< (+ integer-end 1) length)
                  (char-numeric? (string-ref source (+ integer-end 1))))
           (scan-while source (+ integer-end 1) char-numeric?)
           integer-end))))

(def (scan-date-format source start)
  (alet (year-end (scan-digits source start 4))
    (let (length (string-length source))
      (if (and (< year-end length)
               (char=? (string-ref source year-end) #\-))
        (alet (month-end (scan-digits source (+ year-end 1) 2))
          (if (and (< month-end length)
                   (char=? (string-ref source month-end) #\-))
            (scan-digits source (+ month-end 1) 2)
            month-end))
        year-end))))

(def (scan-time-format source start)
  (alet (hour-end (scan-digits source start 2))
    (let (length (string-length source))
      (if (and (< hour-end length)
               (char=? (string-ref source hour-end) #\:))
        (alet (minute-end (scan-digits source (+ hour-end 1) 2))
          (if (and (< minute-end length)
                   (char=? (string-ref source minute-end) #\:))
            (alet (second-end (scan-digits source (+ minute-end 1) 2))
              (if (and (< second-end length)
                       (char=? (string-ref source second-end) #\.)
                       (< (+ second-end 1) length)
                       (char-numeric? (string-ref source (+ second-end 1))))
                (scan-while source (+ second-end 1) char-numeric?)
                second-end))
            minute-end))
        hour-end))))

(def (scan-timezone source start)
  (let (length (string-length source))
    (cond
     ((and (< start length) (char=? (string-ref source start) #\Z))
      (+ start 1))
     ((and (< start length)
           (memv (string-ref source start) '(#\+ #\-)))
      (alet (hour-end (scan-digits source (+ start 1) 2))
        (and (< hour-end length)
             (char=? (string-ref source hour-end) #\:)
             (scan-digits source (+ hour-end 1) 2))))
     (else start))))

(def (scan-fhirpath-date source start)
  (and (< start (string-length source))
       (char=? (string-ref source start) #\@)
       (alet (end (scan-date-format source (+ start 1)))
         (and (or (= end (string-length source))
                  (not (char=? (string-ref source end) #\T)))
              end))))

(def (scan-fhirpath-datetime source start)
  (and (< start (string-length source))
       (char=? (string-ref source start) #\@)
       (alet (date-end (scan-date-format source (+ start 1)))
         (and (< date-end (string-length source))
              (char=? (string-ref source date-end) #\T)
              (let ((time-start (+ date-end 1))
                    (length (string-length source)))
                (if (and (< time-start length)
                         (char-numeric? (string-ref source time-start)))
                  (alet (time-end (scan-time-format source time-start))
                    (scan-timezone source time-end))
                  time-start))))))

(def (scan-fhirpath-time source start)
  (let (length (string-length source))
    (and (< (+ start 2) length)
         (char=? (string-ref source start) #\@)
         (char=? (string-ref source (+ start 1)) #\T)
         (scan-time-format source (+ start 2)))))
