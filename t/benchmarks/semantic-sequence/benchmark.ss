#!/usr/bin/env gxi
;;; Same-head join policies: tokens are prebuilt; every construction root stays live.
(import :gerbil-parser/src/runtime/event-program
        (only-in :gerbil-parser/src/runtime/token make-token))
(def (median values)
  (let* ((sorted (list-sort < values)) (mid (quotient (length sorted) 2)))
    (/ (+ (list-ref sorted (- mid 1)) (list-ref sorted mid)) 2.0)))
(def (build append-code tokens count)
  (let loop ((i 0) (code #f) (roots '()))
    (if (= i count) roots
      (let (next (append-code code (vector-ref tokens i)))
        (loop (+ i 1) next (cons next roots))))))
(def (check-sequence sequence tokens count)
  (let (i 0)
    (event-program-sequence-for-each
     (lambda (field value delta moved?)
       (unless (and (not field) (eq? value (vector-ref tokens i)) (= delta 0) (not moved?))
         (error "producer token identity or movement changed"))
       (set! i (+ i 1))) sequence)
    (unless (and (= i count) (= (event-program-sequence-start sequence 0) 0)
                 (= (event-program-sequence-end sequence 0) count))
      (error "producer count/bounds changed"))))
(def (measure family units mode tokens)
  (let* ((append-code (if (eq? mode 'avl) event-program-append/avl event-program-append))
         (parent (and (eq? family 'retained-root-forks) (car (build append-code tokens units))))
         (operations (if parent 128 (* 8 units)))
         (times '()) (allocations '()) (lives '()))
    (for-each
     (lambda (sample)
       (##gc)
       (let* ((before (##process-statistics)) (start (cpu-time))
              (roots (if parent
                       (map (lambda (_) (append-code parent (vector-ref tokens units))) (iota 128))
                       (map (lambda (_) (build append-code tokens units)) (iota 8))))
              (elapsed (* 1000.0 (- (cpu-time) start))))
         ;; Collection is outside CPU timing and settles process allocation/live counters.
         (##gc)
         (let* ((after (##process-statistics))
                (allocated (- (f64vector-ref after 16) (f64vector-ref before 16)))
                (live (- (f64vector-ref after 17) (f64vector-ref before 17))))
           (if parent
             (begin (check-sequence parent tokens units)
                    (check-sequence (car roots) tokens (+ units 1))
                    (check-sequence (last roots) tokens (+ units 1)))
             (for-each
              (lambda (history)
                (check-sequence (car history) tokens units)
                (check-sequence (list-ref history (quotient units 2)) tokens (- units (quotient units 2)))
                (check-sequence (last history) tokens 1)) roots))
           (set! times (cons elapsed times))
           (set! allocations (cons allocated allocations))
           (set! lives (cons live lives))
           (write (list 'sequence-sample family units mode sample elapsed allocated live))
           (newline) (force-output)))) (iota 20))
    (list (cons 'mode mode) (cons 'samples 20) (cons 'operations operations)
          (cons 'cpu-samples-ms (reverse times)) (cons 'cpu-median-ms (median times))
          (cons 'allocation-samples-bytes (reverse allocations))
          (cons 'allocation-median-bytes (median allocations))
          (cons 'retained-live-samples-bytes (reverse lives))
          (cons 'retained-live-median-bytes (median lives)))))
(def (main . args)
  (for-each
   (lambda (family)
     (for-each
      (lambda (units)
        (let (tokens (list->vector (map (lambda (i) (make-token 'number "1" i (+ i 1))) (iota (+ units 1)))))
          (for-each
           (lambda (order)
             (for-each
              (lambda (mode)
                (write (append (list (cons 'workload 'persistent-sequence-construction)
                                     (cons 'family family) (cons 'input-units units)
                                     (cons 'order order) (cons 'retained-roots-equal? #t))
                               (measure family units mode tokens)))
                (newline) (force-output))
              (if (= order 1) '(avl append-buffer) '(append-buffer avl)))) '(1 2))))
      (if (eq? family 'linear-retained-roots) '(400 800 1600) '(256 512 1024))))
   '(linear-retained-roots retained-root-forks))
  (displayln "SEMANTIC-SEQUENCE-ALL-OK"))
(export main)
