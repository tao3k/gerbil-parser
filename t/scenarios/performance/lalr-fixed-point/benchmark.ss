((benchmarkKind . scenario-e2e)
 (max_total . 500ms)
 (target_total . 250ms)
 (regression_budget . 250ms)
 (expected_over_input_budget . 250ms)
 (targetRationale . "ten paired classic grammar compilations must retain exactly-once LR(0) state visits within the compiler hot-path budget")
 (sampleCount . 20)
 (rule . GERBIL-PARSER-LALR-FIXED-POINT)
 (feature . lalr-fixed-point-compilation)
 (optimizationFocus . "fixed LR(0) automaton construction plus delta-only lookahead propagation")
 (inputShape . "ten repetitions of the shared-lookahead and precedence expression grammar pair per sample")
 (expectedOutcome . "every LR(0) state is visited exactly once while all lookahead propagation reaches a finite fixed point")
 (measurementPhases collect-before collect-after policy-before policy-after
                    assert-time-gate observe-runtime-memory)
 (tags performance integration compiler lalr fixed-point))
