;;; Complete request extraction, AST replay and canonical event products.
(import :std/test
        (only-in :std/string/utf8 string-utf8-length)
        (only-in :gerbil-parser/t/fixtures/lr-request-product extract-value extract-token extract-event replay-request reference-events)
        (only-in :gerbil-parser/t/fixtures/runtime-record-assignments/languages/records/grammar records-parser)
        (only-in :gerbil-parser/languages/arithmetic/grammar arithmetic-parser)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-runtime parser-machine-ir
                 parser-machine-trivia parser-machine-grammar-digest)
        (only-in :gerbil-parser/src/compiler/lr lr-spec-ref production-table)
        (only-in :gerbil-parser/src/runtime/token make-token token-kind token-lexeme token-start token-end)
        (only-in :gerbil-parser/src/runtime/lexer lex-source)
        (only-in :gerbil-parser/src/runtime/significant parser-significant-tokens)
        (only-in :gerbil-parser/src/runtime/recognition make-recognition-node make-recognition-child recognition-child-value)
        (only-in :gerbil-parser/src/runtime/funcs recognition-sequence-root-child)
        (only-in :gerbil-parser/src/runtime/lr-parser lr-parse/prepared lr-recognition-project
                 current-lr-recognition-observer current-lr-event-program-enabled?)
        (only-in :gerbil-parser/src/runtime/artifact make-success-parse-artifact parse-artifact-events
                 parse-artifact-valid? parse-artifact-roundtrip)
        (only-in :gerbil-parser/src/runtime/event-program event-program-value?)
        (only-in :gerbil-parser/src/runtime/parser parse-source))
(export lr-request-product-test)
(def (check-request-product machine source)
  (let* ((tokens (lex-source machine source)) (significant (parser-significant-tokens machine tokens))
         (runtime (parser-machine-runtime machine)) (trivia? (parser-machine-trivia machine))
         (digest (parser-machine-grammar-digest machine)) (captured #f))
    (parameterize ((current-lr-event-program-enabled? #f)
                   (current-lr-recognition-observer (lambda (value) (set! captured value))))
      (let-values (((root rest) (lr-parse/prepared runtime significant)))
        (check rest => '())
        (let* ((extracted (extract-value root))
               (projected (recognition-child-value (recognition-sequence-root-child (lr-recognition-project captured tokens))))
               (expected (reference-events extracted tokens trivia? (string-utf8-length source)))
               (artifact (make-success-parse-artifact digest source tokens root trivia?))
               (events (parse-artifact-events artifact)))
          (check (extract-value projected) => extracted)
          (let* ((spec (cdr (assq 'lr-spec (parser-machine-ir machine)))) (table (production-table (lr-spec-ref spec 'productions))))
            (let-values (((instructions values) (replay-request table captured significant)))
              (check (list values) => (list (list (list #f extracted))))
              (check (length (filter (lambda (instruction) (eq? (car instruction) 'shift)) instructions)) => (length significant))
              (check (> (length instructions) (length significant)) => #t)))
          (check (map extract-event events) => expected)
          (check (parse-artifact-valid? artifact) => #t)
          (check (parse-artifact-roundtrip artifact) => source)
          (check (map extract-event (parse-artifact-events (parse-source machine source))) => expected)
          (parameterize ((current-lr-event-program-enabled? #t) (current-lr-recognition-observer #f))
            (let-values (((program rest) (lr-parse/prepared runtime significant)))
              (check (event-program-value? program) => #t)
              (check rest => '())
              (let (product (make-success-parse-artifact digest source tokens program trivia?))
                (check (map extract-event (parse-artifact-events product)) => expected)
                (check (parse-artifact-valid? product) => #t)
                (check (parse-artifact-roundtrip product) => source)))))))))
(def lr-request-product-test
  (test-suite "complete LR request AST and event correspondence"
    (test-case "empty, trivia, Unicode and 64-record requests share AST and event meaning"
      (for-each (lambda (source) (check-request-product records-parser source))
                (list "" " \t " "  alpha = \"λ\"\n beta=22 \n " (apply string-append (make-list 64 "alpha=1\n")))))
    (test-case "arithmetic precedence and fields use the same complete-request adapter"
      (for-each (lambda (source) (check-request-product arithmetic-parser source))
                '("1" " 1 + 2 * name " "(1 + 2) * 3")))
    (test-case "malformed native event extraction rejects widths, tags and payload types"
      (for-each (lambda (event) (check-exception (extract-event event) true))
                (list #f '#() '#(token 0 word "x" 0) '#(token -1 word "x" 0 1)
                      '#(token 0 word #f 0 1) '#(token 1.0 word "x" 0 1) '#(start-node 0 Root) '#(start-field name -1)
                      '#(unknown 0 Root 0))))
    (test-case "source binding and root admission fail closed before publication"
      (let* ((token (make-token 'word "x" 0 1)) (other (make-token 'word "y" 0 1))
             (root (make-recognition-node 'Root 0 1 (list (make-recognition-child #f token))))
             (tree (extract-value root)))
        (check-exception (reference-events tree (list other) (lambda (_) #f) 1) true)
        (check-exception (make-success-parse-artifact "test" "y" (list other) root (lambda (_) #f)) true)
        (let ((missing (make-recognition-node 'Root 0 1 '())))
          (check-exception (reference-events (extract-value missing) (list token) (lambda (_) #f) 1) true)
          (check-exception (make-success-parse-artifact "test" "x" (list token) missing (lambda (_) #f)) true))
        (check-exception (reference-events (extract-token token) (list token) (lambda (_) #f) 1) true)
        (check-exception (make-success-parse-artifact "test" "x" (list token) token (lambda (_) #f)) true)))))
