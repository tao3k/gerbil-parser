;;; Closed recognition rules compile once to context/first-character dispatch.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in :clan/poo/mop define-type validate)
        (only-in :core/types PooFlowContract. poo-flow-classification-evidence)
        (only-in ../runtime/region-scanner source-prefix-at? region-plan-specification prepare-region-plan)
        (only-in ../runtime/scan make-bounded-text-profile-scanner make-bounded-literal-end-scanner)
        (only-in ../grammar/lexical-algebra text-profile-data)
        (only-in ./result-profile result-plan-projection))
(export BindingProfile. defbinding-profile binding-plan-name-end binding-plan-prefix-end
        binding-plan-operator-end binding-plan-subscript-at? binding-plan-subscript-width binding-plan-region-plan binding-plan-region-scopes part-plan-binding part-step-binding
        PartProfile. PartProfileContract defpart-profile compile-part-profile
        part-plan? part-plan-recipe part-plan-literal part-plan-match part-plan-literal-end
        part-step-operation part-step-kind part-step-opening part-step-closing part-step-delimiter
        part-plan-name-end admit-part-plan
        part-plan-context part-context-match part-context-literal-end)
(def PartProfile. (.o contexts: '() rules: '() literal: 'LiteralPart bindings: '()))
(defstruct part-step (operation kind opening closing delimiter binding))
(defstruct part-rule (prefix guard step))
(defstruct part-context-index (ascii wide))
(def (context-rules context character)
  (let (code (char->integer character))
    (if (< code 128) (vector-ref (part-context-index-ascii context) code)
      (or (hash-get (part-context-index-wide context) character) '()))))
(def (context-rules-put! context character rules)
  (let (code (char->integer character))
    (if (< code 128) (vector-set! (part-context-index-ascii context) code rules)
      (hash-put! (part-context-index-wide context) character rules))))
(defstruct part-plan (recipe-field dispatch literal bindings))
(def (copy-datum value)
  (cond ((pair? value) (cons (copy-datum (car value)) (copy-datum (cdr value))))
        ((string? value) (string-copy value)) (else value)))
(def (distinct? values)
  (let loop ((remaining values) (seen '()))
    (or (null? remaining)
        (and (not (member (car remaining) seen))
             (loop (cdr remaining) (cons (car remaining) seen))))))
(def BindingProfile.
  (.o name: '(seq (run (union (alphabetic) (characters "_")) 1 1)
                 (run (union (alphabetic) (numeric) (characters "_")) 0 #f))
      prefixes: '() operators: '() subscript: #f))
(defstruct binding-plan (recipe name prefix operator subscript-field))
(def (compile-binding profile)
  (unless (object? profile) (error "binding profile requires a POO value"))
  (let* ((name (copy-datum (.ref profile 'name))) (prefixes (copy-datum (.ref profile 'prefixes)))
         (operators (copy-datum (.ref profile 'operators))) (subscript (copy-datum (.ref profile 'subscript))))
    (unless (and (list? prefixes) (list? operators) (distinct? prefixes) (distinct? operators)
                 (andmap (lambda (text) (and (string? text) (> (string-length text) 0))) (append prefixes operators))
                 (or (not subscript)
                     (and (list? subscript) (= (length subscript) 2)
                          (string? (car subscript)) (> (string-length (car subscript)) 0) (char? (cadr subscript)))))
      (error "invalid binding profile slots"))
    (make-binding-plan (list name prefixes operators subscript)
                      (make-bounded-text-profile-scanner name)
                      (make-bounded-literal-end-scanner prefixes)
                      (make-bounded-literal-end-scanner operators) subscript)))
(def (binding-plan-name-end plan text start end)
  (or ((binding-plan-name plan) text start end) start))
(def (binding-plan-prefix-end plan text start end)
  ;; A prefix requires an actual following body character, as declared syntax.
  ((binding-plan-prefix plan) text start (max start (- end 1))))
(def (binding-plan-operator-end plan text start end)
  ((binding-plan-operator plan) text start end))
(def (binding-plan-subscript-width plan)
  (let (spec (binding-plan-subscript-field plan)) (and spec (string-length (car spec)))))
(def (binding-plan-subscript-at? plan text start end)
  (let (spec (binding-plan-subscript-field plan))
    (and spec (<= (+ start (string-length (car spec))) end) (source-prefix-at? text start (car spec)))))
(def (binding-plan-region-plan plan regions)
  (let (subscript (binding-plan-subscript-field plan))
    (and subscript
         (let* ((spec (region-plan-specification regions)) (prefix (car subscript))
                (row (list prefix (string-ref prefix (- (string-length prefix) 1)) (cadr subscript) 1))
                (existing (assoc prefix (caddr spec))))
           (when (and existing (not (equal? existing row))) (error "binding region conflicts with declared pair" prefix))
           (prepare-region-plan (list (car spec) (cadr spec)
                                (if existing (caddr spec) (append (caddr spec) (list row))) (cadddr spec)))))))
(def (binding-plan-region-scopes plan regions)
  (let (subscript (binding-plan-subscript-field plan))
    (and subscript
         (let* ((prefix (car subscript))
                (base (filter (lambda (candidate) (not (equal? candidate prefix)))
                              (map car (caddr (region-plan-specification regions))))))
           (append (map (lambda (parent) (cons parent base)) base)
                   (list (cons prefix (append base (list prefix)))))))))
(def (part-plan-binding plan key)
  (hash-get (part-plan-bindings plan) key))
(def (binding-ref bindings key)
  (or (hash-get bindings key) (error "undeclared binding profile" key)))
(defsyntax (defbinding-profile stx)
  (syntax-case stx (name prefixes operators subscript)
    ((_ (binding marker self base) (name expression) (prefixes prefix ...) (operators operator ...) (subscript #f))
     (and (identifier? #'binding) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def binding (.o (:: self base) name: (text-profile-data expression)
                        prefixes: '(prefix ...) operators: '(operator ...) subscript: #f)))
    ((_ (binding marker self base) (name expression) (prefixes prefix ...) (operators operator ...) (subscript opener closer))
     (and (identifier? #'binding) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def binding (.o (:: self base) name: (text-profile-data expression)
                        prefixes: '(prefix ...) operators: '(operator ...) subscript: (list opener closer))))))
(def (compile-step form bindings)
  (unless (and (list? form) (pair? form)) (error "invalid part operation" form))
  (case (car form)
    ((parameter)
     (unless (= (length form) 1) (error "invalid parameter operation" form))
     (make-part-step 'parameter 'ParameterExpansion 2 1 #f (binding-ref bindings 'parameter)))
    ((quote quoted-body)
     (unless (and (= (length form) 5) (symbol? (cadr form))
                  (exact-integer? (caddr form)) (> (caddr form) 0)
                  (exact-integer? (cadddr form)) (= (cadddr form) 1)
                  (char? (list-ref form 4))) (error "invalid quote operation" form))
     (make-part-step (car form) (cadr form) (caddr form) (cadddr form) (list-ref form 4) #f))
    ((pair)
     (unless (and (= (length form) 4) (symbol? (cadr form))
                  (exact-integer? (caddr form)) (> (caddr form) 0)
                  (exact-integer? (cadddr form)) (> (cadddr form) 0))
       (error "invalid pair operation" form))
     (make-part-step 'pair (cadr form) (caddr form) (cadddr form) #f #f))
    ((name)
     (unless (and (= (length form) 3) (symbol? (cadr form)) (symbol? (caddr form)))
       (error "invalid name operation" form))
     (make-part-step 'name (cadr form) 1 0 #f (binding-ref bindings (caddr form))))
    ((escape)
     (unless (and (= (length form) 2) (symbol? (cadr form))) (error "invalid escape operation" form))
     (make-part-step 'escape (cadr form) 1 0 #f #f))
    (else (error "unknown part operation" form))))
(def (profile-plan profile)
  (unless (object? profile) (error "part profile requires a POO object"))
  (let* ((contexts (.ref profile 'contexts)) (rules (.ref profile 'rules))
         (literal (.ref profile 'literal)) (dispatch (make-hash-table-eq))
         (bindings (make-hash-table-eq)) (declarations (.ref profile 'bindings)))
    (unless (and (list? contexts) (pair? contexts) (andmap symbol? contexts)
                 (distinct? contexts)
                 (list? rules) (symbol? literal)) (error "invalid part profile slots"))
    (unless (and (list? declarations)
                 (andmap (lambda (row) (and (pair? row) (symbol? (car row)) (object? (cdr row)))) declarations)
                 (distinct? (map car declarations))) (error "invalid named binding profiles"))
    (for-each (lambda (row) (hash-put! bindings (car row) (compile-binding (cdr row)))) declarations)
    (for-each (lambda (context) (hash-put! dispatch context (make-part-context-index (make-vector 128 '()) (make-hash-table-eqv)))) contexts)
    (for-each
     (lambda (row)
       (unless (and (list? row) (= (length row) 3) (list? (car row)) (pair? (car row))
                    (andmap (lambda (context) (memq context contexts)) (car row))
                    (distinct? (car row))
                    (list? (cadr row)) (= (length (cadr row)) 3)
                    (eq? (caadr row) 'prefix) (string? (cadadr row))
                    (> (string-length (cadadr row)) 0)
                    (or (memq (caddr (cadr row)) '(any next)) (string? (caddr (cadr row)))))
         (error "invalid part recognition rule" row))
       (let* ((prefix (string-copy (cadadr row))) (guard (let (value (caddr (cadr row))) (if (string? value) (string->list value) value)))
              (step (compile-step (caddr row) bindings)) (rule (make-part-rule prefix guard step)))
         (unless (and (or (not (memq (part-step-operation step) '(name escape parameter)))
                          (= (string-length prefix) (part-step-opening step)))
                      (or (not (memq (part-step-operation step) '(quote pair quoted-body)))
                          (= (string-length prefix) (part-step-opening step)))
                      (or (not (memq (part-step-operation step) '(quote quoted-body)))
                          (char=? (string-ref prefix (- (string-length prefix) 1)) (part-step-delimiter step))))
           (error "part opening does not match recognition prefix" row))
         (for-each
          (lambda (context)
            (let* ((bucket (hash-ref dispatch context)) (key (string-ref prefix 0))
                   (previous (context-rules bucket key)))
              (when (ormap (lambda (other) (and (equal? prefix (part-rule-prefix other))
                                                 (equal? guard (part-rule-guard other)))) previous)
                (error "duplicate part recognition rule" row))
              ;; Keep declaration precedence, including shorter-prefix overrides.
              (context-rules-put! bucket key (append previous (list rule))))) (car row)))) rules)
    (make-part-plan (copy-datum (list contexts rules literal
                      (map (lambda (row) (list (car row) (binding-plan-recipe (hash-ref bindings (car row))))) declarations)))
                    dispatch literal bindings)))
(def (profile-valid? profile)
  (with-catch (lambda (_) #f) (lambda () (profile-plan profile) #t)))
(define-type (PartProfileContract @ PooFlowContract.)
  identity: 'gerbil-parser/part-profile
  .classify: (lambda (candidate context)
    (let (accepted? (profile-valid? candidate))
      (poo-flow-classification-evidence 'gerbil-parser/part-profile candidate accepted?
       (if accepted? '() '((expected gerbil-parser/part-profile))) context))))
(def (compile-part-profile profile)
  (validate PartProfileContract profile) (profile-plan profile))
(def (part-plan-recipe plan) (copy-datum (part-plan-recipe-field plan)))
(def (admit-part-plan plan results regions)
  (let* ((recipe (part-plan-recipe plan)) (contexts (car recipe))
         (region-spec (region-plan-specification regions)) (bindings (part-plan-bindings plan)))
    (unless (and (memq 'word contexts) (memq 'HereDocument contexts))
      (error "part profile lacks required contexts"))
    (def (requires! id captures) (result-plan-projection results id captures))
    (requires! 'Word '((parts parts)))
    (requires! 'HereDocumentLine '((parts parts)))
    (let (assignment (hash-get bindings 'assignment))
      (when assignment
        (requires! 'Assignment '((name span required) (operator span required) (parts parts)))
        (unless (and (pair? (caddr (binding-plan-recipe assignment)))
                     (null? (cadr (binding-plan-recipe assignment))) (not (binding-plan-subscript-field assignment)))
          (error "assignment profile requires operators and excludes prefixes/subscripts"))))
    (requires! (part-plan-literal plan) '((text span required)))
    (for-each
     (lambda (row)
       (let* ((step (compile-step (caddr row) bindings)) (operation (part-step-operation step))
              (kind (part-step-kind step)) (prefix (cadadr row)))
         (case operation
           ((name escape) (requires! kind '((text span required))))
           ((quote) (requires! kind '((open span required) (parts parts) (close span required))))
           ((pair quoted-body) (requires! kind '((open span required) (body span optional) (close span required))))
           ((parameter)
            (requires! kind '((open span required) (prefix span optional) (name span optional) (subscript node optional) (operator span optional) (parts parts) (close span required)))
            (when (binding-plan-subscript-field (part-step-binding step))
              (requires! 'ArraySubscript '((open span required) (parts parts) (close span required)))
              (binding-plan-region-plan (part-step-binding step) regions))))
         (when (eq? operation 'quote)
           (unless (memq kind contexts) (error "quote result lacks part context" kind)))
         (when (memq operation '(quote quoted-body))
           (unless (assv (part-step-delimiter step) (cadr region-spec))
             (error "undeclared part quote delimiter" prefix)))
         (when (memq operation '(pair parameter))
           (let (region (assoc prefix (caddr region-spec)))
             (unless (and region (= (part-step-closing step) (cadddr region)))
               (error "part operation disagrees with region declaration" prefix))))))
     (cadr recipe)))
  plan)
(def (part-plan-context plan context)
  (or (hash-get (part-plan-dispatch plan) context) (error "undeclared part context" context)))
(def (part-context-match bucket text offset end)
  (and (< offset end)
       (let loop ((rules (context-rules bucket (string-ref text offset))))
         (and (pair? rules)
              (let* ((rule (car rules)) (prefix (part-rule-prefix rule))
                     (after (+ offset (string-length prefix))) (guard (part-rule-guard rule)))
                (if (and (<= after end) (source-prefix-at? text offset prefix)
                         (or (eq? guard 'any)
                             (and (< after end) (or (eq? guard 'next) (memv (string-ref text after) guard)))))
                  (part-rule-step rule) (loop (cdr rules))))))))
(def (part-plan-match plan text offset end context)
  (part-context-match (part-plan-context plan context) text offset end))
(def (part-plan-literal-end plan text start end context)
  (part-context-literal-end (part-plan-context plan context) text start end))
(def (part-context-literal-end bucket text start end)
  (let loop ((offset (+ start 1)))
    (if (or (= offset end) (part-context-match bucket text offset end))
      offset (loop (+ offset 1)))))
(def (part-plan-name-end step text start end)
  (binding-plan-name-end (part-step-binding step) text start end))
(defsyntax (defpart-profile stx)
  (syntax-case stx (contexts rules literal bindings)
    ((_ (name marker self base) (contexts context ...) (bindings (key value) ...)
        (rules rule ...) (literal kind))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) contexts: '(context ...)
                    bindings: (list (cons 'key value) ...) rules: '(rule ...) literal: 'kind)))
    ((_ (name marker self base) (bindings (key value) ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) bindings: (list (cons 'key value) ...))))
    ((_ (name marker self base) (contexts context ...) (rules rule ...) (literal kind))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) contexts: '(context ...) rules: '(rule ...) literal: 'kind)))
    ((_ (name marker self base) (rules rule ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) rules: '(rule ...))))
    ((_ (name marker self base) (literal kind))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) literal: 'kind)))))
