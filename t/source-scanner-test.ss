(import (only-in :clan/poo/type OrFalse Symbol))
(import :gerbil-parser/language-test-support)
;;; Engine checkpoints are owned by the creating worker, including shared text.
(import :std/test
        (only-in :gerbil-parser/src/runtime/source-scanner
                 make-source-scanner source-scanner-tokens source-scanner-initial-state source-scanner-step
                 source-scan-state-with-context source-scan-state-byte-offset
                 make-source-scan-session source-scan-session-tokens
                 source-scan-session-scanned-token-count source-scan-session-reused-token-count)
        (only-in :gerbil-parser/src/runtime/token token-start token-end token-kind token-lexeme)
        (only-in :gerbil-parser/src/runtime/source-scanner source-scan-state-context)
        (only-in :gerbil-parser/src/runtime/contextual-scanner
                 +empty-delimiter-queue+ delimiter-queue-enqueue delimiter-queue-take
                 delimiter-queue-list delimiter-obligation-marker delimiter-obligation-quoted?
                 contextual-scan-state-canonical decode-marker)
        (only-in :gerbil-parser/src/language/source source-language-scanner-factory
                 parse-source-language parse-source-language/session source-language-session-artifact
                 source-language-session? source-language-history? source-language-session-history
                 source-language-session-scanned-token-count source-language-session-reused-token-count)
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-success?))
(import (only-in :gerbil-parser/languages/bash/parser bash-source-language))
(def (pending-markers state)
 (map car (cdr (assq 'pending (contextual-scan-state-canonical state)))))
(def (rejected? thunk)
  (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(deflanguage-parser-tests source-scanner-test "source scanner worker ownership"
  (engine)
    (property "history retains scanner ownership without retaining the published artifact"
      (bindings (initial (parse-source-language/session bash-source-language "cat <<A\nα\nA\necho end\n")) (history (source-language-session-history initial)) (source "echo猫 <<A\nα\nA\necho end\n") (next (parse-source-language/session bash-source-language source history)))
      (equal (source-language-history? history)  #t)
      (equal (source-language-session? history)  #f)
      (equal (source-language-session-artifact next)  (parse-source-language bash-source-language source))
      (equal (source-language-session-scanned-token-count next)  1)
      (equal (> (source-language-session-reused-token-count next) 0)  #t))
    (scenario "Bash sessions reuse lexical suffixes and publish full fresh-parser parity"
      (sequential ((old (parse-source-language/session bash-source-language "cat <<A\nα\nA\necho end\n"))
             (source "echo猫 <<A\nα\nA\necho end\n")
             (next (parse-source-language/session bash-source-language source old))
             (later-source "echo猫 <<A\nα\nA\necho 終わり\n")
             (later (parse-source-language/session bash-source-language later-source next)))
        (equal (parse-artifact-success? (source-language-session-artifact next))  #t)
        (equal (source-language-session-artifact next)  (parse-source-language bash-source-language source))
        (equal (source-language-session-scanned-token-count next)  1)
        (equal (source-language-session-reused-token-count next)
                (- (source-language-session-scanned-token-count old) 1))
        ;; The second edit consumes checkpoints rebound by the first edit.
        (equal (source-language-session-artifact later)  (parse-source-language bash-source-language later-source))
        (equal (> (source-language-session-reused-token-count later) 0)  #t)))
    (property "changed quoted delimiter waits for the obligation to close before reuse"
      (bindings (old (parse-source-language/session bash-source-language "cat <<A\nα\nA\necho end\n")) (source "cat <<'A'\nα\nA\necho end\n") (next (parse-source-language/session bash-source-language source old)))
      (equal (source-language-session-artifact next)  (parse-source-language bash-source-language source))
      (equal (source-language-session-scanned-token-count next)  7)
      (equal (source-language-session-reused-token-count next)  4))
    (scenario "source session cache owns tokens and rejects ordinary callback reuse"
      (sequential ((factory (source-language-scanner-factory bash-source-language))
             (text (string-copy "cat <<A\nα\nA\n"))
             (old (make-source-scan-session (factory text) 'command))
             (published (source-scan-session-tokens old)))
        (act (string-set! text 0 #\X))
        (act (string-set! (token-lexeme (car published)) 0 #\X))
        (act (vector-set! (car published) 2 999))
        (equal (token-lexeme (car (source-scan-session-tokens old)))  "cat")
        (sequential ((next (make-source-scan-session (factory "echo猫 <<A\nα\nA\n") 'command old))
               (fresh (source-scanner-tokens (factory "echo猫 <<A\nα\nA\n") 'command)))
          (equal (source-scan-session-tokens next)  fresh)
          (equal (source-scan-session-scanned-token-count next)  1)
          (equal (> (source-scan-session-reused-token-count next) 0)  #t))
        (sequential ((calls 0)
               (worker (make-source-scanner (OrFalse Symbol) Symbol "xy" #f
                         (lambda (_source start context _mode)
                           (set! calls (+ calls 1))
                           (if (= start 2) (values #f start context)
                             (values 'character (+ start 1) context)))))
               (first (make-source-scan-session worker 'ordinary))
               (second (make-source-scan-session worker 'ordinary first)))
          (equal calls  6)
          (equal (source-scan-session-reused-token-count second)  0))))
    (scenario "long session histories rebind prefix middle tail and EOF edits"
      (sequential ((factory (source-language-scanner-factory bash-source-language))
             (prefix (string-join (make-list 64 "echo prefix\n") ""))
             (tail (string-join (make-list 64 "echo tail\n") ""))
             (original (string-append prefix "cat <<A\nα\nA\n" tail))
             (first (make-source-scan-session (factory original) 'command)))
        (each (source) ((list (string-append "猫 " original)
               (string-append prefix "cat <<'A'\nβ\nA\n" tail)
               (string-append original "echo 終\n")
               (string-append original "\n")
               ""))
           (sequential ((next (make-source-scan-session (factory source) 'command first))
                  (fresh (source-scanner-tokens (factory source) 'command))
                  (published (source-scan-session-tokens next))
                  (again (make-source-scan-session (factory source) 'command next)))
             (equal published  fresh)
             (equal (source-scan-session-tokens again)  fresh)
             (equal (source-scan-session-scanned-token-count again)  0)
             (equal (source-scan-session-reused-token-count again)  (length fresh))
             (when (pair? published)
               (act (string-set! (token-lexeme (car published)) 0 #\X))
               (act (vector-set! (car published) 2 999)))
             (equal (source-scan-session-tokens next)  fresh)
             (equal (source-scan-session-tokens first)
                     (source-scanner-tokens (factory original) 'command))))))
    (property "lexical rejection publishes the original diagnostic and retains no cache"
      (bindings (bad-source "echo 'unterminated") (bad (parse-source-language/session bash-source-language bad-source)) (good (parse-source-language/session bash-source-language "echo ok\n" bad)))
      (equal (source-language-session-artifact bad)  (parse-source-language bash-source-language bad-source))
      (equal (parse-artifact-success? (source-language-session-artifact bad))  #f)
      (equal (source-language-session-scanned-token-count bad)  #f)
      (equal (source-language-session-reused-token-count good)  0)
      (equal (source-language-session-artifact good)  (parse-source-language bash-source-language "echo ok\n")))
    (scenario "shared FIFO preserves order and branches without copying the pending prefix"
      (sequential ((a (decode-marker 'raw "A" #f)) (b (decode-marker 'raw "B" #f))
             (first (delimiter-queue-enqueue +empty-delimiter-queue+ a))
             (second (delimiter-queue-enqueue first b)))
        (equal (map delimiter-obligation-marker (delimiter-queue-list first))  '("A"))
        (scope-values (((head rest) (delimiter-queue-take second)))
          (equal (delimiter-obligation-marker head)  "A")
          (equal (map delimiter-obligation-marker (delimiter-queue-list rest))  '("B"))
          (equal (map delimiter-obligation-marker (delimiter-queue-list second))  '("A" "B")))
        (equal (rejected? (lambda () (delimiter-queue-enqueue first 'callback)))  #t)
        (equal (rejected? (lambda () (delimiter-queue-take +empty-delimiter-queue+)))  #t)))
    (scenario "Bash uses engine quote removal including preserved double-quote escapes"
      (each (row) ('(("A" "A" #f) ("'A'" "A" #t) ("\"a\\q\"" "a\\q" #t)
         ("\"a\\$\"" "a$" #t) ("'a\\q'" "a\\q" #t)
         ("A\\\nB" "AB" #f) ("''" "" #t)))
         (scope ((marker (decode-marker 'shell-quote-removal (car row) #f)))
           (equal (delimiter-obligation-marker marker)  (cadr row))
           (equal (delimiter-obligation-quoted? marker)  (caddr row))))
      (equal (rejected? (lambda () (decode-marker 'shell-quote-removal "" #f)))  #t)
      (equal (rejected? (lambda () (decode-marker 'shell-quote-removal "'A" #f)))  #t)
      (equal (rejected? (lambda () (decode-marker 'arbitrary "A" #f)))  #t))
    (scenario "Bash queued checkpoint replay retains its own pending obligations"
      (sequential ((worker ((source-language-scanner-factory bash-source-language) "<<A <<B\nα\nA\nβ\nB\n"))
             (initial (source-scanner-initial-state worker)))
        (scope-values (((open after-open) (source-scanner-step worker initial 'command)))
          (scope-values (((marker queued) (source-scanner-step worker after-open 'command)))
            (equal (pending-markers (source-scan-state-context queued))  '("A"))
            (scope-values (((again replay) (source-scanner-step worker after-open 'command)))
              (equal (token-lexeme again)  "A")
              (equal (pending-markers (source-scan-state-context replay))  '("A")))
            (equal (pending-markers (source-scan-state-context initial))  '())))))
    (property "large Bash deferred batches drain in declaration order"
      (bindings (markers (map (lambda (n) (string-append "END" (number->string n))) (iota 128))) (source (string-append "cat "
                       (apply string-append (map (lambda (name) (string-append "<<" name " ")) markers))
                       "\n" (apply string-append (map (lambda (name) (string-append "α\n" name "\n")) markers)))) (tokens (source-scanner-tokens ((source-language-scanner-factory bash-source-language) source) 'command)))
      (equal (map token-lexeme (filter (lambda (token) (eq? (token-kind token) 'heredoc-marker)) tokens))  markers)
      (equal (map token-lexeme (filter (lambda (token) (eq? (token-kind token) 'heredoc-end)) tokens))
                (map (lambda (name) (string-append name "\n")) markers))
      (equal (apply string-append (map token-lexeme tokens))  source))
    (property "another worker cannot use a checkpoint over the exact same string"
      (bindings (source "αx") (calls 0) (step (lambda (_source offset context _mode)
                     (set! calls (+ calls 1))
                     (values 'character (+ offset 1) context))) (left (make-source-scanner (OrFalse Symbol) Symbol source 'left step)) (right (make-source-scanner (OrFalse Symbol) Symbol source 'right step)) (initial (source-scanner-initial-state left)))
      (equal (rejected? (lambda () (source-scanner-step right initial 'test)))  #t)
      (equal calls  0)
      (equal (rejected? (lambda ()
                           (source-scanner-step right (source-scan-state-with-context initial 'changed) 'test)))  #t)
      (equal calls  0))
    (scenario "owned checkpoint replay and context updates preserve UTF-8 spans"
      (sequential ((worker (make-source-scanner (OrFalse Symbol) Symbol "αx" 'initial
                      (lambda (_source offset context _mode)
                        (if (= offset 2) (values #f offset context)
                          (values 'character (+ offset 1) context)))))
             (initial (source-scanner-initial-state worker)))
        (scope-values (((first next) (source-scanner-step worker initial 'test)))
          (equal (list (token-start first) (token-end first))  '(0 2))
          (equal (source-scan-state-byte-offset initial)  0)
          (scope-values (((again replay) (source-scanner-step worker initial 'test)))
            (equal (list (token-start again) (token-end again))  '(0 2))
            (equal (source-scan-state-byte-offset replay)  2))
          (scope-values (((second end) (source-scanner-step worker (source-scan-state-with-context next 'updated) 'test)))
            (equal (list (token-start second) (token-end second))  '(2 3))
            (scope-values (((eof final) (source-scanner-step worker end 'test)))
              (equal eof  #f)
              (equal (source-scan-state-byte-offset final)  3)))))))
