;;; POO scanner declarations compile to closed shared contextual IR.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in :clan/poo/mop define-type validate)
        (only-in :core/types PooFlowContract. poo-flow-classification-evidence)
        (only-in ../modules/parser/contextual-objects make-contextual-role make-contextual-method make-contextual-scan-rule)
        (only-in ../compiler/contextual-dispatch compile-contextual-dispatch)
        (only-in ../compiler/contextual-scanner-ir compile-contextual-scanner)
        (only-in ../runtime/region-scanner region-plan-specification))
(export ScannerProfile. ScannerProfileContract defscanner-profile compile-scanner-profile)
(def ScannerProfile. (.o modes: '() tokens: '() initial-mode: #f rules: '()))
(def (profile-ir profile)
 (let* ((tokens (.ref profile 'tokens))
        (role (make-contextual-role 'source
                (map (lambda (token) (make-contextual-method token 'any 'any token token)) tokens)))
        (dispatch (compile-contextual-dispatch (list role) (.ref profile 'modes) '(source) tokens))
        (rules (map (lambda (row) (apply make-contextual-scan-rule row)) (.ref profile 'rules))))
  (compile-contextual-scanner rules dispatch (.ref profile 'initial-mode))))
(def (profile-valid? profile)
 (with-catch (lambda (_) #f) (lambda ()
  (and (object? profile) (profile-ir profile) #t))))
(define-type (ScannerProfileContract @ PooFlowContract.)
 identity: 'gerbil-parser/scanner-profile
 .classify: (lambda (candidate context)
  (let (ok? (profile-valid? candidate))
   (poo-flow-classification-evidence 'gerbil-parser/scanner-profile candidate ok?
    (if ok? '() '((expected gerbil-parser/scanner-profile))) context))))
(def (compile-scanner-profile profile)
 (validate ScannerProfileContract profile)
 (profile-ir profile))
(defrules scanner-matcher-value (region-word unless-prefix)
 ((_ (region-word plan initial?))
  (list 'region-word (append (take (region-plan-specification plan) 3) (list initial?))))
 ((_ (unless-prefix (prefix ...) (exception ...) child))
  (list 'unless-prefix (list prefix ...) (list exception ...) (scanner-matcher-value child)))
 ((_ matcher) 'matcher))
(defsyntax (defscanner-profile stx)
 (syntax-case stx (modes initial-mode tokens rules)
  ((_ (name marker self base)
      (modes mode ...) (initial-mode initial) (tokens token ...)
      (rules (rule mode-name form matcher rank action) ...))
   (and (identifier? #'name) (identifier? #'self)
        (eq? (syntax->datum #'marker) '::))
   #'(def name (.o (:: self base) modes: '(mode ...) initial-mode: 'initial
      tokens: '(token ...) rules: (list (list 'rule 'mode-name 'form
       (scanner-matcher-value matcher) rank 'action) ...))))
  ((_ (name marker self base) (rules (rule mode-name form matcher rank action) ...))
   (and (identifier? #'name) (identifier? #'self)
        (eq? (syntax->datum #'marker) '::))
   #'(def name (.o (:: self base) rules: (list (list 'rule 'mode-name 'form
         (scanner-matcher-value matcher) rank 'action) ...))))))
