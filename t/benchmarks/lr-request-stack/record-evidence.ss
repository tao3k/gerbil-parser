;;; Native admission of independently loaded complete-request receipts.
(import (only-in ../parser-stage-cost/benchmark sample-at-percentile))
(export main)

(defstruct record-receipt (summaries artifacts) final: #t)

(def +record-families+ '(gql-request gql-return fhirpath-addition arithmetic-control))
(def (field row name) (cdr (assq name row)))
(def (require-record! condition . details)
  (unless condition (apply error "record request evidence rejected" details)))

(def (read-record-receipt path candidate? image-marker)
  (let ((summaries (make-hash-table)) (samples (make-hash-table))
        (artifacts (make-hash-table)) (complete? #f) (exited? #f) (class? #f))
    (call-with-input-file path
      (lambda (port)
        (let loop ((line (read-line port)))
          (unless (eof-object? line)
            (cond
             ((string-prefix? "(PARSER-COMPONENT-SAMPLE " line)
              (let* ((datum (call-with-input-string line read))
                     (key (cadr datum)) (row (caddr datum)) (old (hash-ref samples key '()))
                     (index (field row 'sample)))
                (require-record! (and (exact-integer? index) (<= 0 index 39)
                                      (not (find (lambda (row) (= index (field row 'sample))) old))) path key 'sample)
                (hash-put! samples key (cons row old))))
             ((string-prefix? "(PARSER-COMPONENT-SUMMARY " line)
              (let* ((row (cadr (call-with-input-string line read))) (key (field row 'stage)))
                (require-record! (not (hash-get summaries key)) path key 'duplicate)
                (hash-put! summaries key row)))
             ((string-prefix? "(RECORD-REQUEST-ARTIFACT " line)
              (let (row (call-with-input-string line read))
                (require-record! (not (hash-get artifacts (cadr row))) path 'duplicate-artifact)
                (hash-put! artifacts (cadr row) (caddr row))))
             ((string-prefix? (string-append image-marker " ") line)
              (require-record! (and (not class?)
                                    (equal? line (string-append image-marker (if candidate? " #t" " #f")))) path 'class)
              (set! class? #t))
             ((equal? line "RECORD-REQUESTS-OK")
              (require-record! (not complete?) path 'duplicate-completion)
              (set! complete? #t))
             ((string-prefix? "PROCESS-RESULT " line)
              (require-record! (and (not exited?) (string-contains line "exit=0 reason=#f missing=()")) path 'exit)
              (set! exited? #t)))
            (loop (read-line port))))))
    (require-record! (and complete? exited? class? (= (hash-length artifacts) 4)
                          (= (hash-length summaries) 9) (= (hash-length samples) 9)) path 'incomplete)
    (for-each
     (lambda (family)
       (require-record! (hash-get artifacts family) path family 'artifact)
       (for-each
        (lambda (stage)
          (let* ((key (list family stage)) (rows (hash-ref samples key '())) (summary (hash-get summaries key)))
            (require-record! (and summary (= (length rows) 40) (= (field summary 'sampleCount) 40)
                                  (= (field summary 'parsesPerSample) 1000)
                                  (andmap (lambda (row) (>= (field row 'cpu-ms) 0)) rows)
                                  (= (field summary 'cpuP50Ms) (field (sample-at-percentile rows 'cpu-ms 50) 'cpu-ms))
                                  (= (field summary 'cpuP95Ms) (field (sample-at-percentile rows 'cpu-ms 95) 'cpu-ms))) path key 'summary)))
        '(prepared-lr full-source))) +record-families+)
    (let* ((key '(sdk-control utf8)) (rows (hash-ref samples key '())) (summary (hash-get summaries key)))
      (require-record! (and summary (= (length rows) 40) (= (field summary 'sampleCount) 40)
                            (= (field summary 'parsesPerSample) 1000)
                            (andmap (lambda (row) (>= (field row 'cpu-ms) 0)) rows)
                            (= (field summary 'cpuP50Ms) (field (sample-at-percentile rows 'cpu-ms 50) 'cpu-ms))
                            (= (field summary 'cpuP95Ms) (field (sample-at-percentile rows 'cpu-ms 95) 'cpu-ms)))
                       path key 'sdk-control))
    (make-record-receipt summaries artifacts)))

(def (main reference-a candidate-a candidate-b reference-b
           (image-marker "RECORD-CLASS-FINAL")
           (targets '(gql-request gql-return fhirpath-addition))
           (controls '(arithmetic-control)))
  ;; Four admitted families and four roles imply a unique complete partition.
  (let (roles (append targets controls))
    (require-record! (and (pair? targets)
                          (member image-marker '("RECORD-CLASS-FINAL" "OWNED-STACK"))
                          (= (length roles) (length +record-families+))
                          (andmap (lambda (family) (memq family roles)) +record-families+))
                     'scope))
  (let* ((references (map (lambda (path) (read-record-receipt path #f image-marker)) (list reference-a reference-b)))
         (candidates (map (lambda (path) (read-record-receipt path #t image-marker)) (list candidate-a candidate-b)))
         (all (append references candidates)))
    (for-each
     (lambda (family)
       (let (digest (hash-get (record-receipt-artifacts (car all)) family))
         (require-record! (andmap (lambda (receipt) (equal? digest (hash-get (record-receipt-artifacts receipt) family))) all) family 'artifact-drift)))
     +record-families+)
    (def (cpu receipts family stage rank)
      (map (lambda (receipt) (field (hash-get (record-receipt-summaries receipt) (list family stage)) rank)) receipts))
    (let* ((control-r (cpu references 'sdk-control 'utf8 'cpuP50Ms))
           (control-c (cpu candidates 'sdk-control 'utf8 'cpuP50Ms))
           (ratio (/ (apply + control-c) (apply + control-r))))
      (require-record! (and (andmap (lambda (value) (>= value 1)) control-r)
                            (<= .95 ratio 1.05)
                            (<= (apply min control-c) (apply max control-r))
                            (<= (apply min control-r) (apply max control-c))) 'control ratio)
      (write (list 'RECORD-CPU-CONTROL ratio)) (newline))
    (for-each
     (lambda (family)
       (for-each
        (lambda (stage)
          (let* ((r (cpu references family stage 'cpuP50Ms)) (c (cpu candidates family stage 'cpuP50Ms))
                 (ratio (/ (apply max c) (apply min r))))
            (write (list 'RECORD-CPU-BOUND family stage ratio)) (newline) (force-output)
            (require-record! (if (memq family targets) (< ratio .95) (<= ratio 1.05)) family stage 'repeated-median)
            (require-record! (<= (apply max (cpu candidates family stage 'cpuP95Ms))
                                 (* 1.05 (apply max (cpu references family stage 'cpuP95Ms)))) family stage 'tail)))
        '(prepared-lr full-source))) (append targets controls))
    (displayln "RECORD-CPU-ADMISSION-OK") (force-output)))
