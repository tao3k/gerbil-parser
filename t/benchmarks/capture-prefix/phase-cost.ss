;;; Recorded-query cost diagnosis. This is not a matched speedup gate.
(import (only-in :gerbil-parser/t/fixtures/runtime-record-assignments/languages/records/grammar records-parser)
        (only-in :gerbil-parser/t/benchmarks/parser-stage-cost/benchmark measure-parser-batch sample-at-percentile)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-runtime parser-machine-trivia parser-machine-grammar-digest call-with-parser-machine-source)
        (only-in :gerbil-parser/src/runtime/incremental make-incremental-session incremental-session-artifact incremental-session-recognition-root)
        (only-in :gerbil-parser/src/runtime/incremental/state incremental-session-state-tokens incremental-session-state-modes)
        (only-in :gerbil-parser/src/runtime/lexer scan-source-token)
        (only-in :gerbil-parser/src/runtime/token token-start token-lexeme)
        (only-in :gerbil-parser/src/runtime/lr-parser lr-initial-checkpoint lr-checkpoint-drive current-lr-recognition-observer lr-runtime-lexical-mode-catalog lr-lexical-mode-id lr-recognition-project)
        (only-in :gerbil-parser/src/runtime/recognition recognition-child-value)
        (only-in :gerbil-parser/src/runtime/artifact make-success-parse-artifact parse-artifact-valid-for-source?))
(import (only-in :gerbil-parser/src/runtime/lr-parser/state
                 lr-recognition-fragment-lookahead lr-recognition-fragment? lr-recognition-fragment-children
                 lr-checkpoint-states lr-checkpoint-semantic-values)
        (only-in :gerbil-parser/src/runtime/lr-parser/transfer fragment-yield-matches?))
(export main)
(defstruct replay-step (offset byte mode token end) final: #t)
(def (main)
  (let* ((source (apply string-append (make-list 64 "a=1\n")))
         (session (make-incremental-session records-parser source #t))
         (expected (incremental-session-artifact session))
         (tokens (incremental-session-state-tokens session))
         (modes (incremental-session-state-modes session))
         (runtime (parser-machine-runtime records-parser))
         (catalog (lr-runtime-lexical-mode-catalog runtime))
         (trivia? (parser-machine-trivia records-parser))
         (steps
          (let loop ((tokens tokens) (modes modes) (offset 0) (rows '()))
            (if (null? tokens) (reverse rows)
              (let* ((token (car tokens)) (end (+ offset (string-length (token-lexeme token)))))
                (loop (cdr tokens) (cdr modes) end
                  (cons (make-replay-step offset (token-start token) (vector-ref catalog (car modes)) token end) rows))))))
         (significant (filter (lambda (row) (not (trivia? (replay-step-token row)))) steps)))
    (unless (and (= (length steps) 256) (= (length significant) 256)
                 (parse-artifact-valid-for-source? expected source))
      (error "recorded query scope changed" (length steps) (length significant) (parse-artifact-valid-for-source? expected source)))
    (def (scan-replay)
      (call-with-parser-machine-source records-parser source
        (lambda ()
          (map (lambda (row)
                 (let-values (((token _end)
                               (scan-source-token records-parser source (replay-step-offset row)
                                 (replay-step-byte row) (replay-step-mode row)))) token)) steps))))
    ;; Bind character and byte positions independently before timing replay.
    (call-with-parser-machine-source records-parser source
      (lambda ()
        (for-each (lambda (row)
                    (let-values (((token end)
                                  (scan-source-token records-parser source (replay-step-offset row)
                                    (replay-step-byte row) (replay-step-mode row))))
                      (unless (and (equal? token (replay-step-token row)) (= end (replay-step-end row)))
                        (error "recorded lexical query changed token or character boundary")))) steps)))
    (def (lr-replay capture? (validate-modes? #f))
      (let ((pending significant) (root #f) (snapshots '()))
        (def (next mode)
          (and (pair? pending)
            (let (row (car pending))
              (when (and validate-modes? (not (= (lr-lexical-mode-id mode) (lr-lexical-mode-id (replay-step-mode row)))))
                (error "LR replay changed an actual lexical mode"))
              (set! pending (cdr pending)) (replay-step-token row))))
        (parameterize ((current-lr-recognition-observer (and capture? (lambda (value) (set! root value)))))
          (let-values (((status payload)
                        (lr-checkpoint-drive (lr-initial-checkpoint runtime '()) next #f #f 'installed
                          (and capture? 32) (and capture? (lambda (frame) (set! snapshots (cons frame snapshots)))))))
            (unless (and (eq? status 'accepted) (null? pending) (null? (cadr payload)))
              (error "LR replay did not finish" status))
            (vector (car payload) root snapshots)))))
    (def full-lr (lr-replay #t #t))
    (def bare-lr (lr-replay #f #t))
    ;; Count the actual retained tree and snapshot depths outside every clock.
    ;; These are logical objects, not a native allocation-byte estimate.
    (let loop ((pending (list (vector-ref full-lr 1))) (fragments 0) (leaves 0))
      (if (null? pending)
        (begin
          (unless (and (= fragments 322) (= leaves 256)
                       (= (length (vector-ref full-lr 2)) 8))
            (error "recorded capture topology changed" fragments leaves))
          (write (list 'CAPTURE-COST-SCOPE 'fragments fragments 'terminals leaves
                       'snapshots
                       (map (lambda (frame)
                              (list (length (lr-checkpoint-states frame))
                                    (length (lr-checkpoint-semantic-values frame))))
                            (reverse (vector-ref full-lr 2)))))
          (newline) (force-output))
        (let (piece (car pending))
          (if (lr-recognition-fragment? piece)
            (loop (append (lr-recognition-fragment-children piece) (cdr pending))
                  (+ fragments 1) leaves)
            (loop (cdr pending) fragments (+ leaves 1))))))
    (def (publish)
      (make-success-parse-artifact (parser-machine-grammar-digest records-parser) source tokens
        (vector-ref full-lr 0) trivia?))
    (unless (and (equal? (scan-replay) tokens) (equal? (publish) expected)
                 (equal? (vector-ref full-lr 0) (vector-ref bare-lr 0))
                 (equal? (recognition-child-value (car (lr-recognition-project (vector-ref full-lr 1) tokens)))
                         (vector-ref full-lr 0)))
      (error "independent recorded replay changed the complete product"))
    (def (whole)
      (let* ((current (make-incremental-session records-parser source #t))
             (artifact (incremental-session-artifact current)))
        (unless (and (incremental-session-recognition-root current)
                     (equal? artifact expected) (parse-artifact-valid-for-source? artifact source))
          (error "complete cost request changed")) artifact))
    ;; A separate scope pays first-demand construction and terminal validation.
    ;; It does not silently move that work outside the forced-request clock.
    (def (force-boundaries! root)
      (let loop ((pending (list root)))
        (unless (null? pending)
          (let (piece (car pending))
            (if (lr-recognition-fragment? piece)
              (begin (lr-recognition-fragment-lookahead piece)
                (loop (append (lr-recognition-fragment-children piece) (cdr pending))))
              (loop (cdr pending)))))))
    (def (whole-forced)
      (let* ((current (make-incremental-session records-parser source #t))
             (artifact (incremental-session-artifact current)))
        (force-boundaries! (incremental-session-recognition-root current))
        (unless (and (fragment-yield-matches? (incremental-session-recognition-root current) 0
                                             (incremental-session-state-tokens current))
                     (equal? artifact expected) (parse-artifact-valid-for-source? artifact source))
          (error "forced-yield request changed")) artifact))
    ;; Topology/projection preflight observes and warms full-lr's private memos.
    ;; Compare timed fresh captures with an independently fresh representation;
    ;; do not force derived lists or indexes inside the captured-LR scope.
    (def cold-full-lr (lr-replay #t))
    (unless (equal? (vector-ref cold-full-lr 0) (vector-ref full-lr 0))
      (error "fresh LR reference changed semantic output"))
    (def stages
      (list (list 'whole whole expected)
            (list 'whole-forced-yield whole-forced expected)
            (list 'recorded-scan scan-replay tokens)
            (list 'captured-lr (lambda () (lr-replay #t)) cold-full-lr)
            (list 'uncaptured-lr (lambda () (lr-replay #f)) bare-lr)
            (list 'publication publish expected)
            (list 'validation (lambda () (parse-artifact-valid-for-source? expected source)) #t)))
    (for-each (lambda (stage) (for-each (lambda (_) ((cadr stage))) (iota 256))) stages)
    (let (rows (make-table test: eq?))
      (for-each
        (lambda (sample)
          (for-each
            (lambda (stage)
              (let ((name (car stage))
                    (row (measure-parser-batch (car stage) sample 256 (cadr stage) (caddr stage))))
                (table-set! rows name (cons row (table-ref rows name '())))
                (write (list 'CAPTURE-COST-SAMPLE name row)) (newline) (force-output)))
            (if (even? sample) stages (reverse stages)))) (iota 5))
      (for-each
        (lambda (stage)
          (let* ((name (car stage)) (samples (table-ref rows name))
                 (median (cdr (assq 'cpu-ms (sample-at-percentile samples 'cpu-ms 50)))))
            (write (list 'CAPTURE-COST-MEDIAN name 'cpu-ms-per-request (/ median 256))) (newline))) stages))
    ;; Allocation-only controls have an explicit preceding collection. Their CPU
    ;; is never admitted as a speedup; the separate complete CPU gate uses natural
    ;; collection throughout. A collection inside this window still rejects bytes.
    (for-each
      (lambda (sample)
        (##gc)
        (let (row (measure-parser-batch 'allocation-only sample 256 whole expected))
          (write (list 'CAPTURE-ALLOCATION-ONLY (assq 'sample row) '(calls . 256)
                       (assq 'gc-count row) (assq 'allocated-bytes row)))
          (newline) (force-output))) (iota 3))
    (displayln "CAPTURE-COST-REPLAY-OK tokens=256 significant=256") (force-output)))
