direction: right
vars: {
  d2-config: {
    theme-id: 200
    pad: 32
  }
}

sources: "Package declarations" {
  shape: page
}
core: "Core source closure" {
  style.fill: "#E8F0FE"
}
gerbil: "Gerbil compiler" {
  style.fill: "#E8F0FE"
}

products: "Separate product owners" {
  direction: down
  library: "Production library"
  ffi: "C and Rust ABI probes"
  research: "Standalone qualification libraries"
  support: "Signed Suite support"
}

transport: "Exact-run artifacts" {
  shape: cylinder
}
consumers: "Independent consumers" {
  direction: down
  standalone: "Official gxi entrypoints"
  suite: "Core TestingScript → Gerbil Harness"
}

sources -> core: "discover and bind inputs"
core -> gerbil: "native build specification"
gerbil -> products.library
gerbil -> products.ffi
gerbil -> products.research
gerbil -> products.support
products.library -> products.ffi: "ABI providers"
products.ffi -> products.research: "owned probe modules"
products -> transport
transport -> consumers.standalone: "normal library products"
transport -> consumers.suite: "source and publication checks"
