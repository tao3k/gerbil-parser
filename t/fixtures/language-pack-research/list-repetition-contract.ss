#!/usr/bin/env gxi
;;; -*- Gerbil -*-
(import (only-in "list-roles" make-nonempty-list-role)
        (only-in "../../../src/modules/parser/objects" grammar-role-ref)
        (only-in "../../../src/grammar/algebra"
                 grammar-expression-nullable? grammar-expression)
        (only-in "../../../src/compiler/lr" lower-rules compute-nullable))
(def checked 0)
(def (probe label actual expected)
  (unless (equal? actual expected) (error "list repetition contract mismatch" label actual expected))
  (set! checked (+ checked 1))
  (display "LIST-REPETITION-CASE-OK: ") (display label) (newline) (force-output))
(def (attempt thunk)
  (with-catch (lambda (condition) (list (error-message condition) (error-irritants condition))) thunk))
(for-each
 (lambda (case)
   (let* ((label (car case)) (item (cadr case)) (separator (caddr case))
          (item-nullable? (list-ref case 3)) (separator-nullable? (list-ref case 4))
          (body (list 'sequence '(reference separator) '(field argument (reference item))))
          (role (make-nonempty-list-role 'call-arguments 'arguments
                  '(reference item) '(reference separator) 'argument))
          (rules (append (grammar-role-ref role 'rules)
                         (list (list 'item item) (list 'separator separator)
                               (list 'iteration-body body)))))
     (let-values (((nullable index) (compute-nullable (lower-rules rules 'arguments))))
       (probe (list label 'item) (table-ref index 'item #f) item-nullable?)
       (probe (list label 'separator) (table-ref index 'separator #f) separator-nullable?)
       (probe (list label 'body)
         (table-ref index 'iteration-body #f) (and item-nullable? separator-nullable?))
       (probe (list label 'entry) (table-ref index 'arguments #f) item-nullable?)
       (probe (list label 'tail) (table-ref index 'call-arguments/tail #f) #t)
       ;; Local inspection has no environment to resolve either reference.
       (probe (list label 'local-reference-summary) (grammar-expression-nullable? body) #f)
       (probe (list label 'referenced-repeat-construction)
         (grammar-expression (repeat (seq (reference separator) (field argument (reference item)))))
         (list 'repeat body)))))
 '((token-and-comma (token identifier) (literal ",") #f #f)
   (empty-item-and-comma (empty) (literal ",") #t #f)
   (token-and-empty-separator (token identifier) (empty) #f #t)
   (both-empty (empty) (empty) #t #t)))
(probe 'explicit-empty-repeat-rejected
  (attempt (lambda () (grammar-expression (repeat (seq (empty) (field argument (empty)))))))
  '("grammar repeat operand must consume input" ((sequence (empty) (field argument (empty))))))
(display "LIST-REPETITION-CONTRACT-OK: ") (display checked)
(display " checks passed") (newline) (force-output)
(exit 0)
