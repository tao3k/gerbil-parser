(import :gerbil-parser/language-test-support)
;;; -*- Gerbil -*-
(import :std/test
        (only-in :gerbil-parser/src/compiler/lr base-symbol)
        (only-in :gerbil-parser/src/compiler/lr-table validate-lr-tables layout-productions?)
        (only-in :gerbil-parser/src/runtime/funcs
                 association-row-vector->index association-row-index-ref)
        (only-in :gerbil-parser/src/runtime/lr-action-index
                 index-action-row index-action-rows lookup-casefolded-literal-action-entry
                 lookup-action-entry lr-action-row-tokens
                 lookup-literal-action-entry lr-action-row-has-literals?)
        (only-in :gerbil-parser/src/compiler/lr-compiler compile-lr-spec)
        (only-in :gerbil-parser/src/runtime/lr-parser lr-prepare lr-parse/prepared)
        (only-in :gerbil-parser/src/runtime/token make-token)
        (only-in :gerbil-parser/src/runtime/recognition recognition-node-kind))


(defparser-check (check-table-rejected actions gotos)
  (raises
   (lr-prepare
    (list (cons 'productions '((0 root ((terminal token word)) concat #f)))
          (cons 'actions actions) (cons 'gotos gotos)
          (cons 'case-insensitive? #f)))
   (lambda (condition) (string-prefix? "invalid LR table" (error-message condition)))))

(deflanguage-parser-tests lr-index-test "prepared LR indexes preserve association semantics"
  (engine)
    (scenario "canonical table admission preserves original rows and entries"
      (each (entry) ('(((terminal token word) shift 0 #f)
         ((terminal token word) shift 0 (left 10))
         ((terminal token word) reduce 0)
         ((terminal eof) accept)
         ((terminal literal "+") reject-nonassoc (terminal literal "+") 10)
         ((terminal token word) fork (shift 0 #f) (reduce 0))
         ((terminal token word) layout-guard (shift 0 #f) (reduce 0))
         ((terminal token word) layout-guard (shift 0 #f) (fork (reduce 0) (reduce 0)))))
         (scope ((actions (vector (if (equal? (car entry) '(terminal eof))
                                 (list entry)
                                 (list entry '((terminal eof) accept)))))
               (gotos (vector '((root . 0)))))
           (scope-values (((same-actions same-gotos)
                         (validate-lr-tables
                          '((0 root ((terminal token word) (terminal literal "+")) concat #f)
                            (1 root () layout-end #f)) actions gotos)))
             (equal (eq? actions same-actions)  #t)
             (equal (eq? gotos same-gotos)  #t)
             (equal (eq? entry (car (vector-ref same-actions 0)))  #t)))))
    (scenario "layout tables require production-derived request capability"
      (each (entry) ('(((terminal token word) layout-guard (shift 0 #f) (reduce 0))
         ((terminal layout-start "{") shift 0 #f)
         ((terminal layout-next ";") shift 0 #f))) (verify check-table-rejected (vector (list entry)) (vector '())))
      (each (rhs) ('(((terminal layout-start "{"))
         ((marked (terminal layout-next ";") ((field separator))))))
         (scope ((productions (list (list 0 'root rhs 'concat #f)))
               (actions (vector (list (cons (base-symbol (car rhs)) '(shift 0 #f))
                                      '((terminal eof) accept))))
               (gotos '#(())))
           (equal (layout-productions? productions)  #t)
           (scope-values (((same-actions _) (validate-lr-tables productions actions gotos)))
             (equal (eq? same-actions actions)  #t)))))
    (scenario "malformed dimensions and rows fail before indexing"
      (each (pair) ('((#f #()) (#() #()) (#(()) #()) (#(invalid) #(()))
                  (#(()) #(invalid)) (#((invalid)) #(()))
                  (#(()) #((root))) (#(()) #((("root" . 0))))
                  (#(()) #(((root . -1)))) (#(()) #(((root . 1))))
                  (#(()) #(((root . 0) (root . 0)))))) (verify check-table-rejected (car pair) (cadr pair))))
    (scenario "action targets and closed wrappers are admitted as one algebra"
      (each (action) ('((shift -1 #f) (shift 1 #f) (shift 0) (shift 0 (left "10"))
         (reduce -1) (reduce 1) (reduce 0 extra) (accept) (accept extra)
         (callback 0) (fork) (fork (reduce 0))
         (fork (shift 0 #f) (fork (reduce 0) (reduce 0)))
         (fork (shift 0 #f) (reduce 1))
         (layout-guard (reduce 0) (reduce 0))
         (layout-guard (shift 0 #f) (shift 0 #f))
         (reject-nonassoc (terminal token other) 1)))
         (verify check-table-rejected (vector (list (cons '(terminal token word) action))) (vector '())))
      (verify check-table-rejected (vector '(((terminal token "word") reduce 0))) (vector '()))
      (verify check-table-rejected (vector '(((terminal token word) reduce 0)
                                     ((terminal token word) shift 0 #f))) (vector '())))
    (scenario "table symbols belong to canonical production vocabulary"
(locals ((productions '((0 root ((marked (terminal token word) ((field value)))
                   (terminal literal "+")) concat #f)
          (1 unused ((terminal token extra)) concat #f)))
(actions '#((((terminal token word) shift 0 #f)
                       ((terminal literal "+") reduce 0)
                       ((terminal token extra) reduce 1)
                       ((terminal eof) accept)))))
      (verify check-table-rejected '#((((terminal token undeclared) reduce 0)
                                ((terminal eof) accept))) '#(()))
      (verify check-table-rejected '#((((terminal literal "undeclared") reduce 0)
                                ((terminal eof) accept))) '#(()))
      (verify check-table-rejected '#((((terminal eof) accept))) '#(((undeclared . 0))))


      (scope-values (((same-actions same-gotos)
                    (validate-lr-tables productions actions '#(((unused . 0))))))
        (equal (eq? actions same-actions)  #t)
        (equal (vector-ref same-gotos 0)  '((unused . 0))))))
    (scenario "absent or disconnected acceptance fails before runtime preparation"
      (verify check-table-rejected '#(() ()) '#(() ()))
      ;; An accepting cycle isolated from state zero cannot complete a request.
      (verify check-table-rejected '#(() (((terminal token word) shift 1 #f)
                                   ((terminal eof) accept))) '#(() ())))
    (scenario "state traversal follows gotos, forks and layout guards"
(locals ((productions '((0 root ((terminal token word)) concat #f)
          (1 root () layout-end #f))))

      (each (tables) ('((#(() (((terminal eof) accept))) #(((root . 1)) ((root . 0))))
         (#((((terminal token word) fork (shift 1 #f) (shift 2 #f))) ()
             (((terminal eof) accept))) #(() () ()))
         (#((((terminal token word) layout-guard (shift 1 #f) (reduce 0)))
             (((terminal eof) accept))) #(() ()))
         (#((((terminal token word) shift 1 #f))
             (((terminal token word) shift 0 #f) ((terminal eof) accept))) #(() ()))
         (#((((terminal eof) fork (reduce 0) (accept))) ()) #(() ()))))
         (scope-values (((same-actions same-gotos)
                       (validate-lr-tables productions (car tables) (cadr tables))))
           (equal (eq? same-actions (car tables))  #t)
           (equal (eq? same-gotos (cadr tables))  #t)))
      ;; The second fork edge, not just its first branch, must be traversed.
      (verify check-table-rejected '#((((terminal token word) fork (shift 0 #f) (reduce 0)))
           (((terminal eof) accept))) '#(() ()))))
    (scenario "goto list/table boundaries preserve identity, misses and first duplicates"
      (each (width) ('(0 1 8 9 32))
         (sequential ((row (map (lambda (n) (cons (number->string n) n)) (iota width)))
                (rows (vector '() row))
                (indexes (association-row-vector->index rows)))
           (equal (association-row-index-ref indexes 0 "missing")  #f)
           (equal (association-row-index-ref indexes 1 "missing")  #f)
           (each (entry) (row)
              (equal (eq? (association-row-index-ref indexes 1 (string-copy (car entry))) entry)  #t))
           (when (pair? row)
             (sequential ((duplicate (cons (string-copy (caar row)) 'later))
                    (indexed (association-row-vector->index (vector (append row (list duplicate))))))
               (equal (eq? (association-row-index-ref indexed 0 (caar row)) (car row))  #t))))))
    (scenario "action list/table boundaries preserve original entries and first duplicates"
      (each (width) ('(0 1 7 8 9 32))
         (sequential ((entries (map (lambda (n) (cons (list 'terminal 'token (number->string n)) (list 'shift n))) (iota width)))
                (rows (if (pair? entries)
                        (append entries (list (cons (caar entries) '(shift 999)))) entries))
                (index (lr-action-row-tokens (index-action-row rows))))
           (equal (lookup-action-entry index "missing")  #f)
           (each (entry) (entries)
              (equal (eq? (lookup-action-entry index (string-copy (caddar entry))) entry)  #t)))))
    (scenario "literal capability retains indexed association semantics"
      (each (width) ('(0 1 8 9 32))
         (sequential ((entries (map (lambda (n)
                               (cons (list 'terminal 'literal (string-append "KEY" (number->string n)))
                                     (list 'shift n))) (iota width)))
                (row (index-action-row entries)) (reads 0))
           (equal (lr-action-row-has-literals? (begin (set! reads (+ reads 1)) row))  (> width 0))
           (equal reads  1)
           (equal (lookup-literal-action-entry row "missing")  #f)
           (each (entry) (entries)
              (equal (eq? (lookup-literal-action-entry row (string-copy (caddar entry))) entry)  #t))))
      (each (literal) ('("+" "A" "λ" "CAFÉ"))
         (sequential ((entry (cons (list 'terminal 'literal literal) '(shift 1)))
                (row (index-action-row (list entry))))
           (equal (lr-action-row-has-literals? row)  #t)
           (equal (eq? (lookup-literal-action-entry row literal) entry)  #t)))
      (each (terminal) ('((terminal token word) (terminal eof) (terminal layout-start line) (terminal layout-next line)))
         (equal (lr-action-row-has-literals? (index-action-row (list (cons terminal '(shift 1)))))  #f)))
    (scenario "shared casefold trie agrees with whole-string conversion and row admission"
(locals ((entry (lambda ( text n) (cons (list 'terminal 'literal text) (list 'shift n)))))

      (each (width) ('(0 1 8 9 32))
         (sequential ((entries (append (map (lambda (n) (entry (string-append "KEY" (number->string n)) n)) (iota width))
                                 (map (lambda (text) (entry text 100)) '("" "A" "AB" "ABC" "CAFÉ" "ZÉ" "+É" "Λ" "SS" "S" "K" "lower"))))
                (first (entry "KEY0" 201))
                (rows (index-action-rows (vector (cons first entries) (list (entry "OTHER" 202)) '()) #t)))
           (each (row) ((vector->list rows))
              (each (text) ('("" "a" "ab" "abc" "abcd" "key0" "key31" "other" "café" "zé" "xé" "+é" "λ" "ß" "ſ" "K" "lower" "missing-long-identifier"))
                 (equal (eq? (lookup-casefolded-literal-action-entry row text)
                             (lookup-literal-action-entry row (string-upcase text)))  #t)))
           (equal (eq? (lookup-casefolded-literal-action-entry (vector-ref rows 0) "key0") first)  #t)
           (equal (lookup-casefolded-literal-action-entry (vector-ref rows 0) "other")  #f)
           (equal (lookup-casefolded-literal-action-entry (vector-ref rows 1) "key0")  #f)
           (equal (lookup-casefolded-literal-action-entry (vector-ref rows 0) 'word)  #f)))))
    (scenario "literal priority and case-sensitive token fallback remain distinct"
(locals ((rules '((source-file (choice (alias Keyword (literal "KEY"))
                                       (alias Word (token word))))))
(check-root (parser-check ( grammar insensitive? text expected)
        (sequential ((runtime (lr-prepare (compile-lr-spec grammar 'source-file 'error insensitive?)))
               (token (make-token 'word text 0 (u8vector-length (string->utf8 text)))))
          (scope-values (((root rest) (lr-parse/prepared runtime (list token))))
            (equal rest  '())
            (equal (recognition-node-kind root)  expected))))))


      (verify check-root rules #t "keY" 'Keyword)
      (verify check-root rules #f "keY" 'Word)
      (verify check-root rules #f "KEY" 'Keyword)
      (verify check-root rules #t "café" 'Word)
      (verify check-root '((source-file (alias Word (token word)))) #t "café" 'Word))))
