;;; Inclusive stage diagnosis only; the matched CPU gate remains independent.
(import (only-in :gerbil-parser/t/fixtures/runtime-record-assignments/languages/records/grammar records-parser)
        (only-in :gerbil-parser/src/runtime/incremental make-incremental-session incremental-session-artifact incremental-session-recognition-root)
        (only-in :gerbil-parser/src/runtime/parse-cost current-parser-cost-observer with-parser-cost-stage)
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-valid-for-source?)
        (only-in :gerbil-parser/src/runtime/parser parse-source))
(export main)
(def (main)
  (let ((source (apply string-append (make-list 64 "a=1\n"))) (totals (make-table test: eq?)))
    (def expected (parse-source records-parser source))
    (def (request)
      (let* ((session (make-incremental-session records-parser source #t))
             (artifact (incremental-session-artifact session)))
        (with-parser-cost-stage 'benchmark-only-verification
          (unless (and (incremental-session-recognition-root session)
                       (equal? artifact expected)
                       (parse-artifact-valid-for-source? artifact source))
            (error "stage diagnosis request rejected")))))
    (for-each (lambda (_) (request)) (iota 256))
    (parameterize ((current-parser-cost-observer
                    (lambda (stage row)
                      (unless (cdr (assq 'completed row)) (error "stage did not complete" stage))
                      (let (old (table-ref totals stage '(0 0 0)))
                        (table-set! totals stage
                          (list (+ 1 (car old)) (+ (cadr old) (cdr (assq 'cpu-ms row)))
                                (+ (caddr old) (cdr (assq 'gc-count row)))))))))
      (for-each (lambda (_) (with-parser-cost-stage 'complete-captured-request (request))) (iota 256)))
    (for-each (lambda (row) (write (cons 'SELECTOR-INCLUSIVE-STAGE row)) (newline))
              (list-sort (lambda (a b) (string<? (symbol->string (car a)) (symbol->string (car b)))) (table->list totals)))
    (displayln "SELECTOR-STAGE-DIAGNOSIS-OK") (force-output)))
