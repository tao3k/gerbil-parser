;;; Observation only: overlapping GC/CPU counters are not additive costs.
(import :std/misc/ports)
(export main)
(def (field row key) (cdr (assq key (cdr row))))
(def (main directory)
  (for-each
    (lambda (count)
      (let* ((path (path-expand (string-append "scheme-vm-" (number->string count) ".ss") directory))
             (rows (filter pair? (call-with-input-file path read-all)))
             (sum (lambda (key) (apply + (map (cut field <> key) rows)))))
        (unless (= (length rows) 20) (error "incomplete cost observations"))
        (displayln count " gc-wall-percent=" (* 100 (/ (sum 'gc-wall-s) (sum 'wall-s)))
          " cpu/wall=" (/ (sum 'process-cpu-s) (sum 'wall-s))
          " heap-max-bytes=" (apply max (map (cut field <> 'vm-heap-bytes) rows))
          " latest-gc-live-max-bytes=" (apply max (map (cut field <> 'latest-gc-live-raw) rows)))))
    '(1000 10000 100000))
  (let* ((all (call-with-input-file (path-expand "diagnostic-1000.ss" directory) read-all))
         (batches (filter (lambda (row) (and (pair? row) (eq? (car row) 'org-fold-diagnostic.v1))) all))
         (rows (apply append (map (cut field <> 'slow-requests) batches))))
    (unless (and (= (length batches) 20) (= (length rows) 400))
      (error "incomplete diagnostic observations"))
    (displayln "diagnostic-selected=" (length rows)
      " with-gc=" (length (filter (lambda (row) (> (list-ref row 2) 0)) rows)))
    (displayln "FIELDS wall-us index gc-count gc-wall-us cpu-us involuntary-switches")
    (for-each (lambda (row) (write row) (newline))
      (take (list-sort (lambda (a b) (> (car a) (car b))) rows) 8))
    (displayln "SLOWEST-NON-GC diagnostic calls")
    (for-each (lambda (row) (write row) (newline))
      (take (list-sort (lambda (a b) (> (car a) (car b)))
                       (filter (lambda (row) (zero? (list-ref row 2))) rows)) 3))))
