;;; Primitive record projection and independent graph/physical-frame replay.
(import (only-in :gerbil-parser/src/runtime/event-program event-program-inspect event-program-walk/inline)
        (only-in :gerbil-parser/src/runtime/token token-kind token-lexeme token-start token-end))
(export extract-event-graph replay-event-graph event-program-callbacks decode-event-frame
        event-graph-certificate check-event-certificate generate-event-witness witness-callbacks packet-event-callbacks)
(def (name-text name)
  (cond ((symbol? name) (symbol->string name)) ((string? name) name)
        (else (error "invalid extraction name" name))))
(def (integer-slot value)
  (unless (and (integer? value) (exact? value)) (error "non-integer extraction slot" value)) value)
(def (decode-event-frame frame)
  (unless (and (vector? frame) (memv (vector-length frame) '(4 5))) (error "invalid continuation width" frame))
  (let ((code (vector-ref frame 0)) (mode (vector-ref frame 1))
        (delta (vector-ref frame 2)) (moved? (vector-ref frame 3)))
    (unless (or (not code) (and (integer? code) (exact? code) (>= code 0))) (error "invalid continuation reference" code))
    (integer-slot delta)
    (unless (boolean? moved?) (error "invalid continuation provenance" moved?))
    (cond
     ((and (= (vector-length frame) 4) (eq? mode #f)) (list 'next code delta moved?))
     ((and (= (vector-length frame) 4) (integer? mode) (exact? mode)) (list 'chunk code mode delta moved?))
     ((and (= (vector-length frame) 5) (eq? mode #t)
           (or (eq? (vector-ref frame 4) #f)
               (and (integer? (vector-ref frame 4)) (exact? (vector-ref frame 4)))))
      (list 'finish code delta moved? (vector-ref frame 4)))
     (else (error "invalid continuation tag or context" frame)))))
(def (extract-event-graph root)
  (let ((identities (make-hash-table-eq)) (next-id 0) (pending '()) (records '()))
    (def (intern! value)
      (if (not value) #f
        (or (hash-get identities value)
            (let (id next-id)
              (set! next-id (+ id 1)) (hash-put! identities value id)
              (set! pending (cons (cons id value) pending)) id))))
    (let (root-id (intern! root))
      (let loop ()
        (unless (null? pending)
          (let* ((entry (car pending)) (id (car entry)) (packet (event-program-inspect (cdr entry))))
            (set! pending (cdr pending))
            (def (slot i) (vector-ref packet i))
            (let (record
                   (case (slot 0)
                     ((token) (unless (string? (slot 2)) (error "invalid extracted token lexeme" (slot 2)))
                      (list 'token (name-text (slot 1)) (slot 2) (integer-slot (slot 3)) (integer-slot (slot 4))))
                     ((branch) (list 'branch (intern! (slot 1)) (intern! (slot 2)) (integer-slot (slot 3)) (integer-slot (slot 4)) (integer-slot (slot 5))))
                     ((view) (list 'view (intern! (slot 1)) (integer-slot (slot 2))))
                     ((append) (list 'append (intern! (slot 1)) (map intern! (slot 2)) (intern! (slot 3))
                                     (integer-slot (slot 4)) (integer-slot (slot 5)) (integer-slot (slot 6))))
                     ((chunk) (list 'chunk (map intern! (slot 1)) (integer-slot (slot 2)) (integer-slot (slot 3))))
                     ((value) (list 'value (and (slot 1) (name-text (slot 1))) (integer-slot (slot 2))
                                    (integer-slot (slot 3)) (intern! (slot 4))))
                     ((field) (list 'field (name-text (slot 1)) (integer-slot (slot 2))
                                    (integer-slot (slot 3)) (intern! (slot 4))))
                     (else (error "unsupported record projection" packet))))
              (set! records (cons (cons id record) records))))
          (loop)))
      (let (heap (make-vector next-id))
        (for-each (lambda (entry) (vector-set! heap (car entry) (cdr entry))) records)
        (cons root-id heap)))))
(def (event-record-children record)
  (case (car record)
    ((token) '())
    ((branch) (list (cadr record) (caddr record)))
    ((view) (list (cadr record)))
    ((append) (cons (cadr record) (append (caddr record) (list (list-ref record 3)))))
    ((chunk) (unless (>= (length (cadr record)) 2) (error "invalid physical chunk width")) (cadr record))
    ((value field) (list (list-ref record 4)))
    (else (error "invalid graph record" record))))
(def (check-event-certificate graph ranks)
  (let* ((heap (cdr graph)) (count (vector-length heap)))
    (def (ref? ref) (or (eq? ref #f) (and (integer? ref) (exact? ref) (>= ref 0) (< ref count))))
    (def (rank ref) (if (eq? ref #f) 0 (vector-ref ranks ref)))
    (and (ref? (car graph)) (vector? ranks) (= (vector-length ranks) count)
         (every (lambda (i) (and (integer? (rank i)) (exact? (rank i)) (> (rank i) 0))) (iota count))
         (every (lambda (i)
                  (every (lambda (child) (and (ref? child) (< (rank child) (rank i))))
                         (event-record-children (vector-ref heap i)))) (iota count)))))
(def (event-graph-certificate graph)
  (let* ((heap (cdr graph)) (count (vector-length heap))
         (colors (make-vector count 0)) (ranks (make-vector count 0)))
    (let loop ((pending (map (lambda (ref) (cons #f ref)) (cons (car graph) (iota count)))))
      (unless (null? pending)
        (let* ((frame (car pending)) (done? (car frame)) (ref (cdr frame)) (rest (cdr pending)))
          (cond
           ((eq? ref #f) (loop rest))
           ((not (and (integer? ref) (exact? ref) (>= ref 0) (< ref count))) (error "invalid graph reference" ref))
           (done?
            (let (height (foldl (lambda (child maximum)
                                 (max maximum (if (eq? child #f) 0 (vector-ref ranks child))))
                               0 (event-record-children (vector-ref heap ref))))
              (vector-set! ranks ref (+ 1 height))
              (vector-set! colors ref 2) (loop rest)))
           ((= (vector-ref colors ref) 1) (error "cyclic instruction graph" ref))
           ((= (vector-ref colors ref) 2) (loop rest))
           (else
            (let (children (event-record-children (vector-ref heap ref)))
              (vector-set! colors ref 1)
              (loop (append (map (lambda (child) (cons #f child)) children) (cons (cons #t ref) rest)))))))))
    (unless (check-event-certificate graph ranks) (error "invalid generated extraction certificate"))
    ranks))
(def (generate-event-witness graph ranks fuel)
  (unless (check-event-certificate graph ranks) (error "invalid extraction certificate"))
  (let (heap (cdr graph))
    (let visit ((ref (car graph)) (fuel fuel))
      (cond
       ((zero? fuel) #f)
       ((eq? ref #f) '(empty))
       (else
        (let* ((r (vector-ref heap ref)) (refs (event-record-children r))
               (programs (map (lambda (child) (visit child (- fuel 1))) refs)))
          (and (not (memq #f programs))
               (let (rows (map cons refs programs))
                 (def (child ref) (cdr (assoc ref rows)))
                 (def (atom op name position) (list 'atom (list op name position)))
                 (case (car r)
                   ((token) (atom 'token (cdr r) (list-ref r 3)))
                   ((branch) (list 'branch (child (cadr r)) (child (caddr r))))
                   ((view) (list 'view (child (cadr r)) (caddr r)))
                   ((append) (list 'branch (child (cadr r))
                               (foldl (lambda (block rest) (list 'branch (child block) rest))
                                      (child (list-ref r 3)) (caddr r))))
                   ((chunk) (foldr (lambda (item rest) (list 'branch (child item) rest)) '(empty) (cadr r)))
                   ((value) (if (cadr r)
                              (list 'branch (atom 'open-node (cadr r) (caddr r))
                                (list 'branch (child (list-ref r 4)) (atom 'close-node (cadr r) (list-ref r 3))))
                              (list 'branch (child (list-ref r 4)) (atom 'boundary #f (list-ref r 3)))))
                   ((field) (list 'branch (atom 'open-field (cadr r) (caddr r))
                              (list 'branch (child (list-ref r 4)) (atom 'close-field (cadr r) (list-ref r 3)))))
                   (else (error "invalid witness record" r)))))))))))
(def (witness-callbacks witness (stride 7))
  (let ((output '()) (ids '()) (next-id 0))
    (let loop ((pending (list (vector witness 0 #f))))
      (if (null? pending)
        (begin (unless (null? ids) (error "unclosed witness callback")) (reverse output))
        (let* ((frame (car pending)) (code (vector-ref frame 0)) (delta (vector-ref frame 1))
               (moved? (vector-ref frame 2)) (rest (cdr pending)))
          (case (car code)
            ((empty) (loop rest))
            ((branch) (loop (cons (vector (cadr code) delta moved?) (cons (vector (caddr code) delta moved?) rest))))
            ((view) (loop (cons (vector (cadr code) (+ delta (caddr code)) #t) rest)))
            ((atom)
             (let* ((call (cadr code)) (op (car call))
                    (context (and (eq? op 'close-node)
                                  (begin (when (null? ids) (error "witness has no opening callback"))
                                         (let (id (car ids)) (set! ids (cdr ids)) id)))))
               (set! output (cons (append call (list delta moved? context)) output))
               (when (eq? op 'open-node) (set! ids (cons next-id ids)) (set! next-id (+ next-id stride)))
               (loop rest)))
            (else (error "invalid witness instruction" code))))))))
(def (replay-event-graph graph (stride 7))
  (event-graph-certificate graph)
  (let ((heap (cdr graph)) (output '()) (next-return 0))
    (def (record ref)
      (if (not ref) '(empty)
        (begin (unless (and (integer? ref) (exact? ref) (>= ref 0) (< ref (vector-length heap)))
                 (error "invalid graph reference" ref))
               (vector-ref heap ref))))
    (def (emit! op name offset delta moved? context)
      (set! output (cons (list op name offset delta moved? context) output))
      (when (eq? op 'open-node)
        (let (result next-return) (set! next-return (+ result stride)) result)))
    ;; Physical frames have exactly the producer's four/five slots. The only
    ;; mutation is a chunk cursor increment; all slots are decoded before use.
    (let loop ((code (car graph)) (finish? #f) (delta 0) (moved? #f) (context #f) (pending '()))
      (let (r (record code))
        (cond
         ((not code)
          (if (null? pending) (reverse output)
            (let* ((raw (car pending)) (frame (decode-event-frame raw)) (next (cadr frame)))
              (case (car frame)
                ((next) (loop next #f (caddr frame) (cadddr frame) #f (cdr pending)))
                ((finish) (loop next #t (caddr frame) (cadddr frame) (list-ref frame 4) (cdr pending)))
                ((chunk)
                 (let* ((chunk (record next)) (items (cadr chunk)) (i (caddr frame)))
                   (unless (and (eq? (car chunk) 'chunk) (>= i 0) (< i (length items)))
                     (error "chunk cursor out of bounds" i))
                   (let (last? (= (+ i 1) (length items)))
                     (unless last? (vector-set! raw 1 (+ i 1)))
                     (loop (list-ref items i) #f (list-ref frame 3) (list-ref frame 4) #f
                           (if last? (cdr pending) pending)))))))))
         (finish?
          (case (car r)
            ((value) (if (cadr r) (emit! 'close-node (cadr r) (list-ref r 3) delta moved? context)
                       (emit! 'boundary #f (list-ref r 3) delta moved? #f)))
            ((field) (emit! 'close-field (cadr r) (list-ref r 3) delta moved? #f))
            (else (error "invalid footer record" r)))
          (loop #f #f delta moved? #f pending))
         (else
          (case (car r)
            ((token) (emit! 'token (cdr r) (list-ref r 3) delta moved? #f) (loop #f #f delta moved? #f pending))
            ((view) (loop (cadr r) #f (+ delta (caddr r)) #t #f pending))
            ((branch) (loop (cadr r) #f delta moved? #f (cons (vector (caddr r) #f delta moved?) pending)))
            ((append)
             (let (stack (foldl (lambda (ref stack) (cons (vector ref #f delta moved?) stack))
                               (cons (vector (list-ref r 3) #f delta moved?) pending) (caddr r)))
               (loop (cadr r) #f delta moved? #f stack)))
            ((chunk)
             (unless (pair? (cadr r)) (error "empty physical chunk"))
             (loop (car (cadr r)) #f delta moved? #f (cons (vector code 1 delta moved?) pending)))
            ((value)
             (let (state (and (cadr r) (emit! 'open-node (cadr r) (caddr r) delta moved? #f)))
               (loop (list-ref r 4) #f delta moved? #f (cons (vector code #t delta moved? state) pending))))
            ((field) (emit! 'open-field (cadr r) (caddr r) delta moved? #f)
             (loop (list-ref r 4) #f delta moved? #f (cons (vector code #t delta moved? #f) pending)))
            (else (error "invalid graph instruction" r)))))))))
(def (event-program-callbacks program (stride 7))
  (let ((output '()) (next-return 0))
    (event-program-walk/inline
     (lambda (op name offset delta moved? context)
       (set! output
         (cons (list op (if (eq? op 'token)
                         (list (name-text (token-kind name)) (token-lexeme name) (token-start name) (token-end name))
                         (and name (name-text name))) offset delta moved? context) output))
       (when (eq? op 'open-node)
         (let (result next-return) (set! next-return (+ result stride)) result))) program)
    (reverse output)))

;;; Grouped task dispatch corresponding to IteratorExecutor.advance. This
;;; interpreter retains four/five-slot packets as data and decodes every task.
;;; It does not call the register replay or either production walker.
(def (packet-event-callbacks graph (stride 7))
  (event-graph-certificate graph)
  (let ((heap (cdr graph)) (output '()) (next-id 0))
    (def (emit! op name position delta moved? context)
      (set! output (cons (list op name position delta moved? context) output))
      (when (eq? op 'open-node)
        (let (id next-id) (set! next-id (+ next-id stride)) id)))
    (let loop ((pending (list (vector (car graph) #f 0 #f))))
      (if (null? pending) (reverse output)
        (let* ((packet (car pending)) (frame (decode-event-frame packet))
               (mode (car frame)) (ref (cadr frame)) (rest (cdr pending))
               (r (if (eq? ref #f) '(empty) (vector-ref heap ref))))
          (case mode
            ((chunk)
             (let ((index (caddr frame)) (delta (list-ref frame 3)) (moved? (list-ref frame 4)))
               (unless (and (>= index 0) (eq? (car r) 'chunk) (< index (length (cadr r))))
                 (error "invalid packet chunk cursor" packet))
               (let* ((suffix (list-tail (cadr r) index))
                      (tail (if (null? (cdr suffix)) rest
                              (cons (vector ref (+ index 1) delta moved?) rest))))
                 (loop (cons (vector (car suffix) #f delta moved?) tail)))))
            ((finish)
             (let ((delta (caddr frame)) (moved? (list-ref frame 3)) (context (list-ref frame 4)))
               (case (car r)
                 ((value)
                  (if (cadr r)
                    (begin (unless (integer? context) (error "missing packet opening result"))
                           (emit! 'close-node (cadr r) (list-ref r 3) delta moved? context))
                    (begin (unless (eq? context #f) (error "unexpected fragment context"))
                           (emit! 'boundary #f (list-ref r 3) delta moved? #f))))
                 ((field)
                  (unless (eq? context #f) (error "unexpected field context"))
                  (emit! 'close-field (cadr r) (list-ref r 3) delta moved? #f))
                 (else (error "invalid packet footer" r)))
               (loop rest)))
            ((next)
             (let ((delta (caddr frame)) (moved? (list-ref frame 3)))
               (def (task ref) (vector ref #f delta moved?))
               (case (car r)
                 ((empty) (loop rest))
                 ((token) (emit! 'token (cdr r) (list-ref r 3) delta moved? #f) (loop rest))
                 ((branch) (loop (cons (task (cadr r)) (cons (task (caddr r)) rest))))
                 ((view) (loop (cons (vector (cadr r) #f (+ delta (caddr r)) #t) rest)))
                 ((append)
                  (loop (cons (task (cadr r))
                          (foldl (lambda (block stack) (cons (task block) stack))
                                 (cons (task (list-ref r 3)) rest) (caddr r)))))
                 ((chunk)
                  (loop (cons (task (car (cadr r))) (cons (vector ref 1 delta moved?) rest))))
                 ((value)
                  (let (context (and (cadr r) (emit! 'open-node (cadr r) (caddr r) delta moved? #f)))
                    (loop (cons (task (list-ref r 4)) (cons (vector ref #t delta moved? context) rest)))))
                 ((field)
                  (emit! 'open-field (cadr r) (caddr r) delta moved? #f)
                  (loop (cons (task (list-ref r 4)) (cons (vector ref #t delta moved? #f) rest))))
                 (else (error "invalid packet instruction" r)))))
            (else (error "invalid packet mode" frame))))))))
