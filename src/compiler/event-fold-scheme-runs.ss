;;; Lower admitted overwrite-only runs into the ordinary request-owned loop.
(import (only-in ./event-fold-scheme-context fold-scheme-fresh-name current-fold-scheme-diagnostics)
        (only-in ./event-fold-scheme-expressions fold-scheme-condition))
(export fold-scheme-run-loop)

(def (fold-scheme-run-loop form plan from until cursor limit byte bindings indices lower-body)
  (let ((members (make-u8vector 256 0))
        (next (fold-scheme-fresh-name 'run-next))
        (last-byte (fold-scheme-fresh-name 'run-last))
        (summaries (vector-ref plan 4))
        (narrow (and (> (vector-length plan) 5) (vector-ref plan 5)))
        (selected-members (fold-scheme-fresh-name 'consumer-members)))
    (def accumulators (map (lambda (_) (fold-scheme-fresh-name 'run-count)) summaries))
    (def classes
      (map (lambda (summary)
             (let (table (make-u8vector 256 0))
               (for-each (lambda (b) (u8vector-set! table b 1)) (cdr summary))
               table)) summaries))
    (def (advance summary table value input)
      `(if (fx= 1 (u8vector-ref ',table ,input)) (+ ,value 1) 0))
    (def (publish summary value)
      (let (target (cdr (assq (car summary) bindings)))
        (if (symbol? target) `(set! ,target ,value)
          `(vector-set! slots ,(caddr target) ,value))))
    (for-each (lambda (member) (u8vector-set! members member 1)) (vector-ref plan 1))
    (def narrow-members
      (if narrow
        (let (table (make-u8vector 256 0))
          (for-each (lambda (b) (u8vector-set! table b 1)) (vector-ref narrow 1)) table)
        members))
    (def (ordinary? byte) `(fx= 0 (u8vector-ref ,selected-members ,byte)))
    (def (facts position)
      (cons (cons '%validated-loop-byte (cons (cadr form) byte))
        (cons (cons '%loop-byte-value byte)
          (cons (cons (cadr form) position)
            (if (equal? (cadddr form) '(line-content-end))
              (cons (cons '%shared-content-end limit) indices) indices)))))
    `(let ((from ,from) (,limit ,until))
       (unless (<= start from ,limit end)
         (error "native fold iteration outside source line"))
       (let iterate ((,cursor from))
         (unless (= ,cursor ,limit)
           (let* ((,byte (u8vector-ref source-bytes ,cursor))
                  (,selected-members
                    ,(if narrow
                       `(if (and (fx= 0 (u8vector-ref ',narrow-members ,byte))
                                 ,@(map (lambda (name)
                                         (fold-scheme-condition
                                          `(uint-equal? (state ,name) (uint 0))
                                          bindings (facts cursor)))
                                       (vector-ref narrow 0)))
                          ',narrow-members ',members)
                       `',members)))
             (if (and ,(ordinary? byte)
                      ,@(map (lambda (name)
                               (fold-scheme-condition `(uint-equal? (state ,name) (uint 0))
                                                      bindings (facts cursor)))
                             (vector-ref plan 0))
                      ,(fold-scheme-condition (vector-ref plan 2) bindings (facts cursor)))
               (let scan ((,next (+ ,cursor 1))
                          ,@(map (lambda (summary table value)
                                   (list value (advance summary table
                                                 (cdr (assq (car summary) bindings)) byte)))
                                 summaries classes accumulators))
                 (if (and (< ,next ,limit) ,(ordinary? `(u8vector-ref source-bytes ,next)))
                   (scan (+ ,next 1)
                         ,@(map (lambda (summary table value)
                                  (advance summary table value `(u8vector-ref source-bytes ,next)))
                                summaries classes accumulators))
                   (let (,last-byte (- ,next 1))
                     ,@(if (eq? (current-fold-scheme-diagnostics) 'counts)
                         `((fold-cost-count! 'ordinary-run-spans)
                           (fold-cost-count! 'ordinary-run-scanned-bytes (- ,next ,cursor))
                           (fold-cost-count! 'ordinary-run-summary-byte-visits
                             (* (- ,next ,cursor) ,(length summaries)))
                           (fold-cost-count! (cond
                             ((= (- ,next ,cursor) 1) 'ordinary-run-length-1)
                             ((<= (- ,next ,cursor) 4) 'ordinary-run-length-2-4)
                             ((<= (- ,next ,cursor) 16) 'ordinary-run-length-5-16)
                             (else 'ordinary-run-length-over-16)))) '())
                     ,@(map publish summaries accumulators)
                     (let (,byte (u8vector-ref source-bytes ,last-byte))
                       ,@(lower-body (vector-ref plan 3) bindings (facts last-byte)))
                     (iterate ,next))))
               (begin
                 ,@(if (eq? (current-fold-scheme-diagnostics) 'counts)
                     '((fold-cost-count! 'ordinary-run-fallback-bytes)) '())
                 ,@(lower-body (list-ref form 4) bindings (facts cursor))
                 (iterate (+ ,cursor 1))))))))))
