;;; Execute the actual nested grow! body with passive owner observations.
;;; No source instruction is removed/reordered and primitive writes forward.
(import (only-in "event-walk-source.ss" read-source-subdefinition))
(export growth-control-observation)

(def owner-names '(states state-transitions kernel-plans))
(def (observe-owners declaration)
  (def (walk form)
    (cond ((not (pair? form)) form)
          ((eq? (car form) 'quote) form)
          ((and (list? form) (= (length form) 3) (eq? (car form) 'set!) (memq (cadr form) owner-names))
           `(begin ,form (observe-owner (quote ,(cadr form)) states state-transitions kernel-plans)))
          (else (map walk form))))
  (walk declaration))

(def (owner-order-valid? before after receipts)
  (and (= (length receipts) 3)
       (equal? (map car receipts) owner-names)
       (eq? (cadr (car receipts)) (car after))
       (eq? (caddr (car receipts)) (cadr before))
       (eq? (cadddr (car receipts)) (caddr before))
       (eq? (cadr (cadr receipts)) (car after))
       (eq? (caddr (cadr receipts)) (cadr after))
       (eq? (cadddr (cadr receipts)) (caddr before))
       (andmap eq? (take (cdr (caddr receipts)) 3) after)
       (andmap (lambda (receipt) (= (list-ref receipt 4) (* 3 (vector-length (car before))))) receipts)))

(def (growth-control-observation capacity count)
  (let* ((declaration (observe-owners (read-source-subdefinition
           "src/compiler/lr-automaton.ss" 'build-lr0-automaton 'grow!)))
         (producer (eval `(lambda (states state-transitions kernel-plans state-count make-vector vector-set! observe-owner)
                           ,@(cddr declaration) (list states state-transitions kernel-plans))))
         (shared (vector 'shared-template))
         (states (list->vector (map (lambda (node) (list node)) (iota capacity))))
         (rows (list->vector (map (lambda (node) (if (even? node) (list (cons node (+ node 1))) '())) (iota capacity))))
         (plans (list->vector (map (lambda (node) (cons node shared)) (iota capacity))))
         (before (list states rows plans)) (snapshots (map vector->list before))
         (allocations '()) (writes '()) (owners '())
         (after (producer states rows plans count
           (lambda (size fill)
             (let (value (make-vector size fill))
               (set! allocations (cons value allocations)) value))
           (lambda (store index value)
             (set! writes (cons (list store index value) writes)) (vector-set! store index value))
           (lambda (name states rows plans)
             (set! owners (cons (list name states rows plans (length writes)) owners)))))
         (ordered (reverse owners))
         (unchanged (equal? snapshots (map vector->list before))))
    (if (= capacity count)
      (let ((expected (apply append (map (lambda (node)
              (map (lambda (source target) (list target node (vector-ref source node))) before after)) (iota count))))
            (copied (reverse writes)))
        (list
          (and (= (length allocations) 3) (andmap (lambda (value) (if (memq value allocations) #t #f)) after)
               (andmap (lambda (value) (= (vector-length value) (* 2 count))) after))
          (and (= (length copied) (length expected))
            (andmap (lambda (one two)
              (and (eq? (car one) (car two)) (= (cadr one) (cadr two)) (eq? (caddr one) (caddr two)))) copied expected))
          (owner-order-valid? before after ordered)
          (and (andmap (lambda (old fresh) (not (eq? old fresh))) before after) unchanged)
          (and (not (owner-order-valid? before after (reverse ordered)))
               (not (owner-order-valid? before after (cdr ordered)))
               (not (owner-order-valid? before after
                 (cons (append (take (car ordered) 4) '(0)) (cdr ordered)))))))
      (list (and (null? allocations) (null? writes) (null? owners))
            (andmap eq? before after) unchanged))))
