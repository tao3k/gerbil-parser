;;; Closed result recipes lower to Scheme code with direct capture operations.
(import (only-in ../language/result-profile result-plan? result-plan-recipe))
(export result-profile-scheme-source)

(def (projection-operation-source operation index)
  (let ((field (cadr operation)) (capture `(vector-ref captures ,index)))
    (case (car operation)
      ((token)
       `(let (value ,capture)
          ,@(if (eq? (list-ref operation 4) 'required)
              `((unless value (error "missing required projection span" ',field))) '())
          (when value
            (unless (and (pair? value) (exact-integer? (car value)) (exact-integer? (cdr value))
                         (<= start (car value) (cdr value) end))
              (error "invalid projection span" ',field value))
            (let (token (recognition-source-token source ',(caddr operation) (car value) (cdr value)))
              (set! children (cons (make-recognition-child ',field token) children))
              (set! tokens (recognition-sequence-append tokens (list token)))))))
      ((one)
       `(let (value ,capture)
          ,@(if (eq? (list-ref operation 3) 'required)
              `((unless value (error "missing required projection node" ',field))) '())
          (when value
            (unless (and (pair? value) (recognition-node? (car value)))
              (error "invalid projection node capture" ',field))
            (set! children (cons (make-recognition-child ',field (car value)) children))
            (set! tokens (recognition-sequence-append tokens (cdr value))))))
      ((many)
       `(let (value ,capture)
          (unless (and (pair? value) (list? (car value)) (andmap recognition-node? (car value)))
            (error "invalid projection parts capture" ',field))
          (for-each (lambda (part)
                      (set! children (cons (make-recognition-child ',field part) children))) (car value))
          (set! tokens (recognition-sequence-append tokens (cdr value)))))
      (else (error "unadmitted result projection opcode" operation)))))

(def (projection-executor-source row)
  (let* ((operations (cdddr row))
         (single (and (pair? operations) (null? (cdr operations)) (car operations))))
    `(cons ',(car row)
       (lambda (source start end captures)
         ,(cond
            ((and single (eq? (car single) 'token) (eq? (list-ref single 4) 'required))
             `(let (span (vector-ref captures 0))
                (unless (and (pair? span) (exact-integer? (car span)) (exact-integer? (cdr span))
                             (<= start (car span) (cdr span) end))
                  (error "invalid required projection span" ',(cadr single) span))
                (let (token (recognition-source-token source ',(caddr single) (car span) (cdr span)))
                  (values (make-recognition-node ',(cadr row)
                            (recognition-source-offset source start) (recognition-source-offset source end)
                            (list (make-recognition-child ',(cadr single) token))) (list token)))))
            ((and single (eq? (car single) 'many))
             `(let (parts (vector-ref captures 0))
                (unless (and (pair? parts) (list? (car parts)) (andmap recognition-node? (car parts)))
                  (error "invalid projection parts capture" ',(cadr single)))
                (values (result-plan-node plan ',(cadr row)
                          (recognition-source-offset source start) (recognition-source-offset source end)
                          (map (lambda (value) (make-recognition-child ',(cadr single) value)) (car parts)))
                        (cdr parts))))
            (else
             ;; Generated emitters own the accumulator spine; captured lists
             ;; and shared recognition values never enter this reversal.
             `(let ((children '()) (tokens '()))
                ,@(map projection-operation-source operations (iota (length operations)))
                (values (result-plan-node plan ',(cadr row)
                          (recognition-source-offset source start) (recognition-source-offset source end)
                          (reverse! children)) tokens))))))))

(def (result-profile-scheme-source plan)
  (unless (result-plan? plan) (error "Scheme projection generation requires an admitted result plan"))
  (let (recipe (result-plan-recipe plan))
    (call-with-output-string (lambda (port)
      (display ";;; Generated by the shared result projection compiler.\n" port)
      (for-each (lambda (form) (write form port) (newline port))
        `((import (only-in :gerbil-parser/src/language/result-profile result-plan-node result-plan-bind-projections)
                  (only-in :gerbil-parser/src/runtime/recognition recognition-node? make-recognition-node make-recognition-child
                           recognition-source-offset recognition-source-token)
                  (only-in :gerbil-parser/src/runtime/funcs recognition-sequence-append))
          (export bind-generated-result-projections)
          (def (bind-generated-result-projections plan)
            (result-plan-bind-projections plan ',recipe
              (list ,@(map projection-executor-source (caddr recipe)))))))))))
