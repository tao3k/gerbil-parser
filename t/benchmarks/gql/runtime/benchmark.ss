((benchmarkKind . scenario-e2e)
 (max_total . 150ms)
 (target_total . 50ms)
 (regression_budget . 100ms)
 (expected_over_input_budget . 15ms)
 (targetRationale . "one hundred full ISO GQL parses target a 50ms p95 envelope with a 150ms admission ceiling under concurrent test-worker contention")
 (sampleCount . 40)
 (rule . GERBIL-PARSER-GQL-RUNTIME)
 (feature . gql-literal-dispatch)
 (optimizationFocus . "catalog-size-independent prefix dispatch across the 319-literal ISO GQL lexical catalog")
 (inputShape . "one hundred representative ISO GQL queries per sample")
 (expectedOutcome . "lossless ParseArtifact publication remains below the 150ms admission ceiling")
 (measurementPhases collect-before collect-after policy-before policy-after
                    assert-time-gate observe-runtime-memory)
 (tags performance hot-path gql lexer runtime))
