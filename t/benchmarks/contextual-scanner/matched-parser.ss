#!/usr/bin/env gxi
;;; Complete ParseArtifact batches; includes one preparation per plan batch.
(import (only-in :gerbil-parser/languages/hcl/v2-24/grammar hcl-v2-24-parser)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-grammar-digest)
        (only-in :gerbil-parser/src/runtime/parser
                 parse-source/contextual prepare-contextual-parser parse-source/contextual/prepared)
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-valid? parse-artifact-roundtrip)
        (only-in :gerbil-parser/t/benchmarks/contextual-scanner/parser-fixture contextual-product))
(export main)
(def (main . args)
  (let ((requests (if (pair? args) (string->number (car args)) 16))
        (samples (if (> (length args) 1) (string->number (cadr args)) 5)))
    (unless (and (integer? requests) (positive? requests)
                 (integer? samples) (positive? samples))
      (error "expected positive requests and samples" args))
    (displayln "PARSER-FIXTURE requests=" requests " samples=" samples) (force-output)
    (let* ((machine hcl-v2-24-parser)
           (product (contextual-product machine (parser-machine-grammar-digest machine)))
           (sources (list "x = 1\n" (apply string-append (make-list 32 "名字 = 1\n"))
                          "x = " "x = @你好\n")))
      (def (run prepared?)
        (##gc)
        (let* ((cpu (cpu-time)) (wall (##current-time-point))
               (plan (and prepared? (prepare-contextual-parser machine product)))
               (results (map (lambda (n)
                               (let (source (list-ref sources (modulo n 4)))
                                 (if prepared? (parse-source/contextual/prepared plan source)
                                   (parse-source/contextual machine product source)))) (iota requests))))
          (let ((cpu-ms (* 1000 (- (cpu-time) cpu)))
                (wall-ms (* 1000 (- (##current-time-point) wall))))
            (displayln "PARSER-MEASURED prepared=" prepared? " cpu-ms=" cpu-ms) (force-output)
            (values results cpu-ms wall-ms))))
      (let loop ((sample 0))
        (when (< sample (+ samples 3))
          (let-values (((left lc lw) (run (odd? sample))))
            (let-values (((right rc rw) (run (even? sample))))
              (unless (equal? left right) (error "prepared parser changed full ParseArtifact"))
              (for-each (lambda (artifact n)
                          (unless (and (parse-artifact-valid? artifact)
                                       (string=? (parse-artifact-roundtrip artifact)
                                                 (list-ref sources (modulo n 4))))
                            (error "prepared parser broke lossless artifact admission"))) left (iota requests))
              (write (list 'requests requests 'sample sample 'warmup (< sample 3)
                           'before-cpu (if (even? sample) lc rc) 'after-cpu (if (even? sample) rc lc)
                           'before-wall (if (even? sample) lw rw) 'after-wall (if (even? sample) rw lw)))
              (newline) (force-output)))
          (loop (+ sample 1))))
      (displayln "CONTEXTUAL-PARSER-SCALE-OK") (force-output))))
