(def grammar-model-clauses '((start (A #\b)) (A (#\a A)) (A ())))

;;; Independent finite CFG derivation relation. Facts are (lhs,start,end).
;;; This uses neither lowered productions nor nullable/FIRST/LR tables.
(def (derivation-chart-accepts? grammar start word)
  (let ((facts (make-table test: equal?)) (limit (string-length word)))
    (def (rhs? symbols at end)
      (cond ((null? symbols) (= at end))
            ((char? (car symbols))
             (and (< at end) (char=? (car symbols) (string-ref word at))
                  (rhs? (cdr symbols) (+ at 1) end)))
            (else
             (let split ((mid at))
               (and (<= mid end)
                    (or (and (table-ref facts (list (car symbols) at mid) #f)
                             (rhs? (cdr symbols) mid end))
                        (split (+ mid 1))))))))
    (let converge ()
      (let (changed? #f)
        (for-each
         (lambda (rule)
           (for-each (lambda (at)
             (for-each (lambda (end)
               (let (key (list (car rule) at end))
                 (when (and (not (table-ref facts key #f)) (rhs? (cadr rule) at end))
                   (table-set! facts key #t) (set! changed? #t))))
               (iota (+ 1 (- limit at)) at))) (iota (+ limit 1)))) grammar)
        (when changed? (converge))))
    (table-ref facts (list start 0 limit) #f)))

(def (source-dsl-accepts? rules root word)
  ;; Span saturation evaluates the authored tree directly. No lowering helper,
  ;; native FIRST/nullable fact or parser table is consulted.
  (let ((facts (make-table test: equal?)) (limit (string-length word)))
    (def (some-split start end predicate)
      (let loop ((at start))
        (and (<= at end) (or (predicate at) (loop (+ at 1))))))
    (def (sequence? expressions start end)
      (if (null? expressions) (= start end)
        (some-split start end
          (lambda (mid) (and (accepts? (car expressions) start mid)
                            (sequence? (cdr expressions) mid end))))))
    (def (star? expression start end)
      (or (= start end)
          (some-split (+ start 1) end
            (lambda (mid) (and (accepts? expression start mid) (star? expression mid end))))))
    (def (accepts? expression start end)
      (case (car expression)
        ((empty) (= start end))
        ((literal) (string=? (substring word start end) (cadr expression)))
        ((token) (string=? (substring word start end) (symbol->string (cadr expression))))
        ((reference) (table-ref facts (list (cadr expression) start end) #f))
        ((choice) (any (lambda (child) (accepts? child start end)) (cdr expression)))
        ((sequence) (sequence? (cdr expression) start end))
        ((optional) (or (= start end) (accepts? (cadr expression) start end)))
        ((repeat) (star? (cadr expression) start end))
        ((repeat1) (some-split start end (lambda (mid)
                    (and (accepts? (cadr expression) start mid) (star? (cadr expression) mid end)))))
        ((field alias) (accepts? (caddr expression) start end))
        ((precedence) (accepts? (cadddr expression) start end))
        (else (error "unsupported source oracle expression" expression))))
    (let converge ()
      (let (new '())
        (for-each (lambda (row)
          (for-each (lambda (start)
            (for-each (lambda (end)
              (let (key (list (car row) start end))
                (when (and (not (table-ref facts key #f)) (accepts? (cadr row) start end))
                  (set! new (cons key new))))) (iota (+ 1 (- limit start)) start))) (iota (+ limit 1)))) rules)
        (unless (null? new)
          (for-each (lambda (key) (table-set! facts key #t)) new)
          (converge))))
    (table-ref facts (list root 0 limit) #f)))

(def (lowered-chart-rules productions)
  (map (lambda (production)
    (list (production-lhs production)
          (map (lambda (value)
            (let (symbol (base-symbol value))
              (if (nonterminal-symbol? symbol) (nonterminal-name symbol)
                (let (text (if (eq? (cadr symbol) 'token) (symbol->string (caddr symbol)) (caddr symbol)))
                  (unless (= (string-length text) 1) (error "chart fixture needs one-character terminals" symbol))
                  (string-ref text 0))))) (production-rhs production)))) productions))

(defparser-check (source-lowering-correspondence-case)
  (each (rules) ((append native-fact-rules
     (list '((start (choice (repeat (literal "a")) (literal "b"))))
           '((start (choice (repeat1 (literal "a")) (literal "b"))))
           '((start (choice (precedence left 1 (repeat (literal "a"))) (literal "b"))))
           '((start (repeat (literal "a"))) (start (literal "b")))
           '((start (sequence)))
           '((start (optional (literal "a"))))
           '((start (repeat1 (choice (literal "a") (literal "b")))))
           '((start (precedence left 3 (sequence (field value (alias A (token a)))
                                             (optional (literal "b")))))))))
     (scope ((clauses (lowered-chart-rules (lower-rules rules 'start))))
       (iterate words ((word "") (remaining 3))
         (equal (derivation-chart-accepts? clauses 'start word)  (source-dsl-accepts? rules 'start word))
         (unless (zero? remaining)
           (continue words (string-append word "a") (- remaining 1))
           (continue words (string-append word "b") (- remaining 1))))))
  ;; A semantic mutation must be visible to the independent authored evaluator.
  (equal (source-dsl-accepts? '((start (sequence (literal "a") (literal "b")))) 'start "a")  #f)
  (equal (derivation-chart-accepts? '((start (#\a))) 'start "a")  #t))

(defparser-check (repetition-owner-case)
  (each (repetition) ('((repeat (literal "a")) (repeat1 (literal "a"))
     (precedence left 1 (repeat (literal "a")))
     (precedence left 1 (repeat1 (literal "a")))))
     (sequential ((rules (list (list 'start (list 'alias 'Start (list 'choice repetition '(literal "b"))))))
            (events '())
            (productions (lower-rules rules 'start #f
              (lambda (production owner path expression)
                (set! events (cons (list production owner path expression) events))))))
       ;; The generic emission contract: a self-recursive repetition owner
       ;; cannot have an alternative emitted from another expression occurrence.
       (each (event) (events)
         (sequential ((production (car event)) (lhs (production-lhs production)) (rhs (production-rhs production)))
           (when (and (memq (car (cadddr event)) '(repeat repeat1))
                      (pair? rhs) (equal? (base-symbol (car rhs)) (list 'nonterminal lhs)))
             (equal (every (lambda (other)
                       (or (not (eq? (production-lhs (car other)) lhs))
                           (equal? (cdr other) (cdr event)))) events)  #t))))
       (each (route) ('(lalr canonical-lr1 follow-partition-lr1))
          (scope ((runtime (lr-prepare (compile-lr-spec rules 'start 'reject #f route))))
(locals ((accepts? (parser-check ( text)
              (using (with-catch (lambda (condition) (if (lr-rejection-condition? condition) #f (raise condition)))) ()
                  (scope-values (((root rest) (lr-parse/prepared runtime
                    (map (lambda (at) (make-token 'word (substring text at (+ at 1)) at (+ at 1)))
                         (iota (string-length text))))))
                    (equal (recognition-node-kind root)  'Start)
                    (act (null? rest)))))))

            (each (count) ((iota 7))
              (scope ((text (make-string count #\a)))
                (equal (parser-check-result accepts? text)  (source-dsl-accepts? rules 'start text))))
            (equal (parser-check-result accepts? "b")  #t)
            (each (text) ('("ba" "baa" "ab" "bb")) (equal (parser-check-result accepts? text)  #f))))))))

(defparser-check (native-fact-certificate-case)
  (equal (call-with-output-string write-native-grammar-facts)
         (call-with-input-file "formal/ParserEngine/NativeFacts.lean" read-all-as-string)))

(defparser-check (grammar-model-pipeline-case)
  ;; The same S -> A b; A -> a A | epsilon fixture as GrammarPipeline.qnt.
  (sequential ((grammar grammar-model-clauses)
         (rules grammar-model-rules)
         (runtimes (map (lambda (route)
                          (lr-prepare (compile-lr-spec rules 'start 'reject #f route)))
                        '(canonical-lr1 follow-partition-lr1))))
(locals ((native-accepts? (lambda ( runtime tokens)
      (with-catch
       (lambda (condition)
         (if (lr-rejection-condition? condition) #f (raise condition)))
       (lambda ()
         (let-values (((_root rest) (lr-parse/prepared runtime tokens))) (null? rest)))))))

    (iterate words ((word "") (remaining 4))
      (sequential ((tokens (map (lambda (at)
                            (make-token (if (char=? (string-ref word at) #\a) 'a 'b)
                                        (substring word at (+ at 1)) at (+ at 1)))
                          (iota (string-length word))))
             (expected (derivation-chart-accepts? grammar 'start word)))
        (each (runtime) (runtimes) (equal (native-accepts? runtime tokens)  expected)))
      (unless (zero? remaining)
        (continue words (string-append word "a") (- remaining 1))
        (continue words (string-append word "b") (- remaining 1))))
    ;; Real ranked scanner -> real prepared parser. Longest beats rank; the
    ;; equal-width/rank winner is the earlier declaration. Modes can remove it.
    (scope ((factory (make-ranked-lexical-scanner-factory
                   '(("a" a 99 0) ("aa" a 1 1) ("aa" a 1 2) ("b" b 99 3)))))
      (each (mask) ((list (vector #t #t #t #t) (vector #t #f #f #t)))
         (scope ((scan (factory '() mask)) (tokens '()) (source "aab"))
           (iterate loop ((at 0))
             (unless (= at (string-length source))
               (scope ((selected (scan source at)))
                 (equal (and selected (> (cadr selected) at))  #t)
                 (when (= at 0)
                   (equal (cadr selected)  (if (vector-ref mask 1) 2 1))
                   (equal (cadddr selected)  (if (vector-ref mask 1) 1 0)))
                 (act (set! tokens (cons (make-token (car selected) (substring source at (cadr selected))
                                               at (cadr selected)) tokens)))
                 (continue loop (cadr selected)))))
           (act (set! tokens (reverse tokens)))
           (equal (map token-kind tokens)  (if (vector-ref mask 1) '(a b) '(a a b)))
           (each (runtime) (runtimes) (equal (native-accepts? runtime tokens)  #t))))))))

(defparser-check (table-support-counterexample-case)
  ;; Schema-valid indices and reachable accept do not certify CFG semantics.
  ;; Mutate one EOF action: accepting after a without the required trailing b.
  (sequential ((spec (compile-lr-spec grammar-model-rules 'start))
         (actions (vector-copy (lr-spec-ref spec 'actions)))
         (shift (cdr (assoc '(terminal token a) (vector-ref actions 0))))
         (target (cadr shift)))
    (act (vector-set! actions target
      (cons (cons +lr-eof+ '(accept))
            (filter (lambda (entry) (not (equal? (car entry) +lr-eof+))) (vector-ref actions target)))))
    (scope ((runtime (lr-prepare (cons (cons 'actions actions) spec))))
      (scope-values (((_root rest) (lr-parse/prepared runtime (list (make-token 'a "a" 0 1)))))
        (equal (null? rest)  #t)
        (equal (derivation-chart-accepts? grammar-model-clauses 'start "a")  #f)))))

(defparser-check (state-sensitive-terminal-case)
  (sequential ((rows (vector '(((terminal literal "if") shift 0 #f)
                         ((terminal token word) shift 1 #f))
                      '(((terminal token word) shift 1 #f))))
         (select (make-lr-action-selector rows (index-action-rows rows #f) #f #f))
         (raw (make-token 'word "if" 0 2)))
    (equal (car (select 0 raw))  '(terminal literal "if"))
    (equal (car (select 1 raw))  '(terminal token word))))

;;; List-pair closure oracle; never uses packed +1, cached templates or the
;;; producer's closure implementation. The augmented production cannot predict.
(def (reference-core-closure table seeds)
  (let visit ((pending seeds) (seen '()))
    (if (null? pending) seen
      (let ((item (car pending)) (tail (cdr pending)))
        (if (member item seen) (visit tail seen)
          (let* ((production (vector-ref table (car item))) (dot (cadr item))
                 (rhs (production-rhs production))
                 (next (and (< dot (length rhs)) (base-symbol (list-ref rhs dot))))
                 (predicted
                  (if (and next (nonterminal-symbol? next))
                    (filter-map (lambda (id)
                       (and (not (zero? id))
                            (eq? (production-lhs (vector-ref table id)) (nonterminal-name next))
                            (list id 0))) (iota (vector-length table))) '())))
            (visit (append tail predicted) (cons item seen))))))))

(def (graph-construction-holds? table states transitions layout)
  (def (coordinates state)
    (map (lambda (core) (list (core-item-production-id core layout) (core-item-dot core layout)))
         (vector-ref states state)))
  (let (initial (reference-core-closure table '((0 0))))
    (and (every (lambda (item) (member item initial)) (coordinates 0))
         (every
          (lambda (edge)
            (let* ((source (coordinates (car edge))) (symbol (cadr edge))
                   (target (coordinates (caddr edge)))
                   (moved (filter-map (lambda (item)
                     (let ((rhs (production-rhs (vector-ref table (car item)))) (dot (cadr item)))
                       (and (< dot (length rhs)) (equal? symbol (base-symbol (list-ref rhs dot)))
                            (list (car item) (+ dot 1))))) source))
                   (closure (reference-core-closure table moved)))
              (and (not (member '(0 0) target))
                   (every (lambda (item) (member item closure)) target)))) transitions))))

(def (table-support-holds? spec table states transitions layout lookaheads offsets terminals)
  (def (supported? state key action)
    (case (car action)
      ((fork) (every (lambda (child) (supported? state key child)) (cdr action)))
      ((reject-nonassoc) #t) ; Rejection makes no successful transition claim.
      ((shift)
       (and (member (list state key (cadr action)) transitions)
            (any (lambda (core)
                   (let* ((rhs (production-rhs (vector-ref table (core-item-production-id core layout))))
                          (dot (core-item-dot core layout)))
                     (and (< dot (length rhs)) (equal? key (base-symbol (list-ref rhs dot))))))
                 (vector-ref states state))))
      ((reduce accept)
       (let* ((id (if (eq? (car action) 'accept) 0 (cadr action)))
              (width (length (production-rhs (vector-ref table id))))
              (terminal-id (let find ((at 0))
                             (and (< at (vector-length terminals))
                                  (if (equal? key (vector-ref terminals at)) at (find (+ at 1)))))))
         (and (if (zero? id) (and (eq? (car action) 'accept) (equal? key +lr-eof+) (= width 1)) #t)
              terminal-id
              (let find ((cores (vector-ref states state)) (node (vector-ref offsets state)))
                (and (pair? cores)
                     (or (and (= (core-item-production-id (car cores) layout) id)
                              (= (core-item-dot (car cores) layout) width)
                              (compiler-index-set-member? (vector-ref lookaheads node) terminal-id))
                         (find (cdr cores) (+ node 1))))))))
      (else #f)))
  (and (every (lambda (state)
                (every (lambda (cell) (supported? state (car cell) (cdr cell)))
                       (vector-ref (lr-spec-ref spec 'actions) state)))
              (iota (- (vector-length offsets) 1)))
       (every (lambda (state)
                (every (lambda (cell) (member (list state (list 'nonterminal (car cell)) (cdr cell)) transitions))
                       (vector-ref (lr-spec-ref spec 'gotos) state)))
              (iota (- (vector-length offsets) 1)))))

(def (reference-lookahead-closure table seeds first nullable)
  ;; Tuple items and symbolic terminals, independent of native masks, suffix
  ;; catalogs, closure scratch arrays and dependency queues.
  (def (suffix-first symbols inherited)
    (if (null? symbols) (list inherited)
      (let* ((symbol (base-symbol (car symbols)))
             (head (if (terminal-symbol? symbol) (list symbol)
                       (cdr (assq (nonterminal-name symbol) first)))))
        (append head (if (and (nonterminal-symbol? symbol)
                             (table-ref nullable (nonterminal-name symbol) #f))
                      (suffix-first (cdr symbols) inherited) '())))))
  (let visit ((pending seeds) (seen '()))
    (if (null? pending) seen
      (let* ((item (car pending)) (tail (cdr pending))
             (rhs (production-rhs (vector-ref table (car item)))) (dot (cadr item)))
        (if (member item seen) (visit tail seen)
          (let (symbol (and (< dot (length rhs)) (base-symbol (list-ref rhs dot))))
            (visit
             (append tail
               (if (and symbol (nonterminal-symbol? symbol))
                 (append-map (lambda (id)
                   (if (eq? (production-lhs (vector-ref table id)) (nonterminal-name symbol))
                     (map (lambda (lookahead) (list id 0 lookahead))
                          (suffix-first (list-tail rhs (+ dot 1)) (caddr item))) '()))
                   (iota (vector-length table))) '()))
             (cons item seen))))))))

(def (reference-graph-lookaheads table states transitions layout count first nullable)
  (let (expected (make-vector count '()))
    (vector-set! expected 0 (reference-lookahead-closure table (list (list 0 0 +lr-eof+)) first nullable))
    (let converge ()
      (let (changed? #f)
        (for-each (lambda (edge)
          (let* ((source (car edge)) (symbol (cadr edge)) (target (caddr edge))
                 (moved (filter-map (lambda (item)
                   (let* ((rhs (production-rhs (vector-ref table (car item)))) (dot (cadr item)))
                     (and (< dot (length rhs)) (equal? symbol (base-symbol (list-ref rhs dot)))
                          (list (car item) (+ dot 1) (caddr item))))) (vector-ref expected source)))
                 (closed (reference-lookahead-closure table moved first nullable)))
            (for-each (lambda (item)
              (unless (member item (vector-ref expected target))
                (vector-set! expected target (cons item (vector-ref expected target)))
                (set! changed? #t))) closed))) transitions)
        (when changed? (converge))))
    expected))

(defparser-check (lookahead-provenance-case)
  (each (entry) ((list (list grammar-model-rules 'start)
         (list lr1-not-lalr-rules 'source-file)
         (list shared-lookahead-rules 'source-file)
         (list '((start (sequence (reference a) (reference dead)))
                 (a (literal "a")) (dead (reference dead))) 'start)))
     (sequential ((rules (car entry)) (root (cadr entry)) (productions (lower-rules rules root))
            (table (production-table productions)) (nullable (reference-nullable productions))
            (first (reference-first productions nullable)) (first-index (make-table test: eq?)))
       (each (row) (first) (act (table-set! first-index (car row) (cdr row))))
       (each (build) ((list build-states-via-lr0 build-states-via-canonical-lr1 build-states-via-partitioned-lr1 build-states-via-follow-partition-lr1))
          (scope-values (((states count lookaheads offsets transitions terminals layout _symbols _visits _items)
                        (build productions table first-index nullable)))
            (scope ((expected (reference-graph-lookaheads table states transitions layout count first nullable)))
              (each (state) ((iota count))
                (scope ((node (vector-ref offsets state)) (actual '()))
                  (each (core) ((vector-ref states state))
                    (each (terminal) ((iota (vector-length terminals)))
                      (when (compiler-index-set-member? (vector-ref lookaheads node) terminal)
                        (act (set! actual (cons (list (core-item-production-id core layout)
                                                (core-item-dot core layout) (vector-ref terminals terminal)) actual)))))
                    (act (set! node (+ node 1))))
                  (equal (every (lambda (item) (not (not (member item (vector-ref expected state))))) actual)  #t)
                  (equal (every (lambda (item) (not (not (member item actual)))) (vector-ref expected state))  #t)
                  ;; Unsupported lookahead cannot gain provenance from a
                  ;; completed native item or its in-range terminal index.
                  (equal (member (list 0 1 '(terminal token impossible)) (vector-ref expected state))  #f)))))))))

(defparser-check (graph-provenance-case)
  (each (entry) ((list (list grammar-model-rules 'start)
         (list lr1-not-lalr-rules 'source-file)
         (list shared-lookahead-rules 'source-file)
         (list '((start (sequence (literal "x") (reference $accept)))
                 ($accept (literal "a"))) 'start)))
     (sequential ((rules (car entry)) (root (cadr entry)) (productions (lower-rules rules root))
            (table (production-table productions)))
       (scope-values (((_nullable nullable _productive _productive-index) (compute-completion productions)))
         (scope-values (((_first first) (compute-first productions nullable)))
           (each (build) ((list build-states-via-lr0 build-states-via-canonical-lr1 build-states-via-follow-partition-lr1))
              (scope-values (((states _count lookaheads offsets transitions terminals layout _symbols _visits _items)
                            (build productions table first nullable)))
                (equal (not (not (graph-construction-holds? table states transitions layout)))  #t)
                (sequential ((route (cond ((eq? build build-states-via-lr0) 'lalr)
                                    ((eq? build build-states-via-canonical-lr1) 'canonical-lr1)
                                    (else 'follow-partition-lr1)))
                       (spec (compile-lr-spec rules root 'probe #f route)))
                  (equal (not (not (table-support-holds? spec table states transitions layout lookaheads offsets terminals)))  #t)
                  (scope ((actions (vector-copy (lr-spec-ref spec 'actions))))
                    (act (vector-set! actions 0 (cons (cons +lr-eof+ '(reduce 0)) (vector-ref actions 0))))
                    (equal (not (table-support-holds? (cons (cons 'actions actions) spec)
                                  table states transitions layout lookaheads offsets terminals))  #t)))
                ;; Inventing a positive-dot RHS symbol must fail the independent
                ;; closure relation even when the graph target remains in range.
                (when (pair? transitions)
                  (sequential ((edge (car transitions))
                         (mutated (cons (list (car edge) '(terminal token impossible) (caddr edge))
                                        (cdr transitions))))
                    (equal (not (graph-construction-holds? table states mutated layout))  #t))))))))))

;; Mirrors the model's physical boundary: the callback observes the same
;; production in ordinal order and identifies a real authored occurrence.
(defparser-check (emission-origin-alignment-case)
(locals ((source-at (lambda ( expression path)
    (if (null? path) expression
      (let* ((kind (car expression))
             (children (case kind
                         ((choice sequence) (cdr expression))
                         ((optional repeat repeat1) (list (cadr expression)))
                         ((field alias) (list (caddr expression)))
                         ((precedence) (list (cadddr expression)))
                         (else '())))
             (index (car path)))
        (and (< index (length children)) (source-at (list-ref children index) (cdr path))))))))

  (sequential ((reserved (map (lambda (index) (string->symbol (string-append "$start." (number->string index))))
                        (iota 128)))
         ;; Half are declared; half are deliberately undefined references. Both
         ;; groups must be reserved before any helper or augmentation is claimed.
         (rules (cons
                 (list 'start
                   (list 'alias 'Start
                     (list 'choice
                       '(sequence (optional (literal "a"))
                                  (repeat1 (sequence (field word (token word)) (literal "b"))))
                       (cons 'sequence (map (lambda (name) (list 'reference name)) (cons '$accept reserved))))))
                 (map (lambda (name) (list name '(empty))) (take reserved 64))))
         (observed '())
         (productions
           (lower-rules rules 'start #f
             (parser-check-procedure (parser-check (production owner path expression)
               (equal (any (lambda (row)
                             (and (eq? owner (car row)) (equal? expression (source-at (cadr row) path)))) rules)  #t)
               (act (set! observed (cons production observed))))))))
    (equal (lower-rules rules 'start)  productions)
    (equal (map production-id productions)  (iota (length productions)))
    (equal (every (lambda (pair) (eq? (car pair) (cadr pair)))
                    (map list (reverse observed) (cdr productions)))  #t)
    (each (production) (productions)
       (scope ((name (production-lhs production)))
         (unless (assq name rules)
           (equal (memq name (cons '$accept reserved))  #f))))
    ;; The source occurrence comparison must reject a stale/wrong child path.
    (equal (source-at '(sequence (literal "a") (literal "b")) '(1))  '(literal "b"))
    (equal (equal? '(literal "a") (source-at '(sequence (literal "a") (literal "b")) '(1)))  #f))))

(defparser-check (lowering-proof-publication-case)
  (sequential ((rules '((start (choice (repeat (literal "a"))
                                (sequence (optional (token word)) (reference missing))))))
         (bindings '()) (published '()) (events '())
         (productions
          (lower-rules rules 'start #f #f
            (parser-check-procedure (parser-check (kind value proof)
              (act (set! events (cons kind events)))
              (choose kind ((binding)
                 (equal (memq value bindings)  #f)
                 (act (set! bindings (cons value bindings)))) ((production)
                 (equal (pair? proof)  #t)
                 ;; A helper's physical identity must be published before any
                 ;; rule that mentions it. Authored and missing names are separate.
                 (each (operand) ((production-rhs value))
                   (scope ((symbol (base-symbol operand)))
                     (when (nonterminal-symbol? symbol)
                       (scope ((name (nonterminal-name symbol)))
                         (unless (memq name '(start missing))
                           (equal (and (memq name bindings) #t)  #t))))))
                 (act (set! published (cons value published))))))))))
    (equal productions  (lower-rules rules 'start))
    (equal (map production-id (reverse published))  (cdr (iota (length productions))))
    (equal (every eq? (reverse published) (cdr productions))  #t)
    (equal (car (reverse events))  'binding))
  ;; A failed proof sink propagates its original condition; it cannot publish
  ;; a successful truncated replay receipt.
  (scope ((failure (list 'proof-sink-failure)))
    (equal (with-catch (lambda (condition) (eq? condition failure))
             (lambda ()
               (lower-rules '((start (empty))) 'start #f #f
                 (lambda (_kind _value _proof) (raise failure)))
               #f))  #t)))

(defparser-check (internal-name-isolation-case)
  ;; Both augmented and lowered helper names must avoid authored declarations.
  (each (entry) ((list
    (list '((start (alias Start (sequence (literal "x") (reference $accept))))
            ($accept (literal "a"))) 'start "xa")
    (list '(($accept (alias Start (sequence (literal "x") (reference $accept.0))))
            ($accept.0 (literal "a"))) '$accept "xa")
    (list '((start (alias Start (sequence (optional (literal "x")) (reference $start.0))))
            ($start.0 (literal "a"))) 'start "xa")))
     (sequential ((rules (car entry)) (root (cadr entry)) (text (caddr entry))
            (productions (lower-rules rules root)))
       (equal (lower-rules rules root)  productions)
       (equal (member (production-lhs (car productions)) (map car rules))  #f)
       (each (route) ('(canonical-lr1 follow-partition-lr1))
          (scope ((runtime (lr-prepare (compile-lr-spec rules root 'reject #f route))))
            (scope-values (((_root rest) (lr-parse/prepared runtime
              (map (lambda (at) (make-token 'punctuation (substring text at (+ at 1)) at (+ at 1)))
                   (iota (string-length text))))))
              (equal (null? rest)  #t))
            (equal (with-catch
                    (lambda (condition)
                      (if (lr-rejection-condition? condition) #t (raise condition)))
                    (lambda () (lr-parse/prepared runtime '()) #f))  #t))))))

(defparser-check (raw-request-terminal-case)
  (sequential ((rules '((start (choice (alias Keyword (sequence (literal "a") (literal "if")))
                                (alias Identifier (sequence (literal "b") (token word)))))))
         (base (lr-prepare (compile-lr-spec rules 'start)))
         (raw (make-token 'word "if" 1 3)) (selected '())
         (runtime (lr-runtime-with-action-selector base
          (lambda (rows index insensitive? layout?)
            (let (select (make-lr-action-selector rows index insensitive? layout?))
              (lambda (state input)
                (let (entry (select state input))
                  (when (and (eq? input raw) entry (eq? (cadr entry) 'shift))
                    (set! selected (cons (car entry) selected)))
                  entry)))))))
    (each (prefix kind) ('("a" "b") '(Keyword Identifier))
       (scope-values (((root rest) (lr-parse/prepared runtime
                         (list (make-token 'punctuation prefix 0 1) raw))))
         (equal (null? rest)  #t)
         (equal (recognition-node-kind root)  kind)))
    (equal (reverse selected)  '((terminal literal "if") (terminal token word)))))

(defparser-check (first-is-not-productivity-case)
  (scope ((productions (lower-rules
                     '((start (sequence (literal "a") (reference dead)))
                       (dead (reference dead))) 'start)))
    (scope-values (((_nullable nullable _productive productive) (compute-completion productions)))
      (scope-values (((_rows first) (compute-first productions nullable)))
        (equal (table-ref nullable 'start #f)  #f)
        (equal (table-ref productive 'start #f)  #f)
        (equal (table-ref first 'start '())  '((terminal literal "a")))))))

(defparser-check (duplicate-production-identity-case)
  ;; Equal base CFG rows retain distinct RHS aliases, precedence and IDs.
  (sequential ((rules '((start (choice
                         (precedence left 1 (alias Lower (literal "a")))
                         (precedence left 2 (alias Higher (literal "a")))))))
         (productions (lower-rules rules 'start))
         (authored (cdr productions))
         (table (production-table productions)))
    (equal (length authored)  2)
    (equal (map production-id authored)  '(1 2))
    (equal (production-lhs (car authored))  (production-lhs (cadr authored)))
    (equal (map base-symbol (production-rhs (car authored)))
       (map base-symbol (production-rhs (cadr authored))))
    (equal (equal? (production-rhs (car authored)) (production-rhs (cadr authored)))  #f)
    (equal (equal? (production-precedence (car authored)) (production-precedence (cadr authored)))  #f)
    (scope-values (((terminals _index) (production-terminal-catalog productions)))
      (scope ((layout (make-item-layout table terminals)))
        (each (dot) ('(0 1))
          (scope ((left (make-core-item 1 dot layout)) (right (make-core-item 2 dot layout)))
            (equal (= left right)  #f)
            (equal (core-item-production-id left layout)  1)
            (equal (core-item-production-id right layout)  2)))))
    (each (route) ('(lalr canonical-lr1 follow-partition-lr1))
      (sequential ((spec (compile-lr-spec rules 'start 'reject #f route))
             (runtime (lr-prepare spec)))
        ;; Repeated requests use the published table after all scratch cleanup.
        (each (iteration) ('(0 1))
          (scope-values (((root rest) (lr-parse/prepared runtime (list (make-token 'punctuation "a" 0 1)))))
            (equal (recognition-node-kind root)  'Higher)
            (equal rest  '())))))))

;;; Independent coordinates include epsilon, unary and uneven-width rules.
;;; Expected coordinates are not decoded from the packed value.
(defparser-check (dense-item-coordinates-case)
  (sequential ((productions (lower-rules '((start (sequence (literal "a") (literal "b") (literal "c")))
                                   (empty (sequence)) (short (literal "z"))) 'start))
         (table (production-table productions)))
    (scope-values (((terminals _index) (production-terminal-catalog productions)))
      (sequential ((layout (make-item-layout table terminals))
             (symbols (make-core-symbol-catalog table layout))
             (coordinates '((0 0) (0 1) (1 0) (1 1) (1 2) (1 3) (2 0) (3 0) (3 1))))
        (equal (core-item-count layout)  9)
        (equal (vector->list symbols)
           '((nonterminal start) #f (terminal literal "a") (terminal literal "b")
               (terminal literal "c") #f #f (terminal literal "z") #f))
        (each (coordinate item) (coordinates (iota 9))
           (equal (make-core-item (car coordinate) (cadr coordinate) layout)  item)
           (equal (core-item-production-id item layout)  (car coordinate))
           (equal (core-item-dot item layout)  (cadr coordinate)))))))

(defparser-check (dense-layout-refinement-case)
  (each (widths) ('((0) (0 0 0) (1 0 7 2 0) (64 1 0 3) (1 128 1 0)))
     (sequential ((rules (map (lambda (width id)
                         (list (string->symbol (string-append "rule-" (number->string id)))
                               (cons 'sequence (make-list width '(token word)))))
                       widths (iota (length widths))))
            (productions (lower-rules rules 'rule-0))
            (table (production-table productions))
            ;; Ordered flattening is intentional: the SDK append-map utility
            ;; reverses each returned segment and is unsuitable for coordinates.
            (coordinates (apply append (map (lambda (production)
                           (map (lambda (dot) (list (production-id production) dot))
                                (iota (+ 1 (length (production-rhs production)))))) productions))))
       (scope-values (((terminals _index) (production-terminal-catalog productions)))
         (sequential ((layout (make-item-layout table terminals))
                (symbols (make-core-symbol-catalog table layout)))
           (equal (core-item-count layout)  (length coordinates))
           (each (coordinate code) (coordinates (iota (length coordinates)))
              (sequential ((id (car coordinate)) (dot (cadr coordinate))
                     (rhs (production-rhs (vector-ref table id))))
                (equal (make-core-item id dot layout)  code)
                (equal (list (core-item-production-id code layout) (core-item-dot code layout))  coordinate)
                (equal (vector-ref symbols code)
                   (and (< dot (length rhs)) (base-symbol (list-ref rhs dot))))
                (when (< dot (length rhs))
                  ;; The logical goto theorem uses this exact after-dot guard.
                  (equal (list (core-item-production-id (+ code 1) layout)
                               (core-item-dot (+ code 1) layout))  (list id (+ dot 1)))))))))))

(defparser-check (skew-item-space-case)
  (sequential ((productions (lower-rules (skew-width-rules 128 64) 'source-file))
         (table (production-table productions)))
    (scope-values (((terminals _index) (production-terminal-catalog productions)))
      (sequential ((layout (make-item-layout table terminals))
             (symbols (make-core-symbol-catalog table layout)))
        ;; Two unary entry rules, 128 unary composition members and one wide
        ;; rule. The old padded domain had 8,515 positions for this grammar.
        (equal (vector-length symbols)  325)
        (equal (make-core-item 130 0 layout)  260)
        (equal (make-core-item 130 64 layout)  324)
        (equal (vector-ref symbols 324)  #f)))
    (verify check-suffix-catalog productions)
    (scope-values (((_names nullable) (compute-nullable productions)))
      (scope-values (((_rows first) (compute-first productions nullable)))
        (scope-values (((partitions _candidates _terminals)
                      (initial-backward-follow-partitions productions table first nullable)))
          (equal (vector-length partitions)  325))))))

(def (admission-result rules (construction 'lalr) (policy 'reject))
  (with-catch
   (lambda (condition) (list (error-message condition) (error-irritants condition)))
   (lambda () (compile-lr-spec rules 'start policy #f construction) 'accepted)))

(def (nullable-repeat-result owner operand (kind 'repeat))
  (list "resolved repetition operand accepts empty input" (list owner kind operand)))

(def (parse-literals rules text (return-root? #f))
  (let (spec (compile-lr-spec
              (map (lambda (row)
                     (if (eq? (car row) 'start)
                       (list 'start (list 'alias 'Start (cadr row))) row)) rules)
              'start))
    (with-catch
     (lambda (condition)
       (if (lr-rejection-condition? condition) 'rejected (raise condition)))
     (lambda ()
       (let-values (((root rest)
                     (lr-parse spec
                      (map (lambda (index)
                             (make-token 'punctuation (string (string-ref text index))
                                         index (+ index 1)))
                           (iota (string-length text))))))
         (unless (null? rest) (error "unconsumed test input" rest))
         (if return-root? root 'accepted))))))

(def (rule-role name rules)
  (make-grammar-role name '() '() '() rules '() '() '() '() '()))

;; Independent repeated-scan oracle retained only in this semantic control.
(def (reference-nullable productions)
  (let (index (make-table test: eq?))
    (let converge ()
      (let (changed? #f)
        (for-each
         (lambda (production)
           (when (and (not (table-ref index (production-lhs production) #f))
                      (every (lambda (value)
                               (let (symbol (base-symbol value))
                                 (and (nonterminal-symbol? symbol)
                                      (table-ref index (nonterminal-name symbol) #f))))
                             (production-rhs production)))
             (table-set! index (production-lhs production) #t)
             (set! changed? #t))) productions)
        (when changed? (converge))))
    index))

(def (nullable-production name rhs) (list 0 name rhs #f #f))

(defparser-check (check-nullable-reference productions)
  (scope ((reference (reference-nullable productions)))
    (scope-values (((names index) (compute-nullable productions)))
      (equal names  (filter (lambda (name) (table-ref reference name #f)) '(a b c)))
      (each (name) ('(a b c missing))
                  (equal (table-ref index name #f)  (table-ref reference name #f))))))

(def (reference-first productions nullable)
  (let ((index (make-table test: eq?)) (names '()) (terminals '((terminal eof))))
    (def (union left right)
      (foldl (lambda (value found) (if (member value found) found (append found (list value)))) left right))
    (for-each
     (lambda (production)
       (set! names (if (memq (production-lhs production) names) names
                      (append names (list (production-lhs production)))))
       (for-each (lambda (value)
                   (let (symbol (base-symbol value))
                     (when (terminal-symbol? symbol)
                       (set! terminals (union terminals (list symbol))))))
                 (production-rhs production))) productions)
    (def (prefix rhs)
      (if (null? rhs) '()
          (let (symbol (base-symbol (car rhs)))
            (if (terminal-symbol? symbol) (list symbol)
                (let* ((name (nonterminal-name symbol)) (found (table-ref index name '())))
                  (if (table-ref nullable name #f) (union found (prefix (cdr rhs))) found))))))
    (let converge ()
      (let (changed? #f)
        (for-each
         (lambda (production)
           (let* ((name (production-lhs production)) (before (table-ref index name '()))
                  (after (union before (prefix (production-rhs production)))))
             (unless (equal? before after)
               (table-set! index name after) (set! changed? #t)))) productions)
        (when changed? (converge))))
    (map (lambda (name)
           (cons name (filter (lambda (terminal) (member terminal (table-ref index name '()))) terminals))) names)))

(defparser-check (check-first-reference productions)
  (sequential ((nullable (reference-nullable productions))
         (expected (reference-first productions nullable)))
    (scope-values (((rows index) (compute-first productions nullable)))
      (equal rows  expected)
      (each (row) (expected) (equal (table-ref index (car row))  (cdr row))))))

(def (reference-productive productions)
  (let (index (make-table test: eq?))
    (let converge ()
      (let (changed? #f)
        (for-each
         (lambda (production)
           (when (and (not (table-ref index (production-lhs production) #f))
                      (every (lambda (value)
                               (let (symbol (base-symbol value))
                                 (or (terminal-symbol? symbol)
                                     (table-ref index (nonterminal-name symbol) #f))))
                             (production-rhs production)))
             (table-set! index (production-lhs production) #t)
             (set! changed? #t))) productions)
        (when changed? (converge))))
    index))

(defparser-check (check-productive-reference productions)
  (scope ((expected (reference-productive productions))
        (nullable (reference-nullable productions))
        (names '()))
    (each (production) (productions)
                (unless (memq (production-lhs production) names)
                  (act (set! names (append names (list (production-lhs production)))))))
    (scope-values (((nullable-found nullable-index found index) (compute-completion productions)))
      (equal nullable-found  (filter (lambda (name) (table-ref nullable name #f)) names))
      (each (name) ((cons 'missing names)) (equal (table-ref nullable-index name #f)  (table-ref nullable name #f)))
      (equal found  (filter (lambda (name) (table-ref expected name #f)) names))
      (each (name) ((cons 'missing names))
                  (equal (table-ref index name #f)  (table-ref expected name #f))
                  (when (table-ref nullable name #f)
                    (equal (table-ref index name #f)  #t))))))

;; Independent forward suffix scans check the entire catalog, including
;; unused/padded slots. The optimized builder folds backwards and uses masks.
(defparser-check (check-suffix-catalog productions)
  (scope ((table (production-table productions)))
    (scope-values (((terminals terminal-index) (production-terminal-catalog productions))
                 ((names nullable) (compute-nullable productions)))
      (scope-values (((first-rows first) (compute-first productions nullable)))
       (sequential ((layout (make-item-layout table terminals))
             (symbols (make-core-symbol-catalog table layout))
             (expected-masks (make-vector (vector-length symbols) 0))
             (expected-nullable (make-vector (vector-length symbols) #f)))
        (iterate production-loop ((id 0))
          (when (< id (vector-length table))
            (iterate suffix-loop ((rest (production-rhs (vector-ref table id))) (dot 0))
              (scope ((item (make-core-item id dot layout)))
                (act (vector-set! expected-masks item
                  (foldl (lambda (terminal mask)
                           (compiler-index-set-union mask
                             (arithmetic-shift 1 (table-ref terminal-index terminal))))
                         0 (sequence-first rest first nullable))))
                (act (vector-set! expected-nullable item (sequence-nullable? rest nullable))))
              (unless (null? rest)
                (continue suffix-loop (cdr rest) (+ dot 1))))
            (continue production-loop (+ id 1))))
        (scope-values (((masks nullable-tails)
                      (make-core-suffix-catalog table layout symbols first nullable terminal-index)))
          (equal masks  expected-masks)
          (equal nullable-tails  expected-nullable)))))))

;;; Named case procedures retain independent assertions and separate native C hosts.

(defparser-check (suffix-facts-case)
  (each (rules) ([shared-lookahead-rules lr1-not-lalr-rules precedence-expression-rules
     inactive-core-conflict-rules (mixed-context-family-rules 8)]) (verify check-suffix-catalog (lower-rules rules 'source-file)))
  ;; Empty FIRST is not nullable; a missing reference blocks a suffix.
  ;; Marked symbols use the same underlying terminal/nonterminal facts.
  (sequential ((a '(nonterminal a)) (b '(nonterminal b))
         (dead '(nonterminal dead)) (missing '(nonterminal missing))
         (x '(terminal literal "x"))
         (marked-a (list 'marked a '((alias A))))
         (marked-x (list 'marked x '((alias X))))
         (operands [a b dead missing x marked-a marked-x]))
    (each (tail) (operands)
        (verify check-suffix-catalog (list (list 0 'root (append operands (list tail)) #f #f)
                (list 1 'a '() #f #f)
                (list 2 'a (list x) #f #f)
                (list 3 'b (list x) #f #f)
                (list 4 'dead (list dead) #f #f))))
    (verify check-suffix-catalog (list (list 0 'root (make-list 256 marked-a) #f #f)
            (list 1 'a '() #f #f) (list 2 'a (list x) #f #f)))))

(defparser-check (completion-publications-case)
  (scope ((prefix (list (nullable-production 'c '((nonterminal a) (nonterminal b)))
                      (nullable-production 'a '((nonterminal d)))
                      (nullable-production 'b '((nonterminal a) (nonterminal a)))
                      (nullable-production 'd '((nonterminal b)))
                      (nullable-production 'blocked '((terminal literal "x") (nonterminal missing)))))
        (seeds (list (nullable-production 'a '((marked (terminal literal "x") (field value))))
                     (nullable-production 'b '()))))
    (verify check-productive-reference (append prefix seeds))
    (verify check-productive-reference (append prefix (reverse seeds))))
  (verify check-productive-reference '())
  (verify check-productive-reference (list (nullable-production 'a '((nonterminal missing) (nonterminal missing)))
         (nullable-production 'b '((terminal literal "x") (nonterminal a)))
         (nullable-production 'c '((marked (nonterminal b) (field value)))))))

(defparser-check (cyclic-productivity-case)
  (scope ((operands '(() ((terminal literal "x")) ((nonterminal a))
                     ((nonterminal b)) ((nonterminal c))
                     ((nonterminal a) (nonterminal a))
                     ((terminal literal "x") (nonterminal b))
                     ((marked (nonterminal b) (field value)))
                     ((nonterminal missing)))))
    (each (a) (operands)
                (each (b) (operands)
                            (each (c) (operands)
                                        (verify check-productive-reference (list (nullable-production 'a a)
                                               (nullable-production 'b b)
                                               (nullable-production 'c c))))))))

(defparser-check (family-productivity-case)
  (each (rules) ((list lr1-not-lalr-rules shared-lookahead-rules precedence-expression-rules
                  mixed-context-rules (lr1-context-family-rules 8)
                  (state-local-candidate-family-rules 4) (mixed-context-family-rules 4)
                  (acyclic-mixed-context-family-rules 4))) (verify check-productive-reference (lower-rules rules 'source-file)))
  (verify check-productive-reference (list (nullable-production 'a '((nonterminal b) (nonterminal b)))
         (nullable-production 'b '((nonterminal c)))
         (nullable-production 'c '((nonterminal a)))
         (nullable-production 'c '((marked (terminal literal "x") (field value))))
         (nullable-production 'a '((nonterminal missing)))
         (nullable-production 'unused '((nonterminal unused))))))

(defparser-check (reverse-productivity-case)
  (sequential ((names (map (lambda (n) (string->symbol (string-append "productive-chain-" (number->string n)))) (iota 4096)))
         (productions (map (lambda (name next)
                             (nullable-production name (if next (list (list 'nonterminal next))
                                                          '((terminal literal "x")))))
                           names (append (cdr names) '(#f)))))
    (scope-values (((found index) (compute-productive productions)))
      (equal found  names)
      (equal (every (lambda (name) (table-ref index name #f)) names)  #t))))

(defparser-check (dead-start-case)
  (each (rules) ('(((start (reference start)))
     ((start (sequence (literal "a") (reference tail))) (tail (reference tail)))))
     (each (route) ('(lalr canonical-lr1 partitioned-lr1 follow-partition-lr1 lalr-then-follow))
        (each (policy) ('(reject selective-glr probe))
           (scope ((result (admission-result rules route policy)))
             (equal (car result)  "LR start rule has no finite terminal derivation")
             (equal (car (cadr result))  'start))))))

(defparser-check (finite-exits-case)
  (equal (parse-literals '((start (empty)) (dead (reference dead))) "")  'accepted)
  (equal (parse-literals '((start (choice (sequence (reference start) (literal "a"))
                                        (literal "b")))
                          (dead (reference dead))) "baa")  'accepted)
  (equal (parse-literals '((start (choice (literal "b") (reference dead)))
                          (dead (sequence (literal "a") (reference dead)))) "b")  'accepted)
  (equal (parse-literals '((start (choice (literal "b") (reference dead)))
                          (dead (sequence (literal "a") (reference dead)))) "a")  'rejected))

(defparser-check (blocked-productivity-case)
  (sequential ((rules '((start (alias Start (choice (reference a)
                                            (sequence (literal "x") (reference b)))))
                  (a (reference start)) (b (reference b))))
         (result (parameterize ((current-grammar-source-map '((rule))))
                   (admission-result rules)))
         (details (cadr (cadr result)))
         (blockers (cdr (assq 'unproductiveRuleBlockers details)))
         (start (car blockers))
         (references (cdr (assq 'blockedReferences start))))
    (equal (map (lambda (row) (cdr (assq 'rule (cdr (assq 'ruleOrigin row))))) blockers)
            '(start b a))
    (equal (map (lambda (row) (cdr (assq 'rule row))) references)  '(a b))
    (equal (map (lambda (row) (cdr (assq 'expressionPath (cdr (assq 'referenceOrigin row))))) references)
            '((0 0) (0 1 1)))
    (equal (length blockers)  3)))

(defparser-check (authored-productivity-case)
  (sequential ((rules '((start (alias Start (repeat1 (field value (reference dead)))))
                  (dead (reference dead))))
         (result (admission-result rules))
         (details (cadr (cadr result)))
         (blockers (cdr (assq 'unproductiveRuleBlockers details)))
         (reference (car (cdr (assq 'blockedReferences (car blockers))))))
    (equal (map (lambda (row) (cdr (assq 'rule (cdr (assq 'ruleOrigin row))))) blockers)
            '(start dead))
    (equal (cdr (assq 'expressionPath (cdr (assq 'referenceOrigin reference))))  '(0 0 0)))
  (each (kind) ('(optional repeat))
              (equal (parse-literals (list (list 'start (list kind '(reference dead)))
                                         '(dead (sequence (literal "a") (reference dead)))) "")  'accepted))
  ;; Finite epsilon admission does not discharge independent LR conflicts.
  (equal (car (admission-result '((start (optional (reference dead)))
                                 (dead (reference dead)))))
          "unresolved reduce/reduce conflict"))

(defparser-check (poo-productivity-case)
  (sequential ((base (make-grammar 'base '()
                 (list (rule-role 'base-rules '((start (reference item)) (item (literal "a")))))))
         (dead (make-grammar 'dead (list base) '()
                 (list (cons 'override (rule-role 'dead-item '((item (reference item))))))))
         (normalized (compile-grammar/context dead))
         (result (parameterize ((current-grammar-source-map (normalized-grammar-source-map normalized "unknown-source")))
                   (admission-result (grammar-ir-ref (normalized-grammar-ir normalized) 'rules))))
         (blockers (cdr (assq 'unproductiveRuleBlockers (cadr (cadr result)))))
         (item-source (cdr (assq 'source (cdr (assq 'ruleOrigin (cadr blockers)))))))
    (equal (cdr (assq 'componentOwner item-source))  'dead-item)
    (equal (cdr (assq 'compositionOperation item-source))  'override)
    (each (exit) ('((literal "b") (empty)))
       (scope ((restored (make-grammar 'restored (list dead) '()
                       (list (cons 'override (rule-role 'restored-item (list (list 'item exit))))))))
         (equal (admission-result (grammar-ir-ref (compile-grammar restored) 'rules))  'accepted)))
    (equal (current-grammar-source-map)  '())))

(defparser-check (cyclic-first-case)
  (scope ((operands '(() ((terminal literal "x")) ((terminal literal "y"))
                     ((nonterminal a)) ((nonterminal b)) ((nonterminal c))
                     ((nonterminal a) (terminal literal "x"))
                     ((marked (nonterminal b) (field value))))))
    (each (a) (operands)
                (each (b) (operands)
                            (each (c) (operands)
                                        (verify check-first-reference (list (nullable-production 'a a)
                                               (nullable-production 'b b)
                                               (nullable-production 'c c))))))))

(defparser-check (family-first-case)
  (each (rules) ((list lr1-not-lalr-rules shared-lookahead-rules precedence-expression-rules
                  mixed-context-rules (lr1-context-family-rules 8)
                  (state-local-candidate-family-rules 4) (mixed-context-family-rules 4)
                  (acyclic-mixed-context-family-rules 4))) (verify check-first-reference (lower-rules rules 'source-file))))

(defparser-check (first-prefix-case)
  (verify check-first-reference (list (nullable-production 'c '((marked (nonterminal a) (field value))))
         (nullable-production 'a '((nonterminal b) (terminal literal "z")))
         (nullable-production 'b '())
         (nullable-production 'a '((terminal literal "x")))
         (nullable-production 'a '((nonterminal b) (nonterminal b) (terminal literal "z")))
         (nullable-production 'c '((nonterminal c) (terminal eof)))))
  (verify check-first-reference (list (nullable-production 'a '((nonterminal b) (terminal literal "blocked")))
         (nullable-production 'b '((marked (terminal literal "y") (field value))))
         (nullable-production 'c '((nonterminal missing) (terminal literal "blocked"))))))

(defparser-check (incomplete-prefix-case)
  (scope ((productions
        (list (nullable-production 'a '((terminal literal "x") (nonterminal b)))
              (nullable-production 'b '((nonterminal b)))
              (nullable-production 'c '((nonterminal a))))))
    (verify check-first-reference productions)
    (scope-values (((rows index) (compute-first productions (reference-nullable productions))))
      (equal (table-ref index 'a)  '((terminal literal "x")))
      (equal (table-ref index 'b)  '())
      (equal (table-ref index 'c)  '((terminal literal "x"))))))

(defparser-check (bignum-first-case)
  (sequential ((terminals (map (lambda (n) (list 'terminal 'literal (number->string n))) (iota 128)))
         (productions
          (append (list (nullable-production 'a '((nonterminal b)))
                        (nullable-production 'b '((nonterminal c)))
                        (nullable-production 'c '((nonterminal a))))
                  (map (lambda (terminal) (nullable-production 'b (list terminal))) terminals))))
    (verify check-first-reference productions)
    (scope-values (((rows index) (compute-first productions (reference-nullable productions))))
      (equal (table-ref index 'a)  terminals))))

(defparser-check (reverse-first-case)
  (sequential ((names (map (lambda (n) (string->symbol (string-append "first-chain-" (number->string n)))) (iota 4096)))
         (productions (map (lambda (name next)
                             (nullable-production name (if next (list (list 'nonterminal next))
                                                          '((terminal literal "x")))))
                           names (append (cdr names) '(#f)))))
    (scope-values (((rows index) (compute-first productions (reference-nullable productions))))
      (equal (map car rows)  names)
      (equal (every (lambda (name) (equal? (table-ref index name) '((terminal literal "x")))) names)  #t))))

(defparser-check (cyclic-nullability-case)
  (scope ((operands '(() ((terminal literal "x")) ((nonterminal a))
                     ((nonterminal b)) ((nonterminal c))
                     ((nonterminal a) (nonterminal a))
                     ((nonterminal a) (nonterminal b))
                     ((marked (nonterminal b) (field value))))))
    (each (a) (operands)
                (each (b) (operands)
                            (each (c) (operands)
                                        (verify check-nullable-reference (list (nullable-production 'a a)
                                               (nullable-production 'b b)
                                               (nullable-production 'c c))))))))

(defparser-check (nullable-occurrences-case)
  (verify check-nullable-reference (list (nullable-production 'a '((nonterminal b) (nonterminal b)))
         (nullable-production 'a '((nonterminal missing)))
         (nullable-production 'b '((nonterminal c) (terminal literal "x")))
         (nullable-production 'b '())
         (nullable-production 'c '((nonterminal c)))))
  (verify check-nullable-reference (list (nullable-production 'a '((nonterminal missing)))
         (nullable-production 'b '((nonterminal a)))
         (nullable-production 'c '())))
  (verify check-nullable-reference (list (nullable-production 'a '((marked (terminal literal "x") (field value))))
         (nullable-production 'b '()) (nullable-production 'c '())))
  (scope-values (((names index)
                (compute-nullable
                 (list (nullable-production 'c '()) (nullable-production 'b '())
                       (nullable-production 'c '()) (nullable-production 'a '())))))
    (equal names  '(c b a))))

(defparser-check (reverse-nullability-case)
  (sequential ((names (map (lambda (n) (string->symbol (string-append "chain-" (number->string n)))) (iota 4096)))
         (productions (map (lambda (name next)
                             (nullable-production name (if next (list (list 'nonterminal next)) '())))
                           names (append (cdr names) '(#f)))))
    (scope-values (((found index) (compute-nullable productions)))
      (equal found  names)
      (equal (every (lambda (name) (table-ref index name #f)) names)  #t))))

(defparser-check (empty-reference-case)
  (equal (admission-result '((start (repeat (reference item))) (item (empty))))
          (nullable-repeat-result 'start '(reference item))))

(defparser-check (optional-reference-case)
  (each (kind) ('(repeat repeat1))
     (equal (admission-result
             `((start (,kind (reference item)))
               (item (reference tail)) (tail (optional (literal "a")))))
             (nullable-repeat-result 'start '(reference item) kind))))

(defparser-check (wrapped-nullability-case)
  (scope ((operand '(precedence left 1
                   (alias Item (field value
                     (sequence (reference left) (reference right)))))))
    (equal (admission-result
            `((start (repeat ,operand)) (left (empty))
              (right (optional (literal "b")))))
            (nullable-repeat-result 'start operand))))

(defparser-check (mutual-nullability-case)
  (equal (admission-result
          '((start (repeat (reference item)))
            (item (reference tail))
            (tail (choice (reference item) (empty)))))
          (nullable-repeat-result 'start '(reference item))))

(defparser-check (nested-repetition-case)
  (equal (admission-result
          '((start (reference container))
            (container (alias Container
                        (sequence (literal "[")
                         (field items (repeat1 (reference item))) (literal "]"))))
            (item (optional (literal "a")))))
          (nullable-repeat-result 'container '(reference item) 'repeat1)))

(defparser-check (obligation-traversal-case)
  (each (expression) ('((sequence (literal "a") (repeat (reference item)))
     (choice (empty) (repeat (reference item)))
     (optional (repeat (reference item)))))
     (equal (admission-result `((start ,expression) (item (empty))))
             (nullable-repeat-result 'start '(reference item)))))

(defparser-check (construction-admission-case)
  (each (construction) ('(lalr canonical-lr1 partitioned-lr1 follow-partition-lr1 lalr-then-follow))
     (equal (admission-result
             '((start (repeat (reference item))) (item (empty))) construction)
             (nullable-repeat-result 'start '(reference item)))))

(defparser-check (glr-repetition-case)
  (each (policy) ('(reject selective-glr probe))
     (equal (admission-result
             '((start (repeat (reference item))) (item (empty))) 'lalr policy)
             (nullable-repeat-result 'start '(reference item)))))

(defparser-check (raw-nullability-case)
  (each (operand) ('((empty) (layout-end)))
     (equal (admission-result `((start (repeat ,operand))))
             (nullable-repeat-result 'start operand))))

(defparser-check (consuming-suffix-case)
  (scope ((rules '((start (repeat (reference item)))
                (item (sequence (reference prefix) (literal "b")))
                (prefix (optional (literal "a"))))))
    (equal (parse-literals rules "")  'accepted)
    (equal (parse-literals rules "babb")  'accepted)
    (equal (parse-literals rules "a")  'rejected)))

(defparser-check (productive-recursion-case)
  (scope ((rules '((start (repeat (reference item)))
                (item (choice (sequence (reference item) (literal "a"))
                              (literal "b"))))))
    (equal (parse-literals rules "baabaa")  'accepted)
    (equal (parse-literals rules "a")  'rejected)))

(defparser-check (effective-override-case)
  (sequential ((base (make-grammar 'base '()
                 (list (rule-role 'base-rules
                         '((start (repeat (reference item))) (item (literal "a")))))))
         (nullable-role (rule-role 'nullable-item '((item (empty)))))
         (derived (make-grammar 'derived (list base) '()
                    (list (cons 'override nullable-role))))
         (restored (make-grammar 'restored (list derived) '()
                     (list (cons 'override (rule-role 'consuming-item
                                           '((item (literal "b")))))))))
    (equal (admission-result (grammar-ir-ref (compile-grammar derived) 'rules))
            (nullable-repeat-result 'start '(reference item)))
    (equal (parse-literals (grammar-ir-ref (compile-grammar restored) 'rules) "bb")
            'accepted)))

(defparser-check (nullable-origin-case)
  (sequential ((base (make-grammar 'base '()
                 (list (rule-role 'base-rules
                         '((start (alias Start (sequence (repeat (reference item))
                                                       (literal "z"))))
                           (item (literal "a")))))))
         (derived (make-grammar 'derived (list base) '()
                    (list (cons 'override (rule-role 'nullable-item '((item (empty))))))))
         (normalized (compile-grammar/context derived))
         (source-map (normalized-grammar-source-map normalized "unknown-source"))
         (result (parameterize ((current-grammar-source-map source-map))
                   (admission-result (grammar-ir-ref (normalized-grammar-ir normalized) 'rules))))
         (details (list-ref (cadr result) 3))
         (origin (cdr (assq 'expressionOrigin details)))
         (references (cdr (assq 'nullableReferencePath details))))
    (equal (cdr (assq 'rule origin))  'start)
    (equal (cdr (assq 'expressionPath origin))  '(0 0))
    (equal (cdr (assq 'componentOwner (cdr (assq 'source origin))))  'base-rules)
    (equal (map (lambda (row) (cdr (assq 'rule row))) references)  '(item))
    (scope ((source (cdr (assq 'source (car references)))))
      (equal (cdr (assq 'componentOwner source))  'nullable-item)
      (equal (cdr (assq 'compositionOperation source))  'override))
    ;; The dynamic context ends with this compile, never contaminating another.
    (equal (current-grammar-source-map)  '())))

(defparser-check (finite-witness-case)
  (sequential ((rules '((start (repeat (reference a)))
                  (a (choice (reference b) (reference epsilon)))
                  (b (reference a)) (epsilon (empty))))
         (result (parameterize ((current-grammar-source-map '((rule))))
                   (admission-result rules)))
         (details (list-ref (cadr result) 3)))
    (equal (map (lambda (row) (cdr (assq 'rule row)))
                (cdr (assq 'nullableReferencePath details)))  '(a epsilon))))

(defparser-check (shared-witness-case)
  (sequential ((names (map (lambda (index) (string->symbol (string-append "nullable-" (number->string index)))) (iota 32)))
         (rules (cons (list 'start (list 'repeat (list 'reference (car names))))
                      (map (lambda (name index)
                             (list name (if (= index 31) '(empty)
                                          (list 'sequence (list 'reference (list-ref names (+ index 1)))
                                                          (list 'reference (list-ref names (+ index 1)))))))
                           names (iota 32))))
         (result (parameterize ((current-grammar-source-map '((rule)))) (admission-result rules)))
         (details (list-ref (cadr result) 3)))
    (equal (map (lambda (row) (cdr (assq 'rule row)))
                (cdr (assq 'nullableReferencePath details)))  names)))

(defparser-check (choice-acceptance-case)
  (each (alternatives) ('(((literal "a") (sequence (literal "a") (literal "b")))
     ((sequence (literal "a") (literal "b")) (literal "a"))))
     (scope ((rules `((start (alias Start
                           (sequence (field prefix (choice ,@alternatives))
                                     (literal "c")))))))
       (equal (parse-literals rules "abc")  'accepted)
       (equal (parse-literals rules "ac")  'accepted)
       (equal (parse-literals rules "ab")  'rejected))))

(defparser-check (choice-span-case)
  (sequential ((short '(literal "a"))
         (long '(sequence (literal "a") (literal "b")))
         (forward `((start (sequence (field prefix (choice ,short ,long))
                                    (literal "c")))))
         (reverse `((start (sequence (field prefix (choice ,long ,short))
                                    (literal "c")))))
         (root (parse-literals forward "abc" #t)))
    (equal root  (parse-literals reverse "abc" #t))
    (equal (recognition-node-kind root)  'Start)
    (equal (list (recognition-node-start root) (recognition-node-end root))  '(0 3))
    (equal (map recognition-child-field (recognition-node-children root))  '(prefix #f))
    (scope ((prefix (recognition-child-value (car (recognition-node-children root)))))
      (equal (list (recognition-value-start prefix) (recognition-value-end prefix))  '(0 2)))))

(defparser-check (helper-continuation-case)
  (scope ((rules '((start (sequence (reference prefix) (literal "c")))
                (prefix (choice (literal "a") (reference longer)))
                (longer (sequence (literal "a") (literal "b"))))))
    (equal (parse-literals rules "abc")  'accepted)
    (equal (parse-literals rules "ac")  'accepted)
    (equal (parse-literals rules "abbc")  'rejected)))

(defparser-check (published-pair-heap-case)
(locals ((copy-pairs (lambda ( value)
    (if (pair? value) (cons (copy-pairs (car value)) (copy-pairs (cdr value))) value)))
(pair-graph? (lambda ( value)
    (and (not (vector? value))
         (or (not (pair? value)) (and (pair-graph? (car value)) (pair-graph? (cdr value))))))))


  (sequential ((spec (compile-lr-spec
                '((start (alias Root (choice (literal "a") (literal "b"))))) 'start))
         (slots (lr-spec-ref spec 'actions))
         (published (vector->list slots))
         (expected (copy-pairs published)))
    (equal (pair-graph? published)  #t)
    ;; Clear the actual published-row vector; retained rows share action pairs
    ;; but do not point back into their mutable vector owner.
    (each (index) ((iota (vector-length slots))) (act (vector-set! slots index '())))
    (equal published  expected)
    (equal (with-catch (lambda (_condition) #t)
             (lambda () (vector-set! slots (vector-length slots) 'bad) #f))  #t)
    (equal (vector->list slots)  (make-list (vector-length slots) '()))
    (equal (with-catch (lambda (_condition) #t)
             (lambda () (vector-set! (car published) 0 'bad) #f))  #t)
    (equal published  expected)
    ;; Negative control: publishing a live vector retains its mutations.
    (sequential ((scratch (vector '(reduce 1))) (alias scratch))
      (act (vector-set! scratch 0 #f))
      (equal (vector-ref alias 0)  #f)))))

(deflanguage-parser-tests resolved-grammar-test "resolved grammar admission and CFG alternatives"
  (engine)
    (scenario "published action pairs survive vector writes and atomic setter failure" (verify published-pair-heap-case))
    (scenario "duplicate CFG rows retain physical IDs and precedence through publication" (verify duplicate-production-identity-case))
    (scenario "native dense item layout refines ordered grammar coordinates and goto" (verify dense-layout-refinement-case))
    (scenario "lowering proof replay publishes bindings and preserves native identity" (verify lowering-proof-publication-case))
    (scenario "physical names, emission ordinals and source occurrences agree" (verify emission-origin-alignment-case))
    (scenario "grammar derivation chart, scanner and LR tables compose on the shared model fixture" (verify grammar-model-pipeline-case))
    (scenario "schema-valid LR tables need a separate grammar-support obligation" (verify table-support-counterexample-case))
    (scenario "one raw token selects different grammar terminals across LR states" (verify state-sensitive-terminal-case))
    (scenario "repetition recursion is isolated from sibling alternatives" (verify repetition-owner-case))
    (scenario "authored DSL agrees with lowered CFG derivations" (verify source-lowering-correspondence-case))
    (scenario "native completion facts match kernel-checked Lean certificates" (verify native-fact-certificate-case))
    (scenario "native LR lookaheads equal independent global closure" (verify lookahead-provenance-case))
    (scenario "constructed LR graphs preserve item origins and start separation" (verify graph-provenance-case))
    (scenario "internal production names are isolated and deterministic" (verify internal-name-isolation-case))
    (scenario "complete raw requests choose terminals from the current LR state" (verify raw-request-terminal-case))
    (scenario "FIRST retains a terminal prefix before an unproductive suffix" (verify first-is-not-productivity-case))
    (scenario "dense item coordinates preserve epsilon and production boundaries" (verify dense-item-coordinates-case))
    (scenario "uneven rule widths allocate only actual dotted positions" (verify skew-item-space-case))
    (scenario "suffix facts preserve forward scans and marked operands" (verify suffix-facts-case))
    (scenario "joint completion preserves delayed and coalesced domain publications" (verify completion-publications-case))
    (scenario "productive facts match exhaustive cyclic fixed-point controls" (verify cyclic-productivity-case))
    (scenario "productive facts match actual LR families and finite alternative exits" (verify family-productivity-case))
    (scenario "reverse productivity chain completes in canonical name order" (verify reverse-productivity-case))
    (scenario "LR targets reject a dead start before state construction for every route" (verify dead-start-case))
    (scenario "finite epsilon and LR recursive exits survive unreachable dead rules" (verify finite-exits-case))
    (scenario "productivity diagnostics retain every blocked choice and finite cyclic graph" (verify blocked-productivity-case))
    (scenario "productivity explains authored wrappers rather than generated helpers" (verify authored-productivity-case))
    (scenario "productivity sees selected POO exits and their declaration owners" (verify poo-productivity-case))
    (scenario "FIRST delta facts match exhaustive cyclic grammar controls" (verify cyclic-first-case))
    (scenario "FIRST facts match an independent oracle across actual LR grammar families" (verify family-first-case))
    (scenario "FIRST prefix blockers and duplicate edges preserve canonical rows" (verify first-prefix-case))
    (scenario "FIRST keeps a terminal prefix without claiming finite completion" (verify incomplete-prefix-case))
    (scenario "FIRST bignum deltas preserve terminal catalog order across a cycle" (verify bignum-first-case))
    (scenario "long reverse FIRST chain propagates its terminal without full rescans" (verify reverse-first-case))
    (scenario "dependency nullable facts match exhaustive cyclic grammar controls" (verify cyclic-nullability-case))
    (scenario "nullable alternatives retain duplicate occurrences and terminal blockers" (verify nullable-occurrences-case))
    (scenario "long reverse nullable chain publishes every name in production order" (verify reverse-nullability-case))
    (scenario "direct reference to an empty rule rejects before LR conflicts" (verify empty-reference-case))
    (scenario "indirect optional reference rejects both repetition forms" (verify optional-reference-case))
    (scenario "nullable sequence through field alias and precedence rejects" (verify wrapped-nullability-case))
    (scenario "nullable alternative propagates through a mutual reference cycle" (verify mutual-nullability-case))
    (scenario "nested repetitions retain the original rule owner" (verify nested-repetition-case))
    (scenario "boolean analysis never skips nested repetition obligations" (verify obligation-traversal-case))
    (scenario "all LR constructions share resolved repetition admission" (verify construction-admission-case))
    (scenario "selective GLR cannot admit a zero-width repetition cycle" (verify glr-repetition-case))
    (scenario "raw IR empty and layout operands reject before state construction" (verify raw-nullability-case))
    (scenario "a nullable prefix followed by a consuming suffix remains valid" (verify consuming-suffix-case))
    (scenario "productive left recursion remains valid inside repeat" (verify productive-recursion-case))
    (scenario "effective POO override is analyzed rather than its parent declaration" (verify effective-override-case))
    (scenario "nullable diagnostics retain selected POO override and expression occurrence" (verify nullable-origin-case))
    (scenario "finite nullable witness skips cycles and retains the effective empty exit" (verify finite-witness-case))
    (scenario "nullable explanation follows a shared DAG without expanding derivation trees" (verify shared-witness-case))
    (scenario "CFG choice reordering preserves acceptance with shared token prefixes" (verify choice-acceptance-case))
    (scenario "choice ordering preserves node fields and exact ranges" (verify choice-span-case))
    (scenario "CFG helper-reference alternatives preserve enclosing continuation" (verify helper-continuation-case)))
