;;; Exact allocation evidence and conservative CPU admission from native receipts.
(import :std/string/misc :std/misc/ports
        (only-in :gerbil-parser/t/benchmarks/parser-stage-cost/benchmark sample-at-percentile))
(export main compare-casefold-request-receipts compare-casefold-request-cpu-receipts)
(def (field row key) (cdr (assq key row)))
(def (require! condition . detail)
  (unless condition (apply error "casefold request evidence rejected" detail)))
(def (read-request-receipt path)
  (let ((samples (make-hash-table)) (raw-samples (make-hash-table)) (summaries (make-hash-table))
        (complete? #f) (exit? #f) (admitted 0))
    (call-with-input-file path
      (lambda (port)
        (let loop ()
          (let (line (read-line port))
            (unless (eof-object? line)
              (cond
               ((string-prefix? "(PARSER-COMPONENT-SAMPLE " line)
                (let* ((datum (call-with-input-string line read))
                       (key (cadr datum)) (row (caddr datum))
                       (bytes (field row 'allocated-bytes)))
                  (hash-put! raw-samples key (cons row (hash-ref raw-samples key '())))
                  (when (number? bytes)
                    (require! (and (= (field row 'gc-count) 0) (integer? bytes) (>= bytes 0)) key 'counter)
                    (hash-put! samples key (cons (inexact->exact bytes) (hash-ref samples key '())))
                    (set! admitted (+ admitted 1)))))
               ((string-prefix? "(PARSER-COMPONENT-SUMMARY " line)
                (let* ((datum (call-with-input-string line read)) (row (cadr datum)))
                  (hash-put! summaries (field row 'stage) row)))
               ((equal? line "LR-CASEFOLD-REQUESTS-OK") (set! complete? #t))
               ((and (string-prefix? "PROCESS-RESULT " line)
                     (string-contains line "exit=0 reason=#f missing=()")) (set! exit? #t)))
              (loop))))))
    (require! (and complete? exit? (= (hash-length summaries) 12)) path 'incomplete)
    (for-each
     (lambda (key)
       (let* ((row (hash-get summaries key)) (values (hash-ref samples key '()))
              (count (field row 'parsesPerSample)))
         (require! (and (= count 20) (= (field row 'sampleCount) 20)
                        (eq? (field row 'allocationScope) 'single-caller)
                        (= (length (hash-ref raw-samples key '())) 20)
                        (= (field (sample-at-percentile (hash-get raw-samples key) 'cpu-ms 50) 'cpu-ms)
                           (field row 'cpuP50Ms))
                        (= (length values) (field row 'allocationSampleCount))
                        (pair? values)
                        (andmap (lambda (value) (= value (car values))) values)
                        ;; The sampler reports a flonum quotient. Compare that representation;
                        ;; exact integer batch counters remain the savings authority.
                        (= (exact->inexact (/ (car values) count)) (field row 'allocatedBytesPerParse))) key 'nonuniform)))
     (hash-keys summaries))
    (list summaries samples admitted)))
(def (compare-casefold-request-receipts candidate-a reference-a reference-b candidate-b)
  (compare-request-receipts candidate-a reference-a reference-b candidate-b 'reduced))

;;; A dispatch-only change must preserve every complete-request allocation
;;; counter. CPU admission uses the same controls and repeated-median gate.
(def (compare-casefold-request-cpu-receipts candidate-a reference-a reference-b candidate-b)
  (compare-request-receipts candidate-a reference-a reference-b candidate-b 'unchanged))

(def (compare-request-receipts candidate-a reference-a reference-b candidate-b allocation-policy)
  (let* ((ca (read-request-receipt candidate-a)) (ra (read-request-receipt reference-a))
         (rb (read-request-receipt reference-b)) (cb (read-request-receipt candidate-b))
         (savings (make-hash-table)) (rows '()))
    (def (cpu receipt key) (field (hash-get (car receipt) key) 'cpuP50Ms))
    (def (stable-control? key)
      (let* ((c [(cpu ca key) (cpu cb key)]) (r [(cpu ra key) (cpu rb key)])
             (ratio (/ (apply + c) (apply + r))))
        (and (<= 0.95 ratio 1.05)
             (<= (/ (apply min c) (apply max r)) 1 (/ (apply max c) (apply min r))))))
    (let (controls-stable?
           (and (stable-control? '(arithmetic-unchanged-control 64 prepared-lr))
                (stable-control? '(arithmetic-unchanged-control 64 full-source))))
      (for-each
       (lambda (key)
         (let* ((baseline (car (hash-get (cadr ra) key)))
                (candidate (car (hash-get (cadr ca) key)))
                (delta (/ (- baseline candidate) 20))
                (cpu-ratio (/ (+ (cpu ca key) (cpu cb key)) (+ (cpu ra key) (cpu rb key))))
                (repeated-benefit? (< (max (cpu ca key) (cpu cb key))
                                      (* 0.95 (min (cpu ra key) (cpu rb key))))))
           (require! (= baseline (car (hash-get (cadr rb) key))) key 'reference-drift)
           (require! (= candidate (car (hash-get (cadr cb) key))) key 'candidate-drift)
           (require! (integer? delta) key 'fractional-saving)
           (require! (if (or (eq? allocation-policy 'unchanged)
                             (eq? (car key) 'arithmetic-unchanged-control)) (= delta 0) (> delta 0)) key 'allocation)
           (hash-put! savings key delta)
           (let (row (list (cons 'stage key) (cons 'saved-bytes delta)
                          (cons 'allocation-reduction (/ (- baseline candidate) baseline))
                          (cons 'cpu-ratio-of-child-medians cpu-ratio)
                          (cons 'repeated-median-benefit? repeated-benefit?)
                          (cons 'cpu-benefit-admitted? (and controls-stable? repeated-benefit?))))
             (set! rows (cons row rows))
             (write (list 'CASEFOLD-REQUEST-EVIDENCE row)) (newline))))
       (hash-keys (car ra)))
      (for-each
       (lambda (key)
         (when (eq? (caddr key) 'prepared-lr)
           (require! (= (hash-get savings key)
                        (hash-get savings (list (car key) (cadr key) 'full-source))) key 'boundary-drift)))
       (hash-keys savings))
      (write (list 'CASEFOLD-REQUEST-ALLOCATION-OK
                   'allocation-policy allocation-policy
                   'admitted-intervals (+ (caddr ca) (caddr ra) (caddr rb) (caddr cb))
                   'unchanged-controls-stable? controls-stable?)) (newline)
      (reverse rows))))
(def (main candidate-a reference-a reference-b candidate-b)
  (compare-casefold-request-receipts candidate-a reference-a reference-b candidate-b)
  (displayln "CASEFOLD-REQUEST-EVIDENCE-OK") (force-output))
