(import :gerbil-parser/language-test-support)
;;; -*- Gerbil -*-
;;; Source-form correspondence for the runtime split, with one admitted
;;; capture algorithm delta covered by the independent frozen semantic control.
(import (only-in :std/test check test-case test-suite)
        (only-in :std/misc/process run-process))

(def base "f57d2aa6502bd39b62119cdd2e5a95469ef6fd9f")
(def (read-forms port)
  (let loop ((forms '()))
    (let (form (read port))
      (if (eof-object? form) (reverse forms) (loop (cons form forms))))))
(def (behavior forms)
  (filter (lambda (form) (not (memq (car form) '(import export)))) forms))
(def (same-forms? expected actual)
  (let loop ((expected expected) (actual actual))
    (if (null? expected) (null? actual)
      (let remove ((before '()) (rest actual))
        (cond
         ((null? rest) #f)
         ((equal? (car expected) (car rest))
          (loop (cdr expected) (append (reverse before) (cdr rest))))
         (else (remove (cons (car rest) before) (cdr rest))))))))
(def (capture-definition? form name)
  (and (pair? form) (memq (car form) '(def definline))
       (pair? (cadr form)) (eq? (caadr form) name)))
(defparser-check (admit-capture-delta original actual)
  (sequential ((old (filter (lambda (form) (capture-definition? form 'capture-reduction)) original))
         (current (filter (lambda (form) (capture-definition? form 'capture-reduction)) actual))
         (reference (filter (lambda (form) (capture-definition? form 'reference-capture-reduction))
                       (call-with-input-file "t/benchmarks/lr-request-stack/capture-reference.ss" read-forms))))
    ;; The historical body stays pinned. Renaming the frozen control must be
    ;; its only difference; every other owner form still compares exactly.
    (equal (length old)  1)
    (equal (length current)  1)
    (equal (length reference)  1)
    (scope ((form (car reference)))
      (equal (cons (car form) (cons (cons 'capture-reduction (cdadr form)) (cddr form)))
              (car old)))
    (sequential ((getters '(lr-recognition-fragment-lookahead lr-recognition-fragment-children lr-recognition-fragment-runtime lr-recognition-fragment-executor
                       lr-recognition-fragment-production-id lr-recognition-fragment-entry-state
                       lr-recognition-fragment-exit-state))
           (introduced? (lambda (form)
             (or (and (eq? (car form) 'def) (eq? (cadr form) '+lr-capture-children-tag+))
                 (capture-definition? form 'make-lr-capture-child-vector)
                 (capture-definition? form 'lr-recognition-fragment-terminal-yield)
                 (capture-definition? form 'prepare-capture-plans)
                 (and (eq? (car form) 'definline)
                      (eq? (caadr form) 'capture-context-from-plan))
                 (and (eq? (car form) 'defrule) (pair? (cadr form))
                      (eq? (caadr form) 'with-capture-bounds))
                 (and (eq? (car form) 'defstruct) (memq (cadr form) '(lr-capture-context lr-capture-plan)))
                 (and (eq? (car form) 'definline) (pair? (cadr form))
                      (memq (caadr form) getters)))))
           (fragment? (lambda (form) (and (eq? (car form) 'defstruct)
                                         (eq? (cadr form) 'lr-recognition-fragment)))))
      (equal (length (filter introduced? actual))  15)
      (each (name) (getters)
                  (equal (length (filter (lambda (form)
                     (and (eq? (car form) 'definline) (pair? (cadr form))
                          (eq? (caadr form) name))) actual))  1))
      (equal (caddr (find (lambda (form)
                          (and (eq? (car form) 'defstruct) (eq? (cadr form) 'lr-capture-plan))) actual))
              '(runtime production-id width contexts))
      (equal (filter (lambda (form)
                       (and (eq? (car form) 'defstruct) (eq? (cadr form) 'lr-capture-children))) actual)
              '())
      (equal (caddr (find (lambda (form)
                          (and (eq? (car form) 'defstruct) (eq? (cadr form) 'lr-capture-context))) actual))
              '(runtime executor production-id entry-state exit-state lookahead-kind))
      (scope ((old-record (find fragment? original)) (new-record (find fragment? actual)))
        (equal (caddr new-record)  '(context children-cache lookahead-cache value start end token-count offset yield-cache))
        (equal (cdddr new-record)  (cdddr old-record))
        (act (map (lambda (form)
               (cond ((capture-definition? form 'capture-reduction) (car old))
                     ((fragment? form) old-record) (else form)))
             (filter (lambda (form) (not (introduced? form))) actual)))))))
(defparser-check (admit-stream-deltas original actual)
  ;; Only these reviewed execution definitions differ. Other split forms keep
  ;; exact historical correspondence; independent controls own semantics.
  (scope ((names '(define-lr-driver lr-run-checkpoint lr-checkpoint-drive
                 make-lr-action-selector lr-parse/prepared/receipt/materialized
                 lr-prepare lr-runtime-for-current-semantic-backend lr-runtime-with-action-selector))
        (inputs '(lr-input-start lr-input-empty? lr-input-token lr-input-tail lr-input-admit lr-input-list)))
(locals ((named? (lambda ( form name)
      (and (pair? form) (memq (car form) '(def defrule))
           (pair? (cadr form)) (eq? (caadr form) name))))
(driver? (lambda ( form) (eq? (car form) 'define-lr-driver)))
(input-form? (lambda ( form) (and (eq? (car form) 'defrules) (memq (cadr form) inputs))))
(runtime-form? (lambda ( form) (and (eq? (car form) 'defstruct) (eq? (cadr form) 'lr-runtime))))
(introduced? (lambda ( form) (or (input-form? form) (driver? form) (named? form 'prepare-lr-goto-columns)))))


    (each (name) (names)
                (equal (length (filter (lambda (form) (named? form name)) original))  1)
                (equal (length (filter (lambda (form) (named? form name)) actual))  1))
    (each (name) (inputs)
                (equal (length (filter (lambda (form) (and (input-form? form) (eq? (cadr form) name))) actual))  1))
    (equal (length (filter (lambda (form) (named? form 'prepare-lr-goto-columns)) actual))  1)
    (equal (filter driver? actual)
           '((define-lr-driver #f #f lr-run-persistent-checkpoint)
             (define-lr-driver #f #t lr-run-stream-checkpoint)
             (define-lr-driver #t #f lr-run-owned-checkpoint)
             (define-lr-driver #t #t lr-run-owned-stream-checkpoint)))
    (scope ((old (filter runtime-form? original)) (new (filter runtime-form? actual)))
      (equal (length old)  1)
      (equal (length new)  1)
      (equal (car new)  (cons 'defstruct (cons 'lr-runtime
                            (cons (append (caddar old) '(goto-columns capture-plans)) (cdddar old)))))
      (act (append (filter driver? original)
        (map (lambda (form)
               (let (name (find (lambda (name) (named? form name)) names))
                 (cond (name (find (lambda (old) (named? old name)) original))
                       ((runtime-form? form) (car old))
                       (else form))))
             (filter (lambda (form) (not (introduced? form))) actual))))))))
(defparser-check (check-family family)
  (sequential ((facade (string-append "src/runtime/" family ".ss"))
         (directory (string-append "src/runtime/" family))
         (original (run-process (list "git" "show" (string-append base ":" facade))
                                coprocess: read-forms))
         (current (call-with-input-file facade read-forms))
         (owners (map (lambda (name)
                        (call-with-input-file (path-expand name directory) read-forms))
                      (filter (lambda (name) (equal? (path-extension name) ".ss"))
                              (directory-files directory)))))
    (equal (behavior current)  '())
    (equal (filter (lambda (f) (eq? (car f) 'export)) current)
            (filter (lambda (f) (eq? (car f) 'export)) original))
    (scope ((actual (apply append (map behavior owners))))
      (equal (same-forms? (behavior original)
                         (if (equal? family "lr-parser")
                           (parser-check-result admit-stream-deltas (behavior original) (parser-check-result admit-capture-delta (behavior original) actual)) actual))  #t))))
(deflanguage-parser-tests runtime-module-organization-test "Runtime module organization correspondence"
  (engine)
    (scenario "LR facade and private owners retain every execution form exactly once"
      (verify check-family "lr-parser"))
    (scenario "incremental facade and owners retain every execution form exactly once"
      (verify check-family "incremental"))
    (scenario "scan facade and pure lexical owners retain every execution form exactly once"
      (verify check-family "scan")))
