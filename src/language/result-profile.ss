;;; Declarative result construction is the authority for publication and catalogs.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in :clan/poo/mop define-type validate)
        (only-in :core/types PooFlowContract. poo-flow-classification-evidence)
        (only-in ./scanner-profile compile-scanner-profile)
        (only-in ../runtime/token token? token-kind token-start token-end)
        (only-in ../runtime/recognition
                 make-recognition-node recognition-node? recognition-node-kind recognition-node-start recognition-node-end
                 recognition-child? recognition-child-field recognition-child-value))
(export ResultProfile. ResultProfileContract defresult-profile compile-result-profile
        result-plan? result-plan-recipe result-plan-catalog result-plan-node result-plan-token)
(def ResultProfile. (.o nodes: '() tokens: '() scanner: #f))
(defstruct result-plan (owned-recipe node-index token-index))
(def (unique-symbols? values)
  (and (list? values) (andmap symbol? values)
       (let (seen (make-hash-table-eq))
         (andmap (lambda (value)
                   (and (not (hash-get seen value))
                        (begin (hash-put! seen value #t) #t))) values))))
(def (profile-plan profile)
  (unless (object? profile) (error "result profile requires a POO object"))
  (let ((nodes (.ref profile 'nodes)) (tokens (.ref profile 'tokens))
        (scanner (.ref profile 'scanner)))
    (unless (and (list? nodes) (pair? nodes)
                 (andmap (lambda (row)
                           (and (list? row) (= (length row) 2) (symbol? (car row))
                                (unique-symbols? (cadr row)))) nodes)
                 (unique-symbols? (map car nodes)) (unique-symbols? tokens))
      (error "invalid result construction declaration"))
    (when scanner (compile-scanner-profile scanner))
    (let* ((published-tokens
            (if scanner
              (append tokens (filter (lambda (kind) (not (memq kind tokens))) (.ref scanner 'tokens)))
              tokens))
           (node-index (make-hash-table-eq)) (token-index (make-hash-table-eq))
          (owned (map (lambda (row) (list (car row) (map values (cadr row)))) nodes)))
      (for-each (lambda (row)
                  (let (fields (make-hash-table-eq))
                    (for-each (lambda (field) (hash-put! fields field #t)) (cadr row))
                    (hash-put! node-index (car row) fields))) owned)
      (for-each (lambda (kind) (hash-put! token-index kind #t)) published-tokens)
      (make-result-plan (list owned (map values published-tokens)) node-index token-index))))
(def (profile-valid? profile)
  (with-catch (lambda (_) #f) (lambda () (profile-plan profile) #t)))
(define-type (ResultProfileContract @ PooFlowContract.)
  identity: 'gerbil-parser/result-profile
  .classify: (lambda (candidate context)
    (let (accepted? (profile-valid? candidate))
      (poo-flow-classification-evidence 'gerbil-parser/result-profile candidate accepted?
       (if accepted? '() '((expected gerbil-parser/result-profile))) context))))
(def (compile-result-profile profile)
  (validate ResultProfileContract profile)
  (profile-plan profile))
(def (result-plan-recipe plan)
  (let (recipe (result-plan-owned-recipe plan))
    (list (map (lambda (row) (list (car row) (map values (cadr row)))) (car recipe))
          (map values (cadr recipe)))))
(def (result-plan-catalog plan)
  (list (cons 'syntax-kinds
              (map (lambda (row) (list (car row) 'result (map values (cadr row))))
                   (car (result-plan-recipe plan))))
        (cons 'terminals (map (lambda (kind) (list kind 'token))
                             (cadr (result-plan-recipe plan))))))
(def (result-plan-token plan token)
  (unless (and (token? token) (exact-integer? (token-start token))
               (exact-integer? (token-end token)) (<= 0 (token-start token) (token-end token))
               (hash-get (result-plan-token-index plan) (token-kind token)))
    (error "undeclared result terminal" token))
  token)
(def (result-plan-node plan kind start end children)
  (let (fields (hash-get (result-plan-node-index plan) kind))
    (unless (and fields (exact-integer? start) (exact-integer? end) (<= 0 start end)
                 (list? children))
      (error "invalid or undeclared result node" kind start end))
    (for-each
     (lambda (child)
       (unless (and (recognition-child? child)
                    (hash-get fields (recognition-child-field child)))
         (error "undeclared result field" kind child))
       (let (value (recognition-child-value child))
         ;; Dispatch once, retain both bounds, then validate the local operation.
         ;; Do not call the generic span dispatcher repeatedly for each child.
         (let-values (((child-start child-end)
                       (cond
                        ((token? value)
                         (unless (hash-get (result-plan-token-index plan) (token-kind value))
                           (error "undeclared child result terminal" kind))
                         (values (token-start value) (token-end value)))
                        ((recognition-node? value)
                         (unless (hash-get (result-plan-node-index plan) (recognition-node-kind value))
                           (error "undeclared child result node" kind))
                         (values (recognition-node-start value) (recognition-node-end value)))
                        (else (error "invalid result child value" kind)))))
           (unless (and (exact-integer? child-start) (exact-integer? child-end)
                        (<= start child-start child-end end))
             (error "result child outside parent span" kind))))) children)
    (make-recognition-node kind start end children)))
(defsyntax (defresult-profile stx)
  (syntax-case stx (nodes tokens scanner)
    ((_ (name marker self base) (scanner source-scanner)
        (nodes (kind field ...) ...) (tokens token ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) scanner: source-scanner
                    nodes: '((kind (field ...)) ...) tokens: '(token ...))))
    ((_ (name marker self base) (nodes (kind field ...) ...) (tokens token ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) nodes: '((kind (field ...)) ...) tokens: '(token ...))))
    ((_ (name marker self base) (nodes (kind field ...) ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) nodes: '((kind (field ...)) ...))))
    ((_ (name marker self base) (tokens token ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) tokens: '(token ...))))
    ((_ (name marker self base) (scanner source-scanner))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) scanner: source-scanner)))))
