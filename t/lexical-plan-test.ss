#!/usr/bin/env gxi
(import :gerbil-parser/language-test-support)
(import (only-in :gerbil-parser/t/fixtures/fixture-release bind-fixture-grammar-release))
(import (only-in :gerbil-parser/languages/tla-plus/syntax/core tla-plus-core-syntax)
        (only-in :gerbil-parser/src/language/descriptor language-grammar-machine)
        (only-in :gerbil-parser/src/language/entry parse-language-source)
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-valid? parse-artifact-success?))
(import :std/test
        :gerbil-parser/src/language/grammar
        (only-in :gerbil-parser/src/runtime/machine
                 current-lexical-plan-sharing-enabled? parser-machine-prepare-lexer
                 parser-machine-lexical-plans parser-machine-lexical-modes-compatible? parser-machine-runtime)
        (only-in :gerbil-parser/src/runtime/lr-parser lr-runtime-lexical-mode-catalog)
        (only-in :gerbil-parser/src/runtime/incremental
                 current-lr-lexical-plan-reuse-enabled? current-lr-source-index-enabled? make-incremental-session parse-incremental-session
                 incremental-session-artifact incremental-session-project-artifact apply-edit make-edit edit-start-byte)
        (only-in :gerbil-parser/languages/hcl/parser hcl-parser parse-hcl)
        (only-in :gerbil-parser/languages/arithmetic/parser arithmetic-parser))
(begin
 (deflanguage lexical-fallback-priority
  (syntax
   (lexical
    (root source-file)
    (lex (first FirstToken (literals "x"))
       (second SecondToken (precedence 9 (fallback)))
       (space Space (whitespace+)))
    (extras space)
    (keywords)
    (recoveries)
    (conflicts reject)
    (case-insensitive #f)))
  (rules (source-file (node SourceFile (seq (field first first) (field second second))))))
 (bind-fixture-grammar-release lexical-fallback-priority "lexical-fallback-priority" "v1" "lexical-fallback-priority.v1") )
(begin
 (deflanguage lexical-fallback-order
  (syntax
   (lexical
    (root source-file)
    (lex (second SecondToken (fallback))
       (first FirstToken (literals "x"))
       (space Space (whitespace+)))
    (extras space)
    (keywords)
    (recoveries)
    (conflicts reject)
    (case-insensitive #f)))
  (rules (source-file (node SourceFile (seq (field first first) (field second second))))))
 (bind-fixture-grammar-release lexical-fallback-order "lexical-fallback-order" "v1" "lexical-fallback-order.v1") )

(def (unique-count plans)
  (length (foldl (lambda (plan found) (if (memq plan found) found (cons plan found))) '() (vector->list plans))))
(def (scan lexer text mode)
  (with-catch (lambda (condition) (list 'rejected (error-message condition) (error-irritants condition)))
    (lambda () (call-with-values (lambda () (lexer text 0 0 mode)) list))))
(deflanguage-parser-tests lexical-plan-test "compiler-proved lexical scanner plans"
  (engine)
    (scenario "shared engine prepares the regenerated TLA core with unchanged mode scans"
      (scope ((machine (language-grammar-machine tla-plus-core-syntax)))
        (scope-values (((shared plans certificates)
                      (parameterize ((current-lexical-plan-sharing-enabled? #t))
                        (parser-machine-prepare-lexer machine)))
                     ((separate controls separate-certificates)
                      (parameterize ((current-lexical-plan-sharing-enabled? #f))
                        (parser-machine-prepare-lexer machine))))
          (equal (< (unique-count plans) (vector-length plans))  #t)
          (equal (unique-count controls)  (vector-length controls))
          (equal (force certificates)  (force separate-certificates))
          (each (mode) ((vector->list (lr-runtime-lexical-mode-catalog (parser-machine-runtime machine))))
             (each (text) ('("MODULE" "λ中" "001" "<=>" "\\A" "(* nested (* x *) *)" "\"λ中😀\"" "@")) (equal (scan shared text mode)  (scan separate text mode))))))
      (each (row) ('(("---- MODULE M ----\nA == TRUE\n====\n" #t)
         ("---- MODULE M ----\nA == IF TRUE THEN 1 ELSE 2\n====\n" #t)
         ("---- MODULE M ----\nA == IF TRUE THEN\n====\n" #f)))
         (scope ((artifact (parse-language-source tla-plus-core-syntax (car row))))
           (equal (parse-artifact-valid? artifact)  #t)
           (equal (parse-artifact-success? artifact)  (cadr row)))))
    (scenario "plan sharing changes construction count but preserves every mode scan"
      (each (machine) ((list hcl-parser arithmetic-parser))
         (scope-values (((shared plans shared-certificates) (parameterize ((current-lexical-plan-sharing-enabled? #t)) (parser-machine-prepare-lexer machine)))
                      ((separate controls control-certificates) (parameterize ((current-lexical-plan-sharing-enabled? #f)) (parser-machine-prepare-lexer machine))))
           (equal (< (unique-count plans) (vector-length plans))  #t)
           (equal (unique-count controls)  (vector-length controls))
           (each (mode) ((vector->list (lr-runtime-lexical-mode-catalog (parser-machine-runtime machine))))
              (each (text) ('("value" "λ中" "001" ".2" "**" "+" "/* λ */" "\n" "\"λ中😀\"" "@")) (equal (scan shared text mode)  (scan separate text mode)))))))
    (scenario "equivalent plans preserve token output across distinct LR modes"
      (sequential ((plans (parser-machine-lexical-plans hcl-parser))
             (catalog (lr-runtime-lexical-mode-catalog (parser-machine-runtime hcl-parser))))
        (scope-values (((lexer ignored certificates) (parser-machine-prepare-lexer hcl-parser)))
          (each (i) ((iota (vector-length plans)))
             (each (j) ((iota (vector-length plans)))
                (when (and (not (= i j)) (eq? (vector-ref plans i) (vector-ref plans j)))
                  (equal (parser-machine-lexical-modes-compatible? hcl-parser i j)  #t)
                  (equal (scan lexer "value" (vector-ref catalog i))  (scan lexer "value" (vector-ref catalog j)))))))))
    (scenario "first-character certificates preserve competition across distinct modes"
      (each (machine) ((list hcl-parser arithmetic-parser
             lexical-fallback-priority-parser lexical-fallback-order-parser))
         (sequential ((catalog (lr-runtime-lexical-mode-catalog (parser-machine-runtime machine)))
                (n (vector-length catalog)) (refined 0) (vetoed 0))
           (scope-values (((lexer plans certificates) (parser-machine-prepare-lexer machine)))
             (each (i) ((iota n))
                (each (j) ((iota n))
                   (each (text) ('("\n" " " "x" "value" "001" ".2" "**" "*" "+" "/* λ */" "\"λ中😀\"" "<<EOF\na\nEOF\n" "λ中" "@" "\r\n" "\"" "/*" "." "999e"))
                      (when (and (eq? machine hcl-parser) (equal? text "\n"))
                        (equal (parser-machine-lexical-modes-compatible? machine i j #\newline)  #t))
                      (scope ((compatible (parser-machine-lexical-modes-compatible? machine i j (string-ref text 0)))
                            (left (scan lexer text (vector-ref catalog i)))
                            (right (scan lexer text (vector-ref catalog j))))
                        (when compatible
                          ;; Rejection mode objects differ; compare outcome, while
                          ;; successful scans compare complete token and offset.
                          (equal (if (eq? (car left) 'rejected) 'rejected left)
                                  (if (eq? (car right) 'rejected) 'rejected right))
                          (unless (parser-machine-lexical-modes-compatible? machine i j)
                            (act (set! refined (+ refined 1)))))
                        (when (and (not compatible) (not (equal? left right)))
                          (act (set! vetoed (+ vetoed 1)))))))))
           (equal (> refined 0)  #t)
           (unless (eq? machine arithmetic-parser) (equal (> vetoed 0)  #t)))))
    (scenario "Unicode byte shifts preserve certified probes and indexed mode provenance"
      (each (indexed?) ('(#f #t))
         (parameters ((current-lr-source-index-enabled? indexed?))
           (sequential ((source (apply string-append (make-list 80 "value = 001\n")))
                  (session (make-incremental-session hcl-parser source #t)))
             (each (edit) ((list (make-edit 0 0 "λ = \"中😀\"\n") (make-edit 0 15 "")))
                (scope-values (((next receipt)
                              (parameterize ((current-lr-lexical-plan-reuse-enabled? #t))
                                (parse-incremental-session session edit))))
                  (scope-values (((control ignored)
                                (parameterize ((current-lr-lexical-plan-reuse-enabled? #f))
                                  (parse-incremental-session session edit))))
                    (equal (incremental-session-artifact next)  (incremental-session-artifact control)))
                  (act (set! source (apply-edit source edit)))
                  (equal (incremental-session-artifact next)  (parse-hcl source))
                  (equal (incremental-session-project-artifact next)  (incremental-session-artifact next))
                  (act (set! session next))))))))
    (scenario "six-edit token convergence preserves full artifacts and original folds"
      (sequential ((line "value = 001\n") (source (apply string-append (make-list 80 line)))
             (session (make-incremental-session hcl-parser source #t)))
        (each (edit) ((list (make-edit 0 0 "other = 002\n") (make-edit 492 0 "third = 003\n")
               (make-edit 0 12 "") (make-edit 480 12 "")
               (make-edit 960 0 "last = 004\n") (make-edit 960 11 "")))
           (scope-values (((next receipt) (parameterize ((current-lr-lexical-plan-reuse-enabled? #t))
                                        (parse-incremental-session session edit))))
             (parameters ((current-lr-lexical-plan-reuse-enabled? #f))
               (scope-values (((control strict-receipt) (parse-incremental-session session edit)))
                 (when (and (zero? (edit-start-byte edit))
                            (equal? source (apply string-append (make-list 80 line))))
                   (equal (< (cdr (assq 'fragmentCertificateProbeByteCount receipt))
                             (cdr (assq 'fragmentCertificateProbeByteCount strict-receipt)))  #t)
                   (equal (> (cdr (assq 'certifiedLexicalProbeTokenCount receipt)) 0)  #t))
                 (equal (incremental-session-artifact next)  (incremental-session-artifact control))))
             (act (set! source (apply-edit source edit)))
             (equal (incremental-session-artifact next)  (parse-hcl source))
             (equal (incremental-session-project-artifact next)  (incremental-session-artifact next))
             (act (set! session next)))))))
