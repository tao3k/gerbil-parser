;;; Structural admission shared by parser-test expansion and source audits.
;;; Ports belong to explicit fixture constructors; console output is a separate
;;; framework capability. This is a syntax contract, not a Scheme sandbox.
(export parser-test-form-admitted?)

(def (parser-test-form-admitted? form forbidden
      (owned-output (if (or (equal? forbidden '(display))
                            (equal? forbidden '(display displayln)))
                      '(display write-string) '(write-string))))
  (let loop ((pending (list (cons form '()))))
    (if (null? pending) #t
      (let* ((frame (car pending)) (form (car frame))
             (owned (cdr frame)) (rest (cdr pending)))
        (def (push forms ports tail)
          (let push-loop ((forms forms) (tail tail))
            (if (null? forms) tail
              (push-loop (cdr forms) (cons (cons (car forms) ports) tail)))))
        (def (without names)
          (filter (lambda (port) (not (memq port names))) owned))
        (def (formal-names names)
          (cond ((symbol? names) (list names))
                ((pair? names)
                 (append (if (symbol? (car names)) (list (car names))
                           (if (and (pair? (car names)) (symbol? (caar names)))
                             (list (caar names)) '()))
                         (formal-names (cdr names))))
                (else '())))
        (def (formal-defaults names)
          (if (pair? names)
            (append (if (and (list? (car names)) (= (length (car names)) 2))
                      (list (cadar names)) '())
                    (formal-defaults (cdr names)))
            '()))
        (def (binding-names bindings)
          (if (and (= (length bindings) 2) (symbol? (car bindings)))
            (list (car bindings))
            (apply append
              (map (lambda (binding)
                     (if (and (list? binding) (pair? binding))
                       (formal-names (car binding)) '())) bindings))))
        (def (ordinary)
          ;; Argument-list tails are not applications. Visit each element once,
          ;; including an improper final tail, without reinterpreting imports
          ;; or argument names as executable heads.
          (let elements ((items form) (next rest))
            (cond ((pair? items)
                   (elements (cdr items) (cons (cons (car items) owned) next)))
                  ((null? items) (loop next))
                  (else (loop (cons (cons items owned) next))))))
        (cond
         ((not (pair? form)) (loop rest))
         ((memq (car form) '(quote syntax)) (loop rest))
         ((memq (car form) '(quasiquote quasisyntax))
          ;; Only executable unquotes enter ordinary expression admission.
          (let ((family (car form))
                (escapes (if (eq? (car form) 'quasiquote)
                           '(unquote unquote-splicing) '(unsyntax unsyntax-splicing))))
           (let templates ((work (list (cons (cdr form) 1))) (next rest))
            (if (null? work) (loop next)
              (let* ((entry (car work)) (value (car entry))
                     (depth (cdr entry)) (tail (cdr work)))
                (cond
                 ((not (pair? value)) (templates tail next))
                 ((eq? (car value) family)
                  (templates (cons (cons (cdr value) (+ depth 1)) tail) next))
                 ((memq (car value) escapes)
                  (if (= depth 1)
                    (templates tail (cons (cons (cdr value) owned) next))
                    (templates (cons (cons (cdr value) (- depth 1)) tail) next)))
                 (else
                  (templates (cons (cons (car value) depth)
                                   (cons (cons (cdr value) depth) tail)) next))))))))
         ((and (memq (car form) '(call-with-output-string call-with-output-file))
               (list? form) (pair? (cdr form)))
          (let (handler (last form))
            (if (and (list? handler) (>= (length handler) 3)
                     (eq? (car handler) 'lambda) (list? (cadr handler))
                     (= (length (cadr handler)) 1) (symbol? (caadr handler)))
              (loop (push (reverse (cdr (reverse (cdr form)))) owned
                      (push (cddr handler) (cons (caadr handler) (without (cadr handler))) rest)))
              (ordinary))))
         ((and (memq (car form) '(using install-check inline-callback)) (list? form) (>= (length form) 4)
               (list? (caddr form)))
          (let* ((names (caddr form)) (producer (cadr form))
                 (fresh-output? (and (eq? (car form) 'using)
                                     (list? producer) (pair? producer)
                                     (memq (car producer) '(call-with-output-string call-with-output-file))
                                     (= (length names) 1) (symbol? (car names))))
                 (ports (if fresh-output? (cons (car names) (without names)) (without names))))
            (loop (cons (cons producer owned) (push (cdddr form) ports rest)))))
         ((and (memq (car form) '(lambda parser-check)) (list? form)
               (>= (length form) 3))
          (let (ports (without (formal-names (cadr form))))
            (loop (push (formal-defaults (cadr form)) ports
                        (push (cddr form) ports rest)))))
         ((and (memq (car form) '(scope sequential locals scope-values sequential-values
                                       let let* letrec letrec* let-values let*-values))
               (list? form) (>= (length form) 3) (list? (cadr form)))
          ;; Rebinding a borrowed port revokes its authority throughout that
          ;; binding group. Initializers can use a distinct outer port name.
          (let* ((bindings (cadr form))
                 (single? (and (= (length bindings) 2) (symbol? (car bindings))))
                 (rows (if single? (list bindings) bindings))
                 (ports (without (binding-names bindings))))
            (and (every (lambda (row) (and (list? row) (= (length row) 2))) rows)
                 (loop (push (map cadr rows) ports (push (cddr form) ports rest))))))
         ((and (eq? (car form) 'each) (list? form) (>= (length form) 4)
               (list? (cadr form)))
          (loop (cons (cons (caddr form) owned)
                      (push (cdddr form) (without (cadr form)) rest))))
         ((and (memq (car form) '(iterate let)) (list? form) (>= (length form) 4)
               (symbol? (cadr form))
               (list? (caddr form)))
          (loop (cons (cons (caddr form) owned)
                      (push (cdddr form)
                            (without (cons (cadr form) (binding-names (caddr form)))) rest))))
         ((and (eq? (car form) 'set!) (list? form) (= (length form) 3)
               (memq (cadr form) owned)) #f)
         ;; The owner audit also reserves protocol bindings for declarations.
         ;; Lexical binding metadata and quoted fixture data remain distinct.
         ((and (memq (car form) '(def define)) (pair? (cdr form))
               (let (name (cadr form))
                 (memq (if (pair? name) (car name) name) forbidden))) #f)
         ((and (symbol? (car form)) (memq (car form) forbidden))
          (let ((arity (if (memq (car form) '(newline force-output)) 2 3)))
            (and (memq (car form) owned-output) (list? form) (= (length form) arity)
                 (memq (last form) owned)
                 (loop (push (reverse (cdr (reverse (cdr form)))) owned rest)))))
         (else (ordinary)))))))
