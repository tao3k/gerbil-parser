(import :gerbil-parser/src/modules/parser/interface
        :gerbil-parser/src/runtime/artifact
        :gerbil-parser/src/runtime/lexer
        :gerbil-parser/src/runtime/significant
        :gerbil-parser/src/compiler/machine
        :gerbil-parser/src/language/descriptor
        :gerbil-parser/languages/gql/iso-39075-2024/parser)
(export main)
(def (measure label count thunk)
  (let loop ((sample 0))
    (when (< sample 5)
      (##gc)
      (let ((started (##current-time-point)) (cpu (cpu-time)))
        (let run ((n count))
          (unless (zero? n) (thunk) (run (- n 1))))
        (write (list (cons 'phase label) (cons 'sample sample) (cons 'count count)
                     (cons 'cpu-ms (* 1000 (- (cpu-time) cpu)))
                     (cons 'wall-ms (* 1000 (- (##current-time-point) started)))))
        (newline) (force-output))
      (loop (+ sample 1)))))
(def (main . args)
  (let* ((machine (language-grammar-machine gql-iso-language-grammar))
         (source +gql-representative-query+)
         (tokens (lex-source machine source))
         (significant (parser-significant-tokens machine tokens)))
    (let-values (((root rest) ((parser-machine-parse machine) significant #f)))
      (unless (null? rest) (error "incomplete parse"))
      (let (artifact (make-success-parse-artifact (parser-machine-grammar-digest machine)
                         source tokens root (parser-machine-trivia machine)))
        (unless (and (parse-artifact-valid? artifact)
                     (equal? (parse-artifact-roundtrip artifact) source))
          (error "invalid complete artifact")))
      (measure 'gql-complete 100 (lambda () (parse-gql-iso-39075-2024 source)))
      (measure 'gql-lex 100 (lambda () (lex-source machine source)))
      (measure 'gql-significant 100 (lambda () (parser-significant-tokens machine tokens)))
      (measure 'gql-lr 100 (lambda () ((parser-machine-parse machine) significant #f)))
      (measure 'gql-publication 100
        (lambda () (make-success-parse-artifact (parser-machine-grammar-digest machine)
                     source tokens root (parser-machine-trivia machine))))))
  (let* ((make-role (lambda () (make-grammar-role 'observability-role '() '() '() '() '() '() '() '() '())))
         (role (make-role))
         (grammar (make-grammar 'observability-grammar '() (list role))))
    (measure 'poo-role 50 make-role)
    (measure 'poo-grammar 50 (lambda () (make-grammar 'observability-grammar '() (list role))))
    (measure 'poo-role-predicate 50 (lambda () (grammar-role? role)))
    (measure 'poo-grammar-predicate 50 (lambda () (grammar? grammar))))
  (displayln "DIAGNOSTIC-OK") (force-output))
