;;; Direct kernel parity plus nullable, Unicode, relocation and exact tail checks.
(import (only-in :gerbil-parser/src/runtime/lr-parser/state
                 lr-runtime-reduction-widths lr-recognition-fragment-children)
        (only-in :gerbil-parser/src/runtime/lr-parser/recognition capture-reduction lr-recognition-relocate)
        (only-in :gerbil-parser/src/compiler/machine parser-machine-runtime)
        (only-in :gerbil-parser/src/runtime/token make-token)
        (only-in :gerbil-parser/t/fixtures/runtime-record-assignments/languages/records/grammar records-parser)
        (only-in :gerbil-parser/t/benchmarks/lr-request-stack/capture-reference reference-capture-reduction))
(def (require! value message) (unless value (error message)))
(let* ((runtime (parser-machine-runtime records-parser))
       (widths (lr-runtime-reduction-widths runtime)) (seen '()))
 (for-each
  (lambda (production)
   (let (width (vector-ref widths production))
    (set! seen (cons width seen))
    (for-each
     (lambda (shift?)
      (let* ((prefix (map (lambda (i)
                           (let (token (make-token 'identifier "α" (* i 2) (+ 2 (* i 2))))
                             (if shift? (lr-recognition-relocate token 3) token))) (iota width)))
             (suffix (list (make-token 'identifier "tail" 100 104)))
             (stack (append (reverse prefix) suffix))
             (states (make-list (+ width 1) 0))
             (args (list runtime #f production states stack '() 7 '(value) 1))
             (reference (apply reference-capture-reduction args))
             (candidate (apply capture-reduction args)))
       (require! (equal? reference candidate) "capture fields or yield association changed")
       (require! (eq? (cdr candidate) suffix) "capture copied or changed the remaining stack")
       (require! (equal? (lr-recognition-fragment-children (car candidate)) prefix) "source order changed")))
     '(#f #t))))
  (iota (vector-length widths)))
 (require! (and (memv 0 seen) (memv 1 seen)) "nullable and unary productions not exercised")
 (displayln "CAPTURE-PREFIX-CONTROLS-OK productions=" (vector-length widths)) (force-output))
