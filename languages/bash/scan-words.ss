;;; -*- Gerbil -*-
;;; Bash word boundaries. Quoting and nested substitutions shield operators.

(export bash-at? bash-word-end bash-operator-at
        bash-quote-end bash-substitution-end)

(def (bash-at? source offset text)
  (let (end (+ offset (string-length text)))
    (and (<= end (string-length source))
         (string=? (substring source offset end) text))))

(def (bash-quote-end source start quote)
  (let (length (string-length source))
    (let loop ((offset (fx+ start 1)))
      (cond
       ((= offset length) (error "unterminated Bash quote" start))
       ((and (not (char=? quote #\'))
             (char=? (string-ref source offset) #\\))
        (loop (min length (fx+ offset 2))))
       ((char=? (string-ref source offset) quote) (fx+ offset 1))
       ((and (char=? quote #\")
             (or (bash-at? source offset "$(")
                 (bash-at? source offset "${")))
        (loop (bash-substitution-end source offset)))
       (else (loop (fx+ offset 1)))))))

(def (bash-backtick-end source start)
  (let (length (string-length source))
    (let loop ((offset (fx+ start 1)))
      (cond
       ((= offset length) (error "unterminated Bash backticks" start))
       ((char=? (string-ref source offset) #\\)
        (loop (min length (fx+ offset 2))))
       ((char=? (string-ref source offset) #\`) (fx+ offset 1))
       (else (loop (fx+ offset 1)))))))

(def (bash-substitution-end source start)
  (let* ((brace? (bash-at? source start "${"))
         (opening (if brace? #\{ #\())
         (closing (if brace? #\} #\)))
         (arithmetic? (and (not brace?) (bash-at? source start "$(("))))
    (let (length (string-length source))
      (let loop ((offset (+ start (if arithmetic? 3 2)))
                 (depth (if arithmetic? 2 1)))
        (cond
         ((= offset length) (error "unterminated Bash substitution" start))
         ((char=? (string-ref source offset) #\\)
          (loop (min length (fx+ offset 2)) depth))
         ((char=? (string-ref source offset) #\')
          (loop (bash-quote-end source offset #\') depth))
         ((char=? (string-ref source offset) #\")
          (loop (bash-quote-end source offset #\") depth))
         ((char=? (string-ref source offset) #\`)
          (loop (bash-backtick-end source offset) depth))
         ((or (bash-at? source offset "${")
              (bash-at? source offset "$(")
              (bash-at? source offset "<(")
              (bash-at? source offset ">("))
          (loop (bash-substitution-end source offset) depth))
         ((char=? (string-ref source offset) opening)
          (loop (fx+ offset 1) (fx+ depth 1)))
         ((char=? (string-ref source offset) closing)
          (if (= depth 1) (fx+ offset 1)
            (loop (fx+ offset 1) (fx- depth 1))))
         (else (loop (fx+ offset 1) depth)))))))

(def +bash-operators+
  '(";;&" "&>>" "<<-" "<<<" "&&" "||" "|&" ";;" ";&"
    "<<" ">>" "<>" "<&" ">&" ">|" "&>" ";" "&" "|" "(" ")"
    "<" ">"))

(def (bash-operator-at source offset)
  (let loop ((operators +bash-operators+))
    (and (pair? operators)
         (if (bash-at? source offset (car operators))
           (car operators)
           (loop (cdr operators))))))

(def (bash-word-end source start)
  (let (length (string-length source))
    (let loop ((offset start))
      (cond
       ((= offset length) offset)
       ((and (> offset start)
             (not (or (bash-at? source offset "<(")
                      (bash-at? source offset ">(")))
             (or (char-whitespace? (string-ref source offset))
                 (bash-operator-at source offset)))
        offset)
       ((char=? (string-ref source offset) #\\)
        (loop (min length (fx+ offset 2))))
       ((char=? (string-ref source offset) #\')
        (loop (bash-quote-end source offset #\')))
       ((char=? (string-ref source offset) #\")
        (loop (bash-quote-end source offset #\")))
       ((char=? (string-ref source offset) #\`)
        (loop (bash-backtick-end source offset)))
       ((or (bash-at? source offset "$(")
            (bash-at? source offset "${")
            (bash-at? source offset "<(")
            (bash-at? source offset ">("))
        (loop (bash-substitution-end source offset)))
       (else (loop (fx+ offset 1)))))))
