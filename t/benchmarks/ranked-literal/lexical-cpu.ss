;;; Complete ranked lexical competition, including rule identity and endpoints.
(import (only-in ./benchmark ranked-cpu-admission)
        (only-in ../../fixtures/ranked-publication reference-ranked-lexical-scanner-factory)
        (only-in :gerbil-parser/src/runtime/scan make-ranked-lexical-scanner-factory))
(export benchmark-ranked-lexical-cpu qualify-ranked-lexical-cpu)
(def (benchmark-ranked-lexical-cpu (groups 20) (calls 500000) (scenario #f))
  (let* ((entries '(("if" keyword 2 0) ("ifelse" longer 1 1) ("+" plus 9 2)
                   ("+++" triple 0 3) ("α😀" wide 1 4) ("1e" prefix 2 7)))
         (regular '((identifier name 0 5) (number number 0 6)))
         (admitted (make-vector 8 #t))
         (old ((reference-ranked-lexical-scanner-factory entries) regular admitted))
         (new ((make-ranked-lexical-scanner-factory entries) regular admitted)))
    (unless (or (not scenario) (memq scenario '(keyword identifier literal-prefix)))
      (error "unknown complete lexical CPU scenario" scenario))
    (map (lambda (row)
      (let ((name (car row)) (source (cadr row)) (expected (caddr row)))
        (ranked-cpu-admission (list 'ranked-lexical name) groups calls expected
          (lambda () (old source 0)) (lambda () (new source 0)))))
      (filter (lambda (row) (or (not scenario) (eq? scenario (car row))))
        '((keyword "ifelse!" (longer 6 1 1))
        (identifier "ifelsewhere!" (name 11 0 5))
        (literal-prefix "+++!" (triple 3 0 3)))))))
(def (qualify-ranked-lexical-cpu (groups 20) (calls 500000) (scenario #f))
  (let (summaries (benchmark-ranked-lexical-cpu groups calls scenario))
    (unless (andmap (lambda (entry) (cdr (assq 'cpu-benefit (cdr entry)))) summaries)
      (error "complete ranked lexical CPU controls or benefit gate failed" summaries))
    (displayln "RANKED-LEXICAL-CPU-PROOF-OK") (force-output)
    summaries))
