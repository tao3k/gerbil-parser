((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 50ms)
 (regression_budget . 50ms)
 (expected_over_input_budget . 50ms)
 (targetRationale . "fifty checked GrammarRole and Grammar construction pairs must remain inside the POO compiler-side construction budget")
 (sampleCount . 20)
 (rule . GERBIL-PARSER-POO-GRAMMAR-OBJECTS)
 (feature . poo-grammar-object-construction)
 (optimizationFocus . "contract prototype reuse plus checked POO object composition outside the parser hot path")
 (inputShape . "fifty GrammarRole and Grammar object pairs per sample")
 (expectedOutcome . "all objects satisfy their POO contracts and construction retains bounded time and memory receipts")
 (measurementPhases collect-before collect-after policy-before policy-after
                    assert-time-gate observe-runtime-memory)
 (tags performance integration compiler poo observability))
