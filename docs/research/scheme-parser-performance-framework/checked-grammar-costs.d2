direction: down
vars: {d2-config: {theme-id: 3; pad: 40}}
style.font-size: 20

current: "Current descriptor and candidate"
preflight: "Complete shape and presence checks"
normalize: "Ordered Slot normalization\nRebound receiver and read observations"
membership: "Final membership and current obligations"
result: "Actual checked Grammar"
refusal: "Original refusal\nRetained callback state"

current -> preflight -> normalize -> membership -> result
preflight -> refusal
normalize -> refusal
membership -> refusal

law: "LeanPoo refinement law\nPreserve values, errors and state" {shape: page}
scheme: "Scheme implementation\nRemove only proven administration"
law -> scheme: "Constrain"
scheme -> normalize: "Retain execution semantics" {style.stroke-dash: 4}
