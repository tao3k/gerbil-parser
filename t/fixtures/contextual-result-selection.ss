;;; Test-owned former dispatch, applied only to an independent prepared handle.
;;; Private access is resolved once during preparation, never inside timing.
(import (only-in :gerbil-parser/src/ffi/language-abi-context language-abi-context-plan))
(import (only-in :gerbil-parser/src/runtime/region-scanner source-prefix-at?))
(export install-reference-contextual-results!)
(def (private namespace name) (eval (string->symbol (string-append namespace "#" name))))
(def (install-reference-contextual-results! context)
  (let* ((ns "gerbil-parser/src/runtime/contextual-scanner")
         (get (lambda (name) (private ns name)))
         (plan ((private "gerbil-parser/src/runtime/parser" "contextual-parser-plan-scanner")
                (language-abi-context-plan context)))
         (seen (make-table test: eq?))
         (mode (get "runtime-scan-rule-mode")) (form (get "runtime-scan-rule-form"))
         (set-result! (get "runtime-scan-rule-result-set!"))
         (cells (get "contextual-scanner-cells"))
         (modes (get "grouped-dispatch-modes"))
         (matcher (get "runtime-scan-rule-matcher"))
         (apply-action (get "apply-scan-action"))
         (set-action! (get "runtime-scan-rule-action-step-set!"))
         (set-executor! (get "runtime-scan-rule-executor-set!"))
         (set-width! (get "runtime-scan-rule-byte-width-set!")))
    (def (install! rule)
      (unless (table-ref seen rule #f)
        (table-set! seen rule #t)
        (let ((m (mode rule)) (f (form rule)))
          (set-result! rule
            (lambda (scanner position)
              (let* ((index (cells scanner))
                     (kind (if (table? index)
                             (table-ref index (list m position f) #f)
                             (let* ((positions (table-ref (modes index) m #f))
                                    (row (and positions (table-ref positions position '())))
                                    (cell (and row (assq f row))))
                               (and cell (cdr cell))))))
                (or kind (error "missing contextual scanner dispatch" m position f)))))
          (set-action! rule apply-action)
          (set-width! rule #f)
          (match (matcher rule)
            (['literal value]
             (let (width (string-length value))
               (set-executor! rule (lambda (source start _state)
                                    (and (source-prefix-at? source start value) (+ start width))))))
            (else (void))))))
    (for-each
     (lambda (index)
       (for-each
        (lambda (entry)
          (let (rules (cdr entry))
            (if ((get "first-character-rules?") rules)
              (begin
                (for-each (lambda (row) (for-each install! row))
                          (vector->list ((get "first-character-rules-ascii") rules)))
                (for-each (lambda (row) (for-each install! (cdr row)))
                          (table->list ((get "first-character-rules-wide") rules)))
                (for-each install! ((get "first-character-rules-alpha") rules))
                (for-each install! ((get "first-character-rules-other") rules)))
              (for-each install! rules)))) (table->list index)))
     (list ((get "contextual-scanner-plan-short-rules") plan)
           ((get "contextual-scanner-plan-long-rules") plan)))
    context))
