;;; Real child output for qualification framing and completed-log controls.
(export main)
(def (main mode)
  (case (string->symbol mode)
    ((ordinary) (display "ERROR_COUNT is a counter\n*** NOTE\nOK\n"))
    ((error) (display "ERROR\n"))
    ((punctuation) (display "ERROR!"))
    ((gambit) (display "*** ERROR rejected"))
    ((boundary)
     (display (make-string 65533 #\x)) (display "\nER") (force-output)
     (display "ROR"))
    ((large)
     (let (block (string->utf8 (string-append "NOTE " (make-string 2042 #\x) "\n")))
       (let loop ((left 4096))
         (when (positive? left)
           (write-subu8vector block 0 (u8vector-length block))
           (loop (- left 1))))))
    (else (error "unknown output fixture" mode)))
  (force-output) (exit 0))
