;;; Closed recognition rules compile once to context/first-character dispatch.
(import (only-in :clan/poo/object .o .ref object?)
        (only-in :clan/poo/mop define-type validate)
        (only-in :core/types PooFlowContract. poo-flow-classification-evidence)
        (only-in ../runtime/region-scanner source-prefix-at? region-plan-specification)
        (only-in ./result-profile result-plan-catalog))
(export PartProfile. PartProfileContract defpart-profile compile-part-profile
        part-plan? part-plan-recipe part-plan-literal part-plan-match part-plan-literal-end
        part-step-operation part-step-kind part-step-opening part-step-closing part-step-delimiter
        part-plan-name-end admit-part-plan
        part-plan-context part-context-match part-context-literal-end)
(def PartProfile. (.o contexts: '() rules: '() literal: 'LiteralPart))
(defstruct part-step (operation kind opening closing delimiter singles))
(defstruct part-rule (prefix guard step))
(defstruct part-context-index (ascii wide))
(def (context-rules context character)
  (let (code (char->integer character))
    (if (< code 128) (vector-ref (part-context-index-ascii context) code)
      (or (hash-get (part-context-index-wide context) character) '()))))
(def (context-rules-put! context character rules)
  (let (code (char->integer character))
    (if (< code 128) (vector-set! (part-context-index-ascii context) code rules)
      (hash-put! (part-context-index-wide context) character rules))))
(defstruct part-plan (recipe-field dispatch literal))
(def (copy-datum value)
  (cond ((pair? value) (cons (copy-datum (car value)) (copy-datum (cdr value))))
        ((string? value) (string-copy value)) (else value)))
(def (distinct? values)
  (let loop ((remaining values) (seen '()))
    (or (null? remaining)
        (and (not (member (car remaining) seen))
             (loop (cdr remaining) (cons (car remaining) seen))))))
(def (compile-step form)
  (unless (and (list? form) (pair? form)) (error "invalid part operation" form))
  (case (car form)
    ((parameter)
     (unless (= (length form) 1) (error "invalid parameter operation" form))
     (make-part-step 'parameter 'ParameterExpansion 2 1 #f #f))
    ((quote quoted-body)
     (unless (and (= (length form) 5) (symbol? (cadr form))
                  (exact-integer? (caddr form)) (> (caddr form) 0)
                  (exact-integer? (cadddr form)) (= (cadddr form) 1)
                  (char? (list-ref form 4))) (error "invalid quote operation" form))
     (make-part-step (car form) (cadr form) (caddr form) (cadddr form) (list-ref form 4) #f))
    ((pair)
     (unless (and (= (length form) 4) (symbol? (cadr form))
                  (exact-integer? (caddr form)) (> (caddr form) 0)
                  (exact-integer? (cadddr form)) (> (cadddr form) 0))
       (error "invalid pair operation" form))
     (make-part-step 'pair (cadr form) (caddr form) (cadddr form) #f #f))
    ((name)
     (unless (and (= (length form) 3) (symbol? (cadr form)) (string? (caddr form)))
       (error "invalid name operation" form))
     (make-part-step 'name (cadr form) 1 0 #f (string->list (caddr form))))
    ((escape)
     (unless (and (= (length form) 2) (symbol? (cadr form))) (error "invalid escape operation" form))
     (make-part-step 'escape (cadr form) 1 0 #f #f))
    (else (error "unknown part operation" form))))
(def (profile-plan profile)
  (unless (object? profile) (error "part profile requires a POO object"))
  (let* ((contexts (.ref profile 'contexts)) (rules (.ref profile 'rules))
         (literal (.ref profile 'literal)) (dispatch (make-hash-table-eq)))
    (unless (and (list? contexts) (pair? contexts) (andmap symbol? contexts)
                 (distinct? contexts)
                 (list? rules) (symbol? literal)) (error "invalid part profile slots"))
    (for-each (lambda (context) (hash-put! dispatch context (make-part-context-index (make-vector 128 '()) (make-hash-table-eqv)))) contexts)
    (for-each
     (lambda (row)
       (unless (and (list? row) (= (length row) 3) (list? (car row)) (pair? (car row))
                    (andmap (lambda (context) (memq context contexts)) (car row))
                    (distinct? (car row))
                    (list? (cadr row)) (= (length (cadr row)) 3)
                    (eq? (caadr row) 'prefix) (string? (cadadr row))
                    (> (string-length (cadadr row)) 0)
                    (or (memq (caddr (cadr row)) '(any next)) (string? (caddr (cadr row)))))
         (error "invalid part recognition rule" row))
       (let* ((prefix (string-copy (cadadr row))) (guard (let (value (caddr (cadr row))) (if (string? value) (string->list value) value)))
              (step (compile-step (caddr row))) (rule (make-part-rule prefix guard step)))
         (unless (and (or (not (memq (part-step-operation step) '(name escape parameter)))
                          (= (string-length prefix) (part-step-opening step)))
                      (or (not (memq (part-step-operation step) '(quote pair quoted-body)))
                          (= (string-length prefix) (part-step-opening step)))
                      (or (not (memq (part-step-operation step) '(quote quoted-body)))
                          (char=? (string-ref prefix (- (string-length prefix) 1)) (part-step-delimiter step))))
           (error "part opening does not match recognition prefix" row))
         (for-each
          (lambda (context)
            (let* ((bucket (hash-ref dispatch context)) (key (string-ref prefix 0))
                   (previous (context-rules bucket key)))
              (when (ormap (lambda (other) (and (equal? prefix (part-rule-prefix other))
                                                 (equal? guard (part-rule-guard other)))) previous)
                (error "duplicate part recognition rule" row))
              ;; Keep declaration precedence, including shorter-prefix overrides.
              (context-rules-put! bucket key (append previous (list rule))))) (car row)))) rules)
    (make-part-plan (copy-datum (list contexts rules literal)) dispatch literal)))
(def (profile-valid? profile)
  (with-catch (lambda (_) #f) (lambda () (profile-plan profile) #t)))
(define-type (PartProfileContract @ PooFlowContract.)
  identity: 'gerbil-parser/part-profile
  .classify: (lambda (candidate context)
    (let (accepted? (profile-valid? candidate))
      (poo-flow-classification-evidence 'gerbil-parser/part-profile candidate accepted?
       (if accepted? '() '((expected gerbil-parser/part-profile))) context))))
(def (compile-part-profile profile)
  (validate PartProfileContract profile) (profile-plan profile))
(def (part-plan-recipe plan) (copy-datum (part-plan-recipe-field plan)))
(def (admit-part-plan plan results regions)
  (let* ((recipe (part-plan-recipe plan)) (contexts (car recipe))
         (catalog (result-plan-catalog results))
         (nodes (cdr (assq 'syntax-kinds catalog)))
         (terminals (cdr (assq 'terminals catalog)))
         (region-spec (region-plan-specification regions)))
    (unless (and (memq 'word contexts) (memq 'HereDocument contexts)
                 (assq (part-plan-literal plan) nodes))
      (error "part profile lacks required contexts or literal result"))
    (def (requires! kind fields tokens)
      (let (declaration (assq kind nodes))
        (unless (and declaration (andmap (lambda (field) (memq field (caddr declaration))) fields)
                     (andmap (lambda (token) (assq token terminals)) tokens))
          (error "part result construction disagrees with operation" kind))))
    (requires! (part-plan-literal plan) '(text) (list (part-plan-literal plan)))
    (for-each
     (lambda (row)
       (let* ((step (compile-step (caddr row))) (operation (part-step-operation step))
              (kind (part-step-kind step)) (prefix (cadadr row)))
         (case operation
           ((name escape) (requires! kind '(text) (list kind)))
           ((quote) (requires! kind '(open part close) '(quote-open quote-close)))
           ((pair quoted-body) (requires! kind '(open body close)
                                         '(substitution-open substitution-body substitution-close)))
           ((parameter) (requires! kind '(open prefix name subscript operator operand close)
                                   '(parameter-open parameter-prefix parameter-name parameter-operator parameter-close))))
         (when (eq? operation 'quote)
           (unless (memq kind contexts) (error "quote result lacks part context" kind)))
         (when (memq operation '(quote quoted-body))
           (unless (assv (part-step-delimiter step) (cadr region-spec))
             (error "undeclared part quote delimiter" prefix)))
         (when (memq operation '(pair parameter))
           (let (region (assoc prefix (caddr region-spec)))
             (unless (and region (= (part-step-closing step) (cadddr region)))
               (error "part operation disagrees with region declaration" prefix))))))
     (cadr recipe)))
  plan)
(def (part-plan-context plan context)
  (or (hash-get (part-plan-dispatch plan) context) (error "undeclared part context" context)))
(def (part-context-match bucket text offset end)
  (and (< offset end)
       (let loop ((rules (context-rules bucket (string-ref text offset))))
         (and (pair? rules)
              (let* ((rule (car rules)) (prefix (part-rule-prefix rule))
                     (after (+ offset (string-length prefix))) (guard (part-rule-guard rule)))
                (if (and (<= after end) (source-prefix-at? text offset prefix)
                         (or (eq? guard 'any)
                             (and (< after end) (or (eq? guard 'next) (memv (string-ref text after) guard)))))
                  (part-rule-step rule) (loop (cdr rules))))))))
(def (part-plan-match plan text offset end context)
  (part-context-match (part-plan-context plan context) text offset end))
(def (part-plan-literal-end plan text start end context)
  (part-context-literal-end (part-plan-context plan context) text start end))
(def (part-context-literal-end bucket text start end)
  (let loop ((offset (+ start 1)))
    (if (or (= offset end) (part-context-match bucket text offset end))
      offset (loop (+ offset 1)))))
(def (part-plan-name-end step text start end)
  (if (>= start end) start
    (let (first (string-ref text start))
      (if (or (char-numeric? first) (memv first (part-step-singles step)))
        (+ start 1)
        (let loop ((offset start))
          (if (and (< offset end)
                   (let (character (string-ref text offset))
                     (or (char-alphabetic? character) (char-numeric? character) (char=? character #\_))))
            (loop (+ offset 1)) offset))))))
(defsyntax (defpart-profile stx)
  (syntax-case stx (contexts rules literal)
    ((_ (name marker self base) (contexts context ...) (rules rule ...) (literal kind))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) contexts: '(context ...) rules: '(rule ...) literal: 'kind)))
    ((_ (name marker self base) (rules rule ...))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) rules: '(rule ...))))
    ((_ (name marker self base) (literal kind))
     (and (identifier? #'name) (identifier? #'self) (eq? (syntax->datum #'marker) '::))
     #'(def name (.o (:: self base) literal: 'kind)))))
