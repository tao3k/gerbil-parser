;;; Static admission coverage, not executed counts or a throughput result.
(import (only-in :gerbil-parser/src/compiler/event-fold-ordinary-run fold-ordinary-run-plan)
        (only-in :gerbil-parser/src/compiler/event-fold-zero-state fold-zero-state-plan)
        (only-in :gerbil-parser/src/compiler/event-fold-byte-dispatch fold-byte-regions)
        (only-in :gerbil-parser/src/compiler/event-fold-analysis fold-eliminate-inert-branches))
(export main)

(def (main path)
  (let ((seen (make-table test: equal?)) (loops 0) (eligible 0))
    (def (walk value)
      (when (pair? value)
        (when (eq? (car value) 'for-line-bytes)
          (set! loops (+ loops 1))
          (let (plan (fold-ordinary-run-plan (list-ref value 4) (cadr value)))
            (when (and (not plan) (eq? (cadr value) 'inline-byte-index))
              (let* ((idle (fold-zero-state-plan (list-ref value 4) #t))
                     (regions (fold-byte-regions (if idle (vector-ref idle 1) (list-ref value 4))
                                                (cadr value)))
                     (common (and regions (fold-eliminate-inert-branches (vector-ref regions 1) (cadr value)))))
                (unless (table-ref seen common #f)
                  (table-set! seen common #t)
                  (write (list 'inline-run-rejection common)) (newline))))
            (when plan
              (set! eligible (+ eligible 1))
              (let (row (list (cadr value) (length (vector-ref plan 0))
                             (length (vector-ref plan 1)) (vector-ref plan 2)
                             (map cadr (vector-ref plan 3))))
                (unless (table-ref seen row #f)
                  (table-set! seen row #t) (write (cons 'run-admission row)) (newline))))))
        (for-each walk value)))
    (walk (call-with-input-file path read))
    (write (list 'static-run-coverage loops eligible)) (newline)))
