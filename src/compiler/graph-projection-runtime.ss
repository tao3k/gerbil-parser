;;; -*- Gerbil -*-
;;; Checked POO graph rules to an immutable syntax projection table.

(import (only-in ../language/descriptor
                 language-grammar-ir language-grammar-machine)
        (only-in ../runtime/identity sha256-text)
        (only-in ../runtime/machine parser-machine-grammar-digest)
        (only-in ../graph/graph-projection-objects
                 graph-projection? graph-projection-nodes
                 graph-node-syntax-kind graph-node-category graph-node-label
                 graph-node-fields graph-field-token graph-field-name
                 graph-field-mode))
(export graph-projection-digest graph-projection-runtime-source
        generate-graph-projection-runtime-module
        graph-projection-ordinal-rules)

(def (graph-projection-ordinal-rules grammar projection)
  (unless (graph-projection? projection)
    (error "graph projection requires a checked POO value" projection))
  (def kinds (cdr (assq 'syntax-kinds (language-grammar-ir grammar))))
  (def indices (make-hash-table-eq size: (length kinds)))
  (let index ((kinds kinds) (ordinal 0))
    (unless (null? kinds)
      (hash-put! indices (caar kinds) (cons ordinal (cadar kinds)))
      (index (cdr kinds) (+ ordinal 1))))
  (def (resolve name category)
    (let (entry (hash-get indices name))
      (unless entry (error "unknown graph projection syntax kind" name category))
      (unless (eq? (cdr entry) category)
        (error "graph projection kind has wrong category" name category))
      (car entry)))
  (values
   (length kinds)
   (map (lambda (node)
          (list (resolve (graph-node-syntax-kind node) 'node)
                (graph-node-category node)
                (graph-node-label node)
                (map (lambda (field)
                       (let (mode (graph-field-mode field))
                         (list (resolve (graph-field-token field)
                                        (if (memq mode '(node-text each-node-text)) 'node 'token))
                               (graph-field-name field)
                               mode)))
                     (graph-node-fields node))))
        (graph-projection-nodes projection))))

(def (projection-fingerprint grammar-digest nodes)
  (sha256-text
   (call-with-output-string
    (lambda (port)
      (write
       (list 'gerbil-parser-graph-projection-v2 grammar-digest
             (map (lambda (node)
                    (list (graph-node-syntax-kind node)
                          (graph-node-category node)
                          (graph-node-label node)
                          (map (lambda (field)
                                 (list (graph-field-token field)
                                       (graph-field-name field)
                                       (graph-field-mode field)))
                               (graph-node-fields node))))
                  nodes))
       port)))))

(def (graph-projection-digest language-grammar projection)
  (unless (graph-projection? projection)
    (error "graph projection digest requires a checked POO value" projection))
  (projection-fingerprint
   (parser-machine-grammar-digest
    (language-grammar-machine language-grammar))
   (graph-projection-nodes projection)))

(def (graph-projection-runtime-source language-grammar projection)
  (unless (graph-projection? projection)
    (error "graph projection AOT requires a checked POO value" projection))
  (let-values (((_ nodes) (graph-projection-ordinal-rules language-grammar projection)))
    (def digest (parser-machine-grammar-digest (language-grammar-machine language-grammar)))
    (def projection-digest (graph-projection-digest language-grammar projection))
    (call-with-output-string
     (lambda (port)
       (display "// @generated by gerbil-parser/src/compiler/graph-projection-runtime.ss\n" port)
       (display "use gerbil_parser_runtime::{GraphFieldMode, GraphFieldRule, GraphNodeRule, GraphProjectionSpec};\n\n" port)
       (display "pub static GRAPH: GraphProjectionSpec = GraphProjectionSpec {\n" port)
       (display "    grammar_digest: " port)
       (write digest port)
       (display ",\n    projection_digest: " port)
       (write projection-digest port)
       (display ",\n    rules: &[\n" port)
       (for-each
        (lambda (node)
          (display "        GraphNodeRule { syntax_kind: " port)
          (display (car node) port)
          (display ", category: " port)
          (write (cadr node) port)
          (display ", kind: " port)
          (write (caddr node) port)
          (display ", fields: &[" port)
          (for-each
           (lambda (field)
             (display "GraphFieldRule { token_kind: " port)
             (display (car field) port)
             (display ", name: " port)
             (write (cadr field) port)
             (display ", mode: GraphFieldMode::" port)
             (display (case (caddr field)
                        ((each) "Each")
                        ((append-or-empty) "AppendOrEmpty")
                        ((node-text) "NodeText")
                        ((each-node-text) "EachNodeText")
                        (else "Append")) port)
             (display " }, " port))
           (cadddr node))
          (display "] },\n" port))
        nodes)
       (display "    ],\n};\n" port)))))

(def (generate-graph-projection-runtime-module output-path language-grammar projection)
  (let (source (graph-projection-runtime-source language-grammar projection))
    (call-with-output-file output-path
      (lambda (port) (display source port)))))
