;;; Native source controls complement the unbounded Lean correspondence proofs.
(import :gerbil-parser/language-test-support
        (prefix-in :std/struct/queue stdq-)
        :std/io/tempfile
        (only-in :std/misc/ports read-all-as-string)
        (only-in :gerbil-parser/t/fixtures/event-walk-source read-source-definition write-event-walk-source-data)
        (only-in :gerbil-parser/src/compiler/lr production-precedence union-values)
        (only-in :gerbil-parser/src/compiler/funcs compiler-index-set-add compiler-index-set-for-each))

(def (source-procedure path name extras)
  (let (declaration (read-source-definition path name))
    (eval (cons 'lambda (cons (append (cdr (cadr declaration)) extras) (cddr declaration))))))
(def (rejected? thunk)
  (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (native-conflicts)
  (let* ((path "src/compiler/lr-compiler.ss")
         (dynamic (source-procedure path 'dynamic-precedence? '()))
         (fork-source (source-procedure path 'fork-action '(union-values)))
         (fork (lambda (left right) (fork-source left right union-values)))
         (unresolved-source (source-procedure path 'fork-or-reject '(fork-action)))
         (unresolved (lambda args (apply unresolved-source (append args (list fork)))))
         (sr-source (source-procedure path 'resolve-shift-reduce '(production-precedence dynamic-precedence? fork-or-reject)))
         (rr-source (source-procedure path 'resolve-reduce-reduce '(production-precedence dynamic-precedence? fork-or-reject fork-action))))
    (list (lambda args (apply sr-source (append args (list production-precedence dynamic unresolved))))
          (lambda args (apply rr-source (append args (list production-precedence dynamic unresolved fork)))) fork)))
(def (native-dispatch)
  (let* ((resolvers (native-conflicts))
         (procedure (source-procedure "src/compiler/lr-compiler.ss" 'resolve-action
                      '(fork-action resolve-shift-reduce resolve-reduce-reduce))))
    (lambda (current incoming table policy)
      (procedure 0 '(terminal token word) current incoming table policy
                 (caddr resolvers) (car resolvers) (cadr resolvers)))))

(def (conflict-observation thunk)
  (with-catch (lambda (_) 'failed) thunk))
(def (unresolved-result policy left right)
  (if (memq policy '(selective-glr probe)) (list 'fork left right) 'failed))
(def (sr-reference shift-priority reduce-priority policy)
  (let ((shift (list 'shift 0 shift-priority)) (reduce '(reduce 1)))
    (if (or (not shift-priority) (not reduce-priority)
            (eq? (car shift-priority) 'dynamic) (eq? (car reduce-priority) 'dynamic))
      (unresolved-result policy shift reduce)
      (let (difference (- (cadr reduce-priority) (cadr shift-priority)))
        (cond ((positive? difference) reduce) ((negative? difference) shift)
              (else (case (car reduce-priority) ((left) reduce) ((right) shift)
                      ((none) (list 'reject-nonassoc '(terminal token word) (cadr reduce-priority)))
                      (else 'failed))))))))
(def (rr-reference left-priority right-priority policy)
  (let ((left '(reduce 0)) (right '(reduce 1)))
    (if (or (and left-priority (eq? (car left-priority) 'dynamic))
            (and right-priority (eq? (car right-priority) 'dynamic)))
      (unresolved-result policy left right)
      (let (difference (- (if left-priority (cadr left-priority) 0)
                         (if right-priority (cadr right-priority) 0)))
        (cond ((positive? difference) left) ((negative? difference) right)
              (else (unresolved-result policy left right)))))))
(def (native-validator)
  (let* ((path "src/compiler/lr-table.ss")
         (bounded (source-procedure path 'bounded-index? '()))
         (precedence (source-procedure path 'precedence? '()))
         (factory (source-procedure path 'make-action-validator '(bounded-index? precedence? +lr-eof+))))
    (lambda (states productions layout?) (factory states productions layout? bounded precedence '(terminal eof)))))
(def (visit-items-observation owners symbols terminals targets table masks items start)
  (let* ((declaration (read-source-definition "src/compiler/lr-compiler.ss" 'build-actions))
         (walk (foldl (lambda (index form) (list-ref form index)) declaration '(2 4 2 3 4)))
         (procedure
           (eval (list 'lambda
                   '(core-item-production-id layout core-symbols core-terminal-ids shift-targets table
                     state-id lookaheads install! compiler-index-set-for-each production-precedence state-items initial-node)
                   (list 'let '((processed-items 0) (lookahead-node initial-node))
                     walk '(list processed-items lookahead-node)))))
         (events '())
         (counters (procedure (lambda (item ignored) (vector-ref owners item)) #f symbols terminals targets table
                     0 masks (lambda (key action) (set! events (cons (cons key action) events)))
                     compiler-index-set-for-each production-precedence items start)))
    (list (reverse events) counters)))
(def (event-observation production kind terminal target keys)
  (let (mask (if keys (foldl (lambda (key mask) (compiler-index-set-add mask key)) 0 keys) 0))
    (visit-items-observation (vector production)
      (vector (case kind ((shift) '(terminal token word)) ((nonterminal) '(nonterminal root)) (else #f)))
      (vector (and (eq? kind 'shift) terminal)) (make-vector (+ terminal 1) target)
      (make-vector (+ production 1) (list production 'root '() 'concat '(left 7)))
      (if keys (vector mask) '#()) '(0) 0)))
(def (generation-preserves-input?)
  (let* ((path (make-temporary-file-name "parser-source-generation-"))
         (declaration (read-source-definition "t/generate-walk-source-witness.ss" 'main))
         (factory (eval (list 'lambda
                         '(read-event-walk-source write-event-walk-source-data event-walk-data-current?)
                         declaration 'main)))
         (generate (factory (lambda ignored '(#\x)) write-event-walk-source-data (lambda ignored #f))))
    (try
      (call-with-output-file path (lambda (port) (write-string "retained proof input" port)))
      (and (rejected? (lambda () (generate "module" path)))
           (equal? (call-with-input-file path read-all-as-string) "retained proof input"))
      (finally (when (file-exists? path) (delete-file path))))))

(def (queue-observation actions gotos)
  (let* ((definitions (map (lambda (name) (read-source-definition "src/compiler/lr-table.ss" name))
                          '(for-each-shift-target accepting-action? validate-accept-reachability)))
         (factory (eval (append '(lambda (stdq-make-Queue stdq-enqueue! stdq-dequeue! stdq-queue-empty?))
                                definitions '(validate-accept-reachability))))
         (enqueued '()) (dequeued '())
         (validate (factory stdq-make-Queue
                     (lambda (queue node) (set! enqueued (cons node enqueued)) (stdq-enqueue! queue node))
                     (lambda (queue) (let (node (stdq-dequeue! queue)) (set! dequeued (cons node dequeued)) node))
                     stdq-queue-empty?))
         (result (with-catch (lambda (_) 'rejected) (lambda () (validate actions gotos) 'accepted))))
    (list result (reverse enqueued) (reverse dequeued))))
(def (queue-fixtures)
  (list
    (list '#((((terminal token word) shift 1 #f)) (((terminal token word) shift 0 #f))) '#(() ()) '(rejected (0 1) (0 1)))
    (list '#((((terminal token word) shift 1 #f)) (((terminal token word) shift 0 #f)) (((terminal eof) accept)))
          '#(() () ()) '(rejected (0 1) (0 1)))
    (list '#((((terminal eof) accept) ((terminal token word) shift 2 #f)) () ()) '#(((root . 1)) () ())
          '(accepted (0 2 1) (0)))
    (list '#((((terminal token word) shift 2 #f)) (((terminal eof) accept)) (((terminal token word) shift 0 #f)))
          '#(((root . 2)) () ((root . 1))) '(accepted (0 2 1) (0 2 1)))
    (list '#((((terminal token word) layout-guard (shift 1 #f) (fork (reduce 0) (reduce 0)))) (((terminal eof) accept)))
          '#(((root . 0)) ()) '(accepted (0 1) (0 1)))
    (list '#((((terminal eof) accept) ((terminal token word) shift 1 #f))) '#(()) '(rejected (0) (0)))))
(def (install-observation events layout? policy)
  (let* ((declaration (read-source-definition "src/compiler/lr-compiler.ss" 'build-actions))
         (install (foldl (lambda (index form) (list-ref form index)) declaration '(2 4 2 3 2)))
         (factory (eval (list 'lambda
                         '(state-actions raw-reductions terminal-values layout? resolve-action/diagnosed table
                           conflict-policy reject-conflict state-items state-id events)
                         (list 'let '((terminal-order '()) (failed? #f)) install
                           '(with-catch (lambda (_) (set! failed? #t))
                              (lambda () (for-each (lambda (entry) (install! (car entry) (cdr entry))) events)))
                           '(list state-actions raw-reductions (reverse terminal-order) failed?)))))
         (dispatch (native-dispatch)))
    (factory (make-vector 2 #f) (make-vector 2 '()) '#((terminal token left) (terminal token right)) layout?
      (lambda (state terminal current incoming table policy reject items) (dispatch current incoming table policy))
      '#((0 root () concat #f) (1 root () concat #f) (2 root () concat #f)) policy #f '() 0 events)))

(deflanguage-parser-tests lr-native-source-test "native LR extraction conflict and validator correspondence"
  (engine)
  (matrix "all signed priority and policy branches match the decision model"
    (setup (resolvers (native-conflicts)))
    ((left '(#f (none -2) (left 0) (right 0) (dynamic 5) (left 9)))
     (right '(#f (none -2) (left 0) (right 0) (dynamic 5) (left 9)))
     (policy '(reject selective-glr probe)))
    (bindings (table (vector (list 0 'root '() 'concat left) (list 1 'root '() 'concat right))))
    (equal (conflict-observation (lambda () ((car resolvers) '(terminal token word) (list 'shift 0 left) '(reduce 1) table policy)))
           (sr-reference left right policy))
    (equal (conflict-observation (lambda () ((cadr resolvers) '(terminal token word) '(reduce 0) '(reduce 1) table policy)))
           (rr-reference left right policy)))
  (matrix "outer dispatcher preserves same-target priority and branch order"
    (setup (dispatch (native-dispatch)))
    ((left '(#f (left -9) (right 0) (dynamic 7))) (right '(#f (none -9) (left 0) (dynamic 7))))
    (bindings (old (list 'shift 0 left)) (new (list 'shift 0 right))
              (table '#())
              (expected (if (and left (or (not right) (>= (cadr left) (cadr right)))) old new)))
    (equal (dispatch old new table 'reject) expected)
    (equal (dispatch '(reject-nonassoc (terminal token word) 0) '(fork (reduce 1) (reduce 2)) table 'probe)
           '(fork (reject-nonassoc (terminal token word) 0) (reduce 1) (reduce 2)))
    (equal (dispatch '(reject-nonassoc (terminal token word) 0) '(reduce 1) table 'reject)
           '(reject-nonassoc (terminal token word) 0)))
  (property "native fork union preserves left duplicates and first observation order"
    (bindings (fork (caddr (native-conflicts))))
    (equal (fork '(fork (reduce 1) (reduce 1)) '(fork (reduce 1) (reduce 2)))
           '(fork (reduce 1) (reduce 1) (reduce 2)))
    (equal (fork '(shift 0 #f) '(fork (reduce 1) (shift 0 #f))) '(fork (shift 0 #f) (reduce 1))))
  (matrix "closed validator admits only the permitted atom and wrapper shapes"
    (setup (factory (native-validator)))
    ((layout? '(#f #t)))
    (bindings (validate (factory 2 3 layout?)))
    (equal (map (lambda (action) (validate action '(terminal token word)))
                '((shift 0 #f) (shift 2 #f) (shift -1 #f) (reduce 2) (reduce 3) (reduce -1)
                  (shift 1 (left -1000000000000000000000)) (shift 1 (unknown 1))
                  (fork (shift 0 #f) (reduce 1)) (fork (reduce 1))
                  (fork (shift 0 #f) (fork (reduce 1) (reduce 2)))
                  (accept) (reject-nonassoc (terminal token word) -3)
                  (reject-nonassoc (terminal eof) 1)
                  (shift 1 (left 1.0)) (shift 1.0 #f) (reduce 1.0)
                  (reject-nonassoc (terminal token word) 1.0)))
           '(#t #f #f #t #f #f #t #f #t #f #f #f #t #f #t #f #f #t))
    (equal (validate '(layout-guard (shift 0 #f) (fork (reduce 1) (reduce 2))) '(terminal token word)) layout?)
    (equal (validate '(layout-guard (shift 0 #f) (fork (reduce 1))) '(terminal token word)) #f)
    (equal (validate '(layout-guard (shift 0 #f) (shift 1 #f)) '(terminal token word)) #f)
    (equal (validate '(accept) '(terminal eof)) #t))
  (matrix "actual item lambda preserves terminal zero and wide lookahead bits"
    (setup)
    ((terminal '(0 3)) (keys '(() (0) (0 3 65 129))))
    (bindings)
    (equal (event-observation 2 'shift terminal 0 keys) (list (list (list terminal 'shift 0 '(left 7))) '(1 1)))
    (equal (event-observation 2 'nonterminal terminal #f keys) '(() (1 1)))
    (equal (car (event-observation 0 'complete terminal #f keys)) (map (lambda (key) (cons key '(accept))) keys))
    (equal (car (event-observation 2 'complete terminal #f keys)) (map (lambda (key) (cons key '(reduce 2))) keys)))
  (property "missing shift transition fails before event installation"
    (bindings)
    (equal (rejected? (lambda () (event-observation 2 'shift 0 #f '(0 65)))) #t))
  (property "failed generation preserves previous input and keywords stay distinct"
    (bindings (keyword-data (call-with-output-string (lambda (port) (write-event-walk-source-data '(test:) port))))
              (symbol-data (call-with-output-string (lambda (port) (write-event-walk-source-data '(test) port)))))
    (equal (equal? keyword-data symbol-data) #f)
    (equal (generation-preserves-input?) #t))
  (property "shift and incomplete nonterminal never read a lookahead mask"
    (bindings)
    (equal (event-observation 2 'shift 0 0 #f) '(((0 shift 0 (left 7))) (1 1)))
    (equal (event-observation 2 'nonterminal 0 #f #f) '(() (1 1)))
    (equal (rejected? (lambda () (event-observation 2 'complete 0 #f #f))) #t))
  (matrix "actual outer validator queue uses original IDs and mark-before-enqueue"
    (setup)
    ((fixture (queue-fixtures)))
    (bindings)
    (equal (queue-observation (car fixture) (cadr fixture)) (caddr fixture)))
  (property "actual mutable resolver replay preserves raw reductions and first touch"
    (bindings (observed (install-observation
               '((0 shift 0 #f) (1 reduce 2) (0 reduce 1) (1 reduce 1) (0 reduce 1)) #t 'probe)))
    (equal (car observed) '#((fork (shift 0 #f) (reduce 1)) (fork (reduce 2) (reduce 1))))
    (equal (cadr observed) '#(((reduce 1) (reduce 1)) ((reduce 1) (reduce 2))))
    (equal (caddr observed) '(0 1))
    (equal (cadddr observed) #f))
  (property "actual resolver failure retains earlier reduction write and blocks later events"
    (bindings (observed (install-observation '((0 shift 0 #f) (0 reduce 1) (1 reduce 2)) #t 'reject)))
    (equal (car observed) '#((shift 0 #f) #f))
    (equal (cadr observed) '#(((reduce 1)) ()))
    (equal (caddr observed) '(0))
    (equal (cadddr observed) #t))
  (property "whole item traversal reads masks by ordinal after branch-skipped entries"
    (bindings (mask (foldl (lambda (key mask) (compiler-index-set-add mask key)) 0 '(65 129))))
    (equal (visit-items-observation '#(1 0 0 2 0 0 0 0 3)
             '#((terminal token word) #f #f (nonterminal root) #f #f #f #f #f)
             '#(0 #f #f #f #f #f #f #f #f) '#(0)
             '#((0 root () concat #f) (1 root () concat (left 7)) (2 root () concat #f) (3 root () concat #f))
             (vector #f #f #f #f #f #f #f mask) '(0 3 8) 5)
           '(((0 shift 0 (left 7)) (65 reduce 3) (129 reduce 3)) (3 8)))))
