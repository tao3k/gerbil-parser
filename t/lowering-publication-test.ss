(import :gerbil-parser/language-test-support
        (only-in :gerbil-parser/t/fixtures/event-walk-source read-source-definition read-source-subdefinition)
        (only-in :gerbil-parser/t/fixtures/lr1-construction native-fact-rules)
        (only-in :gerbil-parser/src/testing/source-witness parser-source-symbol-text)
        (only-in :gerbil-parser/src/compiler/lr lower-rules production-id production-rhs))

;;; Execute the complete source emitter in its real lexical counter/list scope.
;;; Only callbacks and inspection are supplied; no emitter instructions are copied.
(def (make-source-emitter origin proof)
  ((eval
     (list 'lambda '(observe-origin observe-proof)
       (list 'let '((next-id 1) (productions '()))
         (read-source-definition "src/compiler/lr.ss" 'make-production)
         (read-source-subdefinition "src/compiler/lr.ss" 'lower-rules 'emit-production)
         '(values emit-production (lambda () (list next-id (reverse productions)))))))
   origin proof))

;;; Execute both actual nested declarations in one lexical allocation scope.
(def (make-source-names initial reserved)
  ((eval
    (list 'lambda '(initial reserved)
      (list 'let '((next-synthetic initial) (used-names (make-table test: eq?)))
        (read-source-subdefinition "src/compiler/lr.ss" 'lower-rules 'claim-name)
        (read-source-subdefinition "src/compiler/lr.ss" 'lower-rules 'fresh)
        '(for-each (lambda (name) (claim-name name)) reserved)
        '(values (lambda () (fresh 'left)) (lambda () (fresh 'right))
           claim-name (lambda () next-synthetic))))) initial reserved))

(def (candidate-name owner index)
  (string->symbol (string-append "$" (symbol->string owner) "." (number->string index))))

;;; Retain the real root initializer, full procedure scope and reservation
;;; prefix. Entry closures execute the original authored pass and finalizer.
(def (make-source-root rules root)
  (let* ((scope (caddr (read-source-definition "src/compiler/lr.ss" 'lower-rules)))
         (body (cddr scope)) (count (length body)))
    ((eval (list 'lambda '(rules root allow-dynamic? observe-origin observe-proof declare-name)
       (append (list 'let (cadr scope))
         (map (lambda (name) (read-source-definition "src/compiler/lr.ss" name))
              '(make-production marked-symbol? operand-add-action))
         (take body (- count 2))
         (list (list 'values 'fresh 'emit-production
           (list 'lambda '() (list-ref body (- count 2)))
           (list 'lambda '() (last body))
           '(lambda () (list next-id next-synthetic (reverse productions)
                        (eq? used-names rule-counts) used-names rule-counts))))))) rules root #t #f #f #f)))

(defparser-check (source-root-case rules)
  (scope-values (((_fresh _emit dispatch finish inspect) (make-source-root rules 'start)))
    (equal (take (inspect) 4) '(1 0 () #f))
    (act (dispatch))
    (scope ((before (inspect)) (rows (finish)))
      (equal rows (lower-rules rules 'start #t))
      (equal (car before) (length rows))
      (equal (map production-id rows) (iota (length rows)))
      (each (pair) ((map cons (caddr before) (cdr rows)))
        (equal (eq? (car pair) (cdr pair)) #t)))))

(def (make-source-name-index names)
  ((eval (list 'lambda '(names)
     (list 'let '()
       (read-source-subdefinition "t/fixtures/lr1-construction.ss" 'origin-data 'name-id)
       'name-id))) names))

(defparser-check (source-name-index-case count reversed?)
  (sequential ((input (map (lambda (index) (list-ref '(a b 名称) (modulo index 3))) (iota count)))
               (names (if reversed? (reverse input) input))
               (encode (make-source-name-index names)))
    (each (name) (names)
      (equal (encode name)
        (car (filter (lambda (index) (eq? name (list-ref names index))) (iota count)))))
    (raises (encode 'absent) true)))

(defparser-check (captured-name-case initial collisions)
  (scope ((reserved (map (lambda (offset) (candidate-name 'left (+ initial offset))) (iota collisions))))
    (scope-values (((left right claim inspect) (make-source-names initial reserved))
                   ((independent-left _right _claim independent-inspect) (make-source-names initial '())))
      (equal (inspect) initial)
      (scope ((next-synthetic -100))
        (equal (left) (candidate-name 'left (+ initial collisions)))
        (equal next-synthetic -100))
      (equal (inspect) (+ initial collisions 1))
      (equal (right) (candidate-name 'right (+ initial collisions 1)))
      (equal (left) (candidate-name 'left (+ initial collisions 2)))
      (equal (inspect) (+ initial collisions 3))
      (equal (claim (candidate-name 'left (+ initial collisions))) #f)
      (equal (claim 'extra-reserved) 'extra-reserved)
      (equal (claim 'extra-reserved) #f)
      (equal (inspect) (+ initial collisions 3))
      (equal (independent-inspect) initial)
      (equal (independent-left) (candidate-name 'left initial))
      (equal (independent-inspect) (+ initial 1)))))

(defparser-check (publication-observer-case origin? proof?)
  (scope ((inspect #f) (observed '()))
    (scope-values (((emit snapshot)
      (make-source-emitter
        (and origin? (parser-check-procedure (parser-check (production owner path expression)
          (equal (production-id production) (car (inspect)))
          (equal (length (cadr (inspect))) (- (car (inspect)) 1))
          (equal owner 'start) (equal path '(0)) (equal expression '(empty))
          (act (set! observed (cons (cons 'origin production) observed))))))
        (and proof? (parser-check-procedure (parser-check (kind production recipe)
          (equal kind 'production) (equal recipe '(identity ()))
          (equal (production-id production) (car (inspect)))
          (equal (length (cadr (inspect))) (- (car (inspect)) 1))
          (act (set! observed (cons (cons 'proof production) observed)))))))))
      (act (set! inspect snapshot))
      (each (index) ((iota 8))
        (act (emit 'start '() 'concat #f 'start '(0) '(empty) '(identity ()))))
      (equal (car (inspect)) 9)
      (equal (map production-id (cadr (inspect))) '(1 2 3 4 5 6 7 8))
      (each (entry) ((reverse observed))
        (equal (eq? (cdr entry) (list-ref (cadr (inspect)) (- (production-id (cdr entry)) 1))) #t))
      (equal (map car (reverse observed))
        (apply append (map (lambda (_) (append (if origin? '(origin) '()) (if proof? '(proof) '()))) (iota 8)))))))

(defparser-check (publication-failure-case stage fail-at)
  (scope ((failure (list 'publication-failure)) (events '()))
    (scope-values (((emit inspect)
      (make-source-emitter
        (lambda (production _owner _path _expression)
          (set! events (cons (cons 'origin (production-id production)) events))
          (when (and (eq? stage 'origin) (= (production-id production) fail-at)) (raise failure)))
        (lambda (_kind production _recipe)
          (set! events (cons (cons 'proof (production-id production)) events))
          (when (and (eq? stage 'proof) (= (production-id production) fail-at)) (raise failure))))))
      (equal (with-catch (lambda (condition) (eq? condition failure))
               (lambda ()
                 (for-each (lambda (_) (emit 'start '() 'concat #f 'start '() '(empty) '(identity ()))) (iota 8))
                 #f)) #t)
      (equal (car (inspect)) fail-at)
      (equal (map production-id (cadr (inspect))) (cdr (iota fail-at)))
      (equal (car events) (cons stage fail-at))
      (equal (length events) (+ (* 2 (- fail-at 1)) (if (eq? stage 'origin) 1 2))))))

(defparser-check (branch-publication-case rules origin? proof?)
  (scope ((origins '()) (proofs '()))
    (scope ((rows (lower-rules rules 'start #t
      (and origin? (lambda (production _owner _path _expression) (set! origins (cons production origins))))
      (and proof? (lambda (kind production _recipe)
        (when (eq? kind 'production) (set! proofs (cons production proofs))))))))
      (equal rows (lower-rules rules 'start #t))
      (equal (map production-id rows) (iota (length rows)))
      (equal (map production-id (reverse origins)) (if origin? (cdr (iota (length rows))) '()))
      (equal (map production-id (reverse proofs)) (if proof? (cdr (iota (length rows))) '()))
      (each (production) ((append origins proofs))
        (equal (eq? production (list-ref rows (production-id production))) #t)))))

(defparser-check (source-emitter-interleave-case prefix-count width)
  (scope ((rules (list (list 'start (cons 'sequence
             (map (lambda (_) '(optional (literal "x"))) (iota width)))))))
    (scope-values (((fresh emit dispatch finish inspect) (make-source-root rules 'start)))
      (each (index) ((iota prefix-count))
        (equal (fresh 'prefix) (candidate-name 'prefix index))
        (scope ((next-id -100) (productions '(caller-owned)))
          (act (emit 'prefix '((terminal literal "prefix")) 'pass (list 'left index)
                 'prefix '() '(literal "prefix") #f))
          (equal next-id -100)
          (equal productions '(caller-owned))))
      (scope ((prefix (caddr (inspect))))
        (equal prefix
          (map (lambda (index) (list (+ index 1) 'prefix '((terminal literal "prefix"))
                                    'pass (list 'left index))) (iota prefix-count)))
        (act (dispatch))
        (scope ((snapshot (inspect)) (rows (finish))
                (helpers (map (lambda (index) (candidate-name 'start (+ prefix-count index))) (iota width))))
          (equal (car snapshot) (+ prefix-count (* 2 width) 2))
          (equal (cadr snapshot) (+ prefix-count width))
          (equal (take (caddr snapshot) prefix-count) prefix)
          (each (pair) ((map cons prefix (take (caddr snapshot) prefix-count)))
            (equal (eq? (car pair) (cdr pair)) #t))
          (equal rows
            (cons '(0 $accept ((nonterminal start)) pass #f)
              (append prefix
                (apply append (map (lambda (name index)
                  (list (list (+ prefix-count (* 2 index) 1) name '() 'concat #f)
                        (list (+ prefix-count (* 2 index) 2) name '((terminal literal "x")) 'pass #f)))
                  helpers (iota width)))
                (list (list (+ prefix-count (* 2 width) 1) 'start
                            (map (lambda (name) (list 'nonterminal name)) helpers) 'concat #f))))))))))

(deflanguage-parser-tests lowering-publication-test "source lowering publication protocol"
  (engine)
  (scenario "the complete source prefix separates reservations from authored counts"
    (scope ((rules '((start (sequence (reference $start.0) (token payload) (literal "$start.1")))
                    (start (field value (reference later))) (later (empty)))))
      (scope-values (((fresh _emit _dispatch _finish inspect) (make-source-root rules 'start)))
        (scope ((snapshot (inspect)))
          (equal (take snapshot 4) '(1 0 () #f))
          (equal (table-ref (list-ref snapshot 4) 'start #f) #t)
          (equal (table-ref (list-ref snapshot 4) '$start.0 #f) #t)
          (equal (table-ref (list-ref snapshot 4) 'later #f) #t)
          (equal (table-ref (list-ref snapshot 4) '$start.1 #f) #f)
          (equal (table-ref (list-ref snapshot 4) 'payload #f) #f)
          (equal (table-ref (list-ref snapshot 4) 'value #f) #f)
          (equal (table-ref (list-ref snapshot 5) 'start 0) 2)
          (equal (table-ref (list-ref snapshot 5) 'later 0) 1)
          (equal (table-ref (list-ref snapshot 5) '$start.0 0) 0)
          (equal (fresh 'start) '$start.1)
          (equal (take (inspect) 3) '(1 2 ()))))))
  (matrix "recursive dispatch preserves an existing emission prefix and independent name counter"
    (setup) ((prefix-count '(0 1 3 8)) (width '(0 1 2 8 16))) (bindings)
    (equal (parser-check-result source-emitter-interleave-case prefix-count width) (void)))
  (matrix "source name encoding retains first occurrences and rejects absent identities"
    (setup) ((count '(0 1 2 8 32)) (reversed? '(#f #t))) (bindings)
    (equal (parser-check-result source-name-index-case count reversed?) (void)))
  (scenario "equal printed uninterned symbols are distinct and never silently transported as text"
    (scope ((left (string->uninterned-symbol "same")) (right (string->uninterned-symbol "same")))
      (scope ((encode (make-source-name-index (list left right))))
        (equal (symbol->string left) (symbol->string right))
        (equal (encode left) 0)
        (equal (encode right) 1)
        (raises (parser-source-symbol-text left) true)
        (raises (parser-source-symbol-text right) true))))
  (matrix "the complete root scope executes reservation, recursive dispatch and final publication"
    (setup) ((rules native-fact-rules)) (bindings)
    (equal (parser-check-result source-root-case rules) (void)))
  (scenario "root name and production cells and tables have separate ownership"
    (scope-values (((fresh emit _dispatch _finish inspect) (make-source-root '() 'start)))
      (equal (fresh 'start) '$start.0)
      (equal (take (inspect) 4) '(1 1 () #f))
      (act (emit 'start '() 'concat #f 'start '() '(empty) '(identity ())))
      (equal (car (inspect)) 2)
      (equal (cadr (inspect)) 1)
      (equal (fresh 'start) '$start.1)
      (equal (map production-id (caddr (inspect))) '(1))
      (equal (cadr (inspect)) 2)))
  (matrix "source closures share the lexical counter across collision retries and isolate requests"
    (setup) ((initial '(0 4 31)) (collisions '(0 1 8 32))) (bindings)
    (equal (parser-check-result captured-name-case initial collisions) (void)))
  (matrix "callbacks observe the pre-commit counter and the same native objects"
    (setup) ((origin? '(#f #t)) (proof? '(#f #t))) (bindings)
    (equal (parser-check-result publication-observer-case origin? proof?) (void)))
  (matrix "callback failures preserve the committed prefix and stop subsequent effects"
    (setup) ((stage '(origin proof)) (fail-at '(1 3 8))) (bindings)
    (equal (parser-check-result publication-failure-case stage fail-at) (void)))
  (matrix "native recursive lowering branches share one ordered publication protocol"
    (setup)
    ((origin? '(#f #t)) (proof? '(#f #t))
     (rules (append native-fact-rules
       '(((start (choice (empty) (layout-end indent)
                     (sequence (token word) (literal "x") (reference next)
                       (field item (optional (alias Item (literal "a")))))
                     (repeat (literal "b")) (repeat1 (token word))
                     (precedence dynamic 1 (literal "c"))))
          (next (literal "n")))
         ((start (repeat (literal "a"))) (start (optional (literal "b")))
          ($start.0 (empty)) ($accept (literal "reserved")))))))
    (bindings)
    (equal (parser-check-result branch-publication-case rules origin? proof?) (void)))
  (scenario "nested lowering keeps a separate counter and publication owner"
    (scope ((nested '()))
      (scope-values (((emit inspect)
        (make-source-emitter
          (lambda (_production _owner _path _expression)
            (set! nested (cons (lower-rules '((inner (empty))) 'inner) nested))) #f)))
        (act (emit 'start '() 'concat #f 'start '() '(empty) '(identity ())))
        (act (emit 'start '() 'concat #f 'start '() '(empty) '(identity ())))
        (equal (car (inspect)) 3)
        (equal (map production-id (cadr (inspect))) '(1 2))
        (equal (map (lambda (rows) (map production-id rows)) nested) '((0 1) (0 1)))))))
