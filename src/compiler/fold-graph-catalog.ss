;;; Resolve the admitted graph declaration against the native Fold kind order.
(import (only-in ./graph-projection-runtime graph-projection-ordinal-rules))
(export fold-graph-catalog)
(def (fold-graph-catalog grammar projection)
  (defvalues (count declarations) (graph-projection-ordinal-rules grammar projection))
  (def rules (make-vector count #f))
  (let nodes ((rest declarations) (ordinal 0))
    (unless (null? rest)
      (let* ((node (car rest))
             (kind (car node))
             (inputs (make-vector count '()))
             (groups (make-hash-table-string))
             (group-count 0)
             (empty '()))
        (when (vector-ref rules kind)
          (error "repeated graph node" kind))
        (let fields ((remaining (cadddr node)) (index 0))
          (unless (null? remaining)
            (let* ((field (car remaining))
                   (input (car field))
                   (mode (caddr field))
                   (name (cadr field))
                   (group (or (hash-get groups name)
                              (begin0 group-count
                                (hash-put! groups name group-count)
                                (set! group-count (+ group-count 1)))))
                   (record (vector index group (and (memq mode '(each each-node-text)) #t))))
              (vector-set! inputs input (cons record (vector-ref inputs input)))
              (when (eq? mode 'append-or-empty) (set! empty (cons record empty)))
              (fields (cdr remaining) (+ index 1)))))
        (do ((i 0 (+ i 1))) ((>= i count))
          (vector-set! inputs i (reverse! (vector-ref inputs i))))
        (vector-set! rules kind (vector ordinal inputs (reverse! empty) group-count)))
      (nodes (cdr rest) (+ ordinal 1))))
  rules)
