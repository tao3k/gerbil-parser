;;; -*- Gerbil -*-
;;; Existing native process contract observes the existing native test harness.
(import (only-in :gerbil-parser/t/support/qualification/process
                 run-observed-process process-result-status process-result-reason process-result-output))
(export main)
(def (qualify command log expected)
  (let* ((result (run-observed-process command log timeout: 120 idle-timeout: 5 error-output?: #f))
         (output (utf8->string (process-result-output result))))
    (unless (and (= (process-result-status result) expected) (not (process-result-reason result)))
      (error "runtime organization process rejected" (process-result-status result) (process-result-reason result)))
    (if (zero? expected)
      (unless (and (string-contains output "\nOK\n")
                   (not (or (string-contains output "ERROR") (string-contains output "FAILED"))))
        (error "runtime organization harness did not pass"))
      (unless (string-contains output "\nFAILED\n") (error "failure control missing rejection")))))
(def (main)
  (let* ((environment (getenv "GERBIL_PATH"))
         (binary (path-expand "bin/runtime-organization-tests" environment)))
    (qualify (list binary) (path-expand "runtime-organization.log" environment) 0)
    (qualify (list binary "--failure-control")
             (path-expand "runtime-organization-failure.log" environment) 42)
    (displayln "RUNTIME-ORGANIZATION-OK")
    (force-output)))
