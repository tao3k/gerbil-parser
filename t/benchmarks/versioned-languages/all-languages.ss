#!/usr/bin/env gxi
;;; Per-entry warm complete ParseArtifact costs over every admitted corpus.
(import (only-in :clan/poo/object .ref)
        (only-in :gerbil-parser/language-support/development language-loader-fixtures)
        (only-in :gerbil-parser/language-support/fixture syntax-fixture-source)
        (only-in :gerbil-parser/src/runtime/artifact parse-artifact-success? parse-artifact-roundtrip)
        (only-in :gerbil-parser/languages/arithmetic/parser arithmetic-language)
        (only-in :gerbil-parser/languages/arithmetic/parser-test arithmetic-test-language)
        (only-in :gerbil-parser/languages/bash/parser bash-language)
        (only-in :gerbil-parser/languages/bash/parser-test bash-test-language)
        (only-in :gerbil-parser/languages/cypher/parser opencypher-language)
        (only-in :gerbil-parser/languages/cypher/parser-test opencypher-test-language)
        (only-in :gerbil-parser/languages/fhirpath/parser fhirpath-language)
        (only-in :gerbil-parser/languages/fhirpath/parser-test fhirpath-test-language)
        (only-in :gerbil-parser/languages/gql/parser gql-language)
        (only-in :gerbil-parser/languages/gql/parser-test gql-test-language)
        (only-in :gerbil-parser/languages/hcl/parser hcl-language)
        (only-in :gerbil-parser/languages/hcl/parser-test hcl-test-language)
        (only-in :gerbil-parser/languages/hl7/parser hl7-language)
        (only-in :gerbil-parser/languages/hl7/parser-test hl7-test-language)
        (only-in :gerbil-parser/languages/tla-plus/parser
                 tla-plus-core-language tla-plus-layout-language tla-plus-sany-candidate-language)
        (only-in :gerbil-parser/languages/tla-plus/parser-test
                 tla-plus-core-test-language tla-plus-layout-test-language tla-plus-sany-candidate-test-language))
(export main)
(def entries
  (list (list 'arithmetic arithmetic-language arithmetic-test-language)
        (list 'bash bash-language bash-test-language)
        (list 'opencypher opencypher-language opencypher-test-language)
        (list 'fhirpath fhirpath-language fhirpath-test-language)
        (list 'gql gql-language gql-test-language)
        (list 'hcl hcl-language hcl-test-language)
        (list 'hl7 hl7-language hl7-test-language)
        (list 'tla-plus-core tla-plus-core-language tla-plus-core-test-language)
        (list 'tla-plus-layout tla-plus-layout-language tla-plus-layout-test-language)
        (list 'tla-plus-sany-candidate tla-plus-sany-candidate-language tla-plus-sany-candidate-test-language)))
(def (parse-batch parse sources)
  (for-each (lambda (source)
              (let (artifact (parse source))
                (unless (and (parse-artifact-success? artifact)
                             (equal? (parse-artifact-roundtrip artifact) source))
                  (error "all-language benchmark failed semantic admission" source)))) sources))
(def (nearest-rank sorted percentile)
  (list-ref sorted (- (inexact->exact (ceiling (* percentile (length sorted)))) 1)))
(def (main . args)
  (unless (<= (length args) 2) (error "expected sample count and optional entry" args))
  (let* ((samples (if (null? args) 20 (string->number (car args))))
         (selected (if (and (pair? args) (pair? (cdr args)))
                     (let (row (assoc (string->symbol (cadr args)) entries))
                       (unless row (error "unknown all-language benchmark entry" (cadr args)))
                       [row])
                     entries)))
    (unless (and (integer? samples) (exact? samples) (positive? samples)) (error "expected positive sample count" args))
    (for-each
     (lambda (row)
       (let* ((entry (cadr row)) (parse (.ref entry '.parse))
              (sources (map syntax-fixture-source (language-loader-fixtures (caddr row) 'accepted))))
         (parse-batch parse sources)
         (let loop ((remaining samples) (times '()))
           (if (positive? remaining)
             (begin
               (##gc)
               (let (started (##current-time-point))
                 (parse-batch parse sources)
                 (let (elapsed (* 1000.0 (- (##current-time-point) started)))
                   (write (list 'sample (car row) (- samples remaining) elapsed))
                   (newline) (force-output)
                   (loop (- remaining 1) (cons elapsed times)))))
             (let (sorted (list-sort < times))
               (write (list (cons 'schema "gerbil-parser.all-language-batch.v1")
                            (cons 'entry (car row)) (cons 'metadata (.ref (.ref entry 'metadata) 'digest))
                            (cons 'phase 'warm-parse-and-roundtrip)
                            (cons 'fixture-count (length sources))
                            (cons 'source-characters (apply + (map string-length sources)))
                            (cons 'sample-count samples) (cons 'quantile 'nearest-rank)
                            (cons 'p50-ms (nearest-rank sorted 0.50))
                            (cons 'p95-ms (nearest-rank sorted 0.95))))
               (newline) (force-output)))))) selected)
    (exit 0)))
