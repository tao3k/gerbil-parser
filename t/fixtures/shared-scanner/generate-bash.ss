#!/usr/bin/env gxi
;;; Rust controls come from execution of the admitted production Scheme profile.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!)
        "bash"
 (only-in :gerbil-parser/src/compiler/rust-scanner rust-scanner-module-source)
 (only-in :gerbil-parser/src/runtime/contextual-scanner prepare-contextual-scanner contextual-scanner-initial-state contextual-scanner-step)
 (only-in :gerbil-parser/src/runtime/token token-kind token-start token-end))
(def (scan scanner)
 (let loop ((state (contextual-scanner-initial-state scanner)) (tokens '()))
  (let-values (((token next) (contextual-scanner-step scanner state 'source)))
   (if token (loop next (cons token tokens)) (reverse tokens)))))
(def (main output)
 (let ((accepted '()) (rejected '()))
  (for-each (lambda (source)
   (displayln "BASH-SCANNER-CONTROL " (object->string source)) (force-output)
   (with-catch (lambda (_) (set! rejected (cons source rejected)))
    (lambda () (set! accepted (cons (cons source
     (scan (prepare-contextual-scanner bash-scanner-ir source))) accepted)))))
   bash-scanner-sources)
  (call-with-output-file output (lambda (port)
   (display (rust-scanner-module-source bash-scanner-ir) port)
   (display "pub static TRACES: &[(&str, &[gerbil_parser_rowan::ScannedToken])] = &[\n" port)
   (for-each (lambda (trace)
    (display "(" port) (write (car trace) port) (display ", &[" port)
    (for-each (lambda (token)
     (display "gerbil_parser_rowan::ScannedToken { terminal: " port)
     (write (symbol->string (token-kind token)) port)
     (display ", start: " port) (display (token-start token) port)
     (display ", end: " port) (display (token-end token) port) (display " }," port)) (cdr trace))
    (display "]),\n" port)) (reverse accepted))
   (display "];\npub static REJECTED: &[&str] = &[" port)
   (for-each (lambda (source) (write source port) (display "," port)) (reverse rejected))
   (display "];\n" port)))
  (displayln "BASH-SCANNER-RUST-GENERATED accepted=" (length accepted) " rejected=" (length rejected))
  (force-output) (test-child-process-exit! 0)))
