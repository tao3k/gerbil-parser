;;; Run inside the installed gsc, whose c# procedures are the actual compiler.
;;; This control does not copy the cache producer into a second implementation.
(define (compiler-reservation-check condition message)
  (if (not condition) (error message)))

(let ((saved-cache c#targ-fp-cache)
      (saved-reserved c#targ-proc-heap-reserved)
      (saved-flo c#targ-proc-flo-reserved))
  (dynamic-wind
    (lambda () #f)
    (lambda ()
      (compiler-reservation-check
       (equal? (list c#targ-min-word-size c#targ-header-words
                     c#targ-flonum-space c#targ-msection-fudge) '(4 2 6 4096))
       "unqualified compiler reservation metadata")
      (c#targ-fp-cache-init)
      (set! c#targ-proc-heap-reserved 0)
      (set! c#targ-proc-flo-reserved 0)
      (c#targ-heap-reserve 6 #t)
      (c#targ-heap-reserve 5 #f)
      (c#targ-heap-reserve-and-check 6 #t 0)
      (compiler-reservation-check
       (and (= c#targ-proc-heap-reserved 17) (= c#targ-proc-flo-reserved 12))
       "actual reserve counters disagree")
      (c#targ-fp-cache-init)
      (let ((checks 0))
        (define (verify-cache)
          (let* ((slots (vector-ref c#targ-fp-cache 1))
                 (capacity (vector-length slots))
                 (reported (c#targ-fp-cache-size)))
            (let scan ((index 0) (occupied 0) (dirty 0))
              (if (= index capacity)
                (begin
                  (compiler-reservation-check
                   (and (= (+ capacity 1) (* 2 reported))
                        (<= dirty occupied) (<= occupied capacity)
                        (<= (* dirty 2) (* reported c#targ-flonum-space)))
                   "actual cache shape or qualified payload bound disagrees")
                  (set! checks (+ checks 1)))
                (let ((entry (vector-ref slots index)))
                  (scan (+ index 1) (+ occupied (if entry 1 0))
                        (+ dirty (if (and entry (vector-ref entry 1)) 1 0))))))))
        (let enter ((index 1))
          (if (<= index 2047)
            (begin
              (c#targ-fp-cache-enter (c#make-stk index) #t)
              (if (or (<= index 127) (memv index '(128 256 512 1024 2047)))
                  (verify-cache))
              (enter (+ index 1)))))
        (let invalidate ((index 2))
          (if (<= index 2046)
            (begin
              (c#targ-fp-cache-invalidate (c#make-stk index))
              (invalidate (+ index 2)))))
        (verify-cache)
        (let refill ((index 2))
          (if (<= index 2046)
            (begin
              (c#targ-fp-cache-enter (c#make-stk index) #f)
              (refill (+ index 2)))))
        (verify-cache)
        (compiler-reservation-check (= checks 134) "incomplete compiler control")
        (display "COMPILER-RESERVATION-OK observations=")
        (display checks)
        (display " events=4093 charge=6 native-words=2")
        (newline) (force-output)))
    (lambda ()
      (set! c#targ-fp-cache saved-cache)
      (set! c#targ-proc-heap-reserved saved-reserved)
      (set! c#targ-proc-flo-reserved saved-flo))))

;;; Exercise complete check blocks with the real emitter, label table, frame
;;; map generator and counters. This file runs in a dedicated GSC process.
;;; Official initialization is required before creating temporary variables.
(compiler-reservation-check (not c#targ-combine-checks?) "unqualified combined-check compiler metadata")
(c#env.begin!)
(c#targ-set-nb-regs c#targ-target '())
(let ((cases 0))
  (define (check-emission heap floating ssb poll combine target-stack)
    (set! c#targ-proc-code (c#make-stretchable-vector #f))
    (set! c#targ-proc-code-length 0)
    (set! c#targ-proc-rd-res (c#make-stretchable-vector #f))
    (set! c#targ-proc-wr-res (c#make-stretchable-vector #f))
    (set! c#targ-module-rd-res (c#make-stretchable-vector #f))
    (set! c#targ-module-wr-res (c#make-stretchable-vector #f))
    (set! c#targ-proc-lbl-tbl (c#queue-empty))
    (set! c#targ-proc-lbl-tbl-ord (c#queue-empty))
    (set! c#targ-debug-info-state (c#make-debug-info-state))
    (set! c#targ-proc-lbl-counter (c#make-counter 17))
    (set! c#targ-proc-entry-frame
          (c#make-frame 1 (list c#ret-var) '() '() c#ret-var-set))
    (set! c#targ-proc-instr-node #f)
    (set! c#targ-proc-fp 1)
    (set! c#targ-proc-heap-reserved 11)
    (set! c#targ-proc-flo-reserved 6)
    (set! c#targ-proc-ssb-reserved 3)
    (c#targ-fp-cache-init)
    (c#targ-check-conditions heap floating ssb poll target-stack)
    (let ((enabled (or heap ssb poll)))
      (compiler-reservation-check
       (and (= c#targ-proc-code-length (if enabled 3 0))
            (= c#targ-proc-fp (if enabled target-stack 1))
            (= c#targ-proc-heap-reserved (if heap 0 11))
            (= c#targ-proc-flo-reserved (if heap 0 6))
            (= c#targ-proc-ssb-reserved (if ssb 0 3))
            (= (length (c#queue->list c#targ-proc-lbl-tbl-ord)) (if enabled 1 0)))
       "check block count, budget or frame mismatch")
      (if enabled
        (let* ((adjust (c#stretchable-vector-ref c#targ-proc-code 0))
               (check (c#stretchable-vector-ref c#targ-proc-code 1))
               (return (c#stretchable-vector-ref c#targ-proc-code 2))
               (label (cdr return))
               (metadata (vector-ref label 3))
               (expected-opcode
                (string-append
                 (if combine "CHECK" (if poll "POLL" "CHECK"))
                 (if heap "_HEAP" "")
                 (if (and heap (eqv? heap floating)) "_FLO" "")
                 (if ssb "_SSB" "") (if (and poll combine) "_POLL" ""))))
          (compiler-reservation-check
           (and (equal? adjust (if (= target-stack 1) #f (list "ADJFP" (- target-stack 1))))
                (equal? (car check) expected-opcode)
                (eq? (cadr check) (vector-ref label 0))
                (equal? (cddr check) (append (if heap (list (+ 4096 heap)) '()) (if ssb (list ssb) '())))
                (eq? (car return) 'label) (eq? (vector-ref label 2) 'return)
                (eq? (vector-ref metadata 0) 'internal)
                (= (vector-ref metadata 1) target-stack)
                (integer? (vector-ref metadata 2)) (integer? (vector-ref metadata 3))
                (equal? c#targ-fp-cache (vector 0 '#() 0)))
           (list "complete native check instruction or internal return mismatch" heap floating ssb poll combine target-stack adjust check return c#targ-fp-cache)))))
    (set! cases (+ cases 1)))
  (for-each (lambda (heap)
    (for-each (lambda (floating)
      (for-each (lambda (ssb)
        (for-each (lambda (poll)
          (for-each (lambda (combine)
            (for-each (lambda (stack)
              (check-emission heap floating ssb poll combine stack)) '(1 3))) '(#f))) '(#f #t))) '(#f 0 7))) '(#f #t 0 7))) '(#f 0 7))
  (compiler-reservation-check (= cases 144) "incomplete emission control")
  (display "COMPILER-EMISSION-OK cases=144") (newline) (force-output))
;;; The prior grid leaves initialized native label/resource state. Exercise the
;;; real triggering path through frame selection and a dirty F64BOX writeback.
(let ((value-var (c#make-temp-var 'floating-control)))
  (set! c#targ-proc-code (c#make-stretchable-vector #f))
  (set! c#targ-proc-code-length 0)
  (set! c#targ-proc-fp 2)
  (set! c#targ-proc-entry-frame
        (c#make-frame 2 (list c#ret-var value-var) '() '()
                      (c#list->varset (list c#ret-var value-var))))
  (set! c#targ-proc-heap-reserved 4096)
  (set! c#targ-proc-flo-reserved 0)
  (c#targ-fp-cache-init)
  (c#targ-fp-cache-enter (c#make-stk 1) #t)
  (c#targ-heap-reserve-and-check 0 #f 2)
  (compiler-reservation-check
   (and (= c#targ-proc-code-length 4)
        (equal? (c#stretchable-vector-ref c#targ-proc-code 0)
                '("SET_STK" -1 ("F64BOX" ("F64V1"))))
        (not (c#stretchable-vector-ref c#targ-proc-code 1))
        (equal? (car (c#stretchable-vector-ref c#targ-proc-code 2)) "CHECK_HEAP")
        (equal? (cddr (c#stretchable-vector-ref c#targ-proc-code 2)) '(4096))
        (eq? (car (c#stretchable-vector-ref c#targ-proc-code 3)) 'label)
        (= c#targ-proc-heap-reserved 0) (= c#targ-proc-flo-reserved 0)
        (equal? c#targ-fp-cache (vector 0 '#() 0)))
   "triggered frame flush, check or reset mismatch")
  (display "COMPILER-TRIGGER-OK flush=1 instructions=4") (newline) (force-output))

;;; Native close generation: all allocations precede environment setup, so
;;; captures may refer to any closure in the same mutually recursive group.
(let ((cases 0))
  (for-each
   (lambda (count)
     (for-each
      (lambda (arity)
        (set! c#targ-proc-code (c#make-stretchable-vector #f))
        (set! c#targ-proc-code-length 0)
        (set! c#targ-proc-fp 1)
        (set! c#targ-proc-heap-reserved 0)
        (set! c#targ-proc-flo-reserved 0)
        (c#targ-fp-cache-init)
        (let* ((indices (let loop ((i 1)) (if (> i count) '() (cons i (loop (+ i 1))))))
               (parms
                (map (lambda (i)
                       (c#make-closure-parms (c#make-stk i) (+ 100 i)
                         (let loop ((j 0))
                           (if (= j arity) '()
                             (cons (c#make-stk (+ 1 (modulo (+ i j) count))) (loop (+ j 1))))))) indices)))
          (c#targ-gen-close parms 1)
          (compiler-reservation-check
           (and (= c#targ-proc-code-length (* count (+ arity 3)))
                (= c#targ-proc-heap-reserved (* count (c#targ-closure-space arity)))
                (= c#targ-proc-flo-reserved 0))
           "closure emission count or reservation mismatch")
          (for-each
           (lambda (i)
             (compiler-reservation-check
              (equal? (c#stretchable-vector-ref c#targ-proc-code (- i 1))
                      (list "SET_STK" (- i 1) (list "ALLOC_CLO" (c#targ-c-unsigned-long arity))))
              "closure allocation order mismatch")
             (let* ((offset (+ count (* (- i 1) (+ arity 2))))
                    (setup-instruction (c#stretchable-vector-ref c#targ-proc-code offset)))
               (compiler-reservation-check
                (and (equal? (car setup-instruction) "BEGIN_SETUP_CLO") (= (cadr setup-instruction) arity)
                     (equal? (caddr setup-instruction) (list "STK" (- i 1)))
                     (eq? (cadddr setup-instruction) (c#targ-ref-lbl-val (+ 100 i)))
                     (equal? (c#stretchable-vector-ref c#targ-proc-code (+ offset arity 1))
                             (list "END_SETUP_CLO" arity)))
                "closure setup order, destination or label mismatch")
               (let loop ((j 0))
                 (if (< j arity)
                   (begin
                     (compiler-reservation-check
                      (equal? (c#stretchable-vector-ref c#targ-proc-code (+ offset j 1))
                              (list "ADD_CLO_ELEM" j (list "STK" (modulo (+ i j) count))))
                      "closure capture index or operand mismatch")
                     (loop (+ j 1))))))) indices))
        (set! cases (+ cases 1))) '(0 1 2 4 8))) '(0 1 2 4 8))
  (compiler-reservation-check (= cases 25) "incomplete native closure control")
  (display "COMPILER-CLOSURE-OK cases=25") (newline) (force-output))

;;; Noninlined local jump tails, with the real frame and block-check producers.
(let ((cases 0))
  (for-each (lambda (label?)
   (for-each (lambda (arguments)
    (for-each (lambda (safe?)
     (for-each (lambda (falls?)
      (for-each (lambda (poll?)
       (set! c#targ-proc-code (c#make-stretchable-vector #f))
       (set! c#targ-proc-code-length 0)
       (set! c#targ-proc-fp 1)
       (set! c#targ-proc-heap-reserved 0)
       (set! c#targ-proc-flo-reserved 0)
       (set! c#targ-proc-ssb-reserved 0)
       (set! c#targ-proc-unique-name "local-transfer-control")
       (set! c#targ-proc-entry-frame (c#make-frame 1 (list c#ret-var) '() '() c#ret-var-set))
       (set! c#targ-proc-exit-frame c#targ-proc-entry-frame)
       (c#targ-fp-cache-init)
       (c#targ-gen-jump (if label? (c#make-lbl 700) (c#make-reg 4)) #f arguments poll? safe? (if falls? 700 #f))
       (let* ((offset (if poll? 3 0))
              (tail (c#stretchable-vector-ref c#targ-proc-code (+ offset 1)))
              (nargs (if arguments (list "SET_NARGS" arguments) #f))
              (expected
               (if label?
                 (if falls? nargs
                   (list 'seq nargs (list "GOTO" (c#targ-ref-lbl-goto 700))))
                 (if arguments
                   (list (if safe? "JUMPGENSAFE" "JUMPGENNOTSAFE") nargs (cons 'r 4))
                   (list "JUMPRET" (cons 'r 4))))))
         (compiler-reservation-check
          (and (= c#targ-proc-code-length (+ offset 2))
               (not (c#stretchable-vector-ref c#targ-proc-code offset))
               (equal? tail expected)
               (or (not poll?)
                   (and (equal? (car (c#stretchable-vector-ref c#targ-proc-code 1)) "POLL")
                        (eq? (car (c#stretchable-vector-ref c#targ-proc-code 2)) 'label))))
          "local transfer or block poll mismatch"))
       (set! cases (+ cases 1))) '(#f #t))) '(#f #t))) '(#f #t))) '(#f 0))) '(#f #t))
  (compiler-reservation-check (= cases 32) "incomplete local jump control")
  (display "COMPILER-JUMP-OK cases=32") (newline) (force-output))

;;; Actual switch producer, including normalized small groups and symkey buckets.
(c#targ-heap-begin!)
(define (compiler-control-prefix values count)
  (if (= count 0) '() (cons (car values) (compiler-control-prefix (cdr values) (- count 1)))))
(let ((checks 0))
  (define (switch-group entries begin-name case-name end-name)
    (if (null? entries) '()
      (append (list (list begin-name (cons 'r 4)))
        (map (lambda (entry) (list case-name (c#targ-use-obj (car entry))
                                  (c#targ-ref-lbl-goto (cdr entry)))) entries)
        (list (list end-name)))))
  (define (check-switch values next-default? poll?)
    (set! c#targ-proc-code (c#make-stretchable-vector #f))
    (set! c#targ-proc-code-length 0)
    (set! c#targ-proc-fp 1)
    (set! c#targ-proc-heap-reserved 0)
    (set! c#targ-proc-flo-reserved 0)
    (set! c#targ-proc-ssb-reserved 0)
    (set! c#targ-proc-entry-frame (c#make-frame 1 (list c#ret-var) '() '() c#ret-var-set))
    (set! c#targ-proc-exit-frame c#targ-proc-entry-frame)
    (c#targ-fp-cache-init)
    (let* ((entries (let loop ((rest values) (label 3000))
                      (if (null? rest) '() (cons (c#make-switch-case (car rest) label) (loop (cdr rest) (+ label 1))))))
           (fixnums (filter (lambda (entry) (c#targ-fixnum32? (car entry))) entries))
           (characters (filter (lambda (entry) (char? (car entry))) entries))
           (symbols (filter (lambda (entry) (c#symbol-object? (car entry))) entries))
           (keywords (filter (lambda (entry) (c#keyword-object? (car entry))) entries))
           (other (filter (lambda (entry)
                            (not (or (c#targ-fixnum32? (car entry)) (char? (car entry))
                                     (c#symbol-object? (car entry)) (c#keyword-object? (car entry))))) entries))
           (general (append (if (<= (length characters) 2) characters '())
                            (if (<= (length fixnums) 2) fixnums '()) other))
           (symkeys (append symbols keywords))
           (expected
            (append
             (switch-group general "BEGIN_SWITCH" "SWITCH_CASE_GOTO" "END_SWITCH")
             (switch-group (if (<= (length fixnums) 2) '() fixnums) "BEGIN_SWITCH_FIXNUM" "SWITCH_FIXNUM_CASE_GOTO" "END_SWITCH_FIXNUM")
             (switch-group (if (<= (length characters) 2) '() characters) "BEGIN_SWITCH_CHAR" "SWITCH_CHAR_CASE_GOTO" "END_SWITCH_CHAR")
             (if (<= (length symkeys) 20)
               (map (lambda (entry) (list "IF_GOTO" (list "EQP" (cons 'r 4) (c#targ-use-obj (car entry)))
                                          (c#targ-ref-lbl-goto (cdr entry)))) symkeys)
               (let* ((capacity (let grow ((n 1)) (if (> n (length symkeys)) n (grow (* n 2)))))
                      (guard (if (null? keywords) "SYMBOLP" (if (null? symbols) "KEYWORDP" "SYMKEYP"))))
                 (append
                  (list (list "BEGIN_SWITCH_SYMKEY" (cons 'r 4) capacity (list guard)))
                  (let buckets ((index 0))
                    (if (= index capacity) '()
                      (append (list (list "SWITCH_SYMKEY_CASE" index))
                        (map (lambda (entry) (list "SWITCH_SYMKEY_CASE_GOTO" (c#targ-use-obj (car entry))
                                                   (c#targ-ref-lbl-goto (cdr entry))))
                          (filter (lambda (entry)
                                    (= (modulo (c#targ-hash (if (c#symbol-object? (car entry))
                                                            (symbol->string (car entry))
                                                            (c#keyword-object->string (car entry)))) capacity) index)) symkeys))
                        (list (list "GOTO" (c#targ-ref-lbl-goto 9000))) (buckets (+ index 1)))))
                  (list (list "END_SWITCH_SYMKEY")))))
             (if next-default? '() (list (list "GOTO" (c#targ-ref-lbl-goto 9000)))))))
      (for-each (lambda (entry)
        (let* ((value (car entry))
               (name (if (c#symbol-object? value) (symbol->string value) (c#keyword-object->string value)))
               (runtime-hash (if (c#symbol-object? value) (##symbol-hash value) (##keyword-hash value))))
          (compiler-reservation-check (= (c#targ-hash name) runtime-hash)
            "compiler and native symkey hash fields disagree"))) symkeys)
      (c#targ-gen-switch (c#make-reg 4) entries 9000 poll? (if next-default? 9000 #f))
      (let ((offset (if poll? 4 1)))
        (compiler-reservation-check
         (and (= c#targ-proc-code-length (+ offset (length expected)))
              (not (c#stretchable-vector-ref c#targ-proc-code (- offset 1))))
         "switch block prelude or instruction count mismatch")
        (let compare ((index offset) (rest expected))
          (if (pair? rest)
            (begin
              (compiler-reservation-check (equal? (c#stretchable-vector-ref c#targ-proc-code index) (car rest))
                (list "switch target instruction mismatch" index (car rest)))
              (compare (+ index 1) (cdr rest)))))))
    (set! checks (+ checks 1)))
  (let* ((names (let loop ((index 0)) (if (= index 21) '()
                  (cons (string-append "switch-symbol-" (number->string index)) (loop (+ index 1))))))
         (symbols (map string->symbol names))
         (keywords (map string->keyword names))
         (collisions (let find ((index 0) (rest '()))
                       (if (= (length rest) 21) (reverse rest)
                         (let ((name (string-append "switch-collision-" (number->string index))))
                           (find (+ index 1) (if (= (modulo (c#targ-hash name) 32) 7) (cons (string->symbol name) rest) rest))))))
         (unicode-names (map (lambda (name) (string-append "λ-中-" name)) names))
         (profiles (list '() '(1) '(1 2) '(1 2 3) '(#\a #\b #\c)
                         '(#t 1 #\a #f 2 #\b) (list (car symbols))
                         (compiler-control-prefix symbols 20) symbols keywords
                         (append (compiler-control-prefix symbols 11) (compiler-control-prefix keywords 10)) collisions
                         (map string->symbol unicode-names) (map string->keyword unicode-names))))
    (for-each (lambda (values)
      (for-each (lambda (next?)
        (for-each (lambda (poll?) (check-switch values next? poll?)) '(#f #t))) '(#f #t))) profiles))
  (compiler-reservation-check (= checks 56) "incomplete switch control")
  (display "COMPILER-SWITCH-OK cases=56") (newline) (force-output))

;;; Official target selection supplies actual built-in primitive generators.
(c#virtual.begin!)
(compiler-reservation-check (vector? c#*opnd-table*) "uninitialized native operand table")
(c#target-select! 'C '() #f)
(let ((checks 0))
  (define (prepare-ifjump)
    (set! c#targ-proc-code (c#make-stretchable-vector #f))
    (set! c#targ-proc-code-length 0)
    (set! c#targ-proc-fp 1)
    (set! c#targ-proc-heap-reserved 0)
    (set! c#targ-proc-flo-reserved 0)
    (set! c#targ-proc-ssb-reserved 0)
    (set! c#targ-proc-entry-frame (c#make-frame 1 (list c#ret-var) '() '() c#ret-var-set))
    (set! c#targ-proc-exit-frame c#targ-proc-entry-frame)
    (c#targ-fp-cache-init))
  (define (compare-ifjump expected poll?)
    (let ((offset (if poll? 3 0)))
      (compiler-reservation-check (= c#targ-proc-code-length (+ offset (length expected))) "ifjump instruction count mismatch")
      (let loop ((index offset) (rest expected))
        (if (pair? rest)
          (begin
            (compiler-reservation-check (equal? (c#stretchable-vector-ref c#targ-proc-code index) (car rest))
              (list "ifjump target instruction mismatch" index (car rest)))
            (loop (+ index 1) (cdr rest))))))
    (set! checks (+ checks 1)))
  (for-each (lambda (result?)
    (for-each (lambda (next)
      (for-each (lambda (poll?)
        (prepare-ifjump)
        (c#targ-gen-ifjump c#**not-proc-obj (list (c#make-reg 4)) (if result? (c#make-reg 3) #f) #f 600 601 poll? next)
        (let* ((inverted? (eqv? next 600)) (branch (if inverted? 601 600)) (fall (if inverted? 600 601))
               (predicate (list "FALSEP" (cons 'r 4))) (clear (list 'set-r 3 '("FAL"))))
          (compare-ifjump
            (append (list #f (list "IF" (if inverted? (list "NOT" predicate) predicate)))
              (if (and result? inverted?) (list clear) '())
              (list (list "GOTO" (c#targ-ref-lbl-goto branch)) '("END_IF"))
              (if (and result? (not inverted?)) (list clear) '())
              (if (eqv? next fall) '() (list (list "GOTO" (c#targ-ref-lbl-goto fall))))) poll?))) '(#f #t))) '(#f 600 601))) '(#f #t))
  (for-each (lambda (flonum?)
    (for-each (lambda (negated?)
      (for-each (lambda (next)
        (for-each (lambda (poll?)
          (prepare-ifjump)
          (c#targ-fp-cache-enter (c#make-reg 4) #f)
          (c#targ-gen-ifjump (if flonum? c#**flonum?-proc-obj c#**fixnum?-proc-obj)
                             (list (c#make-reg 4)) #f negated? 600 601 poll? next)
          (let ((dest (if flonum? (if negated? 601 600) (if negated? 600 601))))
            (compare-ifjump (list #f (if (eqv? dest next) #f
              (list 'seq #f (list "GOTO" (c#targ-ref-lbl-goto dest))))) poll?))) '(#f #t))) '(#f 600 601))) '(#f #t))) '(#f #t))
  (compiler-reservation-check (= checks 36) "incomplete native ifjump control")
  (display "COMPILER-IFJUMP-OK cases=36") (newline) (force-output))

(compiler-reservation-check (not c#targ-track-scheme-option?) "unqualified source-tracking compiler metadata")
(let ((checks 0))
  (for-each (lambda (task?)
    (for-each (lambda (frame-size)
      (for-each (lambda (label)
        (set! c#targ-proc-code (c#make-stretchable-vector #f))
        (set! c#targ-proc-code-length 0)
        (set! c#targ-proc-heap-reserved 17)
        (set! c#targ-proc-flo-reserved 6)
        (set! c#targ-proc-ssb-reserved 3)
        (c#targ-fp-cache-init)
        (c#targ-fp-cache-enter (c#make-reg 4) #t)
        (let* ((frame (c#make-frame frame-size (cons c#ret-var (make-list (- frame-size 1) c#empty-var)) '() '() c#ret-var-set))
               (instruction ((if task? c#make-label-task-entry c#make-label-simple) label frame #f)))
          (c#targ-gen-gvm-instr #f instruction #f frame-size)
          (let ((emitted (c#stretchable-vector-ref c#targ-proc-code 0)))
            (compiler-reservation-check
             (and (= c#targ-proc-code-length (if task? 2 1))
                  (eq? (car emitted) 'label) (eq? (cdr emitted) (c#targ-get-lbl label))
                  (not (vector-ref (cdr emitted) 2))
                  (or (not task?) (equal? (c#stretchable-vector-ref c#targ-proc-code 1) '("TASK_PUSH" 0)))
                  (= c#targ-proc-fp frame-size) (= c#targ-proc-heap-reserved 0)
                  (= c#targ-proc-flo-reserved 0) (= c#targ-proc-ssb-reserved 0)
                  (equal? c#targ-fp-cache (vector 0 '#() 0)))
             "GVM label dispatch, frame reset or cache-region mismatch")))
        (set! checks (+ checks 1))) '(10000 10001))) '(1 3))) '(#f #t))
  (compiler-reservation-check (= checks 8) "incomplete GVM label control")
  (display "COMPILER-LABEL-OK cases=8") (newline) (force-output))

(c#virtual.end!)
(c#env.end!)
