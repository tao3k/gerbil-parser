;;; -*- Gerbil -*-
;;; Compare the closed flat-block event path with generated recursive events.
;;; Compile with gxc -O before invoking main from gxi.

(import (only-in :gerbil-parser/languages/hcl/v2-24/parser hcl-v2-24-parser)
        (only-in :gerbil-parser/languages/hcl/v2-24/direct-recursive
                 direct-parse-hcl direct-lex-hcl)
        (only-in :gerbil-parser/src/runtime/lexer lex-source)
        (only-in :gerbil-parser/src/runtime/artifact
                 parse-artifact-success?))

(def (benchmark-source blocks shape)
  (call-with-output-string
   (lambda (port)
     (let loop ((i 0))
       (when (< i blocks)
         (display "srv" port)
         (display i port)
         (when (eq? shape 'labeled)
           (display " \"web\" internal" port))
         (display " {\nkey = 1\nport = 2\n}\n" port)
         (loop (fx+ i 1)))))))

(def (main . args)
  (def (argument index default)
    (if (> (length args) index) (list-ref args index) default))
  (let* ((blocks (string->number (argument 0 "256")))
         (samples (string->number (argument 1 "20")))
         (iterations (string->number (argument 2 "10")))
         (shape (string->symbol (argument 3 "unlabeled"))))
    (unless (and (integer? blocks) (positive? blocks)
                 (integer? samples) (positive? samples)
                 (integer? iterations) (positive? iterations)
                 (memq shape '(unlabeled labeled)))
      (error "expected blocks, samples, iterations, unlabeled|labeled" args))
    (let* ((source (benchmark-source blocks shape))
           (generic (direct-parse-hcl hcl-v2-24-parser source #f))
           (specialized (direct-parse-hcl hcl-v2-24-parser source #t)))
      (unless (and (parse-artifact-success? generic)
                   (equal? generic specialized)
                   (equal? (direct-lex-hcl source)
                           (lex-source hcl-v2-24-parser source)))
        (error "flat-block path changed tokens or complete ParseArtifact"))
      (set! generic #f)
      (set! specialized #f)
      (def (measure specialized?)
        (##gc)
        (let ((started (##current-time-point))
              (cpu-started (cpu-time)))
          (let loop ((remaining iterations))
            (when (> remaining 0)
              (direct-parse-hcl hcl-v2-24-parser source specialized?)
              (loop (fx- remaining 1))))
          (values
           (/ (* 1000.0 (- (cpu-time) cpu-started)) iterations)
           (/ (* 1000.0 (- (##current-time-point) started)) iterations))))
      (write (list (cons 'blocks blocks)
                   (cons 'shape shape)
                   (cons 'lines (* 4 blocks))
                   (cons 'source-characters (string-length source))
                   (cons 'iterations iterations)))
      (newline)
      (let sample-loop ((sample -3))
        (when (< sample samples)
          (let-values (((first-cpu first-elapsed)
                        (measure (odd? sample))))
            (let-values (((second-cpu second-elapsed)
                          (measure (even? sample))))
              (when (>= sample 0)
                (write
                 (list (cons 'sample sample)
                       (cons 'generic-cpu-ms
                             (if (odd? sample) second-cpu first-cpu))
                       (cons 'specialized-cpu-ms
                             (if (odd? sample) first-cpu second-cpu))
                       (cons 'generic-elapsed-ms
                             (if (odd? sample) second-elapsed first-elapsed))
                       (cons 'specialized-elapsed-ms
                             (if (odd? sample) first-elapsed second-elapsed))))
                (newline))))
          (sample-loop (fx+ sample 1)))))))
(export main)
