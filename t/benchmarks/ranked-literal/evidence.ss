;;; Exact allocation evidence and conservative CPU admission from native receipts.
(import (only-in :gerbil-parser/t/benchmarks/parser-stage-cost/receipt read-parser-component-receipt))
(export compare-ranked-literal-receipts)
(def (field row key) (cdr (assq key row)))
(def (require! condition . detail)
  (unless condition (apply error "ranked scanner evidence rejected" detail)))
(def (read-request-receipt path)
  (read-parser-component-receipt path "RANKED-LITERAL-REQUESTS-OK" 12 5000 20))

(def (compare-ranked-literal-receipts reference-a candidate-a candidate-b reference-b)
  (let* ((ra (read-request-receipt reference-a)) (ca (read-request-receipt candidate-a))
         (cb (read-request-receipt candidate-b)) (rb (read-request-receipt reference-b)))
    (def (cpu receipt key) (field (hash-get (car receipt) key) 'cpuP50Ms))
    (def (control? key)
      (or (= (cadr key) 1) (eq? (car key) 'missing-prefix)
          (eq? (car key) 'filtered-prefixes)))
    (def (stable? key)
      (let* ((c [(cpu ca key) (cpu cb key)]) (r [(cpu ra key) (cpu rb key)])
             (ratio (/ (apply + c) (apply + r))))
        (and (<= 0.95 ratio 1.05)
             (<= (/ (apply min c) (apply max r)) 1 (/ (apply max c) (apply min r))))))
    (let* ((keys (apply append
                  (map (lambda (width)
                         (map (lambda (name) (list name width))
                              '(accepting-prefixes filtered-prefixes missing-prefix))) '(1 4 16 64))))
           (controls-stable? (andmap stable? (filter control? keys))))
      (for-each
       (lambda (key)
         (let* ((baseline (car (hash-get (cadr ra) key)))
                (candidate (car (hash-get (cadr ca) key)))
                (saved (/ (- baseline candidate) 5000))
                (expected (if (eq? (car key) 'accepting-prefixes) (* 192 (- (cadr key) 1)) 0))
                (benefit? (< (max (cpu ca key) (cpu cb key))
                             (* 0.95 (min (cpu ra key) (cpu rb key))))))
           (require! (= baseline (car (hash-get (cadr rb) key))) key 'reference-drift)
           (require! (= candidate (car (hash-get (cadr cb) key))) key 'candidate-drift)
           (require! (= saved expected) key 'allocation-model)
           (write (list 'RANKED-LITERAL-EVIDENCE key 'saved-bytes saved
                        'cpu-ratio (/ (+ (cpu ca key) (cpu cb key)) (+ (cpu ra key) (cpu rb key)))
                        'repeated-benefit? benefit?
                        'cpu-benefit-admitted? (and controls-stable? benefit?)))
           (newline) (force-output))) keys)
      (write (list 'RANKED-LITERAL-ALLOCATION-OK 'admitted-intervals
                   (+ (caddr ra) (caddr ca) (caddr cb) (caddr rb))
                   'controls-stable? controls-stable?)) (newline) (force-output))))
