;;; Full generated Org Fold. Probe mode is diagnostic, never timed admission.
(import :std/ffi :std/misc/ports :std/crypto/digest :std/encoding/hex
        (only-in :std/os/time current-system-time-precise timespec-tv_sec timespec-tv_nsec)
        :gerbil-parser/benchmarks/real-fold/parse-org-compiled-events)
(export main)
(C-ffi-macrology)
(C-include "<sys/resource.h>")
(def-C-lambda gc-count () double "___return(___VMSTATE->mem.nb_gcs_);")
(def-C-lambda gc-wall () double "___return(___VMSTATE->mem.gc_real_time_);")
(def-C-lambda gc-live () double "___return(___VMSTATE->mem.latest_gc_live_);")
(def-C-lambda heap-bytes () unsigned-int64
  "___return(___VMSTATE->mem.heap_size_ * sizeof(___WORD));")
(def-C-lambda cpu-seconds () double
  "struct rusage r; getrusage(RUSAGE_SELF, &r);
   ___return(r.ru_utime.tv_sec + r.ru_stime.tv_sec +
     (r.ru_utime.tv_usec + r.ru_stime.tv_usec) * 1e-6);")
(def-C-lambda involuntary () long
  "struct rusage r; getrusage(RUSAGE_SELF, &r); ___return(r.ru_nivcsw);")
(def (clock-ns)
  (let (t (current-system-time-precise))
    (+ (* (timespec-tv_sec t) 1000000000) (timespec-tv_nsec t))))
(def (main requests batches fixtures grammar-path (mode "baseline"))
  (let* ((count (string->number requests)) (samples (string->number batches))
         (probe? (equal? mode "diagnostic"))
         (grammar (call-with-input-file grammar-path read-all-as-string))
         (bases (list->vector (map (lambda (name)
                   (call-with-input-file (path-expand name fixtures) read-all-as-string))
                 '("doc.org" "plain-links.org" "quote-heavy.org")))))
    (unless (and (memv count '(1000 10000 100000)) (= samples 20)
                 (member mode '("baseline" "diagnostic"))) (error "invalid baseline arguments"))
    (for-each
      (lambda (batch)
        (let* ((inputs (list->vector (map (lambda (index)
                         (string-append (vector-ref bases (modulo index 3))
                           "\nchanging request " (number->string index) " α中🦀\n"))
                       (iota count (* count batch)))))
               (corpus (Digest::sha256)) (input-bytes 0)
               (latencies (make-f64vector count 0.)) (rows '())
               (output (Digest::sha256)) (output-bytes 0))
          (for-each (lambda (source)
            (let (bytes (string->utf8 source))
              (set! input-bytes (+ input-bytes (u8vector-length bytes)))
              (digest-update! corpus bytes))) (vector->list inputs))
          (let ((corpus-hash (hex-encode (digest-final! corpus))))
            (parse-org-compiled-events (vector-ref inputs 0))
            (let* ((g0 (gc-count)) (gw0 (gc-wall)) (cpu0 (cpu-seconds))
                   (stats0 (##process-statistics)) (begin (clock-ns)))
              (let loop ((index 0))
                (when (< index count)
                  (let* ((ng0 (and probe? (gc-count)))
                         (w0 (and probe? (gc-wall))) (c0 (and probe? (cpu-seconds)))
                         (s0 (and probe? (involuntary))) (start (clock-ns))
                         (tape (parse-org-compiled-events (vector-ref inputs index)))
                         (elapsed (- (clock-ns) start)))
                    (when (< elapsed 0) (error "benchmark clock moved backwards"))
                    (f64vector-set! latencies index (/ elapsed 1000.0))
                    (when probe?
                      (let (row (list (/ elapsed 1000.0) index (- (gc-count) ng0)
                                      (* 1e6 (- (gc-wall) w0))
                                      (* 1e6 (- (cpu-seconds) c0)) (- (involuntary) s0)))
                        (set! rows (take (list-sort (lambda (a b) (> (car a) (car b)))
                                                   (cons row rows)) (min 20 (+ 1 (length rows)))))))
                    (set! output-bytes (+ output-bytes (u8vector-length tape)))
                    (digest-update! output tape)
                    (loop (+ index 1)))))
              (let* ((wall (/ (- (clock-ns) begin) 1e9))
                     (cpu (- (cpu-seconds) cpu0)) (gcs (- (gc-count) g0))
                     (gc-s (- (gc-wall) gw0)) (stats1 (##process-statistics))
                     (sorted (list->vector (list-sort < (f64vector->list latencies)))))
                (write `(backend-baseline.v1 (backend . scheme-vm) (workload . real-org-fold)
                  (mode . ,(string->symbol mode)) (requests . ,count) (batch . ,batch)
                  (grammar . ,grammar) (corpus-sha256 . ,corpus-hash) (input-bytes . ,input-bytes)
                  (input-reserved-bytes . unavailable) (wall-s . ,wall)
                  (throughput-requests/s . ,(/ count wall))
                  (p95-us . ,(vector-ref sorted (- (quotient (+ (* count 95) 99) 100) 1)))
                  (p99-us . ,(vector-ref sorted (- (quotient (+ (* count 99) 99) 100) 1)))
                  (output-sha256 . ,(hex-encode (digest-final! output)))
                  (output-bytes . ,output-bytes) (gc-count . ,gcs) (gc-wall-s . ,gc-s)
                  (process-cpu-s . ,cpu) (vm-heap-bytes . ,(heap-bytes))
                  (latest-gc-live-raw . ,(gc-live))
                  (allocation-counter-delta . ,(- (f64vector-ref stats1 7) (f64vector-ref stats0 7)))
                  (boundary . fold-to-oev1-with-stream-validation) (concurrency . 1) (smp . not-exercised)))
                (newline)
                (when probe?
                  (write `(org-fold-diagnostic.v1 (batch . ,batch)
                    (fields . (wall-us index gc-count gc-wall-us cpu-us involuntary-switches))
                    (slow-requests . ,rows))) (newline))
                (force-output)))))) (iota samples 1))
    (displayln "BACKEND-BASELINE-COMPLETE")))
