#!/usr/bin/env gxi
;;; Scheme owns tables and recognized captures; Rust independently executes the
;;; construction IR. These controls do not claim Rust Word recognition.
(import (only-in :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process test-child-process-exit!)
        (only-in :gerbil-parser/t/fixtures/bash-products bash-results bash-parts bash-word-regions)
        (only-in :gerbil-parser/src/compiler/rust-runtime result-profile-rust-source)
        (only-in :gerbil-parser/src/language/result-profile compile-result-profile result-plan-recipe)
        (only-in :gerbil-parser/src/language/part-profile compile-part-profile)
        (only-in :gerbil-parser/src/runtime/shell-word make-shell-word-parser)
        (only-in :gerbil-parser/src/runtime/token make-token token? token-kind token-start token-end)
        (only-in :gerbil-parser/src/runtime/recognition recognition-node-kind recognition-node-start recognition-node-end
                 recognition-node-children recognition-child-field recognition-child-value))
(def controls '((word "") (word "α😀") (word "'α😀'") (word "\"α${x:-中}\"")
  (word "$'a\\n'") (word "${arr[${i:-1}]:-λ}") (word "$(echo α)")
  (word "$((1+2))") (word "<(echo 中)") (word "`echo α`") (word "$x\\α")
  (assignment "name+=\"α${x:-中}\"") (here "α${x:-中}\\\n")))
(def (index-of values predicate)
  (let loop ((values values) (at 0))
    (cond ((null? values) (error "unknown result kind")) ((predicate (car values)) at)
          (else (loop (cdr values) (+ at 1))))))
(def (span port value)
  (display (if (token? value) (token-start value) (recognition-node-start value)) port)
  (display ".." port) (display (if (token? value) (token-end value) (recognition-node-end value)) port))
(def (main output)
  (let* ((plan (compile-result-profile bash-results)) (recipe (result-plan-recipe plan))
         (nodes (car recipe)) (terminals (cadr recipe)))
    (def (node-id kind) (index-of nodes (lambda (row) (eq? (car row) kind))))
    (def (token-id kind) (+ (length nodes) (index-of terminals (lambda (value) (eq? value kind)))))
    (def (replay port node)
      (let* ((id (recognition-node-kind node)) (projection (assq id (caddr recipe)))
             (children (recognition-node-children node)))
        (display "profile.project(" port) (write (symbol->string id) port) (display ", source, " port)
        (span port node) (display ", vec![" port)
        (for-each (lambda (operation)
          (let (values (map recognition-child-value (filter (lambda (child) (eq? (recognition-child-field child) (cadr operation))) children)))
            (case (car operation)
              ((token) (if (null? values) (display "ResultCapture::Absent" port)
                         (begin (display "ResultCapture::Span(" port) (span port (car values)) (display ")" port))))
              ((one) (if (null? values) (display "ResultCapture::Absent" port)
                       (begin (display "ResultCapture::Node(" port) (replay port (car values)) (display "?)" port))))
              ((many) (display "ResultCapture::Parts(vec![" port)
                (for-each (lambda (value) (replay port value) (display "?," port)) values) (display "])" port)))
            (display "," port))) (cdddr projection))
        (display "])" port)))
    (def (events port value)
      (if (token? value)
        (begin (display "TreeEvent::Token {kind: " port) (display (token-id (token-kind value)) port)
          (display ", start: " port) (display (token-start value) port) (display ", end: " port)
          (display (token-end value) port) (display "}," port))
        (begin (display "TreeEvent::StartNode(" port) (display (node-id (recognition-node-kind value)) port) (display ")," port)
          (for-each (lambda (child) (events port (recognition-child-value child))) (recognition-node-children value))
          (display "TreeEvent::FinishNode," port))))
    (def (fields port node)
      (for-each (lambda (child)
        (display "(" port) (write (symbol->string (recognition-node-kind node)) port) (display "," port)
        (write (symbol->string (recognition-child-field child)) port) (display ")," port)
        (unless (token? (recognition-child-value child)) (fields port (recognition-child-value child))))
        (recognition-node-children node)))
    (let-values (((word assignment here) (make-shell-word-parser bash-word-regions plan (compile-part-profile bash-parts))))
      (let (recognized (map (lambda (control)
        (let* ((source (cadr control)) (token (make-token 'word source 0 (u8vector-length (string->utf8 source))))
               (parser (case (car control) ((word) word) ((assignment) assignment) ((here) here))))
          (let-values (((node tokens) (parser token))) (unless node (error "control failed recognition" control)) node))) controls))
        (call-with-output-file output (lambda (port)
          (display (result-profile-rust-source plan) port)
          (display "use gerbil_parser_runtime::{PreparedResultProfile, ProjectedNode, ResultCapture, Diagnostic, TreeEvent};\n" port)
          (display "pub static SOURCES: &[&str] = &[" port)
          (for-each (lambda (row) (write (cadr row) port) (display "," port)) controls) (display "];\n" port)
          (for-each (lambda (node index)
            (display "fn replay_" port) (display index port)
            (display "<'s>(profile: &PreparedResultProfile, source: &'s str) -> Result<ProjectedNode<'s>, Diagnostic> {" port)
            (replay port node) (display "}\n" port)) recognized (iota (length controls)))
          (display "pub fn replay<'s>(profile: &PreparedResultProfile, source: &'s str, index: usize) -> Result<ProjectedNode<'s>, Diagnostic> {match index {\n" port)
          (for-each (lambda (index) (display index port) (display " => replay_" port) (display index port)
            (display "(profile, source),\n" port)) (iota (length controls)))
          (display "_ => panic!(\"unknown generated control\")}}\n" port)
          (display "pub static EXPECTED: &[&[TreeEvent]] = &[" port)
          (for-each (lambda (node) (display "&[" port) (events port node) (display "]," port)) recognized) (display "];\n" port)
          (display "pub static FIELDS: &[&[(&str,&str)]] = &[" port)
          (for-each (lambda (node) (display "&[" port) (fields port node) (display "]," port)) recognized) (display "];\n" port)))
        (displayln "RESULT-PROJECTIONS-RUST-GENERATED controls=" (length controls)) (force-output) (test-child-process-exit! 0)))))
